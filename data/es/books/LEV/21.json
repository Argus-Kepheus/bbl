1:23"},{"type":"char","marker":"w","strong":"H0389","content":["Empero"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H0935","content":["entrará"]}," ",{"type":"char","marker":"w","strong":"H6532","content":["del velo"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["adentro"]},", ",{"type":"char","marker":"w","strong":"H3808","content":["ni"]}," ",{"type":"char","marker":"w","strong":"H5066","content":["se allegará"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["al"]}," ",{"type":"char","marker":"w","strong":"H4196","content":["altar"]},", ",{"type":"char","marker":"w","strong":"H3588","content":["por"]}," ",{"type":"char","marker":"w","strong":"H3971","content":["cuanto hay falta"]}," en él: ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H2490","content":["profanará"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["mi"]}," ",{"type":"char","marker":"w","strong":"H4720","content":["santuario"]},", ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H6942","content":["soy el que los santifico"]},". ",{"type":"verse","marker":"v","eid":"LEV 21:23"},{"type":"verse","marker":"v","number":"24","sid":"LEV 21:24"},{"type":"char","marker":"w","strong":"H4872","content":["Y Moisés"]}," ",{"type":"char","marker":"w","strong":"H1696","content":["habló"]}," ",{"type":"char","marker":"w","strong":"H0175","content":["esto a Aarón"]},", ",{"type":"char","marker":"w","strong":"H1121","content":["y a sus hijos"]},", ",{"type":"char","marker":"w","strong":"H3605","content":["y a todos"]}," ",{"type":"char","marker":"w","strong":"H1121","content":["los hijos"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]},". ",{"type":"verse","marker":"v","eid":"LEV 21:24"}]}],"speech":{"1":{"text":"Y JEHOVÁ dijo a Moisés: Habla a los sacerdotes hijos de Aarón, y diles que no se contaminen por un muerto en sus pueblos.","spans":[{"start":24,"end":121,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"2":{"text":"Mas por su pariente cercano a sí, por su madre, o por su padre, o por su hijo, o por su hermano,","spans":[{"start":0,"end":96,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"3":{"text":"O por su hermana virgen, a él cercana, la cual no haya tenido marido, por ella se contaminará.","spans":[{"start":0,"end":94,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"4":{"text":"No se contaminará, porque es príncipe en sus pueblos, haciéndose inmundo.","spans":[{"start":0,"end":73,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"5":{"text":"No harán calva en su cabeza, ni raerán la punta de su barba, ni en su carne harán rasguños.","spans":[{"start":0,"end":91,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"6":{"text":"Santos serán a su Dios, y no profanarán el nombre de su Dios; porque los fuegos de Jehová y el pan de su Dios ofrecen: por tanto serán santos.","spans":[{"start":0,"end":142,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"7":{"text":"Mujer ramera o infame no tomarán: ni tomarán mujer repudiada de su marido: porque es santo a su Dios.","spans":[{"start":0,"end":101,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"8":{"text":"Lo santificarás por tanto, pues el pan de tu Dios ofrece: santo será para ti, porque santo soy yo Jehová vuestro santificador.","spans":[{"start":0,"end":126,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"9":{"text":"Y la hija del varón sacerdote, si comenzare a fornicar, a su padre amancilla: quemada será al fuego.","spans":[{"start":0,"end":100,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"10":{"text":"Y el sumo sacerdote entre sus hermanos, sobre cuya cabeza fue derramado el aceite de la unción, y que hinchió su mano para vestir las vestimentas, no descubrirá su cabeza, ni romperá sus vestidos:","spans":[{"start":0,"end":196,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"11":{"text":"Ni entrará donde haya alguna persona muerta, ni por su padre, o por su madre se contaminará.","spans":[{"start":0,"end":92,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"12":{"text":"Ni saldrá del santuario, ni contaminará el santuario de su Dios; porque la corona del aceite de la unción de su Dios está sobre él: Yo Jehová.","spans":[{"start":0,"end":142,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"13":{"text":"Y tomará él mujer con su virginidad.","spans":[{"start":0,"end":36,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"14":{"text":"Viuda, o repudiada, o infame, o ramera, estas no tomará: mas tomará virgen de sus pueblos por mujer.","spans":[{"start":0,"end":100,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"15":{"text":"Y no amancillará su simiente en sus pueblos; porque yo Jehová soy el que los santifico.","spans":[{"start":0,"end":87,"speech":"LEV-21-1-jehovah","speaker":"jehovah"}]},"17":{"text":"Habla a Aarón, y dile: El varón de tu simiente en sus generaciones, en el cual hubiere falta, no se allegará para ofrecer el pan de su Dios.","spans":[{"start":0,"end":140,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]},"18":{"text":"Porque ningún varón en el cual hubiere falta, se allegará: varón ciego, o cojo, o falto, o sobrado,","spans":[{"start":0,"end":99,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]},"19":{"text":"O varón en el cual hubiere quebradura de pie o rotura de mano,","spans":[{"start":0,"end":62,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]},"20":{"text":"O corcovado, o lagañoso, o que tuviere nube en el ojo, o que tenga sarna, o empeine, o compañón relajado;","spans":[{"start":0,"end":105,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]},"21":{"text":"Ningún varón de la simiente de Aarón sacerdote, en el cual hubiere falta, se allegará para ofrecer las ofrendas encendidas de Jehová. Hay falta en él; no se allegará a ofrecer el pan de su Dios.","spans":[{"start":0,"end":194,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]},"22":{"text":"El pan de su Dios, de lo muy santo y las cosas santificadas, comerá.","spans":[{"start":0,"end":68,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]},"23":{"text":"Empero no entrará del velo adentro, ni se allegará al altar, por cuanto hay falta en él: y no profanará mi santuario, porque yo Jehová soy el que los santifico.","spans":[{"start":0,"end":160,"speech":"LEV-21-17-jehovah","speaker":"jehovah"}]}}}
