pe":"char","marker":"w","strong":"H3548","content":["el sacerdote"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["delante"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["de Jehová"]}," ",{"type":"char","marker":"w","strong":"H2101","content":["del flujo"]}," de su inmundicia. ",{"type":"verse","marker":"v","eid":"LEV 15:30"},{"type":"verse","marker":"v","number":"31","sid":"LEV 15:31"},{"type":"char","marker":"w","strong":"H5144","content":["Así apartaréis"]}," ",{"type":"char","marker":"w","strong":"H1121","content":["los hijos"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]}," de sus inmundicias, ",{"type":"char","marker":"w","strong":"H3808","content":["a fin de que no"]}," ",{"type":"char","marker":"w","strong":"H4191","content":["mueran"]}," ",{"type":"char","marker":"w","strong":"H2932","content":["por sus inmundicias"]},", ",{"type":"char","marker":"w","strong":"H2930","content":["ensuciando"]}," ",{"type":"char","marker":"w","strong":"H4908","content":["mi tabernáculo"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que está"]}," ",{"type":"char","marker":"w","strong":"H8432","content":["entre"]}," ellos. ",{"type":"verse","marker":"v","eid":"LEV 15:31"},{"type":"verse","marker":"v","number":"32","sid":"LEV 15:32"},{"type":"char","marker":"w","strong":"H2063","content":["Esta"]}," ",{"type":"char","marker":"w","strong":"H8451","content":["es la ley"]}," ",{"type":"char","marker":"w","strong":"H2100","content":["del que tiene flujo"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["y del que"]}," ",{"type":"char","marker":"w","strong":"H3318","content":["sale derramamiento"]}," ",{"type":"char","marker":"w","strong":"H2233,H7902","content":["de semen"]},", ",{"type":"char","marker":"w","strong":"H2930","content":["viniendo a ser inmundo"]}," a causa de ello; ",{"type":"verse","marker":"v","eid":"LEV 15:32"},{"type":"verse","marker":"v","number":"33","sid":"LEV 15:33"},{"type":"char","marker":"w","strong":"H1739","content":["Y de la que padece"]}," ",{"type":"char","marker":"w","strong":"H5079","content":["su costumbre"]},", ",{"type":"char","marker":"w","strong":"H2100","content":["y acerca del que tuviere flujo"]},", ",{"type":"char","marker":"w","strong":"H2145","content":["sea varón"]}," o hembra, ",{"type":"char","marker":"w","strong":"H0376","content":["y del hombre"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H7901","content":["durmiere"]}," ",{"type":"char","marker":"w","strong":"H5973","content":["con"]}," ",{"type":"char","marker":"w","strong":"H2931","content":["mujer inmunda"]},". ",{"type":"verse","marker":"v","eid":"LEV 15:33"}]}],"speech":{"2":{"text":"Hablad a los hijos de Israel, y decidles: Cualquier varón, cuando su simiente manare de su carne, será inmundo.","spans":[{"start":0,"end":111,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y esta será su inmundicia en su flujo; sea que su carne destiló por causa de su flujo, o que su carne se obstruyó a causa de su flujo, él será inmundo.","spans":[{"start":0,"end":151,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Toda cama en que se acostare el que tuviere flujo, será inmunda; y toda cosa sobre que se sentare, inmunda será.","spans":[{"start":0,"end":112,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Y cualquiera que tocare a su cama, lavará sus vestidos; lavarase también a sí mismo con agua, y será inmundo hasta la tarde.","spans":[{"start":0,"end":124,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Y el que se sentare sobre aquello en que se hubiere sentado el que tiene flujo, lavará sus vestidos, se lavará también a sí mismo con agua, y será inmundo hasta la tarde.","spans":[{"start":0,"end":170,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Asimismo el que tocare la carne del que tiene flujo, lavará sus vestidos, y a sí mismo se lavará con agua, y será inmundo hasta la tarde.","spans":[{"start":0,"end":137,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y si el que tiene flujo escupiere sobre el limpio, este lavará sus vestidos, y después de haberse lavado con agua, será inmundo hasta la tarde.","spans":[{"start":0,"end":143,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Y todo aparejo sobre que cabalgare el que tuviere flujo, será inmundo.","spans":[{"start":0,"end":70,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y cualquiera que tocare cualquiera cosa que haya estado debajo de él, será inmundo hasta la tarde; y el que la llevare, lavará sus vestidos, y después de lavarse con agua, será inmundo hasta la tarde.","spans":[{"start":0,"end":200,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Y todo aquel a quien tocare el que tiene flujo, y no lavare con agua sus manos, lavará sus vestidos, y a sí mismo se lavará con agua, y será inmundo hasta la tarde.","spans":[{"start":0,"end":164,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Y la vasija de barro en que tocare el que tiene flujo, será quebrada; y toda vasija de madera será lavada con agua.","spans":[{"start":0,"end":115,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Y cuando se hubiere limpiado de su flujo el que tiene flujo, se ha de contar siete días desde su purificación, y lavará sus vestidos, y lavará su carne en aguas vivas, y será limpio.","spans":[{"start":0,"end":182,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y el octavo día tomará dos tórtolas, o dos palominos, y vendrá delante de Jehová a la puerta del tabernáculo del testimonio, y los dará al sacerdote:","spans":[{"start":0,"end":149,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Y haralos el sacerdote, el uno ofrenda por el pecado, y el otro holocausto: y le purificará el sacerdote de su flujo delante de Jehová.","spans":[{"start":0,"end":135,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Y el hombre, cuando de él saliere derramamiento de semen, lavará en aguas toda su carne, y será inmundo hasta la tarde.","spans":[{"start":0,"end":119,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Y toda vestimenta, o toda piel sobre la cual hubiere el derramamiento del semen, lavarase con agua, y será inmunda hasta la tarde.","spans":[{"start":0,"end":130,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"18":{"text":"Y la mujer con quien el varón tuviera ayuntamiento de semen, ambos se lavarán con agua, y serán inmundos hasta la tarde.","spans":[{"start":0,"end":120,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"19":{"text":"Y cuando la mujer tuviere flujo de sangre, y su flujo fuere en su carne, siete días estará apartada; y cualquiera que tocare en ella, será inmundo hasta la tarde.","spans":[{"start":0,"end":162,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"20":{"text":"Y todo aquello sobre que ella se acostare mientras su separación, será inmundo: también todo aquello sobre que se sentare, será inmundo.","spans":[{"start":0,"end":136,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"21":{"text":"Y cualquiera que tocare a su cama, lavará sus vestidos, y después de lavarse con agua, será inmundo hasta la tarde.","spans":[{"start":0,"end":115,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"22":{"text":"También cualquiera que tocare cualquier mueble sobre que ella se hubiere sentado, lavará sus vestidos; lavarase luego a sí mismo con agua, y será inmundo hasta la tarde.","spans":[{"start":0,"end":169,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"23":{"text":"Y si estuviere sobre la cama, o sobre la silla en que ella se hubiere sentado, el que tocare en ella será inmundo hasta la tarde.","spans":[{"start":0,"end":129,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"24":{"text":"Y si alguno durmiere con ella, y su menstruo fuere sobre él, será inmundo por siete días; y toda cama sobre que durmiere, será inmunda.","spans":[{"start":0,"end":135,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"25":{"text":"Y la mujer, cuando siguiere el flujo de su sangre por muchos días fuera del tiempo de su costumbre, o cuando tuviere flujo de sangre más de su costumbre; todo el tiempo del flujo de su inmundicia, será inmunda como en los días de su costumbre.","spans":[{"start":0,"end":243,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"26":{"text":"Toda cama en que durmiere todo el tiempo de su flujo, le será como la cama de su costumbre; y todo mueble sobre que se sentare, será inmundo, como la inmundicia de su costumbre.","spans":[{"start":0,"end":177,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"27":{"text":"Cualquiera que tocare en esas cosas será inmundo; y lavará sus vestidos, y a sí mismo se lavará con agua, y será inmundo hasta la tarde.","spans":[{"start":0,"end":136,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"28":{"text":"Y cuando fuere libre de su flujo, se ha de contar siete días, y después será limpia.","spans":[{"start":0,"end":84,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"29":{"text":"Y el octavo día tomará consigo dos tórtolas, o dos palominos, y los traerá al sacerdote, a la puerta del tabernáculo del testimonio:","spans":[{"start":0,"end":132,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"30":{"text":"Y el sacerdote hará el uno ofrenda por el pecado, y el otro holocausto; y la purificará el sacerdote delante de Jehová del flujo de su inmundicia.","spans":[{"start":0,"end":146,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]},"31":{"text":"Así apartaréis los hijos de Israel de sus inmundicias, a fin de que no mueran por sus inmundicias, ensuciando mi tabernáculo que está entre ellos.","spans":[{"start":0,"end":146,"speech":"LEV-15-2-jehovah","speaker":"jehovah"}]}}}
