,"strong":"H0834","content":["en que"]}," ",{"type":"char","marker":"w","strong":"H1310","content":["fuere cocida"]},", ",{"type":"char","marker":"w","strong":"H7665","content":["será"]}," quebrada: ",{"type":"char","marker":"w","strong":"H0518","content":["y si"]}," ",{"type":"char","marker":"w","strong":"H1310","content":["fuere cocida"]}," ",{"type":"char","marker":"w","strong":"H3627","content":["en vasija"]}," ",{"type":"char","marker":"w","strong":"H5178","content":["de metal"]},", ",{"type":"char","marker":"w","strong":"H7665","content":["será"]}," ",{"type":"char","marker":"w","strong":"H4838","content":["fregada"]}," ",{"type":"char","marker":"w","strong":"H7857","content":["y lavada"]}," ",{"type":"char","marker":"w","strong":"H4325","content":["con agua"]},". ",{"type":"verse","marker":"v","eid":"LEV 6:28"},{"type":"verse","marker":"v","number":"29","sid":"LEV 6:29"},{"type":"char","marker":"w","strong":"H3605","content":["Todo"]}," ",{"type":"char","marker":"w","strong":"H2145","content":["varón"]}," ",{"type":"char","marker":"w","strong":"H3548","content":["de entre los sacerdotes"]}," ",{"type":"char","marker":"w","strong":"H0398","content":["la comerá"]},": ",{"type":"char","marker":"w","strong":"H6944","content":["es cosa santísima"]},". ",{"type":"verse","marker":"v","eid":"LEV 6:29"},{"type":"verse","marker":"v","number":"30","sid":"LEV 6:30"},{"type":"char","marker":"w","strong":"H3808","content":["Mas no"]}," ",{"type":"char","marker":"w","strong":"H0398","content":["se comerá"]}," ",{"type":"char","marker":"w","strong":"H3722","content":["de expiación"]}," alguna, ",{"type":"char","marker":"w","strong":"H0834","content":["de cuya"]}," ",{"type":"char","marker":"w","strong":"H1818","content":["sangre"]}," ",{"type":"char","marker":"w","strong":"H0935","content":["se metiere"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["en"]}," ",{"type":"char","marker":"w","strong":"H0168","content":["el tabernáculo"]}," ",{"type":"char","marker":"w","strong":"H4150","content":["del testimonio"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["para reconciliar en"]}," ",{"type":"char","marker":"w","strong":"H6944","content":["el santuario"]},": ",{"type":"char","marker":"w","strong":"H0784","content":["al fuego"]}," ",{"type":"char","marker":"w","strong":"H8313","content":["será quemada"]},". ",{"type":"verse","marker":"v","eid":"LEV 6:30"}]}],"speech":{"2":{"text":"Cuando una persona pecare, e hiciere prevaricación contra Jehová, y negare a su prójimo lo encomendado, o dejado en su mano, o bien robare, o calumniare a su prójimo;","spans":[{"start":0,"end":166,"speech":"LEV-6-2-jehovah","speaker":"jehovah"}]},"3":{"text":"O sea que hallando lo perdido, después lo negare, y jurare en falso, en alguna de todas aquellas cosas en que suele pecar el hombre:","spans":[{"start":0,"end":132,"speech":"LEV-6-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Entonces será que, puesto habrá pecado y ofendido, restituirá aquello que robó, o por el daño de la calumnia, o el depósito que se le encomendó, o lo perdido que halló,","spans":[{"start":0,"end":168,"speech":"LEV-6-2-jehovah","speaker":"jehovah"}]},"5":{"text":"O todo aquello sobre que hubiere jurado falsamente; lo restituirá, pues, por entero, y añadirá a ello la quinta parte, que ha de pagar a aquel a quien pertenece en el día de su expiación.","spans":[{"start":0,"end":187,"speech":"LEV-6-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Y por su expiación traerá a Jehová un carnero sin tacha de los rebaños, conforme a tu estimación, al sacerdote para la expiación:","spans":[{"start":0,"end":129,"speech":"LEV-6-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Y el sacerdote hará expiación por él delante de Jehová, y obtendrá perdón de cualquiera de todas las cosas en que suele ofender.","spans":[{"start":0,"end":128,"speech":"LEV-6-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Manda a Aarón y a sus hijos diciendo: Esta es la ley del holocausto: (es holocausto, porque se quema sobre el altar toda la noche hasta la mañana, y el fuego del altar arderá en él:)","spans":[{"start":0,"end":182,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"10":{"text":"El sacerdote se pondrá su vestimenta de lino, y se vestirá pañetes de lino sobre su carne; y cuando el fuego hubiere consumido el holocausto, apartará él las cenizas de sobre el altar, y pondralas junto al altar.","spans":[{"start":0,"end":212,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"11":{"text":"Después se desnudará de sus vestimentas, y se pondrá otras vestiduras, y sacará las cenizas fuera del real al lugar limpio.","spans":[{"start":0,"end":123,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"12":{"text":"Y el fuego encendido sobre el altar no ha de apagarse, sino que el sacerdote pondrá en él leña cada mañana, y acomodará sobre él el holocausto, y quemará sobre él los sebos de las paces.","spans":[{"start":0,"end":186,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"13":{"text":"El fuego ha de arder continuamente en el altar; no se apagará.","spans":[{"start":0,"end":62,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"14":{"text":"Y esta es la ley del presente: Han de ofrecerlo los hijos de Aarón delante de Jehová, delante del altar.","spans":[{"start":0,"end":104,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"15":{"text":"Y tomará de él un puñado de la flor de harina del presente, y de su aceite, y todo el incienso que está sobre el presente, y haralo arder sobre el altar por memoria, en olor suavísimo a Jehová.","spans":[{"start":0,"end":193,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"16":{"text":"Y el sobrante de ella lo comerán Aarón y sus hijos: sin levadura se comerá en el lugar santo; en el atrio del tabernáculo del testimonio lo comerán.","spans":[{"start":0,"end":148,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"17":{"text":"No se cocerá con levadura: helo dado a ellos por su porción de mis ofrendas encendidas; es cosa santísima, como la expiación por el pecado, y como la expiación por la culpa.","spans":[{"start":0,"end":173,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"18":{"text":"Todos los varones de los hijos de Aarón comerán de ella. Estatuto perpetuo será para vuestras generaciones tocante a las ofrendas encendidas de Jehová: toda cosa que tocare en ellas será santificada.","spans":[{"start":0,"end":199,"speech":"LEV-6-9-jehovah","speaker":"jehovah"}]},"20":{"text":"Esta es la ofrenda de Aarón y de sus hijos, que ofrecerán a Jehová el día que serán ungidos: la décima parte de un epha de flor de harina, presente perpetuo, la mitad a la mañana y la mitad a la tarde.","spans":[{"start":0,"end":201,"speech":"LEV-6-20-jehovah","speaker":"jehovah"}]},"21":{"text":"En sartén se aderezará con aceite; frita la traerás, y los pedazos cocidos del presente ofrecerás a Jehová en olor de suavidad.","spans":[{"start":0,"end":127,"speech":"LEV-6-20-jehovah","speaker":"jehovah"}]},"22":{"text":"Y el sacerdote que en lugar de Aarón fuere ungido de entre sus hijos, hará la ofrenda; estatuto perpetuo de Jehová: toda ella será quemada.","spans":[{"start":0,"end":139,"speech":"LEV-6-20-jehovah","speaker":"jehovah"}]},"23":{"text":"Y todo presente de sacerdote será enteramente quemado; no se comerá.","spans":[{"start":0,"end":68,"speech":"LEV-6-20-jehovah","speaker":"jehovah"}]},"25":{"text":"Habla a Aarón y a sus hijos, diciendo: Esta es la ley de la expiación: en el lugar donde será degollado el holocausto, será degollada la expiación por el pecado delante de Jehová: es cosa santísima.","spans":[{"start":0,"end":198,"speech":"LEV-6-25-jehovah","speaker":"jehovah"}]},"26":{"text":"El sacerdote que la ofreciere por expiación, la comerá: en el lugar santo será comida, en el atrio del tabernáculo del testimonio.","spans":[{"start":0,"end":130,"speech":"LEV-6-25-jehovah","speaker":"jehovah"}]},"27":{"text":"Todo lo que en su carne tocare, será santificado; y si cayere de su sangre sobre el vestido, lavarás aquello sobre que cayere, en el lugar santo.","spans":[{"start":0,"end":145,"speech":"LEV-6-25-jehovah","speaker":"jehovah"}]},"28":{"text":"Y la vasija de barro en que fuere cocida, será quebrada: y si fuere cocida en vasija de metal, será fregada y lavada con agua.","spans":[{"start":0,"end":126,"speech":"LEV-6-25-jehovah","speaker":"jehovah"}]},"29":{"text":"Todo varón de entre los sacerdotes la comerá: es cosa santísima.","spans":[{"start":0,"end":64,"speech":"LEV-6-25-jehovah","speaker":"jehovah"}]},"30":{"text":"Mas no se comerá de expiación alguna, de cuya sangre se metiere en el tabernáculo del testimonio para reconciliar en el santuario: al fuego será quemada.","spans":[{"start":0,"end":153,"speech":"LEV-6-25-jehovah","speaker":"jehovah"}]}}}
