trong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H0935","content":["os introduzco"]}," ",{"type":"char","marker":"w","strong":"H3427","content":["para que habitéis"]}," en ella. ",{"type":"verse","marker":"v","eid":"LEV 20:22"},{"type":"verse","marker":"v","number":"23","sid":"LEV 20:23"},{"type":"char","marker":"w","strong":"H3808","content":["Y no"]}," ",{"type":"char","marker":"w","strong":"H3212","content":["andéis"]}," ",{"type":"char","marker":"w","strong":"H2708","content":["en las prácticas"]}," ",{"type":"char","marker":"w","strong":"H6973","content":["de la gente"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H7971","content":["echaré"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["de delante"]}," de vosotros: ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H6213","content":["ellos hicieron"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todas"]}," ",{"type":"char","marker":"w","strong":"H0428","content":["estas"]}," cosas, ",{"type":"char","marker":"w","strong":"H6973","content":["y los tuve en abominación"]},". ",{"type":"verse","marker":"v","eid":"LEV 20:23"},{"type":"verse","marker":"v","number":"24","sid":"LEV 20:24"},{"type":"char","marker":"w","strong":"H0859","content":["Empero a vosotros"]}," ",{"type":"char","marker":"w","strong":"H0559","content":["os he dicho"]},": ",{"type":"char","marker":"w","strong":"H0859","content":["Vosotros"]}," ",{"type":"char","marker":"w","strong":"H3423","content":["poseeréis"]}," ",{"type":"char","marker":"w","strong":"H0127","content":["la tierra"]}," de ellos, ",{"type":"char","marker":"w","strong":"H0589","content":["y yo"]}," ",{"type":"char","marker":"w","strong":"H5414","content":["os la daré"]}," ",{"type":"char","marker":"w","strong":"H3423","content":["para que la poseáis por heredad"]},", ",{"type":"char","marker":"w","strong":"H0776","content":["tierra"]}," ",{"type":"char","marker":"w","strong":"H2100","content":["que fluye"]}," ",{"type":"char","marker":"w","strong":"H2461","content":["leche"]}," ",{"type":"char","marker":"w","strong":"H1706","content":["y miel"]},": ",{"type":"char","marker":"w","strong":"H0589","content":["Yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H0859","content":["vuestro"]}," ",{"type":"char","marker":"w","strong":"H0430","content":["Dios"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0914","content":["os he apartado"]}," ",{"type":"char","marker":"w","strong":"H4480","content":["de"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["los pueblos"]},". ",{"type":"verse","marker":"v","eid":"LEV 20:24"},{"type":"verse","marker":"v","number":"25","sid":"LEV 20:25"}," Por tanto, ",{"type":"char","marker":"w","strong":"H0914","content":["vosotros haréis diferencia entre"]}," ",{"type":"char","marker":"w","strong":"H2889","content":["animal limpio"]}," ",{"type":"char","marker":"w","strong":"H2931","content":["e inmundo"]},", ",{"type":"char","marker":"w","strong":"H0914","content":["y entre"]}," ",{"type":"char","marker":"w","strong":"H5775","content":["ave"]}," ",{"type":"char","marker":"w","strong":"H2931","content":["inmunda"]}," ",{"type":"char","marker":"w","strong":"H2889","content":["y limpia"]},": ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H5315","content":["ensuciéis vuestras personas"]}," ",{"type":"char","marker":"w","strong":"H0929","content":["en los animales"]},", ",{"type":"char","marker":"w","strong":"H5775","content":["ni en las aves"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["ni en ninguna cosa que"]}," ",{"type":"char","marker":"w","strong":"H7430","content":["va arrastrando"]}," ",{"type":"char","marker":"w","strong":"H0127","content":["por la tierra"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["las cuales"]}," ",{"type":"char","marker":"w","strong":"H0914","content":["os he apartado"]}," por inmundas. ",{"type":"verse","marker":"v","eid":"LEV 20:25"},{"type":"verse","marker":"v","number":"26","sid":"LEV 20:26"}," Habéis, pues, ",{"type":"char","marker":"w","strong":"H1961","content":["de serme"]}," ",{"type":"char","marker":"w","strong":"H6918","content":["santos"]},", ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H6918","content":["soy santo"]},", ",{"type":"char","marker":"w","strong":"H0914","content":["y os he apartado"]}," ",{"type":"char","marker":"w","strong":"H4480","content":["de"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["los pueblos"]},", ",{"type":"char","marker":"w","strong":"H1961","content":["para que seáis"]}," míos. ",{"type":"verse","marker":"v","eid":"LEV 20:26"},{"type":"verse","marker":"v","number":"27","sid":"LEV 20:27"},{"type":"char","marker":"w","strong":"H0376","content":["Y el hombre"]}," ",{"type":"char","marker":"w","strong":"H0176","content":["o"]}," ",{"type":"char","marker":"w","strong":"H0802","content":["la mujer"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["en quienes"]}," ",{"type":"char","marker":"w","strong":"H0178","content":["hubiere espíritu pithónico"]}," ",{"type":"char","marker":"w","strong":"H0176","content":["o"]}," ",{"type":"char","marker":"w","strong":"H3049","content":["de adivinación"]},", ",{"type":"char","marker":"w","strong":"H4191","content":["han de ser"]}," ",{"type":"char","marker":"w","strong":"H4191","content":["muertos"]},": ",{"type":"char","marker":"w","strong":"H7275","content":["los apedrearán"]}," ",{"type":"char","marker":"w","strong":"H0068","content":["con piedras"]},"; ",{"type":"char","marker":"w","strong":"H1818","content":["su sangre"]}," sobre ellos. ",{"type":"verse","marker":"v","eid":"LEV 20:27"}]}],"speech":{"2":{"text":"Dirás asimismo a los hijos de Israel: Cualquier varón de los hijos de Israel, o de los extranjeros que peregrinan en Israel, que diere de su simiente a Moloch, de seguro morirá: el pueblo de la tierra lo apedreará con piedras.","spans":[{"start":0,"end":226,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y yo pondré mi rostro contra el tal varón, y lo cortaré de entre su pueblo; por cuanto dio de su simiente a Moloch, contaminando mi santuario, y amancillando mi santo nombre.","spans":[{"start":0,"end":174,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Que si escondiere el pueblo de la tierra sus ojos de aquel varón que hubiere dado de su simiente a Moloch, para no matarle,","spans":[{"start":0,"end":123,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Entonces yo pondré mi rostro contra aquel varón, y contra su familia, y le cortaré de entre su pueblo, con todos los que fornicaron en pos de él, prostituyéndose con Moloch.","spans":[{"start":0,"end":173,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Y la persona que atendiere a encantadores o adivinos, para prostituirse tras de ellos, yo pondré mi rostro contra la tal persona, y cortarela de entre su pueblo.","spans":[{"start":0,"end":161,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Santificaos, pues, y sed santos, porque yo Jehová soy vuestro Dios.","spans":[{"start":0,"end":67,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y guardad mis estatutos, y ponedlos por obra: Yo Jehová que os santifico.","spans":[{"start":0,"end":73,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Porque varón que maldijere a su padre o a su madre, de cierto morirá: a su padre o a su madre maldijo; su sangre será sobre él.","spans":[{"start":0,"end":127,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y el hombre que adulterare con la mujer de otro, el que cometiere adulterio con la mujer de su prójimo, indefectiblemente se hará morir al adúltero y a la adúltera.","spans":[{"start":0,"end":164,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Y cualquiera que se echare con la mujer de su padre, la desnudez de su padre descubrió: ambos han de ser muertos; su sangre será sobre ellos.","spans":[{"start":0,"end":141,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Y cualquiera que durmiere con su nuera, ambos han de morir: hicieron confusión; su sangre será sobre ellos.","spans":[{"start":0,"end":107,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Y cualquiera que tuviere ayuntamiento con varón como con mujer, abominación hicieron: entrambos han de ser muertos; sobre ellos será su sangre.","spans":[{"start":0,"end":143,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y el que tomare mujer y a la madre de ella, comete vileza: quemarán en fuego a él y a ellas, porque no haya vileza entre vosotros.","spans":[{"start":0,"end":130,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Y cualquiera que tuviere cópula con bestia, ha de ser muerto; y mataréis a la bestia.","spans":[{"start":0,"end":85,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Y la mujer que se allegare a algún animal, para tener ayuntamiento con él, a la mujer y al animal matarás: morirán infaliblemente; será su sangre sobre ellos.","spans":[{"start":0,"end":158,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Y cualquiera que tomare a su hermana, hija de su padre o hija de su madre, y viere su desnudez, y ella viere la suya, cosa es execrable; por tanto serán muertos a ojos de los hijos de su pueblo: descubrió la desnudez de su hermana; su pecado llevará.","spans":[{"start":0,"end":250,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"18":{"text":"Y cualquiera que durmiere con mujer menstruosa, y descubriere su desnudez, su fuente descubrió, y ella descubrió la fuente de su sangre: ambos serán cortados de entre su pueblo.","spans":[{"start":0,"end":177,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"19":{"text":"La desnudez de la hermana de tu madre, o de la hermana de tu padre, no descubrirás: por cuanto descubrió su parienta, su iniquidad llevarán.","spans":[{"start":0,"end":140,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"20":{"text":"Y cualquiera que durmiere con la mujer del hermano de su padre, la desnudez del hermano de su padre descubrió; su pecado llevarán; morirán sin hijos.","spans":[{"start":0,"end":149,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"21":{"text":"Y el que tomare la mujer de su hermano, es suciedad; la desnudez de su hermano descubrió; sin hijos serán.","spans":[{"start":0,"end":106,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"22":{"text":"Guardad, pues, todos mis estatutos y todos mis derechos, y ponedlos por obra: y no os vomitará la tierra, en la cual yo os introduzco para que habitéis en ella.","spans":[{"start":0,"end":160,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"23":{"text":"Y no andéis en las prácticas de la gente que yo echaré de delante de vosotros: porque ellos hicieron todas estas cosas, y los tuve en abominación.","spans":[{"start":0,"end":146,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"24":{"text":"Empero a vosotros os he dicho: Vosotros poseeréis la tierra de ellos, y yo os la daré para que la poseáis por heredad, tierra que fluye leche y miel: Yo Jehová vuestro Dios, que os he apartado de los pueblos.","spans":[{"start":0,"end":208,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"25":{"text":"Por tanto, vosotros haréis diferencia entre animal limpio e inmundo, y entre ave inmunda y limpia: y no ensuciéis vuestras personas en los animales, ni en las aves, ni en ninguna cosa que va arrastrando por la tierra, las cuales os he apartado por inmundas.","spans":[{"start":0,"end":257,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"26":{"text":"Habéis, pues, de serme santos, porque yo Jehová soy santo, y os he apartado de los pueblos, para que seáis míos.","spans":[{"start":0,"end":112,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]},"27":{"text":"Y el hombre o la mujer en quienes hubiere espíritu pithónico o de adivinación, han de ser muertos: los apedrearán con piedras; su sangre sobre ellos.","spans":[{"start":0,"end":149,"speech":"LEV-20-2-jehovah","speaker":"jehovah"}]}}}
