nt":["ofrecerás"]}," ",{"type":"char","marker":"w","strong":"H4503","content":["por ofrenda"]}," ",{"type":"char","marker":"w","strong":"H1061","content":["de tus primicias"]},". ",{"type":"verse","marker":"v","eid":"LEV 2:14"},{"type":"verse","marker":"v","number":"15","sid":"LEV 2:15"},{"type":"char","marker":"w","strong":"H5414","content":["Y pondrás"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["sobre"]}," ",{"type":"char","marker":"w","strong":"H1931","content":["ella"]}," ",{"type":"char","marker":"w","strong":"H8081","content":["aceite"]},", ",{"type":"char","marker":"w","strong":"H7760","content":["y pondrás"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["sobre"]}," ",{"type":"char","marker":"w","strong":"H1931","content":["ella"]}," ",{"type":"char","marker":"w","strong":"H3828","content":["incienso"]},": ",{"type":"char","marker":"w","strong":"H4503","content":["es presente"]},". ",{"type":"verse","marker":"v","eid":"LEV 2:15"},{"type":"verse","marker":"v","number":"16","sid":"LEV 2:16"},{"type":"char","marker":"w","strong":"H3548","content":["Y el sacerdote"]}," ",{"type":"char","marker":"w","strong":"H6999","content":["hará arder"]},", ",{"type":"char","marker":"w","strong":"H0234","content":["en memoria"]}," del don, ",{"type":"char","marker":"w","strong":"H1643","content":["parte de su grano"]}," desmenuzado, ",{"type":"char","marker":"w","strong":"H8081","content":["y de su aceite"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["con"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todo"]}," ",{"type":"char","marker":"w","strong":"H3828","content":["su incienso"]},"; ",{"type":"char","marker":"w","strong":"H0801","content":["es ofrenda encendida"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["a Jehová"]},". ",{"type":"verse","marker":"v","eid":"LEV 2:16"}]}],"speech":{"1":{"text":"Y CUANDO alguna persona ofreciere oblación de presente a Jehová, su ofrenda será flor de harina, sobre la cual echará aceite, y pondrá sobre ella incienso:","spans":[{"start":0,"end":155,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"2":{"text":"Y la traerá a los sacerdotes, hijos de Aarón; y de ello tomará el sacerdote su puño lleno de su flor de harina y de su aceite, con todo su incienso, y lo hará arder sobre el altar: ofrenda encendida para recuerdo, de olor suave a Jehová.","spans":[{"start":0,"end":237,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y la sobra del presente será de Aarón y de sus hijos: es cosa santísima de las ofrendas que se queman a Jehová.","spans":[{"start":0,"end":111,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Y cuando ofrecieres ofrenda de presente cocida en horno, será de tortas de flor de harina sin levadura, amasadas con aceite, y hojaldres sin levadura untadas con aceite.","spans":[{"start":0,"end":169,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Mas si tu presente fuere ofrenda de sartén, será de flor de harina sin levadura, amasada con aceite,","spans":[{"start":0,"end":100,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"6":{"text":"La cual partirás en piezas, y echarás sobre ella aceite: es presente.","spans":[{"start":0,"end":69,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Y si tu presente fuere ofrenda cocida en cazuela, harase de flor de harina con aceite.","spans":[{"start":0,"end":86,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y traerás a Jehová la ofrenda que se hará de estas cosas, y la presentarás al sacerdote, el cual la llegará al altar.","spans":[{"start":0,"end":117,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Y tomará el sacerdote de aquel presente, en memoria del mismo, y haralo arder sobre el altar; ofrenda encendida, de suave olor a Jehová.","spans":[{"start":0,"end":136,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y lo restante del presente será de Aarón y de sus hijos: es cosa santísima de las ofrendas que se queman a Jehová.","spans":[{"start":0,"end":114,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Ningún presente que ofreciereis a Jehová, será con levadura: porque de ninguna cosa leuda, ni de ninguna miel, se ha de quemar ofrenda a Jehová.","spans":[{"start":0,"end":144,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"12":{"text":"En la ofrenda de las primicias las ofreceréis a Jehová: mas no subirán sobre el altar en olor de suavidad.","spans":[{"start":0,"end":106,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Y sazonarás toda ofrenda de tu presente con sal; y no harás que falte jamás de tu presente la sal de la alianza de tu Dios: en toda ofrenda tuya ofrecerás sal.","spans":[{"start":0,"end":159,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y si ofrecieres a Jehová presente de primicias, tostarás al fuego las espigas verdes, y el grano desmenuzado ofrecerás por ofrenda de tus primicias.","spans":[{"start":0,"end":148,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Y pondrás sobre ella aceite, y pondrás sobre ella incienso: es presente.","spans":[{"start":0,"end":72,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Y el sacerdote hará arder, en memoria del don, parte de su grano desmenuzado, y de su aceite con todo su incienso; es ofrenda encendida a Jehová.","spans":[{"start":0,"end":145,"speech":"LEV-1-2-jehovah","speaker":"jehovah"}]}}}
