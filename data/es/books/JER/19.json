:"char","marker":"w","strong":"H6635","content":["de los ejércitos"]},", ",{"type":"char","marker":"w","strong":"H0430","content":["Dios"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]},": ",{"type":"char","marker":"w","strong":"H0935","content":["He aquí yo traigo"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["sobre"]}," ",{"type":"char","marker":"w","strong":"H5892","content":["esta ciudad"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["y sobre"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todas"]}," ",{"type":"char","marker":"w","strong":"H5892","content":["sus villas"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todo"]}," ",{"type":"char","marker":"w","strong":"H7451","content":["el mal"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H1697","content":["hablé"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["contra"]}," ella: ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H7185","content":["han endurecido"]}," ",{"type":"char","marker":"w","strong":"H6203","content":["su cerviz"]},", ",{"type":"char","marker":"w","strong":"H1097","content":["para no"]}," ",{"type":"char","marker":"w","strong":"H8085","content":["oír"]}," ",{"type":"char","marker":"w","strong":"H1696","content":["mis palabras"]},". ",{"type":"verse","marker":"v","eid":"JER 19:15"}]}],"speech":{"1":{"text":"ASÍ dijo Jehová: Ve, y compra una vasija de barro del alfarero, y lleva contigo de los ancianos del pueblo, y de los ancianos de los sacerdotes;","spans":[{"start":17,"end":144,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"2":{"text":"Y saldrás al valle del hijo de Hinnom, que está a la entrada de la puerta oriental, y publicarás allí las palabras que yo te hablaré.","spans":[{"start":0,"end":133,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"3":{"text":"Dirás pues: Oíd palabra de Jehová, oh reyes de Judá, y moradores de Jerusalem. Así dice Jehová de los ejércitos, Dios de Israel: He aquí que yo traigo mal sobre este lugar, tal que quien lo oyere, le retiñan los oídos.","spans":[{"start":0,"end":218,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"4":{"text":"Porque me dejaron, y enajenaron este lugar, y ofrecieron en él perfumes a dioses ajenos, los cuales no habían ellos conocido, ni sus padres, ni los reyes de Judá; y llenaron este lugar de sangre de inocentes;","spans":[{"start":0,"end":208,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"5":{"text":"Y edificaron alto a Baal, para quemar con fuego sus hijos en holocaustos al mismo Baal; cosa que no les mandé, ni hablé, ni me vino al pensamiento.","spans":[{"start":0,"end":147,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"6":{"text":"Por tanto, he aquí vienen días, dice Jehová, que este lugar no se llamará más Topheth, ni Valle del hijo de Hinnom, sino Valle de la Matanza.","spans":[{"start":0,"end":31,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"},{"start":45,"end":141,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"7":{"text":"Y desvaneceré el consejo de Judá y de Jerusalem en este lugar; y hareles caer a cuchillo delante de sus enemigos, y en las manos de los que buscan sus almas; y daré sus cuerpos para comida de las aves del cielo y de las bestias de la tierra:","spans":[{"start":0,"end":241,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"8":{"text":"Y pondré a esta ciudad por espanto y silbo: todo aquel que pasare por ella se maravillará, y silbará sobre todas sus plagas.","spans":[{"start":0,"end":124,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"9":{"text":"Y hareles comer la carne de sus hijos y la carne de sus hijas; y cada uno comerá la carne de su amigo, en el cerco y en el apuro con que los estrecharán sus enemigos y los que buscan sus almas.","spans":[{"start":0,"end":193,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"10":{"text":"Y quebrarás la vasija ante los ojos de los varones que van contigo,","spans":[{"start":0,"end":67,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"11":{"text":"Y les dirás: Así ha dicho Jehová de los ejércitos: Así quebrantaré a este pueblo y a esta ciudad, como quien quiebra un vaso de barro, que no puede más restaurarse; y en Topheth se enterrarán, porque no habrá otro lugar para enterrar.","spans":[{"start":0,"end":234,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"12":{"text":"Así haré a este lugar, dice Jehová, y a sus moradores, poniendo esta ciudad como Topheth.","spans":[{"start":0,"end":22,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"},{"start":36,"end":89,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]},"13":{"text":"Y las casas de Jerusalem, y las casas de los reyes de Judá, serán como el lugar de Topheth inmundas, por todas las casas sobre cuyos tejados ofrecieron perfumes a todo el ejército del cielo, y vertieron libaciones a dioses ajenos.","spans":[{"start":0,"end":230,"speech":"JER-19-1-13-jehovah","speaker":"jehovah"}]}}}
