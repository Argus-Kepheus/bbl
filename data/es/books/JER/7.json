pe":"verse","marker":"v","eid":"JER 7:32"},{"type":"verse","marker":"v","number":"33","sid":"JER 7:33"},{"type":"char","marker":"w","strong":"H1961","content":["Y serán"]}," ",{"type":"char","marker":"w","strong":"H5038","content":["los cuerpos muertos"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["de este pueblo"]}," ",{"type":"char","marker":"w","strong":"H3978","content":["para comida"]}," ",{"type":"char","marker":"w","strong":"H5775","content":["de las aves"]}," ",{"type":"char","marker":"w","strong":"H8064","content":["del cielo"]}," ",{"type":"char","marker":"w","strong":"H0929","content":["y de las bestias"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["de la tierra"]},"; ",{"type":"char","marker":"w","strong":"H0369","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H2729","content":["habrá quien las espante"]},". ",{"type":"verse","marker":"v","eid":"JER 7:33"},{"type":"verse","marker":"v","number":"34","sid":"JER 7:34"},{"type":"char","marker":"w","strong":"H7673","content":["Y haré cesar"]}," ",{"type":"char","marker":"w","strong":"H5892","content":["de las ciudades"]}," ",{"type":"char","marker":"w","strong":"H3063","content":["de Judá"]},", ",{"type":"char","marker":"w","strong":"H2351","content":["y de la calles"]}," ",{"type":"char","marker":"w","strong":"H3389","content":["de Jerusalem"]},", ",{"type":"char","marker":"w","strong":"H6963","content":["voz"]}," ",{"type":"char","marker":"w","strong":"H8342","content":["de gozo"]}," ",{"type":"char","marker":"w","strong":"H6963","content":["y voz"]}," ",{"type":"char","marker":"w","strong":"H8057","content":["de alegría"]},", ",{"type":"char","marker":"w","strong":"H6963","content":["voz"]}," ",{"type":"char","marker":"w","strong":"H2860","content":["de esposo"]}," ",{"type":"char","marker":"w","strong":"H6963","content":["y voz"]}," ",{"type":"char","marker":"w","strong":"H3618","content":["de esposa"]},"; ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["la tierra"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["será"]}," ",{"type":"char","marker":"w","strong":"H2723","content":["en desolación"]},". ",{"type":"verse","marker":"v","eid":"JER 7:34"}]}],"speech":{"2":{"text":"Ponte a la puerta de la casa de Jehová, y predica allí esta palabra, y di: Oíd palabra de Jehová, todo Judá, los que entráis por estas puertas para adorar a Jehová.","spans":[{"start":0,"end":164,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"3":{"text":"Así ha dicho Jehová de los ejércitos, Dios de Israel: Mejorad vuestros caminos y vuestras obras, y os haré morar en este lugar.","spans":[{"start":0,"end":127,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"4":{"text":"No fiéis en palabras de mentira, diciendo: Templo de Jehová, templo de Jehová, templo de Jehová es este.","spans":[{"start":0,"end":104,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"5":{"text":"Mas si mejorareis cumplidamente vuestros caminos y vuestras obras; si con exactitud hiciereis derecho entre el hombre y su prójimo,","spans":[{"start":0,"end":131,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"6":{"text":"Ni oprimiereis al peregrino, al huérfano, y a la viuda, ni en este lugar derramareis la sangre inocente, ni anduviereis en pos de dioses ajenos para mal vuestro;","spans":[{"start":0,"end":161,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"7":{"text":"Os haré morar en este lugar, en la tierra que di a vuestros padres para siempre.","spans":[{"start":0,"end":80,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"8":{"text":"He aquí vosotros os confiáis en palabras de mentira, que no aprovechan.","spans":[{"start":0,"end":71,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"9":{"text":"¿Hurtando, matando, y adulterando, y jurando falso, e incensando a Baal, y andando tras dioses extraños que no conocisteis,","spans":[{"start":0,"end":123,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"10":{"text":"Vendréis y os pondréis delante de mí en esta casa sobre la cual es invocado mi nombre, y diréis: Librados somos: para hacer todas estas abominaciones?","spans":[{"start":0,"end":150,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"11":{"text":"¿Es cueva de ladrones delante de vuestros ojos esta casa, sobre la cual es invocado mi nombre? He aquí que también yo veo, dice Jehová.","spans":[{"start":0,"end":122,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"12":{"text":"Andad empero ahora a mi lugar que fue en Silo, donde hice que morase mi nombre al principio, y ved lo que le hice por la maldad de mi pueblo Israel.","spans":[{"start":0,"end":148,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"13":{"text":"Ahora pues, por cuanto habéis vosotros hecho todas estas obras, dice Jehová, y bien que os hablé, madrugando para hablar, no oísteis, y os llamé, y no respondisteis;","spans":[{"start":0,"end":63,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"},{"start":77,"end":165,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"14":{"text":"Haré también a esta casa sobre la cual es invocado mi nombre, en la que vosotros confiáis, y a este lugar que di a vosotros y a vuestros padres, como hice a Silo:","spans":[{"start":0,"end":162,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"15":{"text":"Que os echaré de mi presencia como eché a todos vuestros hermanos, a toda la generación de Ephraim.","spans":[{"start":0,"end":99,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"16":{"text":"Tú pues, no ores por este pueblo, ni levantes por ellos clamor ni oración, ni me ruegues; porque no te oiré.","spans":[{"start":0,"end":108,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"17":{"text":"¿No ves lo que estos hacen en las ciudades de Judá y en las calles de Jerusalem?","spans":[{"start":0,"end":80,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"18":{"text":"Los hijos cogen la leña, y los padres encienden el fuego, y las mujeres amasan la masa, para hacer tortas a la reina del cielo y para hacer ofrendas a dioses ajenos, por provocarme a ira.","spans":[{"start":0,"end":187,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"19":{"text":"¿Provocaranme ellos a ira, dice Jehová, y no más bien obran ellos mismos para confusión de sus rostros?","spans":[{"start":0,"end":26,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"},{"start":40,"end":103,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"20":{"text":"Por tanto, así ha dicho el Señor Jehová: He aquí que mi furor y mi ira se derrama sobre este lugar, sobre los hombres, sobre los animales, y sobre los árboles del campo, y sobre los frutos de la tierra; y encenderase, y no se apagará.","spans":[{"start":0,"end":234,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"21":{"text":"Así ha dicho Jehová de los ejércitos, Dios de Israel: Añadid vuestros holocaustos sobre vuestros sacrificios, y comed carne.","spans":[{"start":0,"end":124,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"22":{"text":"Porque no hablé yo con vuestros padres, ni les mandé el día que los saqué de la tierra de Egipto, acerca de holocaustos y de víctimas:","spans":[{"start":0,"end":134,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"23":{"text":"Mas esto les mandé, diciendo: Escuchad mi voz, y seré a vosotros por Dios, y vosotros me seréis por pueblo; y andad en todo camino que os mandare, para que os vaya bien.","spans":[{"start":0,"end":169,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"24":{"text":"Y no oyeron ni inclinaron su oído; antes caminaron en sus consejos, en la dureza de su corazón malvado, y fueron hacia atrás y no hacia adelante,","spans":[{"start":0,"end":145,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"25":{"text":"Desde el día que vuestros padres salieron de la tierra de Egipto hasta hoy. Y os envié a todos los profetas mis siervos, cada día madrugando y enviándolos:","spans":[{"start":0,"end":155,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"26":{"text":"Mas no me oyeron ni inclinaron su oído; antes endurecieron su cerviz, e hicieron peor que sus padres.","spans":[{"start":0,"end":101,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"27":{"text":"Tú pues les dirás todas estas palabras, mas no te oirán; aun los llamarás, y no te responderán.","spans":[{"start":0,"end":95,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"28":{"text":"Les dirás por tanto: Esta es la gente que no escuchó la voz de Jehová su Dios, ni tomó corrección; perdiose la fe, y de la boca de ellos fue cortada.","spans":[{"start":0,"end":149,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"29":{"text":"Trasquila tu cabello, y arrójalo, y levanta llanto sobre las alturas; porque Jehová ha aborrecido y dejado la nación de su ira.","spans":[{"start":0,"end":127,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"30":{"text":"Porque los hijos de Judá han hecho lo malo ante mis ojos, dice Jehová; pusieron sus abominaciones en la casa sobre la cual mi nombre fue invocado, amancillándola.","spans":[{"start":0,"end":57,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"},{"start":71,"end":162,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"31":{"text":"Y han edificado los altos de Topheth, que es en el valle del hijo de Hinnom, para quemar al fuego sus hijos y sus hijas, cosa que yo no les mandé, ni subió en mi corazón.","spans":[{"start":0,"end":170,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"32":{"text":"Por tanto, he aquí vendrán días, ha dicho Jehová, que no se diga más, Topheth, ni valle del hijo de Hinnom, sino Valle de la Matanza; y serán enterrados en Topheth, por no haber lugar.","spans":[{"start":0,"end":32,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"},{"start":50,"end":184,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"33":{"text":"Y serán los cuerpos muertos de este pueblo para comida de las aves del cielo y de las bestias de la tierra; y no habrá quien las espante.","spans":[{"start":0,"end":137,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]},"34":{"text":"Y haré cesar de las ciudades de Judá, y de la calles de Jerusalem, voz de gozo y voz de alegría, voz de esposo y voz de esposa; porque la tierra será en desolación.","spans":[{"start":0,"end":164,"speech":"JER-7-2-34-jehovah","speaker":"jehovah"}]}}}
