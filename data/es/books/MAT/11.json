2532","content":["y"]}," ",{"type":"char","marker":"w","strong":"G2147","content":["hallaréis"]}," ",{"type":"char","marker":"w","strong":"G0372","content":["descanso"]}," ",{"type":"char","marker":"w","strong":"G5216","content":["para vuestras"]}," ",{"type":"char","marker":"w","strong":"G5590","content":["almas"]},". ",{"type":"verse","marker":"v","eid":"MAT 11:29"},{"type":"verse","marker":"v","number":"30","sid":"MAT 11:30"},{"type":"char","marker":"w","strong":"G1063","content":["Porque"]}," ",{"type":"char","marker":"w","strong":"G3450","content":["mi"]}," ",{"type":"char","marker":"w","strong":"G2218","content":["yugo"]}," ",{"type":"char","marker":"w","strong":"G2076","content":["es"]}," ",{"type":"char","marker":"w","strong":"G5543","content":["fácil"]},", ",{"type":"char","marker":"w","strong":"G2532","content":["y"]}," ",{"type":"char","marker":"w","strong":"G1645","content":["ligera"]}," ",{"type":"char","marker":"w","strong":"G3450","content":["mi"]}," ",{"type":"char","marker":"w","strong":"G5413","content":["carga"]},". ",{"type":"verse","marker":"v","eid":"MAT 11:30"}]}],"speech":{"4":{"text":"Y respondiendo Jesús, les dijo: Id, y haced saber á Juan las cosas que oís y veis:","spans":[{"start":32,"end":82,"speech":"MAT-11-4"}]},"5":{"text":"Los ciegos ven, y los cojos andan; los leprosos son limpiados, y los sordos oyen; los muertos son resucitados, y á los pobres es anunciado el evangelio.","spans":[{"start":0,"end":152,"speech":"MAT-11-4"}]},"6":{"text":"Y bienaventurado es el que no fuere escandalizado en mí.","spans":[{"start":0,"end":56,"speech":"MAT-11-4"}]},"7":{"text":"E idos ellos, comenzó Jesús á decir de Juan á las gentes: ¿Qué salisteis á ver al desierto? ¿una caña que es meneada del viento?","spans":[{"start":58,"end":128,"speech":"MAT-11-7"}]},"8":{"text":"Mas ¿qué salisteis á ver? ¿un hombre cubierto de delicados vestidos? He aquí, los que traen vestidos delicados, en las casas de los reyes están.","spans":[{"start":0,"end":144,"speech":"MAT-11-7"}]},"9":{"text":"Mas ¿qué salisteis á ver? ¿un profeta? También os digo, y más que profeta.","spans":[{"start":0,"end":74,"speech":"MAT-11-7"}]},"10":{"text":"Porque éste es de quien está escrito: He aquí, yo envío mi mensajero delante de tu faz, que aparejará tu camino delante de ti.","spans":[{"start":0,"end":126,"speech":"MAT-11-7"}]},"11":{"text":"De cierto os digo, que no se levantó entre los que nacen de mujeres otro mayor que Juan el Bautista; mas el que es muy más pequeño en el reino de los cielos, mayor es que él.","spans":[{"start":0,"end":174,"speech":"MAT-11-7"}]},"12":{"text":"Desde los días de Juan el Bautista hasta ahora, al reino de los cielos se hace fuerza, y los valientes lo arrebatan.","spans":[{"start":0,"end":116,"speech":"MAT-11-7"}]},"13":{"text":"Porque todos los profetas y la ley hasta Juan profetizaron.","spans":[{"start":0,"end":59,"speech":"MAT-11-7"}]},"14":{"text":"Y si queréis recibir, él es aquel Elías que había de venir.","spans":[{"start":0,"end":59,"speech":"MAT-11-7"}]},"15":{"text":"El que tiene oídos para oir, oiga.","spans":[{"start":0,"end":34,"speech":"MAT-11-7"}]},"16":{"text":"Mas ¿á quién compararé esta generación? Es semejante á los muchachos que se sientan en las plazas, y dan voces á sus compañeros,","spans":[{"start":0,"end":128,"speech":"MAT-11-7"}]},"17":{"text":"Y dicen: Os tañimos flauta, y no bailasteis; os endechamos, y no lamentasteis.","spans":[{"start":0,"end":78,"speech":"MAT-11-7"}]},"18":{"text":"Porque vino Juan, que ni comía ni bebía, y dicen: Demonio tiene.","spans":[{"start":0,"end":64,"speech":"MAT-11-7"}]},"19":{"text":"Vino el Hijo del hombre, que come y bebe, y dicen: He aquí un hombre comilón, y bebedor de vino, amigo de publicanos y de pecadores. Mas la sabiduría es justificada por sus hijos.","spans":[{"start":0,"end":179,"speech":"MAT-11-7"}]},"21":{"text":"¡Ay de ti, Corazín! ¡Ay de ti, Bethsaida! porque si en Tiro y en Sidón fueran hechas las maravillas que han sido hechas en vosotras, en otro tiempo se hubieran arrepentido en saco y en ceniza.","spans":[{"start":0,"end":192,"speech":"MAT-11-21"}]},"22":{"text":"Por tanto os digo, que á Tiro y á Sidón será más tolerable el castigo en el día del juicio, que á vosotras.","spans":[{"start":0,"end":107,"speech":"MAT-11-21"}]},"23":{"text":"Y tú, Capernaum, que eres levantada hasta el cielo, hasta los infiernos serás abajada; porque si en los de Sodoma fueran hechas las maravillas que han sido hechas en ti, hubieran quedado hasta el día de hoy.","spans":[{"start":0,"end":207,"speech":"MAT-11-21"}]},"24":{"text":"Por tanto os digo, que á la tierra de los de Sodoma será más tolerable el castigo en el día del juicio, que á ti.","spans":[{"start":0,"end":113,"speech":"MAT-11-21"}]},"25":{"text":"En aquel tiempo, respondiendo Jesús, dijo: Te alabo, Padre, Señor del cielo y de la tierra, que hayas escondido estas cosas de los sabios y de los entendidos, y las hayas revelado á los niños.","spans":[{"start":43,"end":192,"speech":"MAT-11-25"}]},"26":{"text":"Así, Padre, pues que así agradó en tus ojos.","spans":[{"start":0,"end":44,"speech":"MAT-11-25"}]},"27":{"text":"Todas las cosas me son entregadas de mi Padre: y nadie conoció al Hijo, sino el Padre; ni al Padre conoció alguno, sino el Hijo, y aquel á quien el Hijo lo quisiere revelar.","spans":[{"start":0,"end":173,"speech":"MAT-11-25"}]},"28":{"text":"Venid á mí todos los que estáis trabajados y cargados, que yo os haré descansar.","spans":[{"start":0,"end":80,"speech":"MAT-11-25"}]},"29":{"text":"Llevad mi yugo sobre vosotros, y aprended de mí, que soy manso y humilde de corazón; y hallaréis descanso para vuestras almas.","spans":[{"start":0,"end":126,"speech":"MAT-11-25"}]},"30":{"text":"Porque mi yugo es fácil, y ligera mi carga.","spans":[{"start":0,"end":43,"speech":"MAT-11-25"}]}}}
