:"char","marker":"w","strong":"G0591","content":["pagará"]}," ",{"type":"char","marker":"w","strong":"G1538","content":["á cada"]}," ",{"type":"char","marker":"w","strong":"G2596","content":["uno conforme"]}," ",{"type":"char","marker":"w","strong":"G0846","content":["á sus"]}," ",{"type":"char","marker":"w","strong":"G4234","content":["obras"]},". ",{"type":"verse","marker":"v","eid":"MAT 16:27"},{"type":"verse","marker":"v","number":"28","sid":"MAT 16:28"},{"type":"char","marker":"w","strong":"G0281","content":["De cierto"]}," ",{"type":"char","marker":"w","strong":"G5213","content":["os"]}," ",{"type":"char","marker":"w","strong":"G3004","content":["digo"]},": ",{"type":"char","marker":"w","strong":"G1526","content":["hay"]}," ",{"type":"char","marker":"w","strong":"G5100","content":["algunos"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["de los"]}," ",{"type":"char","marker":"w","strong":"G2476","content":["que están"]}," ",{"type":"char","marker":"w","strong":"G5602","content":["aquí"]},", ",{"type":"char","marker":"w","strong":"G3756,G3361","content":["que no"]}," ",{"type":"char","marker":"w","strong":"G1089","content":["gustarán"]}," ",{"type":"char","marker":"w","strong":"G2288","content":["la muerte"]},", ",{"type":"char","marker":"w","strong":"G2193","content":["hasta"]}," ",{"type":"char","marker":"w","strong":"G0302","content":["que"]}," ",{"type":"char","marker":"w","strong":"G1492","content":["hayan visto"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["al"]}," ",{"type":"char","marker":"w","strong":"G5207","content":["Hijo"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["del"]}," ",{"type":"char","marker":"w","strong":"G0444","content":["hombre"]}," ",{"type":"char","marker":"w","strong":"G2064","content":["viniendo"]}," ",{"type":"char","marker":"w","strong":"G1722","content":["en"]}," ",{"type":"char","marker":"w","strong":"G0846","content":["su"]}," ",{"type":"char","marker":"w","strong":"G0932","content":["reino"]},". ",{"type":"verse","marker":"v","eid":"MAT 16:28"}]}],"speech":{"2":{"text":"Mas él respondiendo, les dijo: Cuando es la tarde del día, decís: Sereno; porque el cielo tiene arreboles.","spans":[{"start":31,"end":106,"speech":"MAT-16-2"}]},"3":{"text":"Y á la mañana: Hoy tempestad; porque tiene arreboles el cielo triste. Hipócritas, que sabéis hacer diferencia en la faz del cielo; ¿y en las señales de los tiempos no podéis?","spans":[{"start":0,"end":174,"speech":"MAT-16-2"}]},"4":{"text":"La generación mala y adulterina demanda señal; mas señal no le será dada, sino la señal de Jonás profeta. Y dejándolos, se fué.","spans":[{"start":0,"end":105,"speech":"MAT-16-2"}]},"6":{"text":"Y Jesús les dijo: Mirad, y guardaos de la levadura de los Fariseos y de los Saduceos.","spans":[{"start":18,"end":85,"speech":"MAT-16-6"}]},"8":{"text":"Y entendiéndolo Jesús, les dijo: ¿Por qué pensáis dentro de vosotros, hombres de poca fe, que no tomasteis pan?","spans":[{"start":33,"end":111,"speech":"MAT-16-8"}]},"9":{"text":"¿No entendéis aún, ni os acordáis de los cinco panes entre cinco mil hombres, y cuántos cestos alzasteis?","spans":[{"start":0,"end":105,"speech":"MAT-16-8"}]},"10":{"text":"¿Ni de los siete panes entre cuatro mil, y cuántas espuertas tomasteis?","spans":[{"start":0,"end":71,"speech":"MAT-16-8"}]},"11":{"text":"¿Cómo es que no entendéis que no por el pan os dije, que os guardaseis de la levadura de los Fariseos y de los Saduceos?","spans":[{"start":0,"end":120,"speech":"MAT-16-8"}]},"13":{"text":"Y viniendo Jesús á las partes de Cesarea de Filipo, preguntó á sus discípulos, diciendo: ¿Quién dicen los hombres que es el Hijo del hombre?","spans":[{"start":89,"end":140,"speech":"MAT-16-13"}]},"15":{"text":"El les dice: Y vosotros, ¿quién decís que soy?","spans":[{"start":13,"end":46,"speech":"MAT-16-15"}]},"17":{"text":"Entonces, respondiendo Jesús, le dijo: Bienaventurado eres, Simón, hijo de Jonás; porque no te lo reveló carne ni sangre, mas mi Padre que está en los cielos.","spans":[{"start":39,"end":158,"speech":"MAT-16-17"}]},"18":{"text":"Mas yo también te digo, que tú eres Pedro, y sobre esta piedra edificaré mi iglesia; y las puertas del infierno no prevalecerán contra ella.","spans":[{"start":0,"end":140,"speech":"MAT-16-17"}]},"19":{"text":"Y á ti daré las llaves del reino de los cielos; y todo lo que ligares en la tierra será ligado en los cielos; y todo lo que desatares en la tierra será desatado en los cielos.","spans":[{"start":0,"end":175,"speech":"MAT-16-17"}]},"23":{"text":"Entonces él, volviéndose, dijo á Pedro: Quítate de delante de mí, Satanás; me eres escándalo; porque no entiendes lo que es de Dios sino lo que es de los hombres.","spans":[{"start":40,"end":162,"speech":"MAT-16-23"}]},"24":{"text":"Entonces Jesús dijo á sus discípulos: Si alguno quiere venir en pos de mí, niéguese á sí mismo, y tome su cruz, y sígame.","spans":[{"start":38,"end":121,"speech":"MAT-16-24"}]},"25":{"text":"Porque cualquiera que quisiere salvar su vida, la perderá, y cualquiera que perdiere su vida por causa de mí, la hallará.","spans":[{"start":0,"end":121,"speech":"MAT-16-24"}]},"26":{"text":"Porque ¿de qué aprovecha al hombre, si granjeare todo el mundo, y perdiere su alma? O ¿qué recompensa dará el hombre por su alma?","spans":[{"start":0,"end":129,"speech":"MAT-16-24"}]},"27":{"text":"Porque el Hijo del hombre vendrá en la gloria de su Padre con sus ángeles, y entonces pagará á cada uno conforme á sus obras.","spans":[{"start":0,"end":125,"speech":"MAT-16-24"}]},"28":{"text":"De cierto os digo: hay algunos de los que están aquí, que no gustarán la muerte, hasta que hayan visto al Hijo del hombre viniendo en su reino.","spans":[{"start":0,"end":143,"speech":"MAT-16-24"}]}}}
