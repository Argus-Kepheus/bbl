"eid":"NUM 6:23"},{"type":"verse","marker":"v","number":"24","sid":"NUM 6:24"},{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H1288","content":["te bendiga"]},", ",{"type":"char","marker":"w","strong":"H8104","content":["y te guarde"]},": ",{"type":"verse","marker":"v","eid":"NUM 6:24"},{"type":"verse","marker":"v","number":"25","sid":"NUM 6:25"},{"type":"char","marker":"w","strong":"H0215","content":["Haga resplandecer"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["su rostro"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["sobre"]}," ti, ",{"type":"char","marker":"w","strong":"H2603","content":["y haya de ti misericordia"]},": ",{"type":"verse","marker":"v","eid":"NUM 6:25"},{"type":"verse","marker":"v","number":"26","sid":"NUM 6:26"},{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H5375","content":["alce"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["a"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["ti su rostro"]},", ",{"type":"char","marker":"w","strong":"H7760","content":["y ponga"]}," ",{"type":"char","marker":"w","strong":"H7965","content":["en ti paz"]},". ",{"type":"verse","marker":"v","eid":"NUM 6:26"},{"type":"verse","marker":"v","number":"27","sid":"NUM 6:27"},{"type":"char","marker":"w","strong":"H7760","content":["Y pondrán"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["mi"]}," ",{"type":"char","marker":"w","strong":"H8034","content":["nombre"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["sobre"]}," ",{"type":"char","marker":"w","strong":"H1121","content":["los hijos"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]},", ",{"type":"char","marker":"w","strong":"H0589","content":["y yo"]}," ",{"type":"char","marker":"w","strong":"H1288","content":["los bendeciré"]},". ",{"type":"verse","marker":"v","eid":"NUM 6:27"}]}],"speech":{"2":{"text":"Habla a los hijos de Israel, y diles: El hombre, o la mujer, cuando se apartare haciendo voto de Nazareo, para dedicarse a Jehová,","spans":[{"start":0,"end":130,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Se abstendrá de vino y de sidra; vinagre de vino, ni vinagre de sidra no beberá, ni beberá algún licor de uvas, ni tampoco comerá uvas frescas ni secas.","spans":[{"start":0,"end":152,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Todo el tiempo de su nazareato, de todo lo que se hace de vid de vino, desde los granillos hasta el hollejo, no comerá.","spans":[{"start":0,"end":119,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Todo el tiempo del voto de su nazareato no pasará navaja sobre su cabeza, hasta que sean cumplidos los días de su apartamiento a Jehová: santo será; dejará crecer las guedejas del cabello de su cabeza.","spans":[{"start":0,"end":201,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Todo el tiempo que se apartare a Jehová, no entrará a persona muerta.","spans":[{"start":0,"end":69,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Por su padre, ni por su madre, por su hermano, ni por su hermana, no se contaminará con ellos cuando murieren; porque consagración de su Dios tiene sobre su cabeza.","spans":[{"start":0,"end":164,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Todo el tiempo de su nazareato, será santo a Jehová.","spans":[{"start":0,"end":52,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Y si alguno muriere muy de repente junto a él, contaminará la cabeza de su nazareato; por tanto el día de su purificación raerá su cabeza; al séptimo día la raerá.","spans":[{"start":0,"end":163,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y el día octavo traerá dos tórtolas o dos palominos al sacerdote, a la puerta del tabernáculo del testimonio;","spans":[{"start":0,"end":109,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Y el sacerdote hará el uno en expiación, y el otro en holocausto: y expiaralo de lo que pecó sobre el muerto, y santificará su cabeza en aquel día.","spans":[{"start":0,"end":147,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Y consagrará a Jehová los días de su nazareato, y traerá un cordero de un año en expiación por la culpa; y los días primeros serán anulados, por cuanto fue contaminado su nazareato.","spans":[{"start":0,"end":181,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Esta es, pues, la ley del Nazareo el día que se cumpliere el tiempo de su nazareato: Vendrá a la puerta del tabernáculo del testimonio;","spans":[{"start":0,"end":135,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y ofrecerá su ofrenda a Jehová, un cordero de un año sin tacha en holocausto, y una cordera de un año sin defecto en expiación, y un carnero sin defecto por sacrificio de paces:","spans":[{"start":0,"end":177,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Además un canastillo de cenceñas, tortas de flor de harina amasadas con aceite, y hojaldres cenceñas untadas con aceite, y su presente, y sus libaciones.","spans":[{"start":0,"end":153,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Y el sacerdote lo ofrecerá delante de Jehová, y hará su expiación y su holocausto:","spans":[{"start":0,"end":82,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Y ofrecerá el carnero en sacrificio de paces a Jehová, con el canastillo de las cenceñas; ofrecerá asimismo el sacerdote su presente, y sus libaciones.","spans":[{"start":0,"end":151,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"18":{"text":"Entonces el Nazareo raerá a la puerta del tabernáculo del testimonio la cabeza de su nazareato, y tomará los cabellos de la cabeza de su nazareato, y los pondrá sobre el fuego que está debajo del sacrificio de las paces.","spans":[{"start":0,"end":220,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"19":{"text":"Después tomará el sacerdote la espaldilla cocida del carnero, y una torta sin levadura del canastillo, y una hojaldre sin levadura, y pondralas sobre las manos del Nazareo, después que fuere raído su nazareato:","spans":[{"start":0,"end":210,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"20":{"text":"Y el sacerdote mecerá aquello, ofrenda agitada delante de Jehová; lo cual será cosa santa del sacerdote, a más del pecho mecido y de la espaldilla separada: y después podrá beber vino el Nazareo.","spans":[{"start":0,"end":195,"speech":"NUM-6-2-jehovah","speaker":"jehovah"}]},"23":{"text":"Habla a Aarón y a sus hijos, y diles: Así bendeciréis a los hijos de Israel, diciéndoles:","spans":[{"start":0,"end":89,"speech":"NUM-6-23-jehovah","speaker":"jehovah"}]},"24":{"text":"Jehová te bendiga, y te guarde:","spans":[{"start":0,"end":31,"speech":"NUM-6-23-jehovah","speaker":"jehovah"}]},"25":{"text":"Haga resplandecer Jehová su rostro sobre ti, y haya de ti misericordia:","spans":[{"start":0,"end":71,"speech":"NUM-6-23-jehovah","speaker":"jehovah"}]},"26":{"text":"Jehová alce a ti su rostro, y ponga en ti paz.","spans":[{"start":0,"end":46,"speech":"NUM-6-23-jehovah","speaker":"jehovah"}]},"27":{"text":"Y pondrán mi nombre sobre los hijos de Israel, y yo los bendeciré.","spans":[{"start":0,"end":66,"speech":"NUM-6-23-jehovah","speaker":"jehovah"}]}}}
