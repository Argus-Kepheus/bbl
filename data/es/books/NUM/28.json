":"char","marker":"w","strong":"H8141","content":["año"]},": ",{"type":"verse","marker":"v","eid":"NUM 28:27"},{"type":"verse","marker":"v","number":"28","sid":"NUM 28:28"},{"type":"char","marker":"w","strong":"H4503","content":["Y el presente"]}," de ellos, ",{"type":"char","marker":"w","strong":"H5560","content":["flor de harina"]}," ",{"type":"char","marker":"w","strong":"H1101","content":["amasada"]}," ",{"type":"char","marker":"w","strong":"H8081","content":["con aceite"]},", ",{"type":"char","marker":"w","strong":"H7969","content":["tres"]}," ",{"type":"char","marker":"w","strong":"H6241","content":["décimas"]}," ",{"type":"char","marker":"w","strong":"H6499","content":["con cada becerro"]},", ",{"type":"char","marker":"w","strong":"H8147","content":["dos"]}," ",{"type":"char","marker":"w","strong":"H6241","content":["décimas"]}," ",{"type":"char","marker":"w","strong":"H0352","content":["con cada carnero"]},", ",{"type":"verse","marker":"v","eid":"NUM 28:28"},{"type":"verse","marker":"v","number":"29","sid":"NUM 28:29"},{"type":"char","marker":"w","strong":"H0259","content":["Con cada uno"]}," ",{"type":"char","marker":"w","strong":"H7651","content":["de los siete"]}," ",{"type":"char","marker":"w","strong":"H3532","content":["corderos"]}," ",{"type":"char","marker":"w","strong":"H6241","content":["una décima"]},"; ",{"type":"verse","marker":"v","eid":"NUM 28:29"},{"type":"verse","marker":"v","number":"30","sid":"NUM 28:30"},{"type":"char","marker":"w","strong":"H0259","content":["Un"]}," ",{"type":"char","marker":"w","strong":"H5795","content":["macho cabrío"]},", ",{"type":"char","marker":"w","strong":"H3722","content":["para hacer expiación"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["por"]}," vosotros. ",{"type":"verse","marker":"v","eid":"NUM 28:30"},{"type":"verse","marker":"v","number":"31","sid":"NUM 28:31"},{"type":"char","marker":"w","strong":"H6213","content":["Los ofreceréis"]},", ",{"type":"char","marker":"w","strong":"H0905","content":["además"]}," ",{"type":"char","marker":"w","strong":"H5930","content":["del holocausto"]}," ",{"type":"char","marker":"w","strong":"H8548","content":["continuo"]}," ",{"type":"char","marker":"w","strong":"H4503","content":["con sus presentes"]},", ",{"type":"char","marker":"w","strong":"H5262","content":["y sus libaciones"]},": ",{"type":"char","marker":"w","strong":"H8549","content":["sin defecto"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["los tomaréis"]},". ",{"type":"verse","marker":"v","eid":"NUM 28:31"}]}],"speech":{"2":{"text":"Manda a los hijos de Israel, y diles: Mi ofrenda, mi pan con mis ofrendas encendidas en olor a mí agradable, guardaréis, ofreciéndomelo a su tiempo.","spans":[{"start":0,"end":148,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y les dirás: Esta es la ofrenda encendida que ofreceréis a Jehová: dos corderos sin tacha de un año, cada un día, será el holocausto continuo.","spans":[{"start":0,"end":142,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"4":{"text":"El un cordero ofrecerás por la mañana, y el otro cordero ofrecerás entre las dos tardes:","spans":[{"start":0,"end":88,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Y la décima de un epha de flor de harina, amasada con una cuarta de un hin de aceite molido, en presente.","spans":[{"start":0,"end":105,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Es holocausto continuo, que fue hecho en el monte de Sinaí en olor de suavidad, ofrenda encendida a Jehová.","spans":[{"start":0,"end":107,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Y su libación, la cuarta de un hin con cada cordero: derramarás libación de superior vino a Jehová en el santuario.","spans":[{"start":0,"end":115,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y ofrecerás el segundo cordero entre las dos tardes: conforme a la ofrenda de la mañana, y conforme a su libación ofrecerás, ofrenda encendida en olor de suavidad a Jehová.","spans":[{"start":0,"end":172,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Mas el día del sábado dos corderos de un año sin defecto, y dos décimas de flor de harina amasada con aceite, por presente, con su libación:","spans":[{"start":0,"end":140,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Es el holocausto del sábado en cada sábado, además del holocausto continuo, y su libación.","spans":[{"start":0,"end":90,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Y en los principios de vuestros meses ofreceréis en holocausto a Jehová dos becerros de la vacada, y un carnero, y siete corderos de un año sin defecto;","spans":[{"start":0,"end":152,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Y tres décimas de flor de harina amasada con aceite, por presente con cada becerro; y dos décimas de flor de harina amasada con aceite, por presente con cada carnero;","spans":[{"start":0,"end":166,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Y una décima de flor de harina amasada con aceite, en ofrenda por presente con cada cordero: holocausto de olor suave, ofrenda encendida a Jehová.","spans":[{"start":0,"end":146,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y sus libaciones de vino, medio hin con cada becerro, y el tercio de un hin con cada carnero, y la cuarta de un hin con cada cordero. Este es el holocausto de cada mes por todos los meses del año.","spans":[{"start":0,"end":196,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Y un macho cabrío en expiación se ofrecerá a Jehová, además del holocausto continuo con su libación.","spans":[{"start":0,"end":100,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Mas en el mes primero, a los catorce del mes será la pascua de Jehová.","spans":[{"start":0,"end":70,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Y a los quince días de aqueste mes, la solemnidad: por siete días se comerán ázimos.","spans":[{"start":0,"end":84,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"18":{"text":"El primer día, santa convocación; ninguna obra servil haréis:","spans":[{"start":0,"end":61,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"19":{"text":"Y ofreceréis por ofrenda encendida en holocausto a Jehová dos becerros de la vacada, y un carnero, y siete corderos de un año: sin defecto los tomaréis:","spans":[{"start":0,"end":152,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"20":{"text":"Y su presente de harina amasada con aceite: tres décimas con cada becerro, y dos décimas con cada carnero ofreceréis;","spans":[{"start":0,"end":117,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"21":{"text":"Con cada uno de los siete corderos ofreceréis una décima;","spans":[{"start":0,"end":57,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"22":{"text":"Y un macho cabrío por expiación, para reconciliaros.","spans":[{"start":0,"end":52,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"23":{"text":"Esto ofreceréis además del holocausto de la mañana, que es el holocausto continuo.","spans":[{"start":0,"end":82,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"24":{"text":"Conforme a esto ofreceréis cada uno de los siete días, vianda y ofrenda encendida en olor de suavidad a Jehová; ofrecerse ha, además del holocausto continuo, con su libación.","spans":[{"start":0,"end":174,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"25":{"text":"Y el séptimo día tendréis santa convocación: ninguna obra servil haréis.","spans":[{"start":0,"end":72,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"26":{"text":"Además el día de las primicias, cuando ofreciereis presente nuevo a Jehová en vuestras semanas, tendréis santa convocación: ninguna obra servil haréis:","spans":[{"start":0,"end":151,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"27":{"text":"Y ofreceréis en holocausto, en olor de suavidad a Jehová, dos becerros de la vacada, un carnero, siete corderos de un año:","spans":[{"start":0,"end":122,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"28":{"text":"Y el presente de ellos, flor de harina amasada con aceite, tres décimas con cada becerro, dos décimas con cada carnero,","spans":[{"start":0,"end":119,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"29":{"text":"Con cada uno de los siete corderos una décima;","spans":[{"start":0,"end":46,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"30":{"text":"Un macho cabrío, para hacer expiación por vosotros.","spans":[{"start":0,"end":51,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"31":{"text":"Los ofreceréis, además del holocausto continuo con sus presentes, y sus libaciones: sin defecto los tomaréis.","spans":[{"start":0,"end":109,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]}}}
