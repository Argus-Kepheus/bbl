pe":"verse","marker":"v","number":"29","sid":"NUM 34:29"},{"type":"char","marker":"w","strong":"H0834","content":["Estos son a los que"]}," ",{"type":"char","marker":"w","strong":"H6680","content":["mandó"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H1121","content":["hiciesen la partición de la herencia a los hijos"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["en la tierra"]}," ",{"type":"char","marker":"w","strong":"H3667","content":["de Canaán"]},". ",{"type":"verse","marker":"v","eid":"NUM 34:29"}]}],"speech":{"2":{"text":"Manda a los hijos de Israel, y diles: Cuando hubiereis entrado en la tierra de Canaán, es a saber, la tierra que os ha de caer en heredad, la tierra de Canaán según sus términos;","spans":[{"start":0,"end":178,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Tendréis el lado del mediodía desde el desierto de Zin hasta los términos de Edom; y os será el término del mediodía al extremo del mar salado hacia el oriente:","spans":[{"start":0,"end":160,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Y este término os irá rodeando desde el mediodía hasta la subida de Acrabbim, y pasará hasta Zin; y sus salidas serán del mediodía a Cades-barnea; y saldrá a Hasar-addar, y pasará hasta Asmón;","spans":[{"start":0,"end":192,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Y rodeará este término, desde Asmón hasta el torrente de Egipto, y sus remates serán al occidente.","spans":[{"start":0,"end":98,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Y el término occidental os será la gran mar: este término os será el término occidental.","spans":[{"start":0,"end":88,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Y el término del norte será este: desde la gran mar os señalaréis el monte de Hor;","spans":[{"start":0,"end":82,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Del monte de Hor señalaréis a la entrada de Hamath, y serán las salidas de aquel término a Sedad;","spans":[{"start":0,"end":97,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Y saldrá este término a Ziphón, y serán sus remates en Hasar-enán: este os será el término del norte.","spans":[{"start":0,"end":101,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y por término al oriente os señalaréis desde Hasar-enán hasta Sepham;","spans":[{"start":0,"end":69,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Y bajará este término desde Sepham a Ribla, al oriente de Ain: y descenderá el término, y llegará a la costa de la mar de Cinnereth al oriente;","spans":[{"start":0,"end":143,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Después descenderá este término al Jordán, y serán sus salidas al mar Salado: esta será vuestra tierra: por sus términos alrededor.","spans":[{"start":0,"end":131,"speech":"NUM-34-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Estos son los nombres de los varones que os aposesionarán la tierra: Eleazar el sacerdote, y Josué hijo de Nun.","spans":[{"start":0,"end":111,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"18":{"text":"Tomaréis también de cada tribu un príncipe, para dar la posesión de la tierra.","spans":[{"start":0,"end":78,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"19":{"text":"Y estos son los nombres de los varones: De la tribu de Judá, Caleb hijo de Jephone.","spans":[{"start":0,"end":83,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"20":{"text":"Y de la tribu de los hijos de Simeón, Samuel hijo de Ammiud.","spans":[{"start":0,"end":60,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"21":{"text":"De la tribu de Benjamín, Elidad hijo de Chislón.","spans":[{"start":0,"end":48,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"22":{"text":"Y de la tribu de los hijos de Dan, el príncipe Bucci hijo de Jogli.","spans":[{"start":0,"end":67,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"23":{"text":"De los hijos de José: de la tribu de los hijos de Manasés, el príncipe Haniel hijo de Ephod.","spans":[{"start":0,"end":92,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"24":{"text":"Y de la tribu de los hijos de Ephraim, el príncipe Chêmuel hijo de Siphtán.","spans":[{"start":0,"end":75,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"25":{"text":"Y de la tribu de los hijos de Zabulón, el príncipe Elisaphán hijo de Pharnach.","spans":[{"start":0,"end":78,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"26":{"text":"Y de la tribu de los hijos de Issachâr, el príncipe Paltiel hijo de Azan.","spans":[{"start":0,"end":73,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"27":{"text":"Y de la tribu de los hijos de Aser, el príncipe Ahiud hijo de Selomi.","spans":[{"start":0,"end":69,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]},"28":{"text":"Y de la tribu de los hijos de Nephtalí, el príncipe Pedael hijo de Ammiud.","spans":[{"start":0,"end":74,"speech":"NUM-34-17-jehovah","speaker":"jehovah"}]}}}
