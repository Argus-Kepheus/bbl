,"marker":"w","strong":"H4503","content":["y para vuestros presentes"]},", ",{"type":"char","marker":"w","strong":"H5262","content":["y para vuestras libaciones"]},", ",{"type":"char","marker":"w","strong":"H8002","content":["y para vuestras paces"]},". "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","eid":"NUM 29:39"},{"type":"verse","marker":"v","number":"40","sid":"NUM 29:40"}]}],"speech":{"1":{"text":"Y EL séptimo mes, al primero del mes tendréis santa convocación: ninguna obra servil haréis; os será día de sonar las trompetas.","spans":[{"start":0,"end":128,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"2":{"text":"Y ofreceréis holocausto por olor de suavidad a Jehová, un becerro de la vacada, un carnero, siete corderos de un año sin defecto;","spans":[{"start":0,"end":129,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y el presente de ellos, de flor de harina amasada con aceite, tres décimas con cada becerro, dos décimas con cada carnero,","spans":[{"start":0,"end":122,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Y con cada uno de los siete corderos, una décima;","spans":[{"start":0,"end":49,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Y un macho cabrío por expiación, para reconciliaros:","spans":[{"start":0,"end":52,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Además del holocausto del mes, y su presente, y el holocausto continuo y su presente, y sus libaciones, conforme a su ley, por ofrenda encendida a Jehová en olor de suavidad.","spans":[{"start":0,"end":174,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Y en el diez de este mes séptimo tendréis santa convocación, y afligiréis vuestras almas: ninguna obra haréis:","spans":[{"start":0,"end":110,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y ofreceréis en holocausto a Jehová por olor de suavidad, un becerro de la vacada, un carnero, siete corderos de un año; sin defecto los tomaréis:","spans":[{"start":0,"end":146,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Y sus presentes, flor de harina amasada con aceite, tres décimas con cada becerro, dos décimas con cada carnero,","spans":[{"start":0,"end":112,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y con cada uno de los siete corderos, una décima;","spans":[{"start":0,"end":49,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Un macho cabrío por expiación: además de la ofrenda de las expiaciones por el pecado, y del holocausto continuo, y de sus presentes, y de sus libaciones.","spans":[{"start":0,"end":153,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"12":{"text":"También a los quince días del mes séptimo tendréis santa convocación; ninguna obra servil haréis, y celebraréis solemnidad a Jehová por siete días;","spans":[{"start":0,"end":147,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Y ofreceréis en holocausto, en ofrenda encendida a Jehová en olor de suavidad, trece becerros de la vacada, dos carneros, catorce corderos de un año: han de ser sin defecto;","spans":[{"start":0,"end":173,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y los presentes de ellos, de flor de harina amasada con aceite, tres décimas con cada uno de los trece becerros, dos décimas con cada uno de los dos carneros,","spans":[{"start":0,"end":158,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Y con cada uno de los catorce corderos, una décima;","spans":[{"start":0,"end":51,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, su presente y su libación.","spans":[{"start":0,"end":91,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Y el segundo día, doce becerros de la vacada, dos carneros, catorce corderos de un año sin defecto;","spans":[{"start":0,"end":99,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"18":{"text":"Y sus presentes y sus libaciones con los becerros, con los carneros, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":133,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"19":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, y su presente y su libación.","spans":[{"start":0,"end":93,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"20":{"text":"Y el día tercero, once becerros, dos carneros, catorce corderos de un año sin defecto;","spans":[{"start":0,"end":86,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"21":{"text":"Y sus presentes y sus libaciones con los becerros, con los carneros, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":133,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"22":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, y su presente y su libación.","spans":[{"start":0,"end":93,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"23":{"text":"Y el cuarto día, diez becerros, dos carneros, catorce corderos de un año sin defecto;","spans":[{"start":0,"end":85,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"24":{"text":"Sus presentes y sus libaciones con los becerros, con los carneros, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":131,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"25":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, su presente y su libación.","spans":[{"start":0,"end":91,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"26":{"text":"Y el quinto día, nueve becerros, dos carneros, catorce corderos de un año sin defecto;","spans":[{"start":0,"end":86,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"27":{"text":"Y sus presentes y sus libaciones con los becerros, con los carneros, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":133,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"28":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, su presente y su libación.","spans":[{"start":0,"end":91,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"29":{"text":"Y el sexto día, ocho becerros, dos carneros, catorce corderos de un año sin defecto;","spans":[{"start":0,"end":84,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"30":{"text":"Y sus presentes y sus libaciones con los becerros, con los carneros, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":133,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"31":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, su presente y sus libaciones.","spans":[{"start":0,"end":94,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"32":{"text":"Y el séptimo día, siete becerros, dos carneros, catorce corderos de un año sin defecto;","spans":[{"start":0,"end":87,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"33":{"text":"Y sus presentes y sus libaciones con los becerros, con los carneros, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":133,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"34":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, con su presente y su libación.","spans":[{"start":0,"end":95,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"35":{"text":"El octavo día tendréis solemnidad: ninguna obra servil haréis:","spans":[{"start":0,"end":62,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"36":{"text":"Y ofreceréis en holocausto, en ofrenda encendida de olor suave a Jehová, un novillo, un carnero, siete corderos de un año sin defecto;","spans":[{"start":0,"end":134,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"37":{"text":"Sus presentes y sus libaciones con el novillo, con el carnero, y con los corderos, según el número de ellos, conforme a la ley;","spans":[{"start":0,"end":127,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"38":{"text":"Y un macho cabrío por expiación: además del holocausto continuo, con su presente y su libación.","spans":[{"start":0,"end":95,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]},"39":{"text":"Estas cosas ofreceréis a Jehová en vuestras solemnidades, además de vuestros votos, y de vuestras ofrendas libres, para vuestros holocaustos, y para vuestros presentes, y para vuestras libaciones, y para vuestras paces.","spans":[{"start":0,"end":219,"speech":"NUM-28-2-jehovah","speaker":"jehovah"}]}}}
