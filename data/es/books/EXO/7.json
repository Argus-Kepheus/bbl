,"content":["con sus encantamientos"]},": ",{"type":"char","marker":"w","strong":"H3820","content":["y el corazón"]}," ",{"type":"char","marker":"w","strong":"H6547","content":["de Faraón"]}," ",{"type":"char","marker":"w","strong":"H2388","content":["se endureció"]},", ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["los"]}," ",{"type":"char","marker":"w","strong":"H8085","content":["escuchó"]},"; ",{"type":"char","marker":"w","strong":"H3068","content":["como Jehová"]}," ",{"type":"char","marker":"w","strong":"H1696","content":["lo había dicho"]},". ",{"type":"verse","marker":"v","eid":"EXO 7:22"},{"type":"verse","marker":"v","number":"23","sid":"EXO 7:23"},{"type":"char","marker":"w","strong":"H6437","content":["Y tornando"]}," ",{"type":"char","marker":"w","strong":"H6547","content":["Faraón"]}," ",{"type":"char","marker":"w","strong":"H6437","content":["volviose"]}," ",{"type":"char","marker":"w","strong":"H1004","content":["a su casa"]},", ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H7896","content":["puso"]}," ",{"type":"char","marker":"w","strong":"H3820","content":["su corazón"]}," ",{"type":"char","marker":"w","strong":"H1571","content":["aun"]}," ",{"type":"char","marker":"w","strong":"H2063","content":["en esto"]},". ",{"type":"verse","marker":"v","eid":"EXO 7:23"},{"type":"verse","marker":"v","number":"24","sid":"EXO 7:24"},{"type":"char","marker":"w","strong":"H3605","content":["Y en todo"]}," ",{"type":"char","marker":"w","strong":"H4714","content":["Egipto"]}," ",{"type":"char","marker":"w","strong":"H2658","content":["hicieron"]}," ",{"type":"char","marker":"w","strong":"H5439","content":["pozos alrededor"]}," ",{"type":"char","marker":"w","strong":"H2975","content":["del río"]}," ",{"type":"char","marker":"w","strong":"H8354","content":["para beber"]},", ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H3201","content":["podían"]}," ",{"type":"char","marker":"w","strong":"H8354","content":["beber"]}," ",{"type":"char","marker":"w","strong":"H4325","content":["de las aguas"]}," ",{"type":"char","marker":"w","strong":"H2975","content":["del río"]},". ",{"type":"verse","marker":"v","eid":"EXO 7:24"},{"type":"verse","marker":"v","number":"25","sid":"EXO 7:25"},{"type":"char","marker":"w","strong":"H4390","content":["Y cumpliéronse"]}," ",{"type":"char","marker":"w","strong":"H7651","content":["siete"]}," ",{"type":"char","marker":"w","strong":"H3117","content":["días"]}," ",{"type":"char","marker":"w","strong":"H0310","content":["después"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["que Jehová"]}," ",{"type":"char","marker":"w","strong":"H5221","content":["hirió"]}," ",{"type":"char","marker":"w","strong":"H2975","content":["el río"]},". ",{"type":"verse","marker":"v","eid":"EXO 7:25"}]}],"speech":{"1":{"text":"Y JEHOVÁ dijo a Moisés: Mira, yo te he constituido dios para Faraón, y tu hermano Aarón será tu profeta.","spans":[{"start":24,"end":104,"speech":"EXO-7-1-jehovah","speaker":"jehovah"}]},"2":{"text":"Tú dirás todas las cosas que yo te mandaré, y Aarón tu hermano hablará a Faraón, para que deje ir de su tierra a los hijos de Israel.","spans":[{"start":0,"end":133,"speech":"EXO-7-1-jehovah","speaker":"jehovah"}]},"3":{"text":"Y yo endureceré el corazón de Faraón, y multiplicaré en la tierra de Egipto mis señales y mis maravillas.","spans":[{"start":0,"end":105,"speech":"EXO-7-1-jehovah","speaker":"jehovah"}]},"4":{"text":"Y Faraón no os oirá; mas yo pondré mi mano sobre Egipto, y sacaré a mis ejércitos, mi pueblo, los hijos de Israel, de la tierra de Egipto, con grandes juicios.","spans":[{"start":0,"end":159,"speech":"EXO-7-1-jehovah","speaker":"jehovah"}]},"5":{"text":"Y sabrán los Egipcios que yo soy Jehová, cuando extenderé mi mano sobre Egipto, y sacaré los hijos de Israel de en medio de ellos.","spans":[{"start":0,"end":130,"speech":"EXO-7-1-jehovah","speaker":"jehovah"}]},"9":{"text":"Si Faraón os respondiere diciendo, Mostrad milagro; dirás a Aarón: Toma tu vara, y échala delante de Faraón, para que se torne culebra.","spans":[{"start":0,"end":135,"speech":"EXO-7-9-jehovah","speaker":"jehovah"}]},"14":{"text":"Entonces Jehová dijo a Moisés: El corazón de Faraón está agravado, que no quiere dejar ir al pueblo.","spans":[{"start":31,"end":100,"speech":"EXO-7-14-jehovah","speaker":"jehovah"}]},"15":{"text":"Ve por la mañana a Faraón, he aquí que él sale a las aguas; y tú ponte a la orilla del río delante de él, y toma en tu mano la vara que se volvió culebra,","spans":[{"start":0,"end":154,"speech":"EXO-7-14-jehovah","speaker":"jehovah"}]},"16":{"text":"Y dile: Jehová el Dios de los Hebreos me ha enviado a ti, diciendo: Deja ir a mi pueblo, para que me sirvan en el desierto; y he aquí que hasta ahora no has querido oír.","spans":[{"start":0,"end":169,"speech":"EXO-7-14-jehovah","speaker":"jehovah"}]},"17":{"text":"Así ha dicho Jehová: En esto conocerás que yo soy Jehová: he aquí, yo heriré con la vara que tengo en mi mano el agua que está en el río, y se convertirá en sangre:","spans":[{"start":0,"end":164,"speech":"EXO-7-14-jehovah","speaker":"jehovah"}]},"18":{"text":"Y los peces que hay en el río morirán, y hederá el río, y tendrán asco los Egipcios de beber el agua del río.","spans":[{"start":0,"end":109,"speech":"EXO-7-14-jehovah","speaker":"jehovah"}]},"19":{"text":"Y Jehová dijo a Moisés: Di a Aarón: Toma tu vara, y extiende tu mano sobre las aguas de Egipto, sobre sus ríos, sobre sus arroyos y sobre sus estanques, y sobre todos sus depósitos de aguas, para que se conviertan en sangre, y haya sangre por toda la región de Egipto, así en los vasos de madera como en los de piedra.","spans":[{"start":24,"end":318,"speech":"EXO-7-14-jehovah","speaker":"jehovah"}]}}}
