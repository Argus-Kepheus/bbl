do"]}," ",{"type":"char","marker":"w","strong":"H7453","content":["de tu prójimo"]},", ",{"type":"char","marker":"w","strong":"H0935","content":["a puestas"]}," ",{"type":"char","marker":"w","strong":"H8121","content":["del sol"]}," ",{"type":"char","marker":"w","strong":"H7725","content":["se lo volverás"]},": ",{"type":"verse","marker":"v","eid":"EXO 22:26"},{"type":"verse","marker":"v","number":"27","sid":"EXO 22:27"},{"type":"char","marker":"w","strong":"H3588","content":["Porque"]}," ",{"type":"char","marker":"w","strong":"H1931","content":["solo aquello es"]}," ",{"type":"char","marker":"w","strong":"H1931","content":["su"]}," ",{"type":"char","marker":"w","strong":"H3682","content":["cubierta"]},", ",{"type":"char","marker":"w","strong":"H1931","content":["es"]}," ",{"type":"char","marker":"w","strong":"H8071","content":["aquel el vestido"]}," ",{"type":"char","marker":"w","strong":"H5785","content":["para cubrir sus carnes"]},", ",{"type":"char","marker":"w","strong":"H4100","content":["en el que"]}," ",{"type":"char","marker":"w","strong":"H7901","content":["ha de dormir"]},": ",{"type":"char","marker":"w","strong":"H3588","content":["y será que cuando"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["él a mí"]}," ",{"type":"char","marker":"w","strong":"H6817","content":["clamare"]},", ",{"type":"char","marker":"w","strong":"H8085","content":["yo entonces le oiré"]},", ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["soy"]}," ",{"type":"char","marker":"w","strong":"H2587","content":["misericordioso"]},". ",{"type":"verse","marker":"v","eid":"EXO 22:27"},{"type":"verse","marker":"v","number":"28","sid":"EXO 22:28"},{"type":"char","marker":"w","strong":"H3808","content":["No"]}," ",{"type":"char","marker":"w","strong":"H7043","content":["denostarás"]}," ",{"type":"char","marker":"w","strong":"H0430","content":["a los jueces"]},", ",{"type":"char","marker":"w","strong":"H0779","content":["ni maldecirás"]}," ",{"type":"char","marker":"w","strong":"H5387","content":["al príncipe"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["de tu pueblo"]},". ",{"type":"verse","marker":"v","eid":"EXO 22:28"},{"type":"verse","marker":"v","number":"29","sid":"EXO 22:29"},{"type":"char","marker":"w","strong":"H3808","content":["No"]}," ",{"type":"char","marker":"w","strong":"H0309","content":["dilatarás"]}," ",{"type":"char","marker":"w","strong":"H4395","content":["la primicia"]}," de tu cosecha, ni de tu licor: ",{"type":"char","marker":"w","strong":"H1831","content":["me"]}," ",{"type":"char","marker":"w","strong":"H5414","content":["darás"]}," ",{"type":"char","marker":"w","strong":"H1060","content":["el primogénito"]}," ",{"type":"char","marker":"w","strong":"H1121","content":["de tus hijos"]},". ",{"type":"verse","marker":"v","eid":"EXO 22:29"},{"type":"verse","marker":"v","number":"30","sid":"EXO 22:30"},{"type":"char","marker":"w","strong":"H6213","content":["Así harás"]}," ",{"type":"char","marker":"w","strong":"H7794","content":["con el de tu buey"]}," ",{"type":"char","marker":"w","strong":"H6629","content":["y de tu oveja"]},": ",{"type":"char","marker":"w","strong":"H7651","content":["siete"]}," ",{"type":"char","marker":"w","strong":"H3117","content":["días"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["estará"]}," ",{"type":"char","marker":"w","strong":"H5973","content":["con"]}," ",{"type":"char","marker":"w","strong":"H0517","content":["su madre"]},", ",{"type":"char","marker":"w","strong":"H8066","content":["y al octavo"]}," ",{"type":"char","marker":"w","strong":"H3117","content":["día"]}," ",{"type":"char","marker":"w","strong":"H5414","content":["me lo darás"]},". ",{"type":"verse","marker":"v","eid":"EXO 22:30"},{"type":"verse","marker":"v","number":"31","sid":"EXO 22:31"},{"type":"char","marker":"w","strong":"H0582","content":["Y habéis de serme varones"]}," ",{"type":"char","marker":"w","strong":"H6944","content":["santos"]},": ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H0398","content":["comeréis"]}," ",{"type":"char","marker":"w","strong":"H1320","content":["carne"]}," ",{"type":"char","marker":"w","strong":"H2966","content":["arrebatada de las fieras"]}," ",{"type":"char","marker":"w","strong":"H7704","content":["en el campo"]},"; ",{"type":"char","marker":"w","strong":"H3611","content":["a los perros"]}," ",{"type":"char","marker":"w","strong":"H7993","content":["la echaréis"]},". ",{"type":"verse","marker":"v","eid":"EXO 22:31"}]}],"speech":{"1":{"text":"CUANDO alguno hurtare buey u oveja, y le degollare o vendiere, por aquel buey pagará cinco bueyes, y por aquella oveja cuatro ovejas.","spans":[{"start":0,"end":133,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"2":{"text":"Si el ladrón fuere hallado forzando una casa, y fuere herido y muriere, el que le hirió no será culpado de su muerte.","spans":[{"start":0,"end":117,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"3":{"text":"Si el sol hubiere sobre él salido, el matador será reo de homicidio: el ladrón habrá de restituir cumplidamente; si no tuviere, será vendido por su hurto.","spans":[{"start":0,"end":154,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"4":{"text":"Si fuere hallado con el hurto en la mano, sea buey o asno u oveja vivos, pagará el duplo.","spans":[{"start":0,"end":89,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"5":{"text":"Si alguno hiciere pacer campo o viña, y metiere su bestia, y comiere la tierra de otro, de lo mejor de su tierra y de lo mejor de su viña pagará.","spans":[{"start":0,"end":145,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"6":{"text":"Cuando rompiere un fuego, y hallare espinas, y fuere quemado montón, o haza, o campo, el que encendió el fuego pagará lo quemado.","spans":[{"start":0,"end":129,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"7":{"text":"Cuando alguno diere a su prójimo plata o alhajas a guardar, y fuere hurtado de la casa de aquel hombre, si el ladrón se hallare, pagará el doble.","spans":[{"start":0,"end":145,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"8":{"text":"Si el ladrón no se hallare, entonces el dueño de la casa será presentado a los jueces, para ver si ha metido su mano en la hacienda de su prójimo.","spans":[{"start":0,"end":146,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"9":{"text":"Sobre todo negocio de fraude, sobre buey, sobre asno, sobre oveja, sobre vestido, sobre toda cosa perdida, cuando uno dijere: Esto es mío, la causa de ambos vendrá delante de los jueces; y el que los jueces condenaren, pagará el doble a su prójimo.","spans":[{"start":0,"end":248,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"10":{"text":"Si alguno hubiere dado a su prójimo asno, o buey, u oveja, o cualquier otro animal a guardar, y se muriere, o se perniquebrare, o fuere llevado sin verlo nadie;","spans":[{"start":0,"end":160,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"11":{"text":"Juramento de Jehová tendrá lugar entre ambos de que no echó su mano a la hacienda de su prójimo: y su dueño lo aceptará, y el otro no pagará.","spans":[{"start":0,"end":141,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"12":{"text":"Mas si le hubiere sido hurtado, resarcirá a su dueño.","spans":[{"start":0,"end":53,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"13":{"text":"Y si le hubiere sido arrebatado por fiera, traerle ha testimonio, y no pagará lo arrebatado.","spans":[{"start":0,"end":92,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"14":{"text":"Pero si alguno hubiere tomado prestada bestia de su prójimo, y fuere estropeada o muerta, ausente su dueño, deberá pagarla.","spans":[{"start":0,"end":123,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"15":{"text":"Si el dueño estaba presente, no la pagará. Si era alquilada, él vendrá por su alquiler.","spans":[{"start":0,"end":87,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"16":{"text":"Y si alguno engañare a alguna doncella que no fuere desposada, y durmiere con ella, deberá dotarla y tomarla por mujer.","spans":[{"start":0,"end":119,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"17":{"text":"Si su padre no quisiere dársela, él le pesará plata conforme al dote de las vírgenes.","spans":[{"start":0,"end":85,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"18":{"text":"A la hechicera no dejarás que viva.","spans":[{"start":0,"end":35,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"19":{"text":"Cualquiera que tuviere ayuntamiento con bestia, morirá.","spans":[{"start":0,"end":55,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"20":{"text":"El que sacrificare a dioses, excepto a solo Jehová, será muerto.","spans":[{"start":0,"end":64,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"21":{"text":"Y al extranjero no engañarás, ni angustiarás, porque extranjeros fuisteis vosotros en la tierra de Egipto.","spans":[{"start":0,"end":106,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"22":{"text":"A ninguna viuda ni huérfano afligiréis.","spans":[{"start":0,"end":39,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"23":{"text":"Que si tú llegas a afligirle, y él a mí clamare, ciertamente oiré yo su clamor;","spans":[{"start":0,"end":79,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"24":{"text":"Y mi furor se encenderá, y os mataré a cuchillo, y vuestras mujeres serán viudas, y huérfanos vuestros hijos.","spans":[{"start":0,"end":109,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"25":{"text":"Si dieres a mi pueblo dinero emprestado, al pobre que está contigo, no te portarás con él como logrero, ni le impondrás usura.","spans":[{"start":0,"end":126,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"26":{"text":"Si tomares en prenda el vestido de tu prójimo, a puestas del sol se lo volverás:","spans":[{"start":0,"end":80,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"27":{"text":"Porque solo aquello es su cubierta, es aquel el vestido para cubrir sus carnes, en el que ha de dormir: y será que cuando él a mí clamare, yo entonces le oiré, porque soy misericordioso.","spans":[{"start":0,"end":186,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"28":{"text":"No denostarás a los jueces, ni maldecirás al príncipe de tu pueblo.","spans":[{"start":0,"end":67,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"29":{"text":"No dilatarás la primicia de tu cosecha, ni de tu licor: me darás el primogénito de tus hijos.","spans":[{"start":0,"end":93,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"30":{"text":"Así harás con el de tu buey y de tu oveja: siete días estará con su madre, y al octavo día me lo darás.","spans":[{"start":0,"end":103,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"31":{"text":"Y habéis de serme varones santos: y no comeréis carne arrebatada de las fieras en el campo; a los perros la echaréis.","spans":[{"start":0,"end":117,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]}}}
