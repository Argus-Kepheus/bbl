ype":"char","marker":"w","strong":"H0376","content":["Cualquiera"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que hiciere"]}," ",{"type":"char","marker":"w","strong":"H6213","content":["otra"]}," como ella para olerla, ",{"type":"char","marker":"w","strong":"H3772","content":["será cortado"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["de sus pueblos"]},". ",{"type":"verse","marker":"v","eid":"EXO 30:38"}]}],"speech":{"1":{"text":"HARÁS asimismo un altar de sahumerio de perfume: de madera de Sittim lo harás.","spans":[{"start":0,"end":78,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"2":{"text":"Su longitud será de un codo, y su anchura de un codo: será cuadrado: y su altura de dos codos: y sus cuernos serán de lo mismo.","spans":[{"start":0,"end":127,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y cubrirlo has de oro puro, su techado, y sus paredes en derredor, y sus cuernos: y le harás en derredor una corona de oro.","spans":[{"start":0,"end":123,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Le harás también dos anillos de oro debajo de su corona a sus dos esquinas en ambos lados suyos, para meter los varales con que será llevado.","spans":[{"start":0,"end":141,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Y harás los varales de madera de Sittim, y los cubrirás de oro.","spans":[{"start":0,"end":63,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Y lo pondrás delante del velo que está junto al arca del testimonio, delante de la cubierta que está sobre el testimonio, donde yo te testificaré de mí.","spans":[{"start":0,"end":152,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Y quemará sobre él Aarón sahumerio de aroma cada mañana: cuando aderezare las lámparas lo quemará.","spans":[{"start":0,"end":98,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y cuando Aarón encenderá las lámparas al anochecer, quemará el sahumerio: rito perpetuo delante de Jehová por vuestras edades.","spans":[{"start":0,"end":126,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"9":{"text":"No ofreceréis sobre él sahumerio extraño, ni holocausto, ni presente; ni tampoco derramaréis sobre él libación.","spans":[{"start":0,"end":111,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Y sobre sus cuernos hará Aarón expiación una vez en el año con la sangre de la expiación para las reconciliaciones: una vez en el año hará expiación sobre él en vuestras edades: será muy santo a Jehová.","spans":[{"start":0,"end":202,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Cuando tomares el número de los hijos de Israel conforme a la cuenta de ellos, cada uno dará a Jehová el rescate de su persona, cuando los contares, y no habrá en ellos mortandad por haberlos contado.","spans":[{"start":0,"end":200,"speech":"EXO-30-12-jehovah","speaker":"jehovah"}]},"13":{"text":"Esto dará cualquiera que pasare por la cuenta, medio siclo conforme al siclo del santuario. El siclo es de veinte óbolos: la mitad de un siclo será la ofrenda a Jehová.","spans":[{"start":0,"end":168,"speech":"EXO-30-12-jehovah","speaker":"jehovah"}]},"14":{"text":"Cualquiera que pasare por la cuenta, de veinte años arriba, dará la ofrenda a Jehová.","spans":[{"start":0,"end":85,"speech":"EXO-30-12-jehovah","speaker":"jehovah"}]},"15":{"text":"Ni el rico aumentará, ni el pobre disminuirá de medio siclo, cuando dieren la ofrenda a Jehová para hacer expiación por vuestras personas.","spans":[{"start":0,"end":138,"speech":"EXO-30-12-jehovah","speaker":"jehovah"}]},"16":{"text":"Y tomarás de los hijos de Israel el dinero de las expiaciones, y lo darás para la obra del tabernáculo del testimonio: y será por memoria a los hijos de Israel delante de Jehová, para expiar vuestras personas.","spans":[{"start":0,"end":209,"speech":"EXO-30-12-jehovah","speaker":"jehovah"}]},"18":{"text":"Harás también una fuente de metal, con su basa de metal, para lavar; y la has de poner entre el tabernáculo del testimonio y el altar; y pondrás en ella agua.","spans":[{"start":0,"end":158,"speech":"EXO-30-18-jehovah","speaker":"jehovah"}]},"19":{"text":"Y de ella se lavarán Aarón y sus hijos sus manos y sus pies:","spans":[{"start":0,"end":60,"speech":"EXO-30-18-jehovah","speaker":"jehovah"}]},"20":{"text":"Cuando entraren en el tabernáculo del testimonio, se han de lavar con agua, y no morirán: y cuando se llegaren al altar para ministrar, para encender a Jehová la ofrenda que se ha de consumir al fuego,","spans":[{"start":0,"end":201,"speech":"EXO-30-18-jehovah","speaker":"jehovah"}]},"21":{"text":"También se lavarán las manos y los pies, y no morirán. Y lo tendrán por estatuto perpetuo él y su simiente por sus generaciones.","spans":[{"start":0,"end":128,"speech":"EXO-30-18-jehovah","speaker":"jehovah"}]},"23":{"text":"Y tú has de tomar de las principales drogas; de mirra excelente quinientos siclos, y de canela aromática la mitad, esto es, doscientos y cincuenta, y de cálamo aromático doscientos y cincuenta,","spans":[{"start":0,"end":193,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"24":{"text":"Y de casia quinientos, al peso del santuario, y de aceite de olivas un hin:","spans":[{"start":0,"end":75,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"25":{"text":"Y harás de ello el aceite de la santa unción, superior ungüento, obra de perfumador, el cual será el aceite de la unción sagrada.","spans":[{"start":0,"end":129,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"26":{"text":"Con él ungirás el tabernáculo del testimonio, y el arca del testimonio,","spans":[{"start":0,"end":71,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"27":{"text":"Y la mesa, y todos sus vasos, y el candelero, y todos sus vasos, y el altar del perfume,","spans":[{"start":0,"end":88,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"28":{"text":"Y el altar del holocausto, todos sus vasos, y la fuente y su basa.","spans":[{"start":0,"end":66,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"29":{"text":"Así los consagrarás, y serán cosas santísimas: todo lo que tocare en ellos, será santificado.","spans":[{"start":0,"end":93,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"30":{"text":"Ungirás también a Aarón y a sus hijos, y los consagrarás para que sean mis sacerdotes.","spans":[{"start":0,"end":86,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"31":{"text":"Y hablarás a los hijos de Israel, diciendo: Este será mi aceite de la santa unción por vuestras edades.","spans":[{"start":0,"end":103,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"32":{"text":"Sobre carne de hombre no será untado, ni haréis otro semejante, conforme a su composición: santo es; por santo habéis de tenerlo vosotros.","spans":[{"start":0,"end":138,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"33":{"text":"Cualquiera que compusiere ungüento semejante, y que pusiere de él sobre extraño, será cortado de sus pueblos.","spans":[{"start":0,"end":109,"speech":"EXO-30-23-jehovah","speaker":"jehovah"}]},"34":{"text":"Dijo aún Jehová a Moisés: Tómate aromas, estacte y uña olorosa y gálbano aromático e incienso limpio; de todo en igual peso:","spans":[{"start":26,"end":124,"speech":"EXO-30-34-jehovah","speaker":"jehovah"}]},"35":{"text":"Y harás de ello una confección aromática de obra de perfumador, bien mezclada, pura y santa:","spans":[{"start":0,"end":92,"speech":"EXO-30-34-jehovah","speaker":"jehovah"}]},"36":{"text":"Y molerás alguna de ella pulverizándola, y la pondrás delante del testimonio en el tabernáculo del testimonio, donde yo te testificaré de mí. Os será cosa santísima.","spans":[{"start":0,"end":165,"speech":"EXO-30-34-jehovah","speaker":"jehovah"}]},"37":{"text":"Como la confección que harás, no os haréis otra según su composición: te será cosa sagrada para Jehová.","spans":[{"start":0,"end":103,"speech":"EXO-30-34-jehovah","speaker":"jehovah"}]},"38":{"text":"Cualquiera que hiciere otra como ella para olerla, será cortado de sus pueblos.","spans":[{"start":0,"end":79,"speech":"EXO-30-34-jehovah","speaker":"jehovah"}]}}}
