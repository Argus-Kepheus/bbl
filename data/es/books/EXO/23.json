"marker":"w","strong":"H2416","content":["ti las bestias"]}," ",{"type":"char","marker":"w","strong":"H7704","content":["del campo"]},". ",{"type":"verse","marker":"v","eid":"EXO 23:29"},{"type":"verse","marker":"v","number":"30","sid":"EXO 23:30"},{"type":"char","marker":"w","strong":"H4592","content":["Poco"]}," ",{"type":"char","marker":"w","strong":"H4592","content":["a poco"]}," ",{"type":"char","marker":"w","strong":"H1644","content":["los echaré"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["de delante"]}," de ti, ",{"type":"char","marker":"w","strong":"H5704","content":["hasta"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H6509","content":["te multipliques"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["y tomes la tierra"]}," ",{"type":"char","marker":"w","strong":"H5157","content":["por heredad"]},". ",{"type":"verse","marker":"v","eid":"EXO 23:30"},{"type":"verse","marker":"v","number":"31","sid":"EXO 23:31"},{"type":"char","marker":"w","strong":"H5414","content":["Y yo pondré"]}," ",{"type":"char","marker":"w","strong":"H1366","content":["tu término"]}," ",{"type":"char","marker":"w","strong":"H3220","content":["desde el mar"]}," ",{"type":"char","marker":"w","strong":"H5488","content":["Bermejo"]}," ",{"type":"char","marker":"w","strong":"H5704","content":["hasta"]}," ",{"type":"char","marker":"w","strong":"H3220","content":["la mar"]}," de Palestina, ",{"type":"char","marker":"w","strong":"H4057","content":["y desde el desierto"]}," ",{"type":"char","marker":"w","strong":"H5704","content":["hasta"]}," ",{"type":"char","marker":"w","strong":"H5104","content":["el río"]},": ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H5414","content":["pondré"]}," ",{"type":"char","marker":"w","strong":"H3027","content":["en vuestras manos"]}," ",{"type":"char","marker":"w","strong":"H3427","content":["los moradores"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["de la tierra"]},", ",{"type":"char","marker":"w","strong":"H1644","content":["y tú los echarás"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["de delante"]}," de ti. ",{"type":"verse","marker":"v","eid":"EXO 23:31"},{"type":"verse","marker":"v","number":"32","sid":"EXO 23:32"},{"type":"char","marker":"w","strong":"H3808","content":["No"]}," ",{"type":"char","marker":"w","strong":"H3772","content":["harás"]}," ",{"type":"char","marker":"w","strong":"H1285","content":["alianza"]}," con ellos, ",{"type":"char","marker":"w","strong":"H0430","content":["ni con sus dioses"]},". ",{"type":"verse","marker":"v","eid":"EXO 23:32"},{"type":"verse","marker":"v","number":"33","sid":"EXO 23:33"},{"type":"char","marker":"w","strong":"H0776","content":["En tu tierra"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H3427","content":["habitarán"]},", ",{"type":"char","marker":"w","strong":"H6435","content":["no"]}," ",{"type":"char","marker":"w","strong":"H2398","content":["sea que te hagan pecar"]}," ",{"type":"char","marker":"w","strong":"H5647","content":["contra mí sirviendo"]}," ",{"type":"char","marker":"w","strong":"H0430","content":["a sus dioses"]},": ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["te será"]}," ",{"type":"char","marker":"w","strong":"H4170","content":["de tropiezo"]},". ",{"type":"verse","marker":"v","eid":"EXO 23:33"}]}],"speech":{"1":{"text":"NO admitirás falso rumor. No te concertarás con el impío para ser testigo falso.","spans":[{"start":0,"end":80,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"2":{"text":"No seguirás a los muchos para mal hacer; ni responderás en litigio inclinándote a los más para hacer agravios;","spans":[{"start":0,"end":110,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"3":{"text":"Ni al pobre distinguirás en su causa.","spans":[{"start":0,"end":37,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"4":{"text":"Si encontrares el buey de tu enemigo o su asno extraviado, vuelve a llevárselo.","spans":[{"start":0,"end":79,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"5":{"text":"Si vieres el asno del que te aborrece caído debajo de su carga, ¿le dejarás entonces desamparado? Sin falta ayudarás con él a levantarlo.","spans":[{"start":0,"end":137,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"6":{"text":"No pervertirás el derecho de tu mendigo en su pleito.","spans":[{"start":0,"end":53,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"7":{"text":"De palabra de mentira te alejarás, y no matarás al inocente y justo; porque yo no justificaré al impío.","spans":[{"start":0,"end":103,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"8":{"text":"No recibirás presente; porque el presente ciega a los que ven, y pervierte las palabras justas.","spans":[{"start":0,"end":95,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"9":{"text":"Y no angustiarás al extranjero: pues vosotros sabéis cómo se halla el alma del extranjero, ya que extranjeros fuisteis en la tierra de Egipto.","spans":[{"start":0,"end":142,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"10":{"text":"Seis años sembrarás tu tierra, y allegarás su cosecha:","spans":[{"start":0,"end":54,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"11":{"text":"Mas el séptimo la dejarás vacante y soltarás, para que coman los pobres de tu pueblo; y de lo que quedare comerán las bestias del campo; así harás de tu viña y de tu olivar.","spans":[{"start":0,"end":173,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"12":{"text":"Seis días harás tus negocios, y al séptimo día holgarás, a fin que descanse tu buey y tu asno, y tome refrigerio el hijo de tu sierva, y el extranjero.","spans":[{"start":0,"end":151,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"13":{"text":"Y en todo lo que os he dicho seréis avisados. Y nombre de otros dioses no mentaréis, ni se oirá de vuestra boca.","spans":[{"start":0,"end":112,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"14":{"text":"Tres veces en el año me celebraréis fiesta.","spans":[{"start":0,"end":43,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"15":{"text":"La fiesta de los ázimos guardarás: siete días comerás los panes sin levadura, como yo te mandé, en el tiempo del mes de Abib; porque en él saliste de Egipto: y ninguno comparecerá vacío delante de mí:","spans":[{"start":0,"end":200,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"16":{"text":"También la fiesta de la siega, los primeros frutos de tus labores que hubieres sembrado en el campo; y la fiesta de la cosecha a la salida del año, cuando habrás recogido tus labores del campo.","spans":[{"start":0,"end":193,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"17":{"text":"Tres veces en el año parecerá todo varón tuyo delante del Señor Jehová.","spans":[{"start":0,"end":71,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"18":{"text":"No ofrecerás con pan leudo la sangre de mi sacrificio; ni el sebo de mi víctima quedará de la noche hasta la mañana.","spans":[{"start":0,"end":116,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"19":{"text":"Las primicias de los primeros frutos de tu tierra traerás a la casa de Jehová tu Dios. No guisarás el cabrito con la leche de su madre.","spans":[{"start":0,"end":135,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"20":{"text":"He aquí yo envío el Angel delante de ti para que te guarde en el camino, y te introduzca en el lugar que yo he preparado.","spans":[{"start":0,"end":121,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"21":{"text":"Guárdate delante de él, y oye su voz; no le seas rebelde; porque él no perdonará vuestra rebelión: porque mi nombre está en él.","spans":[{"start":0,"end":127,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"22":{"text":"Pero si en verdad oyeres su voz, e hicieres todo lo que yo te dijere, seré enemigo a tus enemigos, y afligiré a los que te afligieren.","spans":[{"start":0,"end":134,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"23":{"text":"Porque mi Angel irá delante de ti, y te introducirá al Amorrheo, y al Hetheo, y al Pherezeo, y al Cananeo, y al Heveo, y al Jebuseo, a los cuales yo haré destruir.","spans":[{"start":0,"end":163,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"24":{"text":"No te inclinarás a sus dioses, ni los servirás, ni harás como ellos hacen; antes los destruirás del todo, y quebrantarás enteramente sus estatuas.","spans":[{"start":0,"end":146,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"25":{"text":"Mas a Jehová vuestro Dios serviréis, y él bendecirá tu pan y tus aguas; y yo quitaré toda enfermedad de en medio de ti.","spans":[{"start":0,"end":119,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"26":{"text":"No habrá mujer que aborte, ni estéril en tu tierra; y yo cumpliré el número de tus días.","spans":[{"start":0,"end":88,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"27":{"text":"Yo enviaré mi terror delante de ti, y consternaré a todo pueblo donde tú entrares, y te daré la cerviz de todos tus enemigos.","spans":[{"start":0,"end":125,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"28":{"text":"Yo enviaré la avispa delante de ti, que eche fuera al Heveo, y al Cananeo, y al Hetheo, de delante de ti:","spans":[{"start":0,"end":105,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"29":{"text":"No los echaré de delante de ti en un año, porque no quede la tierra desierta, y se aumenten contra ti las bestias del campo.","spans":[{"start":0,"end":124,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"30":{"text":"Poco a poco los echaré de delante de ti, hasta que te multipliques y tomes la tierra por heredad.","spans":[{"start":0,"end":97,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"31":{"text":"Y yo pondré tu término desde el mar Bermejo hasta la mar de Palestina, y desde el desierto hasta el río: porque pondré en vuestras manos los moradores de la tierra, y tú los echarás de delante de ti.","spans":[{"start":0,"end":199,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"32":{"text":"No harás alianza con ellos, ni con sus dioses.","spans":[{"start":0,"end":46,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]},"33":{"text":"En tu tierra no habitarán, no sea que te hagan pecar contra mí sirviendo a sus dioses: porque te será de tropiezo.","spans":[{"start":0,"end":114,"speech":"EXO-21-1-jehovah","speaker":"jehovah"}]}}}
