"char","marker":"w","strong":"H1961","content":["serán"]}," de lo mismo, ",{"type":"char","marker":"w","strong":"H3605","content":["todo"]}," ",{"type":"char","marker":"w","strong":"H4749","content":["ello una pieza labrada"]}," a martillo, ",{"type":"char","marker":"w","strong":"H2091","content":["de oro"]}," ",{"type":"char","marker":"w","strong":"H2889","content":["puro"]},". ",{"type":"verse","marker":"v","eid":"EXO 25:36"},{"type":"verse","marker":"v","number":"37","sid":"EXO 25:37"},{"type":"char","marker":"w","strong":"H6213","content":["Y hacerle"]}," ",{"type":"char","marker":"w","strong":"H7651","content":["has siete"]}," ",{"type":"char","marker":"w","strong":"H5216","content":["candilejas"]},", ",{"type":"char","marker":"w","strong":"H5927","content":["las cuales encenderás"]}," ",{"type":"char","marker":"w","strong":"H0215","content":["para que alumbren"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["a la parte"]}," ",{"type":"char","marker":"w","strong":"H5676","content":["de su delantera"]},": ",{"type":"verse","marker":"v","eid":"EXO 25:37"},{"type":"verse","marker":"v","number":"38","sid":"EXO 25:38"},{"type":"char","marker":"w","strong":"H4457","content":["También sus despabiladeras"]}," ",{"type":"char","marker":"w","strong":"H4289","content":["y sus platillos"]},", ",{"type":"char","marker":"w","strong":"H2091","content":["de oro"]}," ",{"type":"char","marker":"w","strong":"H2889","content":["puro"]},". ",{"type":"verse","marker":"v","eid":"EXO 25:38"},{"type":"verse","marker":"v","number":"39","sid":"EXO 25:39"},{"type":"char","marker":"w","strong":"H3603","content":["De un talento"]}," ",{"type":"char","marker":"w","strong":"H2091","content":["de oro"]}," ",{"type":"char","marker":"w","strong":"H2889","content":["fino"]}," ",{"type":"char","marker":"w","strong":"H6213","content":["lo harás"]},", ",{"type":"char","marker":"w","strong":"H0853","content":["con"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todos"]}," ",{"type":"char","marker":"w","strong":"H3627","content":["estos vasos"]},". ",{"type":"verse","marker":"v","eid":"EXO 25:39"},{"type":"verse","marker":"v","number":"40","sid":"EXO 25:40"},{"type":"char","marker":"w","strong":"H7200","content":["Y mira"]},", ",{"type":"char","marker":"w","strong":"H6213","content":["y hazlos"]}," ",{"type":"char","marker":"w","strong":"H8403","content":["conforme a su modelo"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H7200","content":["te ha sido mostrado"]}," ",{"type":"char","marker":"w","strong":"H2022","content":["en el monte"]},". ",{"type":"verse","marker":"v","eid":"EXO 25:40"}]}],"speech":{"2":{"text":"Di a los hijos de Israel que tomen para mí ofrenda: de todo varón que la diere de su voluntad, de corazón, tomaréis mi ofrenda.","spans":[{"start":0,"end":127,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"3":{"text":"Y esta es la ofrenda que tomaréis de ellos: Oro, y plata, y cobre,","spans":[{"start":0,"end":66,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"4":{"text":"Y jacinto, y púrpura, y carmesí, y lino fino, y pelo de cabras,","spans":[{"start":0,"end":63,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"5":{"text":"Y cueros de carneros teñidos de rojo, y cueros de tejones, y madera de Sittim;","spans":[{"start":0,"end":78,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"6":{"text":"Aceite para la luminaria, especias para el aceite de la unción, y para el sahumerio aromático;","spans":[{"start":0,"end":94,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"7":{"text":"Piedras de onix, y piedras de engastes, para el ephod, y para el racional.","spans":[{"start":0,"end":74,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"8":{"text":"Y hacerme han un santuario, y yo habitaré entre ellos.","spans":[{"start":0,"end":54,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"9":{"text":"Conforme a todo lo que yo te mostrare, el diseño del tabernáculo, y el diseño de todos sus vasos, así lo haréis.","spans":[{"start":0,"end":112,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"10":{"text":"Harán también un arca de madera de Sittim, cuya longitud será de dos codos y medio, y su anchura de codo y medio, y su altura de codo y medio.","spans":[{"start":0,"end":142,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"11":{"text":"Y la cubrirás de oro puro; por dentro y por fuera la cubrirás; y harás sobre ella una cornisa de oro alrededor.","spans":[{"start":0,"end":111,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"12":{"text":"Y para ella harás de fundición cuatro anillos de oro, que pondrás a sus cuatro esquinas; dos anillos al un lado de ella, y dos anillos al otro lado.","spans":[{"start":0,"end":148,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"13":{"text":"Y harás unas varas de madera de Sittim, las cuales cubrirás de oro:","spans":[{"start":0,"end":67,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"14":{"text":"Y meterás las varas por los anillos a los lados del arca, para llevar el arca con ellas.","spans":[{"start":0,"end":88,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"15":{"text":"Las varas se estarán en los anillos del arca: no se quitarán de ella.","spans":[{"start":0,"end":69,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"16":{"text":"Y pondrás en el arca el testimonio que yo te daré.","spans":[{"start":0,"end":50,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"17":{"text":"Y harás una cubierta de oro fino, cuya longitud será de dos codos y medio, y su anchura de codo y medio.","spans":[{"start":0,"end":104,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"18":{"text":"Harás también dos querubines de oro, labrados a martillo los harás, en los dos cabos de la cubierta.","spans":[{"start":0,"end":100,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"19":{"text":"Harás, pues, un querubín al extremo de un lado, y un querubín al otro extremo del lado opuesto: de la calidad de la cubierta harás los querubines en sus dos extremidades.","spans":[{"start":0,"end":170,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"20":{"text":"Y los querubines extenderán por encima las alas, cubriendo con sus alas la cubierta: sus caras la una enfrente de la otra, mirando a la cubierta las caras de los querubines.","spans":[{"start":0,"end":173,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"21":{"text":"Y pondrás la cubierta encima del arca, y en el arca pondrás el testimonio que yo te daré.","spans":[{"start":0,"end":89,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"22":{"text":"Y de allí me declararé a ti, y hablaré contigo de sobre la cubierta, de entre los dos querubines que están sobre el arca del testimonio, todo lo que yo te mandaré para los hijos de Israel.","spans":[{"start":0,"end":188,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"23":{"text":"Harás asimismo una mesa de madera de Sittim: su longitud será de dos codos, y de un codo su anchura, y su altura de codo y medio.","spans":[{"start":0,"end":129,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"24":{"text":"Y la cubrirás de oro puro, y le has de hacer una cornisa de oro alrededor.","spans":[{"start":0,"end":74,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"25":{"text":"Hacerle has también una moldura alrededor, del ancho de una mano, a la cual moldura harás una cornisa de oro en circunferencia.","spans":[{"start":0,"end":127,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"26":{"text":"Y le harás cuatro anillos de oro, los cuales pondrás a las cuatro esquinas que corresponden a sus cuatro pies.","spans":[{"start":0,"end":110,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"27":{"text":"Los anillos estarán antes de la moldura, por lugares de las varas, para llevar la mesa.","spans":[{"start":0,"end":87,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"28":{"text":"Y harás las varas de madera de Sittim, y las cubrirás de oro, y con ellas será llevada la mesa.","spans":[{"start":0,"end":95,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"29":{"text":"Harás también sus platos, y sus cucharas, y sus cubiertas, y sus tazones, con que se libará: de oro fino los harás.","spans":[{"start":0,"end":115,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"30":{"text":"Y pondrás sobre la mesa el pan de la proposición delante de mí continuamente.","spans":[{"start":0,"end":77,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"31":{"text":"Harás además un candelero de oro puro; labrado a martillo se hará el candelero: su pie, y su caña, sus copas, sus manzanas, y sus flores, serán de lo mismo:","spans":[{"start":0,"end":156,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"32":{"text":"Y saldrán seis brazos de sus lados: tres brazos del candelero del un lado suyo, y tres brazos del candelero del otro su lado:","spans":[{"start":0,"end":125,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"33":{"text":"Tres copas en forma de almendras en el un brazo, una manzana y una flor; y tres copas, figura de almendras, en el otro brazo, una manzana y una flor: así pues, en los seis brazos que salen del candelero:","spans":[{"start":0,"end":203,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"34":{"text":"Y en el candelero cuatro copas en forma de almendras, sus manzanas y sus flores.","spans":[{"start":0,"end":80,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"35":{"text":"Habrá una manzana debajo de los dos brazos de lo mismo, otra manzana debajo de los otros dos brazos de lo mismo, y otra manzana debajo de los otros dos brazos de lo mismo, en conformidad a los seis brazos que salen del candelero.","spans":[{"start":0,"end":229,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"36":{"text":"Sus manzanas y sus brazos serán de lo mismo, todo ello una pieza labrada a martillo, de oro puro.","spans":[{"start":0,"end":97,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"37":{"text":"Y hacerle has siete candilejas, las cuales encenderás para que alumbren a la parte de su delantera:","spans":[{"start":0,"end":99,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"38":{"text":"También sus despabiladeras y sus platillos, de oro puro.","spans":[{"start":0,"end":56,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"39":{"text":"De un talento de oro fino lo harás, con todos estos vasos.","spans":[{"start":0,"end":58,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]},"40":{"text":"Y mira, y hazlos conforme a su modelo, que te ha sido mostrado en el monte.","spans":[{"start":0,"end":75,"speech":"EXO-25-2-jehovah","speaker":"jehovah"}]}}}
