",{"type":"verse","marker":"v","eid":"PSA 50:21"},{"type":"verse","marker":"v","number":"22","sid":"PSA 50:22"},{"type":"char","marker":"w","strong":"H0995","content":["Entended"]}," ",{"type":"char","marker":"w","strong":"H4994","content":["ahora"]}," ",{"type":"char","marker":"w","strong":"H2063","content":["esto"]},", ",{"type":"char","marker":"w","strong":"H7911","content":["los que os olvidáis"]}," ",{"type":"char","marker":"w","strong":"H0433","content":["de Dios"]},"; ",{"type":"char","marker":"w","strong":"H6435","content":["no"]}," sea que arrebate, ",{"type":"char","marker":"w","strong":"H5337","content":["sin que nadie libre"]},". ",{"type":"verse","marker":"v","eid":"PSA 50:22"},{"type":"verse","marker":"v","number":"23","sid":"PSA 50:23"},{"type":"char","marker":"w","strong":"H2076","content":["El que sacrifica"]}," ",{"type":"char","marker":"w","strong":"H8426","content":["alabanza"]}," ",{"type":"char","marker":"w","strong":"H3513","content":["me honrará"]},": ",{"type":"char","marker":"w","strong":"H7760","content":["y al que ordenare"]}," ",{"type":"char","marker":"w","strong":"H1870","content":["su camino"]},", ",{"type":"char","marker":"w","strong":"H7200","content":["le mostraré"]}," ",{"type":"char","marker":"w","strong":"H3468","content":["la salud"]}," ",{"type":"char","marker":"w","strong":"H0430","content":["de Dios"]},". "]}],"speech":{"5":{"text":"Juntadme mis santos; los que hicieron conmigo pacto con sacrificio.","spans":[{"start":0,"end":67,"speech":"PSA-50-5-jehovah","speaker":"jehovah"}]},"7":{"text":"Oye, pueblo mío, y hablaré: escucha, Israel, y testificaré contra ti: yo soy Dios, el Dios tuyo.","spans":[{"start":0,"end":96,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"8":{"text":"No te reprenderé sobre tus sacrificios, ni por tus holocaustos, que delante de mí están siempre.","spans":[{"start":0,"end":96,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"9":{"text":"No tomaré de tu casa becerros, ni machos cabríos de tus apriscos.","spans":[{"start":0,"end":65,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"10":{"text":"Porque mía es toda bestia del bosque, y los millares de animales en los collados.","spans":[{"start":0,"end":81,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"11":{"text":"Conozco todas las aves de los montes, y en mi poder están las fieras del campo.","spans":[{"start":0,"end":79,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"12":{"text":"Si yo tuviese hambre, no te lo diría a ti: porque mío es el mundo y su plenitud.","spans":[{"start":0,"end":80,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"13":{"text":"¿Tengo de comer yo carne de toros, o de beber sangre de machos cabríos?","spans":[{"start":0,"end":71,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"14":{"text":"Sacrifica a Dios alabanza, y paga tus votos al Altísimo.","spans":[{"start":0,"end":56,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"15":{"text":"E invócame en el día de la angustia: te libraré, y tú me honrarás.","spans":[{"start":0,"end":66,"speech":"PSA-50-7-jehovah","speaker":"jehovah"}]},"16":{"text":"Pero al malo dijo Dios: ¿Qué tienes tú que enarrar mis leyes, y que tomar mi pacto en tu boca,","spans":[{"start":24,"end":94,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"17":{"text":"Pues que tú aborreces el castigo, y echas a tu espalda mis palabras?","spans":[{"start":0,"end":68,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"18":{"text":"Si veías al ladrón, tú corrías con él; y con los adúlteros era tu parte.","spans":[{"start":0,"end":72,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"19":{"text":"Tu boca metías en mal, y tu lengua componía engaño.","spans":[{"start":0,"end":51,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"20":{"text":"Tomabas asiento, y hablabas contra tu hermano; contra el hijo de tu madre ponías infamia.","spans":[{"start":0,"end":89,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"21":{"text":"Estas cosas hiciste, y yo he callado: pensabas que de cierto sería yo como tú: yo te argüiré, y pondrelas delante de tus ojos.","spans":[{"start":0,"end":126,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"22":{"text":"Entended ahora esto, los que os olvidáis de Dios; no sea que arrebate, sin que nadie libre.","spans":[{"start":0,"end":91,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]},"23":{"text":"El que sacrifica alabanza me honrará: y al que ordenare su camino, le mostraré la salud de Dios.","spans":[{"start":0,"end":96,"speech":"PSA-50-16-jehovah","speaker":"jehovah"}]}}}
