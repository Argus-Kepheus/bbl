char","marker":"w","strong":"G0068","content":["campo"]},"; ",{"type":"char","marker":"w","strong":"G3588","content":["el"]}," ",{"type":"char","marker":"w","strong":"G1520","content":["uno"]}," ",{"type":"char","marker":"w","strong":"G3880","content":["será tomado"]},", ",{"type":"char","marker":"w","strong":"G2532","content":["y"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["el"]}," ",{"type":"char","marker":"w","strong":"G2087","content":["otro"]}," ",{"type":"char","marker":"w","strong":"G0863","content":["dejado"]},". ",{"type":"verse","marker":"v","eid":"LUK 17:36"},{"type":"verse","marker":"v","number":"37","sid":"LUK 17:37"},{"type":"char","marker":"w","strong":"G2532","content":["Y"]}," ",{"type":"char","marker":"w","strong":"G0611","content":["respondiendo"]},", ",{"type":"char","marker":"w","strong":"G0846","content":["le"]}," ",{"type":"char","marker":"w","strong":"G3004","content":["dicen"]},": ¿",{"type":"char","marker":"w","strong":"G4226","content":["Dónde"]},", ",{"type":"char","marker":"w","strong":"G2962","content":["Señor"]},"? ",{"type":"char","marker":"w","strong":"G0846","content":["Y él les"]}," ",{"type":"char","marker":"w","strong":"G2036","content":["dijo"]},": ",{"type":"char","marker":"w","strong":"G3699","content":["Donde"]}," ",{"type":"char","marker":"add","content":["estuviere"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["el"]}," ",{"type":"char","marker":"w","strong":"G4983","content":["cuerpo"]},", ",{"type":"char","marker":"w","strong":"G4863","content":["allá se juntarán"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["también las"]}," ",{"type":"char","marker":"w","strong":"G0105","content":["águilas"]},". ",{"type":"verse","marker":"v","eid":"LUK 17:37"}]}],"speech":{"1":{"text":"Y Á SUS discípulos dice: Imposible es que no vengan escándalos; mas ¡ay de aquél por quien vienen!","spans":[{"start":25,"end":98,"speech":"LUK-17-1"}]},"2":{"text":"Mejor le fuera, si le pusiesen al cuello una piedra de molino, y le lanzasen en el mar, que escandalizar á uno de estos pequeñitos.","spans":[{"start":0,"end":131,"speech":"LUK-17-1"}]},"3":{"text":"Mirad por vosotros: si pecare contra ti tu hermano, repréndele; y si se arrepintiere, perdónale.","spans":[{"start":0,"end":96,"speech":"LUK-17-1"}]},"4":{"text":"Y si siete veces al día pecare contra ti, y siete veces al día se volviere á ti, diciendo, pésame, perdónale.","spans":[{"start":0,"end":109,"speech":"LUK-17-1"}]},"6":{"text":"Entonces el Señor dijo: Si tuvieseis fe como un grano de mostaza, diréis á este sicómoro: Desarráigate, y plántate en el mar; y os obedecerá.","spans":[{"start":24,"end":141,"speech":"LUK-17-6"}]},"7":{"text":"¿Y quién de vosotros tiene un siervo que ara ó apacienta, que vuelto del campo le diga luego: Pasa, siéntate á la mesa?","spans":[{"start":0,"end":119,"speech":"LUK-17-6"}]},"8":{"text":"¿No le dice antes: Adereza qué cene, y arremángate, y sírveme hasta que haya comido y bebido; y después de esto, come tú y bebe?","spans":[{"start":0,"end":128,"speech":"LUK-17-6"}]},"9":{"text":"¿Da gracias al siervo porque hizo lo que le había sido mandado? Pienso que no.","spans":[{"start":0,"end":78,"speech":"LUK-17-6"}]},"10":{"text":"Así también vosotros, cuando hubiereis hecho todo lo que os es mandado, decid: Siervos inútiles somos, porque lo que debíamos hacer, hicimos.","spans":[{"start":0,"end":141,"speech":"LUK-17-6"}]},"14":{"text":"Y como él los vió, les dijo: Id, mostraos á los sacerdotes. Y aconteció, que yendo ellos, fueron limpios.","spans":[{"start":29,"end":59,"speech":"LUK-17-14"}]},"17":{"text":"Y respondiendo Jesús, dijo: ¿No son diez los que fueron limpios? ¿Y los nueve dónde están?","spans":[{"start":28,"end":90,"speech":"LUK-17-17"}]},"18":{"text":"¿No hubo quien volviese y diese gloria á Dios sino este extranjero?","spans":[{"start":0,"end":67,"speech":"LUK-17-17"}]},"19":{"text":"Y díjole: Levántate, vete; tu fe te ha salvado.","spans":[{"start":10,"end":47,"speech":"LUK-17-19"}]},"20":{"text":"Y preguntado por los Fariseos, cuándo había de venir el reino de Dios, les respondió y dijo: El reino de Dios no vendrá con advertencia;","spans":[{"start":93,"end":136,"speech":"LUK-17-20"}]},"21":{"text":"Ni dirán: Helo aquí, ó helo allí: porque he aquí el reino de Dios entre vosotros está.","spans":[{"start":0,"end":86,"speech":"LUK-17-20"}]},"22":{"text":"Y dijo á sus discípulos: Tiempo vendrá, cuando desearéis ver uno de los días del Hijo del hombre, y no lo veréis.","spans":[{"start":25,"end":113,"speech":"LUK-17-22"}]},"23":{"text":"Y os dirán: Helo aquí, ó helo allí. No vayáis, ni sigáis.","spans":[{"start":0,"end":57,"speech":"LUK-17-22"}]},"24":{"text":"Porque como el relámpago, relampagueando desde una parte de debajo del cielo, resplandece hasta la otra debajo del cielo, así también será el Hijo del hombre en su día.","spans":[{"start":0,"end":168,"speech":"LUK-17-22"}]},"25":{"text":"Mas primero es necesario que padezca mucho, y sea reprobado de esta generación.","spans":[{"start":0,"end":79,"speech":"LUK-17-22"}]},"26":{"text":"Y como fué en los días de Noé, así también será en los días del Hijo del hombre.","spans":[{"start":0,"end":80,"speech":"LUK-17-22"}]},"27":{"text":"Comían, bebían, los hombres tomaban mujeres, y las mujeres maridos, hasta el día que entró Noé en el arca; y vino el diluvio, y destruyó á todos.","spans":[{"start":0,"end":145,"speech":"LUK-17-22"}]},"28":{"text":"Asimismo también como fué en los días de Lot; comían, bebían, compraban, vendían, plantaban, edificaban;","spans":[{"start":0,"end":104,"speech":"LUK-17-22"}]},"29":{"text":"Mas el día que Lot salió de Sodoma, llovió del cielo fuego y azufre, y destruyó á todos:","spans":[{"start":0,"end":88,"speech":"LUK-17-22"}]},"30":{"text":"Como esto será el día en que el Hijo del hombre se manifestará.","spans":[{"start":0,"end":63,"speech":"LUK-17-22"}]},"31":{"text":"En aquel día, el que estuviere en el terrado, y sus alhajas en casa, no descienda á tomarlas: y el que en el campo, asimismo no vuelva atrás.","spans":[{"start":0,"end":141,"speech":"LUK-17-22"}]},"32":{"text":"Acordaos de la mujer de Lot.","spans":[{"start":0,"end":28,"speech":"LUK-17-22"}]},"33":{"text":"Cualquiera que procurare salvar su vida, la perderá; y cualquiera que la perdiere, la salvará.","spans":[{"start":0,"end":94,"speech":"LUK-17-22"}]},"34":{"text":"Os digo que en aquella noche estarán dos en una cama; el uno será tomado, y el otro será dejado.","spans":[{"start":0,"end":96,"speech":"LUK-17-22"}]},"35":{"text":"Dos mujeres estarán moliendo juntas: la una será tomada, y la otra dejada.","spans":[{"start":0,"end":74,"speech":"LUK-17-22"}]},"36":{"text":"Dos estarán en el campo; el uno será tomado, y el otro dejado.","spans":[{"start":0,"end":62,"speech":"LUK-17-22"}]},"37":{"text":"Y respondiendo, le dicen: ¿Dónde, Señor? Y él les dijo: Donde estuviere el cuerpo, allá se juntarán también las águilas.","spans":[{"start":56,"end":120,"speech":"LUK-17-37"}]}}}
