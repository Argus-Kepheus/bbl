ker":"w","strong":"G1161","content":["entonces"]}," ",{"type":"char","marker":"w","strong":"G2036","content":["dijo"]},": ",{"type":"char","marker":"w","strong":"G3780","content":["No"]},", ",{"type":"char","marker":"w","strong":"G3962","content":["padre"]}," ",{"type":"char","marker":"w","strong":"G0011","content":["Abraham"]},": ",{"type":"char","marker":"w","strong":"G0235","content":["mas"]}," ",{"type":"char","marker":"w","strong":"G1437","content":["si"]}," ",{"type":"char","marker":"w","strong":"G5100","content":["alguno"]}," ",{"type":"char","marker":"w","strong":"G4198","content":["fuere"]}," ",{"type":"char","marker":"w","strong":"G4314","content":["á"]}," ",{"type":"char","marker":"w","strong":"G0846","content":["ellos"]}," ",{"type":"char","marker":"w","strong":"G0575","content":["de"]}," ",{"type":"char","marker":"w","strong":"G3498","content":["los muertos"]},", ",{"type":"char","marker":"w","strong":"G3340","content":["se arrepentirán"]},". ",{"type":"verse","marker":"v","eid":"LUK 16:30"},{"type":"verse","marker":"v","number":"31","sid":"LUK 16:31"},{"type":"char","marker":"w","strong":"G1161","content":["Mas"]}," ",{"type":"char","marker":"add","content":["Abraham"]}," ",{"type":"char","marker":"w","strong":"G0846","content":["le"]}," ",{"type":"char","marker":"w","strong":"G2036","content":["dijo"]},": ",{"type":"char","marker":"w","strong":"G1487","content":["Si"]}," ",{"type":"char","marker":"w","strong":"G3756","content":["no"]}," ",{"type":"char","marker":"w","strong":"G0191","content":["oyen"]}," ",{"type":"char","marker":"w","strong":"G3475","content":["á Moisés"]}," ",{"type":"char","marker":"w","strong":"G2532","content":["y"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["á los"]}," ",{"type":"char","marker":"w","strong":"G4396","content":["profetas"]},", ",{"type":"char","marker":"w","strong":"G3761","content":["tampoco"]}," ",{"type":"char","marker":"w","strong":"G3982","content":["se persuadirán"]},", ",{"type":"char","marker":"w","strong":"G1487","content":["si"]}," ",{"type":"char","marker":"w","strong":"G5100","content":["alguno"]}," ",{"type":"char","marker":"w","strong":"G0450","content":["se levantare"]}," ",{"type":"char","marker":"w","strong":"G1537","content":["de"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["los"]}," ",{"type":"char","marker":"w","strong":"G3498","content":["muertos"]},". ",{"type":"verse","marker":"v","eid":"LUK 16:31"}]}],"speech":{"1":{"text":"Y DIJO también á sus discípulos: Había un hombre rico, el cual tenía un mayordomo, y éste fué acusado delante de él como disipador de sus bienes.","spans":[{"start":33,"end":145,"speech":"LUK-16-1"}]},"2":{"text":"Y le llamó, y le dijo: ¿Qué es esto que oigo de ti? Da cuenta de tu mayordomía, porque ya no podrás más ser mayordomo.","spans":[{"start":0,"end":118,"speech":"LUK-16-1"}]},"3":{"text":"Entonces el mayordomo dijo dentro de sí: ¿Qué haré? que mi señor me quita la mayordomía. Cavar, no puedo; mendigar, tengo vergüenza.","spans":[{"start":0,"end":132,"speech":"LUK-16-1"}]},"4":{"text":"Yo sé lo que haré para que cuando fuere quitado de la mayordomía, me reciban en sus casas.","spans":[{"start":0,"end":90,"speech":"LUK-16-1"}]},"5":{"text":"Y llamando á cada uno de los deudores de su señor, dijo al primero: ¿Cuánto debes á mi señor?","spans":[{"start":0,"end":93,"speech":"LUK-16-1"}]},"6":{"text":"Y él dijo: Cien barriles de aceite. Y le dijo: Toma tu obligación, y siéntate presto, y escribe cincuenta.","spans":[{"start":0,"end":106,"speech":"LUK-16-1"}]},"7":{"text":"Después dijo á otro: ¿Y tú, cuánto debes? Y él dijo: Cien coros de trigo. Y él le dijo: Toma tu obligación, y escribe ochenta.","spans":[{"start":0,"end":126,"speech":"LUK-16-1"}]},"8":{"text":"Y alabó el señor al mayordomo malo por haber hecho discretamente; porque los hijos de este siglo son en su generación más sagaces que los hijos de luz.","spans":[{"start":0,"end":151,"speech":"LUK-16-1"}]},"9":{"text":"Y yo os digo: Haceos amigos de las riquezas de maldad, para que cuando faltareis, os reciban en las moradas eternas.","spans":[{"start":0,"end":116,"speech":"LUK-16-1"}]},"10":{"text":"El que es fiel en lo muy poco, también en lo más es fiel: y el que en lo muy poco es injusto, también en lo más es injusto.","spans":[{"start":0,"end":123,"speech":"LUK-16-1"}]},"11":{"text":"Pues si en las malas riquezas no fuisteis fieles, ¿quién os confiará lo verdadero?","spans":[{"start":0,"end":82,"speech":"LUK-16-1"}]},"12":{"text":"Y si en lo ajeno no fuisteis fieles, ¿quién os dará lo que es vuestro?","spans":[{"start":0,"end":70,"speech":"LUK-16-1"}]},"13":{"text":"Ningún siervo puede servir á dos señores; porque ó aborrecerá al uno y amará al otro, ó se allegará al uno y menospreciará al otro. No podéis servir á Dios y á las riquezas.","spans":[{"start":0,"end":173,"speech":"LUK-16-1"}]},"15":{"text":"Y díjoles: Vosotros sois los que os justificáis á vosotros mismos delante de los hombres; mas Dios conoce vuestros corazones; porque lo que los hombres tienen por sublime, delante de Dios es abominación.","spans":[{"start":11,"end":203,"speech":"LUK-16-15"}]},"16":{"text":"La ley y los profetas hasta Juan: desde entonces el reino de Dios es anunciado, y quienquiera se esfuerza á entrar en él.","spans":[{"start":0,"end":121,"speech":"LUK-16-15"}]},"17":{"text":"Empero más fácil cosa es pasar el cielo y la tierra, que frustrarse un tilde de la ley.","spans":[{"start":0,"end":87,"speech":"LUK-16-15"}]},"18":{"text":"Cualquiera que repudia á su mujer, y se casa con otra, adultera: y el que se casa con la repudiada del marido, adultera.","spans":[{"start":0,"end":120,"speech":"LUK-16-15"}]},"19":{"text":"Había un hombre rico, que se vestía de púrpura y de lino fino, y hacía cada día banquete con esplendidez.","spans":[{"start":0,"end":105,"speech":"LUK-16-15"}]},"20":{"text":"Había también un mendigo llamado Lázaro, el cual estaba echado á la puerta de él, lleno de llagas,","spans":[{"start":0,"end":98,"speech":"LUK-16-15"}]},"21":{"text":"Y deseando hartarse de las migajas que caían de la mesa del rico; y aun los perros venían y le lamían las llagas.","spans":[{"start":0,"end":113,"speech":"LUK-16-15"}]},"22":{"text":"Y aconteció que murió el mendigo, y fué llevado por los ángeles al seno de Abraham: y murió también el rico, y fué sepultado.","spans":[{"start":0,"end":125,"speech":"LUK-16-15"}]},"23":{"text":"Y en el infierno alzó sus ojos, estando en los tormentos, y vió á Abraham de lejos, y á Lázaro en su seno.","spans":[{"start":0,"end":106,"speech":"LUK-16-15"}]},"24":{"text":"Entonces él, dando voces, dijo: Padre Abraham, ten misericordia de mí, y envía á Lázaro que moje la punta de su dedo en agua, y refresque mi lengua; porque soy atormentado en esta llama.","spans":[{"start":0,"end":186,"speech":"LUK-16-15"}]},"25":{"text":"Y díjole Abraham: Hijo, acuérdate que recibiste tus bienes en tu vida, y Lázaro también males; mas ahora éste es consolado aquí, y tú atormentado.","spans":[{"start":0,"end":146,"speech":"LUK-16-15"}]},"26":{"text":"Y además de todo esto, una grande sima está constituída entre nosotros y vosotros, que los que quisieren pasar de aquí á vosotros, no pueden, ni de allá pasar acá.","spans":[{"start":0,"end":163,"speech":"LUK-16-15"}]},"27":{"text":"Y dijo: Ruégote pues, padre, que le envíes á la casa de mi padre;","spans":[{"start":0,"end":65,"speech":"LUK-16-15"}]},"28":{"text":"Porque tengo cinco hermanos; para que les testifique, porque no vengan ellos también á este lugar de tormento.","spans":[{"start":0,"end":110,"speech":"LUK-16-15"}]},"29":{"text":"Y Abraham le dice: A Moisés y á los profetas tienen: óiganlos.","spans":[{"start":0,"end":62,"speech":"LUK-16-15"}]},"30":{"text":"El entonces dijo: No, padre Abraham: mas si alguno fuere á ellos de los muertos, se arrepentirán.","spans":[{"start":0,"end":97,"speech":"LUK-16-15"}]},"31":{"text":"Mas Abraham le dijo: Si no oyen á Moisés y á los profetas, tampoco se persuadirán, si alguno se levantare de los muertos.","spans":[{"start":0,"end":121,"speech":"LUK-16-15"}]}}}
