:"w","strong":"G3777","content":["Ni"]}," ",{"type":"char","marker":"w","strong":"G1519","content":["para"]}," ",{"type":"char","marker":"w","strong":"G1093","content":["la tierra"]},", ",{"type":"char","marker":"w","strong":"G3777","content":["ni"]}," ",{"type":"char","marker":"w","strong":"G1519","content":["para"]}," ",{"type":"char","marker":"w","strong":"G2874","content":["el muladar"]}," ",{"type":"char","marker":"w","strong":"G2076","content":["es"]}," buena; ",{"type":"char","marker":"w","strong":"G1854","content":["fuera"]}," ",{"type":"char","marker":"w","strong":"G0846","content":["la"]}," ",{"type":"char","marker":"w","strong":"G0906","content":["arrojan"]},". ",{"type":"char","marker":"w","strong":"G3588","content":["Quien"]}," ",{"type":"char","marker":"w","strong":"G2192","content":["tiene"]}," ",{"type":"char","marker":"w","strong":"G3775","content":["oídos"]}," ",{"type":"char","marker":"w","strong":"G1519","content":["para"]}," ",{"type":"char","marker":"w","strong":"G0191","content":["oir"]},", ",{"type":"char","marker":"w","strong":"G0191","content":["oiga"]},". ",{"type":"verse","marker":"v","eid":"LUK 14:35"}]}],"speech":{"3":{"text":"Y respondiendo Jesús, habló á los doctores de la ley y á los Fariseos, diciendo: ¿Es lícito sanar en sábado?","spans":[{"start":81,"end":108,"speech":"LUK-14-3"}]},"5":{"text":"Y respondiendo á ellos dijo: ¿El asno ó el buey de cuál de vosotros caerá en algún pozo, y no lo sacará luego en día de sábado?","spans":[{"start":29,"end":127,"speech":"LUK-14-5"}]},"8":{"text":"Cuando fueres convidado de alguno á bodas, no te sientes en el primer lugar, no sea que otro más honrado que tú esté por él convidado,","spans":[{"start":0,"end":134,"speech":"LUK-14-8"}]},"9":{"text":"Y viniendo el que te llamó á ti y á él, te diga: Da lugar á éste: y entonces comiences con vergüenza á tener el lugar último.","spans":[{"start":0,"end":125,"speech":"LUK-14-8"}]},"10":{"text":"Mas cuando fueres convidado, ve, y siéntate en el postrer lugar; porque cuando viniere el que te llamó, te diga: Amigo, sube arriba: entonces tendrás gloria delante de los que juntamente se asientan á la mesa.","spans":[{"start":0,"end":209,"speech":"LUK-14-8"}]},"11":{"text":"Porque cualquiera que se ensalza, será humillado; y el que se humilla, será ensalzado.","spans":[{"start":0,"end":86,"speech":"LUK-14-8"}]},"12":{"text":"Y dijo también al que le había convidado: Cuando haces comida ó cena, no llames á tus amigos, ni á tus hermanos, ni á tus parientes, ni á vecinos ricos; porque también ellos no te vuelvan á convidar, y te sea hecha compensación.","spans":[{"start":42,"end":228,"speech":"LUK-14-12"}]},"13":{"text":"Mas cuando haces banquete, llama á los pobres, los mancos, los cojos, los ciegos;","spans":[{"start":0,"end":81,"speech":"LUK-14-12"}]},"14":{"text":"Y serás bienaventurado; porque no te pueden retribuir; mas te será recompensado en la resurrección de los justos.","spans":[{"start":0,"end":113,"speech":"LUK-14-12"}]},"16":{"text":"El entonces le dijo: Un hombre hizo una grande cena, y convidó á muchos.","spans":[{"start":21,"end":72,"speech":"LUK-14-16"}]},"17":{"text":"Y á la hora de la cena envió á su siervo á decir á los convidados: Venid, que ya está todo aparejado.","spans":[{"start":0,"end":101,"speech":"LUK-14-16"}]},"18":{"text":"Y comenzaron todos á una á excusarse. El primero le dijo: He comprado una hacienda, y necesito salir y verla; te ruego que me des por excusado.","spans":[{"start":0,"end":143,"speech":"LUK-14-16"}]},"19":{"text":"Y el otro dijo: He comprado cinco yuntas de bueyes, y voy á probarlos; ruégote que me des por excusado.","spans":[{"start":0,"end":103,"speech":"LUK-14-16"}]},"20":{"text":"Y el otro dijo: Acabo de casarme, y por tanto no puedo ir.","spans":[{"start":0,"end":58,"speech":"LUK-14-16"}]},"21":{"text":"Y vuelto el siervo, hizo saber estas cosas á su señor. Entonces enojado el padre de la familia, dijo á su siervo: Ve presto por las plazas y por las calles de la ciudad, y mete acá los pobres, los mancos, y cojos, y ciegos.","spans":[{"start":0,"end":223,"speech":"LUK-14-16"}]},"22":{"text":"Y dijo el siervo: Señor, hecho es como mandaste, y aun hay lugar.","spans":[{"start":0,"end":65,"speech":"LUK-14-16"}]},"23":{"text":"Y dijo el señor al siervo: Ve por los caminos y por los vallados, y fuérzalos á entrar, para que se llene mi casa.","spans":[{"start":0,"end":114,"speech":"LUK-14-16"}]},"24":{"text":"Porque os digo que ninguno de aquellos hombres que fueron llamados, gustará mi cena.","spans":[{"start":0,"end":84,"speech":"LUK-14-16"}]},"26":{"text":"Si alguno viene á mí, y no aborrece á su padre, y madre, y mujer, é hijos, y hermanos, y hermanas, y aun también su vida, no puede ser mi discípulo.","spans":[{"start":0,"end":148,"speech":"LUK-14-26"}]},"27":{"text":"Y cualquiera que no trae su cruz, y viene en pos de mí, no puede ser mi discípulo.","spans":[{"start":0,"end":82,"speech":"LUK-14-26"}]},"28":{"text":"Porque ¿cuál de vosotros, queriendo edificar una torre, no cuenta primero sentado los gastos, si tiene lo que necesita para acabarla?","spans":[{"start":0,"end":133,"speech":"LUK-14-26"}]},"29":{"text":"Porque después que haya puesto el fundamento, y no pueda acabarla, todos los que lo vieren, no comiencen á hacer burla de él,","spans":[{"start":0,"end":125,"speech":"LUK-14-26"}]},"30":{"text":"Diciendo: Este hombre comenzó á edificar, y no pudo acabar.","spans":[{"start":0,"end":59,"speech":"LUK-14-26"}]},"31":{"text":"¿O cuál rey, habiendo de ir á hacer guerra contra otro rey, sentándose primero no consulta si puede salir al encuentro con diez mil al que viene contra él con veinte mil?","spans":[{"start":0,"end":170,"speech":"LUK-14-26"}]},"32":{"text":"De otra manera, cuando aun el otro está lejos, le ruega por la paz, enviándole embajada.","spans":[{"start":0,"end":88,"speech":"LUK-14-26"}]},"33":{"text":"Así pues, cualquiera de vosotros que no renuncia á todas las cosas que posee, no puede ser mi discípulo.","spans":[{"start":0,"end":104,"speech":"LUK-14-26"}]},"34":{"text":"Buena es la sal; mas si aun la sal fuere desvanecida, ¿con qué se adobará?","spans":[{"start":0,"end":74,"speech":"LUK-14-26"}]},"35":{"text":"Ni para la tierra, ni para el muladar es buena; fuera la arrojan. Quien tiene oídos para oir, oiga.","spans":[{"start":0,"end":99,"speech":"LUK-14-26"}]}}}
