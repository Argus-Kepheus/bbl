":"EZK 46:21"},{"type":"char","marker":"w","strong":"H3318","content":["Luego me sacó"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["al"]}," ",{"type":"char","marker":"w","strong":"H2691","content":["atrio"]}," ",{"type":"char","marker":"w","strong":"H2435","content":["de afuera"]},", ",{"type":"char","marker":"w","strong":"H5674","content":["y llevome"]}," ",{"type":"char","marker":"w","strong":"H0702","content":["por los cuatro"]}," ",{"type":"char","marker":"w","strong":"H4740","content":["rincones"]}," ",{"type":"char","marker":"w","strong":"H2691","content":["del atrio"]},"; ",{"type":"char","marker":"w","strong":"H4740","content":["y en cada rincón"]}," ",{"type":"char","marker":"w","strong":"H2691","content":["había un patio"]},". ",{"type":"verse","marker":"v","eid":"EZK 46:21"},{"type":"verse","marker":"v","number":"22","sid":"EZK 46:22"},{"type":"char","marker":"w","strong":"H0705","content":["En los cuatro"]}," ",{"type":"char","marker":"w","strong":"H4740","content":["rincones"]}," ",{"type":"char","marker":"w","strong":"H2691","content":["del atrio"]}," ",{"type":"char","marker":"w","strong":"H2691","content":["había patios"]}," ",{"type":"char","marker":"w","strong":"H0702","content":["juntos de cuarenta"]}," ",{"type":"char","marker":"w","strong":"H0753","content":["codos de longitud"]},", ",{"type":"char","marker":"w","strong":"H7970","content":["y treinta"]}," ",{"type":"char","marker":"w","strong":"H7341","content":["de anchura"]},": ",{"type":"char","marker":"w","strong":"H0259","content":["tenían una"]}," ",{"type":"char","marker":"add","content":["misma"]}," ",{"type":"char","marker":"w","strong":"H4060","content":["medida"]}," ",{"type":"char","marker":"w","strong":"H0702","content":["todos cuatro"]}," ",{"type":"char","marker":"w","strong":"H4740","content":["a los rincones"]},". ",{"type":"verse","marker":"v","eid":"EZK 46:22"},{"type":"verse","marker":"v","number":"23","sid":"EZK 46:23"},{"type":"char","marker":"w","strong":"H2905","content":["Y había una pared"]}," ",{"type":"char","marker":"w","strong":"H5439","content":["alrededor"]}," de ellos, ",{"type":"char","marker":"w","strong":"H5439","content":["alrededor"]}," ",{"type":"char","marker":"w","strong":"H0702","content":["de todos cuatro"]},", ",{"type":"char","marker":"w","strong":"H8478","content":["y chimeneas hechas abajo"]}," ",{"type":"char","marker":"w","strong":"H5439","content":["alrededor"]}," ",{"type":"char","marker":"w","strong":"H2918","content":["de las paredes"]},". ",{"type":"verse","marker":"v","eid":"EZK 46:23"},{"type":"verse","marker":"v","number":"24","sid":"EZK 46:24"},{"type":"char","marker":"w","strong":"H0559","content":["Y díjome"]},": ",{"type":"char","marker":"w","strong":"H0428","content":["Estos"]}," ",{"type":"char","marker":"w","strong":"H1310","content":["son los aposentos de los cocineros"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["donde"]}," ",{"type":"char","marker":"w","strong":"H8334","content":["los servidores"]}," ",{"type":"char","marker":"w","strong":"H1004","content":["de la casa"]}," ",{"type":"char","marker":"w","strong":"H1310","content":["cocerán"]}," ",{"type":"char","marker":"w","strong":"H2077","content":["el sacrificio"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["del pueblo"]},". ",{"type":"verse","marker":"v","eid":"EZK 46:24"}]}],"speech":{"1":{"text":"ASÍ ha dicho el Señor Jehová: La puerta del atrio de adentro que mira al oriente, estará cerrada los seis días de trabajo, y el día del sábado se abrirá: abrirase también el día de la nueva luna.","spans":[{"start":0,"end":195,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"2":{"text":"Y el príncipe entrará por el camino del portal de la puerta de afuera, y estará al umbral de la puerta, mientras los sacerdotes harán su holocausto y sus pacíficos, y adorará a la entrada de la puerta: después saldrá; mas no se cerrará la puerta hasta la tarde.","spans":[{"start":0,"end":261,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"3":{"text":"Asimismo adorará el pueblo de la tierra delante de Jehová, a la entrada de la puerta, en los sábados y en las nuevas lunas.","spans":[{"start":0,"end":123,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"4":{"text":"Y el holocausto que el príncipe ofrecerá a Jehová el día del sábado, será seis corderos sin defecto, y un carnero sin tacha:","spans":[{"start":0,"end":124,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"5":{"text":"Y por presente un epha con cada carnero; y con cada cordero un presente, don de su mano, y un hin de aceite con el epha.","spans":[{"start":0,"end":120,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"6":{"text":"Mas el día de la nueva luna, un becerro sin tacha de la vacada, y seis corderos, y un carnero: deberán ser sin defecto.","spans":[{"start":0,"end":119,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"7":{"text":"Y hará presente de un epha con el becerro, y un epha con cada carnero: mas con los corderos, conforme a su facultad; y un hin de aceite por cada epha.","spans":[{"start":0,"end":150,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"8":{"text":"Y cuando el príncipe entrare, entrará por el camino del portal de la puerta: y por el mismo camino saldrá.","spans":[{"start":0,"end":106,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"9":{"text":"Mas cuando el pueblo de la tierra entrare delante de Jehová en las fiestas, el que entrare por la puerta del norte, saldrá por la puerta del mediodía; y el que entrare por la puerta del mediodía, saldrá por la puerta del norte: no volverá por la puerta por donde entró, sino que saldrá por la de enfrente de ella.","spans":[{"start":0,"end":313,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"10":{"text":"Y el príncipe, cuando ellos entraren, él entrará en medio de ellos: y cuando ellos salieren, él saldrá.","spans":[{"start":0,"end":103,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"11":{"text":"Y en las fiestas y en las solemnidades será el presente un epha con cada becerro, y un epha con cada carnero; y con los corderos, lo que le pareciere; y un hin de aceite con cada epha.","spans":[{"start":0,"end":184,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"12":{"text":"Mas cuando el príncipe libremente hiciere holocausto o pacíficos a Jehová, abriranle la puerta que mira al oriente, y hará su holocausto y sus pacíficos, como hace en el día del sábado: después saldrá; y cerrarán la puerta después que saliere.","spans":[{"start":0,"end":243,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"13":{"text":"Y sacrificarás a Jehová cada día en holocausto un cordero de un año sin defecto, cada mañana lo sacrificarás.","spans":[{"start":0,"end":109,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"14":{"text":"Y con él harás todas las mañanas presente de la sexta parte de un epha, y la tercera parte de un hin de aceite para mezclar con la flor de harina: presente para Jehová continuamente por estatuto perpetuo.","spans":[{"start":0,"end":204,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"15":{"text":"Ofrecerán pues el cordero, y el presente y el aceite, todas las mañanas en holocausto continuo.","spans":[{"start":0,"end":95,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"16":{"text":"Así ha dicho el Señor Jehová: Si el príncipe diere algún don de su heredad a alguno de sus hijos, será de ellos; posesión de ellos será por herencia.","spans":[{"start":0,"end":149,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"17":{"text":"Mas si de su heredad diere don a alguno de sus siervos, será de él hasta el año de libertad, y volverá al príncipe; mas su herencia será de sus hijos.","spans":[{"start":0,"end":150,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]},"18":{"text":"Y el príncipe no tomará nada de la herencia del pueblo, por no defraudarlos de su posesión: de lo que él posee dará herencia a sus hijos; para que mi pueblo no sea echado cada uno de su posesión.","spans":[{"start":0,"end":195,"speech":"EZK-46-1-18-jehovah","speaker":"jehovah"}]}}}
