er":"w","strong":"H1992","content":["a ellos"]}," ",{"type":"char","marker":"w","strong":"H0430","content":["por Dios"]},", ",{"type":"char","marker":"w","strong":"H1992","content":["y ellos"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["me serán"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["por pueblo"]},". ",{"type":"verse","marker":"v","eid":"EZK 37:27"},{"type":"verse","marker":"v","number":"28","sid":"EZK 37:28"},{"type":"char","marker":"w","strong":"H3045","content":["Y sabrán"]}," ",{"type":"char","marker":"w","strong":"H1471","content":["las gentes"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["Jehová"]}," ",{"type":"char","marker":"w","strong":"H6942","content":["santifico"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["a Israel"]},", ",{"type":"char","marker":"w","strong":"H0589","content":["estando mi"]}," ",{"type":"char","marker":"w","strong":"H4720","content":["santuario"]}," ",{"type":"char","marker":"w","strong":"H8432","content":["entre"]}," ",{"type":"char","marker":"w","strong":"H5769","content":["ellos para siempre"]},". ",{"type":"verse","marker":"v","eid":"EZK 37:28"}]}],"speech":{"3":{"text":"Y díjome: Hijo del hombre, ¿vivirán estos huesos? Y dije: Señor Jehová, tú lo sabes.","spans":[{"start":10,"end":49,"speech":"EZK-37-3-6-jehovah","speaker":"jehovah"}]},"4":{"text":"Díjome entonces: Profetiza sobre estos huesos, y diles: Huesos secos, oíd palabra de Jehová.","spans":[{"start":17,"end":92,"speech":"EZK-37-3-6-jehovah","speaker":"jehovah"}]},"5":{"text":"Así ha dicho el Señor Jehová a estos huesos: He aquí, yo hago entrar espíritu en vosotros, y viviréis.","spans":[{"start":0,"end":102,"speech":"EZK-37-3-6-jehovah","speaker":"jehovah"}]},"6":{"text":"Y pondré nervios sobre vosotros, y haré subir sobre vosotros carne, y os cubriré de piel, y pondré en vosotros espíritu, y viviréis; y sabréis que yo soy Jehová.","spans":[{"start":0,"end":161,"speech":"EZK-37-3-6-jehovah","speaker":"jehovah"}]},"9":{"text":"Y díjome: Profetiza al espíritu, profetiza, hijo del hombre, y di al espíritu: Así ha dicho el Señor Jehová: Espíritu, ven de los cuatro vientos, y sopla sobre estos muertos, y vivirán.","spans":[{"start":10,"end":185,"speech":"EZK-37-9-9-jehovah","speaker":"jehovah"}]},"11":{"text":"Díjome luego: Hijo del hombre, todos estos huesos son la casa de Israel. He aquí, ellos dicen: Nuestros huesos se secaron, y pereció nuestra esperanza, y somos del todo talados.","spans":[{"start":14,"end":177,"speech":"EZK-37-11-14-jehovah","speaker":"jehovah"}]},"12":{"text":"Por tanto profetiza, y diles: Así ha dicho el Señor Jehová: He aquí, yo abro vuestros sepulcros, pueblo mío, y os haré subir de vuestras sepulturas, y os traeré a la tierra de Israel.","spans":[{"start":0,"end":183,"speech":"EZK-37-11-14-jehovah","speaker":"jehovah"}]},"13":{"text":"Y sabréis que yo soy Jehová, cuando abriere vuestros sepulcros, y os sacare de vuestras sepulturas, pueblo mío.","spans":[{"start":0,"end":111,"speech":"EZK-37-11-14-jehovah","speaker":"jehovah"}]},"14":{"text":"Y pondré mi espíritu en vosotros, y viviréis, y os haré reposar sobre vuestra tierra; y sabréis que yo Jehová hablé, y lo hice, dice Jehová.","spans":[{"start":0,"end":127,"speech":"EZK-37-11-14-jehovah","speaker":"jehovah"}]},"16":{"text":"Tú, hijo del hombre, tómate ahora un palo, y escribe en él: A Judá, y a los hijos de Israel sus compañeros. Toma después otro palo, y escribe en él: A José, palo de Ephraim, y a toda la casa de Israel sus compañeros.","spans":[{"start":0,"end":216,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"17":{"text":"Júntalos luego el uno con el otro, para que sean en uno, y serán uno en tu mano.","spans":[{"start":0,"end":80,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"18":{"text":"Y cuando te hablaren los hijos de tu pueblo, diciendo: ¿No nos enseñarás qué te propones con eso?","spans":[{"start":0,"end":97,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"19":{"text":"Diles: Así ha dicho el Señor Jehová: He aquí, yo tomo el palo de José que está en la mano de Ephraim, y a las tribus de Israel sus compañeros, y pondrelos con él, con el palo de Judá, y harelos un palo, y serán uno en mi mano.","spans":[{"start":0,"end":226,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"20":{"text":"Y los palos sobre que escribieres, estarán en tu mano delante de sus ojos;","spans":[{"start":0,"end":74,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"21":{"text":"Y les dirás: Así ha dicho el Señor Jehová: He aquí, yo tomo a los hijos de Israel de entre las gentes a las cuales fueron, y los juntaré de todas partes, y los traeré a su tierra:","spans":[{"start":0,"end":179,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"22":{"text":"Y los haré una nación en la tierra, en los montes de Israel; y un rey será a todos ellos por rey: y nunca más serán dos naciones, ni nunca más serán divididos en dos reinos:","spans":[{"start":0,"end":173,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"23":{"text":"Ni más se contaminarán con sus ídolos, y con sus abominaciones, y con todas sus rebeliones: y los salvaré de todas sus habitaciones en las cuales pecaron, y los limpiaré; y me serán por pueblo, y yo a ellos por Dios.","spans":[{"start":0,"end":216,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"24":{"text":"Y mi siervo David será rey sobre ellos, y a todos ellos será un pastor: y andarán en mis derechos, y mis ordenanzas guardarán, y las pondrán por obra.","spans":[{"start":0,"end":150,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"25":{"text":"Y habitarán en la tierra que di a mi siervo Jacob, en la cual habitaron vuestros padres; en ella habitarán ellos, y sus hijos, y los hijos de sus hijos para siempre; y mi siervo David les será príncipe para siempre.","spans":[{"start":0,"end":215,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"26":{"text":"Y concertaré con ellos pacto de paz, perpetuo pacto será con ellos: y los asentaré, y los multiplicaré, y pondré mi santuario entre ellos para siempre.","spans":[{"start":0,"end":151,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"27":{"text":"Y estará en ellos mi tabernáculo, y seré a ellos por Dios, y ellos me serán por pueblo.","spans":[{"start":0,"end":87,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]},"28":{"text":"Y sabrán las gentes que yo Jehová santifico a Israel, estando mi santuario entre ellos para siempre.","spans":[{"start":0,"end":100,"speech":"EZK-37-16-28-jehovah","speaker":"jehovah"}]}}}
