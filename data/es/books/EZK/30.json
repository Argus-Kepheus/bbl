:"H0894","content":["de Babilonia"]},", ",{"type":"char","marker":"w","strong":"H2220","content":["y los brazos"]}," ",{"type":"char","marker":"w","strong":"H6547","content":["de Faraón"]}," ",{"type":"char","marker":"w","strong":"H5307","content":["caerán"]},"; ",{"type":"char","marker":"w","strong":"H3045","content":["y sabrán"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["soy Jehová"]},", ",{"type":"char","marker":"w","strong":"H0589","content":["cuando yo"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["pusiere mi"]}," ",{"type":"char","marker":"w","strong":"H2719","content":["espada"]}," ",{"type":"char","marker":"w","strong":"H3027","content":["en la mano"]}," ",{"type":"char","marker":"w","strong":"H4428","content":["del rey"]}," ",{"type":"char","marker":"w","strong":"H0894","content":["de Babilonia"]},", ",{"type":"char","marker":"w","strong":"H0776","content":["y él la extendiere sobre la tierra"]}," ",{"type":"char","marker":"w","strong":"H4714","content":["de Egipto"]},". ",{"type":"verse","marker":"v","eid":"EZK 30:25"},{"type":"verse","marker":"v","number":"26","sid":"EZK 30:26"},{"type":"char","marker":"w","strong":"H6327","content":["Y esparciré"]}," ",{"type":"char","marker":"w","strong":"H4714","content":["los Egipcios"]}," ",{"type":"char","marker":"w","strong":"H1471","content":["entre las gentes"]},", ",{"type":"char","marker":"w","strong":"H2219","content":["y los aventaré"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["por las tierras"]},"; ",{"type":"char","marker":"w","strong":"H3045","content":["y sabrán"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["soy Jehová"]},". ",{"type":"verse","marker":"v","eid":"EZK 30:26"}]}],"speech":{"2":{"text":"Hijo del hombre, profetiza, y di: Así ha dicho el Señor Jehová: Aullad: ¡Ay del día!","spans":[{"start":0,"end":84,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"3":{"text":"Porque cerca está el día, cerca está el día del Señor; día de nublado, día de las gentes será.","spans":[{"start":0,"end":94,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"4":{"text":"Y vendrá espada a Egipto, y habrá miedo en Etiopía, cuando caerán heridos en Egipto; y tomarán su multitud, y serán destruidos sus fundamentos.","spans":[{"start":0,"end":143,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"5":{"text":"Etiopía, y Libia, y Lidia, y todo el conjunto de pueblo, y Chûb, y los hijos de la tierra de la liga, caerán con ellos a cuchillo.","spans":[{"start":0,"end":130,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"6":{"text":"Así ha dicho Jehová: También caerán los que sostienen a Egipto, y la altivez de su fortaleza caerá: desde Migdol hasta Seveneh caerán en él a cuchillo, dice el Señor Jehová.","spans":[{"start":0,"end":151,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"7":{"text":"Y serán asolados entre las tierras asoladas, y sus ciudades serán entre las ciudades desiertas.","spans":[{"start":0,"end":95,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"8":{"text":"Y sabrán que yo soy Jehová, cuando pusiere fuego a Egipto, y fueren quebrantados todos sus ayudadores.","spans":[{"start":0,"end":102,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"9":{"text":"En aquel tiempo saldrán mensajeros de delante de mí en navíos, a espantar a Etiopía la confiada, y tendrán espanto como en el día de Egipto: porque he aquí viene.","spans":[{"start":0,"end":162,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"10":{"text":"Así ha dicho el Señor Jehová: Haré cesar la multitud de Egipto por mano de Nabucodonosor, rey de Babilonia.","spans":[{"start":0,"end":107,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"11":{"text":"El, y con él su pueblo, los más fuertes de las gentes, serán traídos a destruir la tierra: y desenvainarán sus espadas sobre Egipto, y henchirán la tierra de muertos.","spans":[{"start":0,"end":166,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"12":{"text":"Y secaré los ríos, y entregaré la tierra en manos de malos, y destruiré la tierra y su plenitud por mano de extranjeros: yo Jehová he hablado.","spans":[{"start":0,"end":142,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"13":{"text":"Así ha dicho el Señor Jehová: Destruiré también las imágenes, y haré cesar los ídolos de Memphis; y no habrá más príncipe de la tierra de Egipto, y en la tierra de Egipto pondré temor.","spans":[{"start":0,"end":184,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"14":{"text":"Y asolaré a Patros, y pondré fuego a Zoán, y haré juicios en No.","spans":[{"start":0,"end":64,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"15":{"text":"Y derramaré mi ira sobre Sin, fortaleza de Egipto, y talaré la multitud de No.","spans":[{"start":0,"end":78,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"16":{"text":"Y pondré fuego a Egipto; Sin tendrá gran dolor, y No será destrozada, y Memphis tendrá continuas angustias.","spans":[{"start":0,"end":107,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"17":{"text":"Los mancebos de Avén y de Pibeseth caerán a cuchillo; y ellas irán en cautiverio.","spans":[{"start":0,"end":81,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"18":{"text":"Y en Tehaphnes será cerrado el día, cuando quebrantaré yo allí las barras de Egipto, y cesará en ella la soberbia de su fortaleza: nublado la cubrirá, y los moradores de sus aldeas irán en cautiverio.","spans":[{"start":0,"end":200,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"19":{"text":"Haré pues juicios en Egipto y sabrán que yo soy Jehová.","spans":[{"start":0,"end":55,"speech":"EZK-30-2-19-jehovah","speaker":"jehovah"}]},"21":{"text":"Hijo del hombre, quebrantado he el brazo de Faraón rey de Egipto; y he aquí que no ha sido vendado poniéndole medicinas, poniéndole faja para ligarlo, a fin de vigorizarle para que pueda tener espada.","spans":[{"start":0,"end":200,"speech":"EZK-30-21-26-jehovah","speaker":"jehovah"}]},"22":{"text":"Por tanto, así ha dicho el Señor Jehová: Heme aquí contra Faraón rey de Egipto, y quebraré sus brazos, el fuerte y el fracturado, y haré que la espada se le caiga de la mano.","spans":[{"start":0,"end":174,"speech":"EZK-30-21-26-jehovah","speaker":"jehovah"}]},"23":{"text":"Y esparciré los Egipcios entre las gentes, y aventarelos por las tierras.","spans":[{"start":0,"end":73,"speech":"EZK-30-21-26-jehovah","speaker":"jehovah"}]},"24":{"text":"Y fortificaré los brazos del rey de Babilonia, y pondré mi espada en su mano; mas quebraré los brazos de Faraón, y delante de aquel gemirá con gemidos de herido de muerte.","spans":[{"start":0,"end":171,"speech":"EZK-30-21-26-jehovah","speaker":"jehovah"}]},"25":{"text":"Fortificaré pues los brazos del rey de Babilonia, y los brazos de Faraón caerán; y sabrán que yo soy Jehová, cuando yo pusiere mi espada en la mano del rey de Babilonia, y él la extendiere sobre la tierra de Egipto.","spans":[{"start":0,"end":215,"speech":"EZK-30-21-26-jehovah","speaker":"jehovah"}]},"26":{"text":"Y esparciré los Egipcios entre las gentes, y los aventaré por las tierras; y sabrán que yo soy Jehová.","spans":[{"start":0,"end":102,"speech":"EZK-30-21-26-jehovah","speaker":"jehovah"}]}}}
