type":"char","marker":"w","strong":"H0784","content":["y fuego"]}," ",{"type":"char","marker":"w","strong":"H0398","content":["los consumirá"]},"; ",{"type":"char","marker":"w","strong":"H3045","content":["y sabréis"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["soy Jehová"]},", ",{"type":"char","marker":"w","strong":"H7760","content":["cuando pusiere"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["mi"]}," ",{"type":"char","marker":"w","strong":"H6440","content":["rostro"]}," contra ellos. ",{"type":"verse","marker":"v","eid":"EZK 15:7"},{"type":"verse","marker":"v","number":"8","sid":"EZK 15:8"},{"type":"char","marker":"w","strong":"H5414","content":["Y tornaré"]}," ",{"type":"char","marker":"w","strong":"H0776","content":["la tierra"]}," ",{"type":"char","marker":"w","strong":"H8077","content":["en asolamiento"]},", ",{"type":"char","marker":"w","strong":"H3282","content":["por"]}," ",{"type":"char","marker":"w","strong":"H4604","content":["cuanto cometieron"]}," ",{"type":"char","marker":"w","strong":"H4603","content":["prevaricación"]},", ",{"type":"char","marker":"w","strong":"H5002","content":["dice"]}," ",{"type":"char","marker":"w","strong":"H0136","content":["el Señor"]}," ",{"type":"char","marker":"w","strong":"H3069","content":["Jehová"]},". ",{"type":"verse","marker":"v","eid":"EZK 15:8"}]}],"speech":{"2":{"text":"Hijo del hombre, ¿qué es el palo de la vid más que todo palo? ¿Qué es el sarmiento entre los maderos del bosque?","spans":[{"start":0,"end":112,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]},"3":{"text":"¿Tomarán de él madera para hacer alguna obra? ¿Tomarán de él una estaca para colgar de ella algún vaso?","spans":[{"start":0,"end":103,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]},"4":{"text":"He aquí, que es puesto en el fuego para ser consumido; sus dos cabos consumió el fuego, y la parte del medio se quemó; ¿aprovechará para obra alguna?","spans":[{"start":0,"end":149,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]},"5":{"text":"He aquí que cuando estaba entero no era para obra alguna: ¿cuánto menos después que el fuego lo hubiere consumido, y fuere quemado? ¿Será más para alguna obra?","spans":[{"start":0,"end":159,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]},"6":{"text":"Por tanto, así ha dicho el Señor Jehová: Como el palo de la vid entre los maderos del bosque, el cual di al fuego para que lo consuma, así haré a los moradores de Jerusalem.","spans":[{"start":0,"end":173,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]},"7":{"text":"Y pondré mi rostro contra ellos; de fuego salieron, y fuego los consumirá; y sabréis que yo soy Jehová, cuando pusiere mi rostro contra ellos.","spans":[{"start":0,"end":142,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]},"8":{"text":"Y tornaré la tierra en asolamiento, por cuanto cometieron prevaricación, dice el Señor Jehová.","spans":[{"start":0,"end":72,"speech":"EZK-15-2-8-jehovah","speaker":"jehovah"}]}}}
