ype":"char","marker":"w","strong":"H1870","content":["vuestros caminos"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H8505","content":["son derechos"]},". ",{"type":"verse","marker":"v","eid":"EZK 18:29"},{"type":"verse","marker":"v","number":"30","sid":"EZK 18:30"},{"type":"char","marker":"w","strong":"H3651","content":["Por tanto"]},", ",{"type":"char","marker":"w","strong":"H8199","content":["yo os juzgaré"]}," ",{"type":"char","marker":"w","strong":"H0376","content":["a cada uno"]}," ",{"type":"char","marker":"w","strong":"H1870","content":["según sus caminos"]},", ",{"type":"char","marker":"w","strong":"H1004","content":["oh casa"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]},", ",{"type":"char","marker":"w","strong":"H5002","content":["dice"]}," ",{"type":"char","marker":"w","strong":"H0136","content":["el Señor"]}," ",{"type":"char","marker":"w","strong":"H3069","content":["Jehová"]},". ",{"type":"char","marker":"w","strong":"H7725","content":["Convertíos"]},", ",{"type":"char","marker":"w","strong":"H3605","content":["y volveos de todas"]}," ",{"type":"char","marker":"w","strong":"H6588","content":["vuestras iniquidades"]},"; ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["os será"]}," ",{"type":"char","marker":"w","strong":"H5771","content":["la iniquidad"]}," ",{"type":"char","marker":"w","strong":"H4383","content":["causa de ruina"]},". ",{"type":"verse","marker":"v","eid":"EZK 18:30"},{"type":"verse","marker":"v","number":"31","sid":"EZK 18:31"},{"type":"char","marker":"w","strong":"H7993","content":["Echad"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["de vosotros todas"]}," ",{"type":"char","marker":"w","strong":"H6588","content":["vuestras iniquidades"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["con que"]}," ",{"type":"char","marker":"w","strong":"H6586","content":["habéis prevaricado"]},", ",{"type":"char","marker":"w","strong":"H6213","content":["y haceos"]}," ",{"type":"char","marker":"w","strong":"H3820","content":["corazón"]}," ",{"type":"char","marker":"w","strong":"H2319","content":["nuevo"]}," ",{"type":"char","marker":"w","strong":"H7307","content":["y espíritu"]}," ",{"type":"char","marker":"w","strong":"H2319","content":["nuevo"]},". ¿",{"type":"char","marker":"w","strong":"H4100","content":["Y por qué"]}," ",{"type":"char","marker":"w","strong":"H4191","content":["moriréis"]},", ",{"type":"char","marker":"w","strong":"H1004","content":["casa"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]},"? ",{"type":"verse","marker":"v","eid":"EZK 18:31"},{"type":"verse","marker":"v","number":"32","sid":"EZK 18:32"},{"type":"char","marker":"w","strong":"H3808","content":["Que no"]}," ",{"type":"char","marker":"w","strong":"H2654","content":["quiero"]}," ",{"type":"char","marker":"w","strong":"H4191","content":["la muerte"]}," ",{"type":"char","marker":"w","strong":"H4191","content":["del que muere"]},", ",{"type":"char","marker":"w","strong":"H5002","content":["dice"]}," ",{"type":"char","marker":"w","strong":"H0136","content":["el Señor"]}," ",{"type":"char","marker":"w","strong":"H3069","content":["Jehová"]},"; ",{"type":"char","marker":"w","strong":"H7725","content":["convertíos"]}," pues, ",{"type":"char","marker":"w","strong":"H2421","content":["y viviréis"]},". ",{"type":"verse","marker":"v","eid":"EZK 18:32"}]}],"speech":{"2":{"text":"¿Qué pensáis vosotros, vosotros que usáis este refrán sobre la tierra de Israel, diciendo: Los padres comieron el agraz, y los dientes de los hijos tienen la dentera?","spans":[{"start":0,"end":166,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"3":{"text":"Vivo yo, dice el Señor Jehová, que nunca más tendréis por qué usar este refrán en Israel.","spans":[{"start":0,"end":8,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"},{"start":31,"end":89,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"4":{"text":"He aquí que todas las almas son mías; como el alma del padre, así el alma del hijo es mía; el alma que pecare, esa morirá.","spans":[{"start":0,"end":122,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"5":{"text":"Y el hombre que fuere justo, e hiciere juicio y justicia;","spans":[{"start":0,"end":57,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"6":{"text":"Que no comiere sobre los montes, ni alzare sus ojos a los ídolos de la casa de Israel, ni violare la mujer de su prójimo, ni llegare a la mujer menstruosa,","spans":[{"start":0,"end":155,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"7":{"text":"Ni oprimiere a ninguno; al deudor tornare su prenda, no cometiere robo, diere de su pan al hambriento, y cubriere al desnudo con vestido,","spans":[{"start":0,"end":137,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"8":{"text":"No diere a logro, ni recibiere aumento; de la maldad retrajere su mano, e hiciere juicio de verdad entre hombre y hombre,","spans":[{"start":0,"end":121,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"9":{"text":"En mis ordenanzas caminare, y guardare mis derechos para hacer verdad, este es justo: este vivirá, dice el Señor Jehová.","spans":[{"start":0,"end":98,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"10":{"text":"Mas si engendrare hijo ladrón, derramador de sangre, o que haga alguna cosa de estas,","spans":[{"start":0,"end":85,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"11":{"text":"Y que no haga las otras; antes comiere sobre los montes, o violare la mujer de su prójimo,","spans":[{"start":0,"end":90,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"12":{"text":"Al pobre y menesteroso oprimiere, cometiere robos, no tornare la prenda, o alzare sus ojos a los ídolos, e hiciere abominación,","spans":[{"start":0,"end":127,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"13":{"text":"Diere a usura, y recibiere aumento: ¿vivirá este? No vivirá. Todas estas abominaciones hizo; de cierto morirá; su sangre será sobre él.","spans":[{"start":0,"end":135,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"14":{"text":"Pero si este engendrare hijo, el cual viere todos los pecados que su padre hizo, y viéndolos no hiciere según ellos:","spans":[{"start":0,"end":116,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"15":{"text":"No comiere sobre los montes, ni alzare sus ojos a los ídolos de la casa de Israel; la mujer de su prójimo no violare,","spans":[{"start":0,"end":117,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"16":{"text":"Ni oprimiere a nadie; la prenda no empeñare, ni cometiere robos; al hambriento diere de su pan, y cubriere de vestido al desnudo;","spans":[{"start":0,"end":129,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"17":{"text":"Apartare su mano del pobre, usura ni aumento no recibiere; hiciere mis derechos, y anduviere en mis ordenanzas, este no morirá por la maldad de su padre; de cierto vivirá.","spans":[{"start":0,"end":171,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"18":{"text":"Su padre, por cuanto hizo agravio, despojó violentamente al hermano, e hizo en medio de su pueblo lo que no es bueno, he aquí que él morirá por su maldad.","spans":[{"start":0,"end":154,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"19":{"text":"Y si dijereis: ¿Por qué el hijo no llevará por el pecado de su padre? Porque el hijo hizo juicio y justicia, guardó todas mis ordenanzas, y las hizo, de cierto vivirá.","spans":[{"start":0,"end":167,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"20":{"text":"El alma que pecare, esa morirá: el hijo no llevará por el pecado del padre, ni el padre llevará por el pecado del hijo: la justicia del justo será sobre él, y la impiedad del impío será sobre él.","spans":[{"start":0,"end":195,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"21":{"text":"Mas el impío, si se apartare de todos sus pecados que hizo, y guardare todas mis ordenanzas, e hiciere juicio y justicia, de cierto vivirá; no morirá.","spans":[{"start":0,"end":150,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"22":{"text":"Todas sus rebeliones que cometió, no le serán recordadas: en su justicia que hizo vivirá.","spans":[{"start":0,"end":89,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"23":{"text":"¿Quiero yo la muerte del impío? dice el Señor Jehová. ¿No vivirá, si se apartare de sus caminos?","spans":[{"start":0,"end":31,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"},{"start":54,"end":96,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"24":{"text":"Mas si el justo se apartare de su justicia, y cometiere maldad, e hiciere conforme a todas las abominaciones que el impío hizo, ¿vivirá él? Todas las justicias que hizo no vendrán en memoria; por su rebelión con que prevaricó, y por su pecado que cometió, por ello morirá.","spans":[{"start":0,"end":272,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"25":{"text":"Y si dijereis: No es derecho el camino del Señor: oíd ahora, casa de Israel: ¿No es derecho mi camino? ¿No son vuestros caminos torcidos?","spans":[{"start":0,"end":137,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"26":{"text":"Apartándose el justo de su justicia, y haciendo iniquidad, él morirá por ello: por su iniquidad que hizo, morirá.","spans":[{"start":0,"end":113,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"27":{"text":"Y apartándose el impío de su impiedad que hizo, y haciendo juicio y justicia, hará vivir su alma.","spans":[{"start":0,"end":97,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"28":{"text":"Porque miró, y apartose de todas sus prevaricaciones que hizo, de cierto vivirá, no morirá.","spans":[{"start":0,"end":91,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"29":{"text":"Si aun dijere la casa de Israel: No es derecho el camino del Señor: ¿No son derechos mis caminos, casa de Israel? Cierto, vuestros caminos no son derechos.","spans":[{"start":0,"end":155,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"30":{"text":"Por tanto, yo os juzgaré a cada uno según sus caminos, oh casa de Israel, dice el Señor Jehová. Convertíos, y volveos de todas vuestras iniquidades; y no os será la iniquidad causa de ruina.","spans":[{"start":0,"end":73,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"},{"start":96,"end":190,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"31":{"text":"Echad de vosotros todas vuestras iniquidades con que habéis prevaricado, y haceos corazón nuevo y espíritu nuevo. ¿Y por qué moriréis, casa de Israel?","spans":[{"start":0,"end":150,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]},"32":{"text":"Que no quiero la muerte del que muere, dice el Señor Jehová; convertíos pues, y viviréis.","spans":[{"start":0,"end":38,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"},{"start":61,"end":89,"speech":"EZK-18-2-32-jehovah","speaker":"jehovah"}]}}}
