r":"v","eid":"EZK 14:20"},{"type":"verse","marker":"v","number":"21","sid":"EZK 14:21"},{"type":"char","marker":"w","strong":"H3588","content":["Por lo cual así"]}," ",{"type":"char","marker":"w","strong":"H3541","content":["ha"]}," ",{"type":"char","marker":"w","strong":"H0559","content":["dicho"]}," ",{"type":"char","marker":"w","strong":"H0136","content":["el Señor"]}," ",{"type":"char","marker":"w","strong":"H3069","content":["Jehová"]},": ¿",{"type":"char","marker":"w","strong":"H0637","content":["Cuánto más"]},", ",{"type":"char","marker":"w","strong":"H0702","content":["si mis cuatro"]}," ",{"type":"char","marker":"w","strong":"H8201","content":["malos juicios"]},", ",{"type":"char","marker":"w","strong":"H2719","content":["espada"]},", ",{"type":"char","marker":"w","strong":"H7458","content":["y hambre"]},", y mala bestia, ",{"type":"char","marker":"w","strong":"H1698","content":["y pestilencia"]},", ",{"type":"char","marker":"w","strong":"H7971","content":["enviare"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["contra"]}," ",{"type":"char","marker":"w","strong":"H3389","content":["Jerusalem"]},", ",{"type":"char","marker":"w","strong":"H3772","content":["para talar"]}," ",{"type":"char","marker":"w","strong":"H4480","content":["de ella"]}," ",{"type":"char","marker":"w","strong":"H0120","content":["hombres"]}," ",{"type":"char","marker":"w","strong":"H0929","content":["y bestias"]},"? ",{"type":"verse","marker":"v","eid":"EZK 14:21"},{"type":"verse","marker":"v","number":"22","sid":"EZK 14:22"}," Sin embargo, ",{"type":"char","marker":"w","strong":"H2009","content":["he aquí"]}," ",{"type":"char","marker":"w","strong":"H3498","content":["quedarán"]}," ",{"type":"char","marker":"w","strong":"H6413","content":["en ella algunos residuos"]},", ",{"type":"char","marker":"w","strong":"H1121","content":["hijos"]}," ",{"type":"char","marker":"w","strong":"H1323","content":["e hijas"]},", ",{"type":"char","marker":"w","strong":"H3318","content":["que serán llevados"]}," fuera: ",{"type":"char","marker":"w","strong":"H2009","content":["he aquí"]}," ",{"type":"char","marker":"w","strong":"H3318","content":["que ellos entrarán"]}," ",{"type":"char","marker":"w","strong":"H0413","content":["a"]}," vosotros, ",{"type":"char","marker":"w","strong":"H7200","content":["y veréis"]}," ",{"type":"char","marker":"w","strong":"H1870","content":["su camino"]}," ",{"type":"char","marker":"w","strong":"H5949","content":["y sus hechos"]},"; ",{"type":"char","marker":"w","strong":"H5162","content":["y tomaréis consolación"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["del"]}," ",{"type":"char","marker":"w","strong":"H7451","content":["mal"]}," ",{"type":"char","marker":"w","strong":"H0935","content":["que hice venir"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["sobre"]}," ",{"type":"char","marker":"w","strong":"H3389","content":["Jerusalem"]},", ",{"type":"char","marker":"w","strong":"H3605","content":["de todas"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["las cosas que"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["traje sobre"]}," ella. ",{"type":"verse","marker":"v","eid":"EZK 14:22"},{"type":"verse","marker":"v","number":"23","sid":"EZK 14:23"},{"type":"char","marker":"w","strong":"H3588","content":["Y consolaros han cuando"]}," ",{"type":"char","marker":"w","strong":"H7200","content":["viereis"]}," ",{"type":"char","marker":"w","strong":"H1870","content":["su camino"]}," ",{"type":"char","marker":"w","strong":"H5949","content":["y sus hechos"]},", ",{"type":"char","marker":"w","strong":"H3045","content":["y conoceréis"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H2600","content":["sin causa"]}," ",{"type":"char","marker":"w","strong":"H6213","content":["hice"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todo"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["lo que"]}," ",{"type":"char","marker":"w","strong":"H6213","content":["habré hecho"]}," en ella, ",{"type":"char","marker":"w","strong":"H5002","content":["dice"]}," ",{"type":"char","marker":"w","strong":"H0136","content":["el Señor"]}," ",{"type":"char","marker":"w","strong":"H3069","content":["Jehová"]},". ",{"type":"verse","marker":"v","eid":"EZK 14:23"}]}],"speech":{"3":{"text":"Hijo del hombre, estos hombres han puesto sus ídolos en su corazón, y establecido el tropiezo de su maldad delante de su rostro: ¿acaso he de ser yo verdaderamente consultado por ellos?","spans":[{"start":0,"end":185,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"4":{"text":"Háblales por tanto, y diles: Así ha dicho el Señor Jehová: Cualquier hombre de la casa de Israel que hubiere puesto sus ídolos en su corazón, y establecido el tropiezo de su maldad delante de su rostro, y viniere al profeta, yo Jehová responderé al que viniere en la multitud de sus ídolos;","spans":[{"start":0,"end":290,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"5":{"text":"Para tomar a la casa de Israel en su corazón, que se han apartado de mí todos ellos en sus ídolos.","spans":[{"start":0,"end":98,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"6":{"text":"Por tanto di a la casa de Israel: Así dice el Señor Jehová: Convertíos, y volveos de vuestros ídolos, y apartad vuestro rostro de todas vuestras abominaciones.","spans":[{"start":0,"end":159,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"7":{"text":"Porque cualquier hombre de la casa de Israel, y de los extranjeros que moran en Israel, que se hubiere apartado de andar en pos de mí, y hubiere puesto sus ídolos en su corazón, y establecido delante de su rostro el tropiezo de su maldad, y viniere al profeta para preguntarle por mí, yo Jehová le responderé por mí mismo:","spans":[{"start":0,"end":322,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"8":{"text":"Y pondré mi rostro contra aquel hombre, y le pondré por señal y por fábula, y yo lo cortaré de entre mi pueblo; y sabréis que yo soy Jehová.","spans":[{"start":0,"end":140,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"9":{"text":"Y el profeta, cuando fuere engañado y hablare palabra, yo Jehová engañé al tal profeta; y extenderé mi mano sobre él, y raerele de en medio de mi pueblo de Israel.","spans":[{"start":0,"end":163,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"10":{"text":"Y llevarán su maldad: como la maldad del que pregunta, así será la maldad del profeta;","spans":[{"start":0,"end":86,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"11":{"text":"Para que no yerren más la casa de Israel de en pos de mí: ni más se contaminen en todas sus rebeliones, y me sean por pueblo, y yo les sea por Dios, dice el Señor Jehová.","spans":[{"start":0,"end":148,"speech":"EZK-14-3-11-jehovah","speaker":"jehovah"}]},"13":{"text":"Hijo del hombre, cuando la tierra pecare contra mí rebelándose pérfidamente, y extendiere yo mi mano sobre ella, y le quebrantare el arrimo del pan, y enviare en ella hambre, y talare de ella hombres y bestias;","spans":[{"start":0,"end":210,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"14":{"text":"Si estuvieren en medio de ella estos tres varones, Noé, Daniel, y Job, ellos por su justicia librarán su vida, dice el Señor Jehová.","spans":[{"start":0,"end":110,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"15":{"text":"Y si hiciere pasar malas bestias por la tierra, y la asolaren, y fuere desolada que no haya quien pase a causa de las bestias,","spans":[{"start":0,"end":126,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"16":{"text":"Y estos tres varones estuvieren en medio de ella, vivo yo, dice el Señor Jehová, ni a sus hijos ni a sus hijas librarán; ellos solos serán libres, y la tierra será asolada.","spans":[{"start":0,"end":58,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"},{"start":81,"end":172,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"17":{"text":"O si yo trajere espada sobre la tierra, y dijere: Espada, pasa por la tierra; e hiciere talar de ella hombres y bestias,","spans":[{"start":0,"end":120,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"18":{"text":"Y estos tres varones estuvieren en medio de ella, vivo yo, dice el Señor Jehová, no librarán sus hijos ni sus hijas; ellos solos serán libres.","spans":[{"start":0,"end":58,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"},{"start":81,"end":142,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"19":{"text":"O si pestilencia enviare sobre esa tierra, y derramare mi ira sobre ella en sangre, para talar de ella hombres y bestias,","spans":[{"start":0,"end":121,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"20":{"text":"Y estuvieren en medio de ella Noé, Daniel, y Job, vivo yo, dice el Señor Jehová, no librarán hijo ni hija; ellos por su justicia librarán su vida.","spans":[{"start":0,"end":58,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"},{"start":81,"end":146,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"21":{"text":"Por lo cual así ha dicho el Señor Jehová: ¿Cuánto más, si mis cuatro malos juicios, espada, y hambre, y mala bestia, y pestilencia, enviare contra Jerusalem, para talar de ella hombres y bestias?","spans":[{"start":0,"end":195,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"22":{"text":"Sin embargo, he aquí quedarán en ella algunos residuos, hijos e hijas, que serán llevados fuera: he aquí que ellos entrarán a vosotros, y veréis su camino y sus hechos; y tomaréis consolación del mal que hice venir sobre Jerusalem, de todas las cosas que traje sobre ella.","spans":[{"start":0,"end":272,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]},"23":{"text":"Y consolaros han cuando viereis su camino y sus hechos, y conoceréis que no sin causa hice todo lo que habré hecho en ella, dice el Señor Jehová.","spans":[{"start":0,"end":123,"speech":"EZK-14-13-23-jehovah","speaker":"jehovah"}]}}}
