"H2009","content":["he aquí"]}," ",{"type":"char","marker":"w","strong":"H5414","content":["que pondrán"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["sobre"]}," ",{"type":"char","marker":"w","strong":"H0859","content":["ti"]}," ",{"type":"char","marker":"w","strong":"H5688","content":["cuerdas"]},", ",{"type":"char","marker":"w","strong":"H0859","content":["y con ellas te"]}," ",{"type":"char","marker":"w","strong":"H0631","content":["ligarán"]},", ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H3318","content":["saldrás"]}," entre ellos. ",{"type":"verse","marker":"v","eid":"EZK 3:25"},{"type":"verse","marker":"v","number":"26","sid":"EZK 3:26"},{"type":"char","marker":"w","strong":"H1692","content":["Y haré se pegue"]}," ",{"type":"char","marker":"w","strong":"H3956","content":["tu lengua"]}," ",{"type":"char","marker":"w","strong":"H2441","content":["a tu paladar"]},", ",{"type":"char","marker":"w","strong":"H0481","content":["y estarás mudo"]},", ",{"type":"char","marker":"w","strong":"H3808","content":["y no"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["serás"]}," ",{"type":"char","marker":"w","strong":"H0376","content":["a ellos varón"]}," que reprende: ",{"type":"char","marker":"w","strong":"H3198","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["son"]}," ",{"type":"char","marker":"w","strong":"H1004","content":["casa"]}," ",{"type":"char","marker":"w","strong":"H4805","content":["rebelde"]},". ",{"type":"verse","marker":"v","eid":"EZK 3:26"},{"type":"verse","marker":"v","number":"27","sid":"EZK 3:27"},{"type":"char","marker":"w","strong":"H1696","content":["Mas cuando yo te hubiere hablado"]},", ",{"type":"char","marker":"w","strong":"H6605","content":["abriré"]}," ",{"type":"char","marker":"w","strong":"H6310","content":["tu boca"]},", ",{"type":"char","marker":"w","strong":"H0413","content":["y les"]}," ",{"type":"char","marker":"w","strong":"H0559","content":["dirás"]},": ",{"type":"char","marker":"w","strong":"H3541","content":["Así"]}," ",{"type":"char","marker":"w","strong":"H0559","content":["ha dicho"]}," ",{"type":"char","marker":"w","strong":"H0136","content":["el Señor"]}," ",{"type":"char","marker":"w","strong":"H3069","content":["Jehová"]},": ",{"type":"char","marker":"w","strong":"H8085","content":["El que oye"]},", ",{"type":"char","marker":"w","strong":"H8085","content":["oiga"]},"; y el que cesa, cese: ",{"type":"char","marker":"w","strong":"H3588","content":["porque"]}," ",{"type":"char","marker":"w","strong":"H1004","content":["casa"]}," ",{"type":"char","marker":"w","strong":"H4805","content":["rebelde"]}," son. ",{"type":"verse","marker":"v","eid":"EZK 3:27"}]}],"speech":{"1":{"text":"Y DÍJOME: Hijo del hombre, come lo que hallares; come este rollo, y ve y habla a la casa de Israel.","spans":[{"start":10,"end":99,"speech":"EZK-3-1-1-jehovah","speaker":"jehovah"}]},"3":{"text":"Y díjome: Hijo del hombre, haz a tu vientre que coma, e hinche tus entrañas de este rollo que yo te doy. Y comilo, y fue en mi boca dulce como miel.","spans":[{"start":10,"end":104,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"4":{"text":"Díjome luego: Hijo del hombre, ve y entra a la casa de Israel, y habla a ellos con mis palabras.","spans":[{"start":14,"end":96,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"5":{"text":"Porque no eres enviado a pueblo de habla profunda ni de lengua difícil, sino a la casa de Israel.","spans":[{"start":0,"end":97,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"6":{"text":"No a muchos pueblos de profunda habla ni de lengua difícil, cuyas palabras no entiendas; y si a ellos te enviara, ellos te oyeran.","spans":[{"start":0,"end":130,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"7":{"text":"Mas la casa de Israel no te querrán oír, porque no me quieren oír a mí: porque toda la casa de Israel son tiesos de frente, y duros de corazón.","spans":[{"start":0,"end":143,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"8":{"text":"He aquí he hecho yo tu rostro fuerte contra los rostros de ellos, y tu frente fuerte contra su frente.","spans":[{"start":0,"end":102,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"9":{"text":"Como diamante, más fuerte que pedernal he hecho tu frente; no los temas, ni tengas miedo delante de ellos, porque es casa rebelde.","spans":[{"start":0,"end":130,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"10":{"text":"Y díjome: Hijo del hombre, toma en tu corazón todas mis palabras que yo te hablaré, y oye con tus oídos.","spans":[{"start":10,"end":104,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"11":{"text":"Y ve, y entra a los trasportados, a los hijos de tu pueblo, y les hablarás y les dirás: Así ha dicho el Señor Jehová; escuchen, o dejen de escuchar.","spans":[{"start":0,"end":148,"speech":"EZK-3-3-11-jehovah","speaker":"jehovah"}]},"17":{"text":"Hijo del hombre, yo te he puesto por atalaya a la casa de Israel: oirás pues tú la palabra de mi boca, y amonestarlos has de mi parte.","spans":[{"start":0,"end":134,"speech":"EZK-3-17-21-jehovah","speaker":"jehovah"}]},"18":{"text":"Cuando yo dijere al impío: De cierto morirás: y tú no le amonestares, ni le hablares, para que el impío sea apercibido de su mal camino, a fin de que viva, el impío morirá por su maldad, mas su sangre demandaré de tu mano.","spans":[{"start":0,"end":222,"speech":"EZK-3-17-21-jehovah","speaker":"jehovah"}]},"19":{"text":"Y si tú amonestares al impío, y él no se convirtiere de su impiedad, y de su mal camino, él morirá por su maldad, y tú habrás librado tu alma.","spans":[{"start":0,"end":142,"speech":"EZK-3-17-21-jehovah","speaker":"jehovah"}]},"20":{"text":"Y cuando el justo se apartare de su justicia, e hiciere maldad, y pusiere yo tropiezo delante de él, él morirá, porque tú no le amonestaste; en su pecado morirá, y sus justicias que había hecho no vendrán en memoria; mas su sangre demandaré de tu mano.","spans":[{"start":0,"end":252,"speech":"EZK-3-17-21-jehovah","speaker":"jehovah"}]},"21":{"text":"Y si al justo amonestares para que el justo no peque, y no pecare, de cierto vivirá, porque fue amonestado; y tú habrás librado tu alma.","spans":[{"start":0,"end":136,"speech":"EZK-3-17-21-jehovah","speaker":"jehovah"}]},"22":{"text":"Y fue allí la mano de Jehová sobre mí, y díjome: Levántate, y sal al campo, y allí hablaré contigo.","spans":[{"start":49,"end":99,"speech":"EZK-3-22-22-jehovah","speaker":"jehovah"}]},"24":{"text":"Entonces entró espíritu en mí, y afirmome sobre mis pies, y hablome, y díjome: Entra, y enciérrate dentro de tu casa.","spans":[{"start":79,"end":117,"speech":"EZK-3-24-27-jehovah","speaker":"jehovah"}]},"25":{"text":"Y tú, oh hijo del hombre, he aquí que pondrán sobre ti cuerdas, y con ellas te ligarán, y no saldrás entre ellos.","spans":[{"start":0,"end":113,"speech":"EZK-3-24-27-jehovah","speaker":"jehovah"}]},"26":{"text":"Y haré se pegue tu lengua a tu paladar, y estarás mudo, y no serás a ellos varón que reprende: porque son casa rebelde.","spans":[{"start":0,"end":119,"speech":"EZK-3-24-27-jehovah","speaker":"jehovah"}]},"27":{"text":"Mas cuando yo te hubiere hablado, abriré tu boca, y les dirás: Así ha dicho el Señor Jehová: El que oye, oiga; y el que cesa, cese: porque casa rebelde son.","spans":[{"start":0,"end":156,"speech":"EZK-3-24-27-jehovah","speaker":"jehovah"}]}}}
