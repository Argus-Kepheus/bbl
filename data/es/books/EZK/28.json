:"char","marker":"w","strong":"H5414","content":["di"]}," ",{"type":"char","marker":"w","strong":"H5650","content":["a mi siervo"]}," ",{"type":"char","marker":"w","strong":"H3290","content":["Jacob"]},". ",{"type":"verse","marker":"v","eid":"EZK 28:25"},{"type":"verse","marker":"v","number":"26","sid":"EZK 28:26"},{"type":"char","marker":"w","strong":"H3427","content":["Y habitarán"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["en"]}," ",{"type":"char","marker":"w","strong":"H0983","content":["ella seguros"]},", ",{"type":"char","marker":"w","strong":"H1129","content":["y edificarán"]}," ",{"type":"char","marker":"w","strong":"H1004","content":["casas"]},", ",{"type":"char","marker":"w","strong":"H5193","content":["y plantarán"]}," ",{"type":"char","marker":"w","strong":"H3754","content":["viñas"]},", ",{"type":"char","marker":"w","strong":"H3427","content":["y habitarán"]}," ",{"type":"char","marker":"w","strong":"H0983","content":["confiadamente"]},", ",{"type":"char","marker":"w","strong":"H0589","content":["cuando yo"]}," ",{"type":"char","marker":"w","strong":"H8201","content":["haré juicios"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["en"]}," ",{"type":"char","marker":"w","strong":"H3605","content":["todos"]}," ",{"type":"char","marker":"w","strong":"H7590","content":["los que los despojan"]}," ",{"type":"char","marker":"w","strong":"H5921","content":["en"]}," ",{"type":"char","marker":"w","strong":"H5439","content":["sus alrededores"]},"; ",{"type":"char","marker":"w","strong":"H3045","content":["y sabrán"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["soy Jehová"]}," ",{"type":"char","marker":"w","strong":"H0430","content":["su Dios"]},". ",{"type":"verse","marker":"v","eid":"EZK 28:26"}]}],"speech":{"2":{"text":"Hijo del hombre, di al príncipe de Tiro: Así ha dicho el Señor Jehová: Por cuanto se enalteció tu corazón, y dijiste: Yo soy un dios; en la silla de Dios estoy sentado en medio de los mares (siendo tú hombre y no Dios); y has puesto tu corazón como corazón de Dios:","spans":[{"start":0,"end":265,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"3":{"text":"He aquí que tú eres más sabio que Daniel; no hay secreto que te sea oculto;","spans":[{"start":0,"end":75,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"4":{"text":"Con tu sabiduría y con tu prudencia te has juntado riquezas, y has adquirido oro y plata en tus tesoros;","spans":[{"start":0,"end":104,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"5":{"text":"Con la grandeza de tu sabiduría en tu contratación has multiplicado tus riquezas; y a causa de tus riquezas se ha enaltecido tu corazón.","spans":[{"start":0,"end":136,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"6":{"text":"Por tanto, así ha dicho el Señor Jehová: Por cuanto pusiste tu corazón como corazón de Dios,","spans":[{"start":0,"end":92,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"7":{"text":"Por tanto, he aquí yo traigo sobre ti extraños, los fuertes de las gentes, que desenvainarán su espadas contra la hermosura de tu sabiduría, y ensuciarán tu esplendor.","spans":[{"start":0,"end":167,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"8":{"text":"A la huesa te harán descender, y morirás de las muertes de los que mueren en medio de los mares.","spans":[{"start":0,"end":96,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"9":{"text":"¿Hablarás delante de tu matador, diciendo: Yo soy Dios? Tú, hombre eres, y no Dios, en la mano de tu matador.","spans":[{"start":0,"end":109,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"10":{"text":"De muerte de incircuncisos morirás por mano de extraños: porque yo he hablado, dice el Señor Jehová.","spans":[{"start":0,"end":78,"speech":"EZK-28-2-10-jehovah","speaker":"jehovah"}]},"12":{"text":"Hijo del hombre, levanta endechas sobre el rey de Tiro, y dile: Así ha dicho el Señor Jehová: Tú echas el sello a la proporción, lleno de sabiduría, y acabado de hermosura.","spans":[{"start":0,"end":172,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"13":{"text":"En Edén, en el huerto de Dios estuviste: toda piedra preciosa fue tu vestidura; el sardio, topacio, diamante, crisólito, onique, y berilo, el zafiro, carbunclo, y esmeralda, y oro, los primores de tus tamboriles y pífanos estuvieron apercibidos para ti en el día de tu creación.","spans":[{"start":0,"end":278,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"14":{"text":"Tú, querubín grande, cubridor: y yo te puse; en el santo monte de Dios estuviste; en medio de piedras de fuego has andado.","spans":[{"start":0,"end":122,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"15":{"text":"Perfecto eras en todos tus caminos desde el día que fuiste criado, hasta que se halló en ti maldad.","spans":[{"start":0,"end":99,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"16":{"text":"A causa de la multitud de tu contratación fuiste lleno de iniquidad, y pecaste: por lo que yo te eché del monte de Dios, y te arrojé de entre las piedras del fuego, oh querubín cubridor.","spans":[{"start":0,"end":186,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"17":{"text":"Enalteciose tu corazón a causa de tu hermosura, corrompiste tu sabiduría a causa de tu resplandor: yo te arrojaré por tierra; delante de los reyes te pondré para que miren en ti.","spans":[{"start":0,"end":178,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"18":{"text":"Con la multitud de tus maldades, y con la iniquidad de tu contratación ensuciaste tu santuario: yo pues saqué fuego de en medio de ti, el cual te consumió, y púsete en ceniza sobre la tierra a los ojos de todos los que te miran.","spans":[{"start":0,"end":228,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"19":{"text":"Todos los que te conocieron de entre los pueblos, se maravillarán sobre ti: en espanto serás, y para siempre dejarás de ser.","spans":[{"start":0,"end":124,"speech":"EZK-28-12-19-jehovah","speaker":"jehovah"}]},"21":{"text":"Hijo del hombre, pon tu rostro hacia Sidón, y profetiza contra ella;","spans":[{"start":0,"end":68,"speech":"EZK-28-21-26-jehovah","speaker":"jehovah"}]},"22":{"text":"Y dirás: Así ha dicho el Señor Jehová: He aquí yo contra ti, oh Sidón, y en medio de ti seré glorificado: y sabrán que yo soy Jehová, cuando hiciere en ella juicios, y en ella me santificare.","spans":[{"start":0,"end":191,"speech":"EZK-28-21-26-jehovah","speaker":"jehovah"}]},"23":{"text":"Y enviaré a ella pestilencia y sangre en sus plazas; y caerán muertos en medio de ella, con espada contra ella alrededor; y sabrán que yo soy Jehová.","spans":[{"start":0,"end":149,"speech":"EZK-28-21-26-jehovah","speaker":"jehovah"}]},"24":{"text":"Y nunca más será a la casa de Israel espino que le punce, ni espanto que le dé dolor, en todos los alrededores de los que los menosprecian; y sabrán que yo soy Jehová.","spans":[{"start":0,"end":167,"speech":"EZK-28-21-26-jehovah","speaker":"jehovah"}]},"25":{"text":"Así ha dicho el Señor Jehová: Cuando juntaré la casa de Israel de los pueblos entre los cuales están esparcidos, entonces me santificaré en ellos a los ojos de las gentes, y habitarán en su tierra, la cual di a mi siervo Jacob.","spans":[{"start":0,"end":227,"speech":"EZK-28-21-26-jehovah","speaker":"jehovah"}]},"26":{"text":"Y habitarán en ella seguros, y edificarán casas, y plantarán viñas, y habitarán confiadamente, cuando yo haré juicios en todos los que los despojan en sus alrededores; y sabrán que yo soy Jehová su Dios.","spans":[{"start":0,"end":203,"speech":"EZK-28-21-26-jehovah","speaker":"jehovah"}]}}}
