nt":["más"]}," ",{"type":"char","marker":"w","strong":"H3027","content":["en vuestra mano"]}," para caza; ",{"type":"char","marker":"w","strong":"H3045","content":["y sabréis"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["soy Jehová"]},". ",{"type":"verse","marker":"v","eid":"EZK 13:21"},{"type":"verse","marker":"v","number":"22","sid":"EZK 13:22"},{"type":"char","marker":"w","strong":"H3282","content":["Por"]}," ",{"type":"char","marker":"w","strong":"H3512","content":["cuanto entristecisteis"]}," ",{"type":"char","marker":"w","strong":"H8267","content":["con mentira"]}," ",{"type":"char","marker":"w","strong":"H3820","content":["el corazón"]}," ",{"type":"char","marker":"w","strong":"H6662","content":["del justo"]},", ",{"type":"char","marker":"w","strong":"H0589","content":["al cual yo"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H3510","content":["entristecí"]},", ",{"type":"char","marker":"w","strong":"H3027","content":["y esforzasteis las manos"]}," ",{"type":"char","marker":"w","strong":"H7563","content":["del impío"]},", ",{"type":"char","marker":"w","strong":"H1097","content":["para que"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H7725","content":["se apartase"]}," ",{"type":"char","marker":"w","strong":"H7451","content":["de su mal"]}," ",{"type":"char","marker":"w","strong":"H1870","content":["camino"]},", ",{"type":"char","marker":"w","strong":"H2421","content":["infundiéndole ánimo"]},"; ",{"type":"verse","marker":"v","eid":"EZK 13:22"},{"type":"verse","marker":"v","number":"23","sid":"EZK 13:23"},{"type":"char","marker":"w","strong":"H3651","content":["Por tanto"]}," ",{"type":"char","marker":"w","strong":"H3808","content":["no"]}," ",{"type":"char","marker":"w","strong":"H2372","content":["veréis"]}," ",{"type":"char","marker":"w","strong":"H7723","content":["vanidad"]},", ",{"type":"char","marker":"w","strong":"H3808","content":["ni"]}," ",{"type":"char","marker":"w","strong":"H7081","content":["más adivinaréis"]}," ",{"type":"char","marker":"w","strong":"H7080","content":["adivinación"]},"; ",{"type":"char","marker":"w","strong":"H5337","content":["y libraré"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["mi"]}," ",{"type":"char","marker":"w","strong":"H5971","content":["pueblo"]}," ",{"type":"char","marker":"w","strong":"H3027","content":["de vuestra mano"]},"; ",{"type":"char","marker":"w","strong":"H3045","content":["y sabréis"]}," ",{"type":"char","marker":"w","strong":"H3588","content":["que"]}," ",{"type":"char","marker":"w","strong":"H0589","content":["yo"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["soy Jehová"]},". ",{"type":"verse","marker":"v","eid":"EZK 13:23"}]}],"speech":{"2":{"text":"Hijo del hombre, profetiza contra los profetas de Israel que profetizan, y di a los que profetizan de su corazón: Oíd palabra de Jehová.","spans":[{"start":0,"end":136,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"3":{"text":"Así ha dicho el Señor Jehová: ¡Ay de los profetas insensatos, que andan en pos de su propio espíritu, y nada vieron!","spans":[{"start":0,"end":116,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"4":{"text":"Como zorras en los desiertos fueron tus profetas, oh Israel.","spans":[{"start":0,"end":60,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"5":{"text":"No habéis subido a los portillos, ni echasteis vallado en la casa de Israel, estando en la batalla en el día de Jehová.","spans":[{"start":0,"end":119,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"6":{"text":"Vieron vanidad y adivinación de mentira. Dicen: Ha dicho Jehová; y Jehová no los envió: y hacen esperar que se confirme la palabra.","spans":[{"start":0,"end":131,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"7":{"text":"¿No habéis visto visión vana, y no habéis dicho adivinación de mentira, por cuanto decís, Dijo Jehová; no habiendo yo hablado?","spans":[{"start":0,"end":126,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"8":{"text":"Por tanto, así ha dicho el Señor Jehová: Por cuanto vosotros habéis hablado vanidad, y habéis visto mentira, por tanto, he aquí yo contra vosotros, dice el Señor Jehová.","spans":[{"start":0,"end":147,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"9":{"text":"Y será mi mano contra los profetas que ven vanidad, y adivinan mentira: no serán en la congregación de mi pueblo, ni serán escritos en el libro de la casa de Israel, ni a la tierra de Israel volverán; y sabréis que yo soy el Señor Jehová.","spans":[{"start":0,"end":238,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"10":{"text":"Por tanto, y por cuanto engañaron a mi pueblo, diciendo, Paz, no habiendo paz; y el uno edificaba la pared, y he aquí que los otros la encostraban con lodo suelto;","spans":[{"start":0,"end":163,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"11":{"text":"Di a los encostradores con lodo suelto, que caerá; vendrá lluvia inundante, y daré piedras de granizo que la hagan caer, y viento tempestuoso la romperá.","spans":[{"start":0,"end":153,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"12":{"text":"Y he aquí, cuando la pared habrá caído, no os dirán: ¿Dónde está la embarradura con que encostrasteis?","spans":[{"start":0,"end":102,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"13":{"text":"Por tanto, así ha dicho el Señor Jehová: Y haré que la rompa viento tempestuoso con mi ira, y lluvia inundante vendrá con mi furor, y piedras de granizo con enojo para consumir.","spans":[{"start":0,"end":177,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"14":{"text":"Así desbarataré la pared que vosotros encostrasteis con lodo suelto, y echarela a tierra, y será descubierto su cimiento, y caerá, y seréis consumidos en medio de ella; y sabréis que yo soy Jehová.","spans":[{"start":0,"end":197,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"15":{"text":"Cumpliré así mi furor en la pared y en los que la encostraron con lodo suelto; y os diré: No existe la pared, ni aquellos que la encostraron,","spans":[{"start":0,"end":141,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"16":{"text":"Los profetas de Israel que profetizan a Jerusalem, y ven para ella visión de paz, no habiendo paz, dice el Señor Jehová.","spans":[{"start":0,"end":98,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"17":{"text":"Y tú, hijo del hombre, pon tu rostro a las hijas de tu pueblo que profetizan de su corazón, y profetiza contra ellas,","spans":[{"start":0,"end":117,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"18":{"text":"Y di: Así ha dicho el Señor Jehová: ¡Ay de aquellas que cosen almohadillas a todos codos de manos, y hacen veletes sobre la cabeza de toda edad para cazar las almas! ¿Habéis de cazar las almas de mi pueblo, para mantener así vuestra propia vida?","spans":[{"start":0,"end":245,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"19":{"text":"¿Y habéis de profanarme entre mi pueblo por puñados de cebada y por pedazos de pan, matando las almas que no mueren, y dando vida a las almas que no vivirán, mintiendo a mi pueblo que escucha la mentira?","spans":[{"start":0,"end":203,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"20":{"text":"Por tanto, así ha dicho el Señor Jehová: He aquí yo contra vuestras almohadillas, con que cazáis ahí las almas volando; yo las arrancaré de vuestros brazos, y dejaré las almas, las almas que cazáis volando.","spans":[{"start":0,"end":206,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"21":{"text":"Romperé asimismo vuestros veletes, y libraré mi pueblo de vuestra mano, y no estarán más en vuestra mano para caza; y sabréis que yo soy Jehová.","spans":[{"start":0,"end":144,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"22":{"text":"Por cuanto entristecisteis con mentira el corazón del justo, al cual yo no entristecí, y esforzasteis las manos del impío, para que no se apartase de su mal camino, infundiéndole ánimo;","spans":[{"start":0,"end":185,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]},"23":{"text":"Por tanto no veréis vanidad, ni más adivinaréis adivinación; y libraré mi pueblo de vuestra mano; y sabréis que yo soy Jehová.","spans":[{"start":0,"end":126,"speech":"EZK-13-2-23-jehovah","speaker":"jehovah"}]}}}
