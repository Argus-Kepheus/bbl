rong":"H1144","content":["y Benjamín"]}," ",{"type":"char","marker":"w","strong":"H1568","content":["a Galaad"]},". ",{"type":"verse","marker":"v","eid":"OBA 1:19"},{"type":"verse","marker":"v","number":"20","sid":"OBA 1:20"},{"type":"char","marker":"w","strong":"H1546","content":["Y los cautivos"]}," ",{"type":"char","marker":"w","strong":"H2426","content":["de aqueste ejército"]}," ",{"type":"char","marker":"w","strong":"H1121","content":["de los hijos"]}," ",{"type":"char","marker":"w","strong":"H3478","content":["de Israel"]}," ",{"type":"char","marker":"add","content":["poseerán"]}," ",{"type":"char","marker":"w","strong":"H0834","content":["lo"]}," ",{"type":"char","marker":"w","strong":"H3669","content":["de los Cananeos"]}," ",{"type":"char","marker":"w","strong":"H5704","content":["hasta"]}," ",{"type":"char","marker":"w","strong":"H6886","content":["Sarepta"]},"; ",{"type":"char","marker":"w","strong":"H1546","content":["y los cautivos"]}," ",{"type":"char","marker":"w","strong":"H3389","content":["de Jerusalem"]},", ",{"type":"char","marker":"w","strong":"H0834","content":["que"]}," ",{"type":"char","marker":"w","strong":"H5614","content":["están en Sepharad"]},", ",{"type":"char","marker":"w","strong":"H3423","content":["poseerán"]}," ",{"type":"char","marker":"w","strong":"H5892","content":["las ciudades"]}," ",{"type":"char","marker":"w","strong":"H5045","content":["del mediodía"]},". ",{"type":"verse","marker":"v","eid":"OBA 1:20"},{"type":"verse","marker":"v","number":"21","sid":"OBA 1:21"},{"type":"char","marker":"w","strong":"H5927","content":["Y vendrán"]}," ",{"type":"char","marker":"w","strong":"H3467","content":["salvadores"]}," ",{"type":"char","marker":"w","strong":"H2022","content":["al monte"]}," ",{"type":"char","marker":"w","strong":"H6726","content":["de Sión"]}," ",{"type":"char","marker":"w","strong":"H8199","content":["para juzgar"]}," ",{"type":"char","marker":"w","strong":"H2022","content":["al monte"]}," ",{"type":"char","marker":"w","strong":"H6215","content":["de Esaú"]},"; ",{"type":"char","marker":"w","strong":"H4410","content":["y el reino"]}," ",{"type":"char","marker":"w","strong":"H1961","content":["será"]}," ",{"type":"char","marker":"w","strong":"H3068","content":["de Jehová"]},". ",{"type":"verse","marker":"v","eid":"OBA 1:21"}]}],"speech":{"2":{"text":"He aquí, pequeño te he hecho entre las gentes; abatido eres tú en gran manera.","spans":[{"start":0,"end":78,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"3":{"text":"La soberbia de tu corazón te ha engañado, tú que moras en las hendiduras de las peñas, en tu altísima morada; que dices en tu corazón: ¿Quién me derribará a tierra?","spans":[{"start":0,"end":164,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"4":{"text":"Si te encaramares como águila, y si entre las estrellas pusieres tu nido, de ahí te derribaré, dice Jehová.","spans":[{"start":0,"end":94,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"5":{"text":"Si ladrones vinieran a ti, o robadores de noche (¡cómo has sido destruido!) ¿no hurtaran lo que les bastase? Pues si entraran a ti vendimiadores, aun dejaran algún rebusco.","spans":[{"start":0,"end":172,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"6":{"text":"¡Cómo fueron escudriñadas las cosas de Esaú! Sus cosas escondidas fueron buscadas.","spans":[{"start":0,"end":82,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"7":{"text":"Hasta el término te hicieron llegar todos tus aliados; te han engañado tus pacíficos, prevalecieron contra ti; los que comían tu pan, pusieron el lazo debajo de ti: no hay en él entendimiento.","spans":[{"start":0,"end":192,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"8":{"text":"¿No haré que perezcan en aquel día, dice Jehová, los sabios de Edom, y la prudencia del monte de Esaú?","spans":[{"start":0,"end":35,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"},{"start":49,"end":102,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"9":{"text":"Y tus valientes, oh Temán, serán quebrantados; porque todo hombre será talado del monte de Esaú por el estrago.","spans":[{"start":0,"end":111,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"10":{"text":"Por la injuria de tu hermano Jacob te cubrirá vergüenza, y serás talado para siempre.","spans":[{"start":0,"end":85,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"11":{"text":"El día que estando tú delante, llevaban extraños cautivo su ejército, y los extraños entraban por sus puertas, y echaban suertes sobre Jerusalem, tú también eras como uno de ellos.","spans":[{"start":0,"end":180,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"12":{"text":"Pues no debiste tú estar mirando en el día de tu hermano, el día en que fue extrañado: no te habías de haber alegrado de los hijos de Judá en el día que se perdieron, ni habías de ensanchar tu boca en el día de la angustia:","spans":[{"start":0,"end":223,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"13":{"text":"No habías de haber entrado por la puerta de mi pueblo en el día de su quebrantamiento; no, no habías tú de haber mirado su mal el día de su quebranto, ni haber echado mano a sus bienes el día de su calamidad.","spans":[{"start":0,"end":208,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"14":{"text":"Tampoco habías de haberte parado en las encrucijadas, para matar los que de ellos escapasen; ni habías tú de haber entregado los que quedaban en el día de angustia.","spans":[{"start":0,"end":164,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"15":{"text":"Porque cercano está el día de Jehová sobre todas las gentes: como tú hiciste se hará contigo: tu galardón volverá sobre tu cabeza.","spans":[{"start":0,"end":130,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"16":{"text":"De la manera que vosotros bebisteis en mi santo monte, beberán todas las gentes de continuo; beberán, y engullirán, y serán como si no hubieran sido.","spans":[{"start":0,"end":149,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"17":{"text":"Mas en el monte de Sión habrá salvamento, y será santidad, y la casa de Jacob, poseerá sus posesiones.","spans":[{"start":0,"end":102,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"18":{"text":"Y la casa de Jacob será fuego, y la casa de José será llama, y la casa de Esaú estopa, y los quemarán, y los consumirán; ni aun reliquia quedará en la casa de Esaú, porque Jehová lo habló.","spans":[{"start":0,"end":164,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"19":{"text":"Y los del mediodía poseerán el monte de Esaú, y los llanos de los Palestinos; poseerán también los campos de Ephraim, y los campos de Samaria; y Benjamín a Galaad.","spans":[{"start":0,"end":163,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"20":{"text":"Y los cautivos de aqueste ejército de los hijos de Israel poseerán lo de los Cananeos hasta Sarepta; y los cautivos de Jerusalem, que están en Sepharad, poseerán las ciudades del mediodía.","spans":[{"start":0,"end":188,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]},"21":{"text":"Y vendrán salvadores al monte de Sión para juzgar al monte de Esaú; y el reino será de Jehová.","spans":[{"start":0,"end":94,"speech":"OBA-1-2-21-jehovah","speaker":"jehovah"}]}}}
