28","content":["que venciere"]},", ",{"type":"char","marker":"w","strong":"G0846","content":["yo le"]}," ",{"type":"char","marker":"w","strong":"G1325","content":["daré"]}," ",{"type":"char","marker":"w","strong":"G2523","content":["que se siente"]}," ",{"type":"char","marker":"w","strong":"G3326,G1700","content":["conmigo"]}," ",{"type":"char","marker":"w","strong":"G1722","content":["en"]}," ",{"type":"char","marker":"w","strong":"G3450","content":["mi"]}," ",{"type":"char","marker":"w","strong":"G2362","content":["trono"]},"; ",{"type":"char","marker":"w","strong":"G2504","content":["así"]}," ",{"type":"char","marker":"w","strong":"G5613","content":["como"]}," ",{"type":"char","marker":"w","strong":"G3528","content":["yo he vencido"]},", ",{"type":"char","marker":"w","strong":"G2532","content":["y"]}," ",{"type":"char","marker":"w","strong":"G2523","content":["me he sentado"]}," ",{"type":"char","marker":"w","strong":"G3326","content":["con"]}," ",{"type":"char","marker":"w","strong":"G3450","content":["mi"]}," ",{"type":"char","marker":"w","strong":"G3962","content":["Padre"]}," ",{"type":"char","marker":"w","strong":"G1722","content":["en"]}," ",{"type":"char","marker":"w","strong":"G0846","content":["su"]}," ",{"type":"char","marker":"w","strong":"G2362","content":["trono"]},". ",{"type":"verse","marker":"v","eid":"REV 3:21"},{"type":"verse","marker":"v","number":"22","sid":"REV 3:22"},{"type":"char","marker":"w","strong":"G3588","content":["El"]}," ",{"type":"char","marker":"w","strong":"G2192","content":["que tiene"]}," ",{"type":"char","marker":"w","strong":"G3775","content":["oído"]},", ",{"type":"char","marker":"w","strong":"G0191","content":["oiga"]}," ",{"type":"char","marker":"w","strong":"G5101","content":["lo que"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["el"]}," ",{"type":"char","marker":"w","strong":"G4151","content":["Espíritu"]}," ",{"type":"char","marker":"w","strong":"G3004","content":["dice"]}," ",{"type":"char","marker":"w","strong":"G3588","content":["á las"]}," ",{"type":"char","marker":"w","strong":"G1577","content":["iglesias"]},". ",{"type":"verse","marker":"v","eid":"REV 3:22"}]}],"speech":{"1":{"text":"Y ESCRIBE al ángel de la iglesia en SARDIS: El que tiene los siete Espíritus de Dios, y las siete estrellas, dice estas cosas: Yo conozco tus obras, que tienes nombre que vives, y estás muerto.","spans":[{"start":0,"end":193,"speech":"REV-1-17"}]},"2":{"text":"Sé vigilante y confirma las otras cosas que están para morir; porque no he hallado tus obras perfectas delante de Dios.","spans":[{"start":0,"end":119,"speech":"REV-1-17"}]},"3":{"text":"Acuérdate pues de lo que has recibido y has oído, y guárdalo, y arrepiéntete. Y si no velares, vendré á ti como ladrón, y no sabrás en qué hora vendré á ti.","spans":[{"start":0,"end":156,"speech":"REV-1-17"}]},"4":{"text":"Mas tienes unas pocas personas en Sardis que no han ensuciado sus vestiduras: y andarán conmigo en vestiduras blancas; porque son dignos.","spans":[{"start":0,"end":137,"speech":"REV-1-17"}]},"5":{"text":"El que venciere, será vestido de vestiduras blancas; y no borraré su nombre del libro de la vida, y confesaré su nombre delante de mi Padre, y delante de sus ángeles.","spans":[{"start":0,"end":166,"speech":"REV-1-17"}]},"6":{"text":"El que tiene oído, oiga lo que el Espíritu dice á las iglesias.","spans":[{"start":0,"end":63,"speech":"REV-1-17"}]},"7":{"text":"Y escribe al ángel de la iglesia en FILADELFIA: Estas cosas dice el Santo, el Verdadero, el que tiene la llave de David, el que abre y ninguno cierra, y cierra y ninguno abre:","spans":[{"start":0,"end":175,"speech":"REV-1-17"}]},"8":{"text":"Yo conozco tus obras: he aquí, he dado una puerta abierta delante de ti, la cual ninguno puede cerrar; porque tienes un poco de potencia, y has guardado mi palabra, y no has negado mi nombre.","spans":[{"start":0,"end":191,"speech":"REV-1-17"}]},"9":{"text":"He aquí, yo doy de la sinagoga de Satanás, los que se dicen ser Judíos, y no lo son, mas mienten; he aquí, yo los constreñiré á que vengan y adoren delante de tus pies, y sepan que yo te he amado.","spans":[{"start":0,"end":196,"speech":"REV-1-17"}]},"10":{"text":"Porque has guardado la palabra de mi paciencia, yo también te guardaré de la hora de la tentación que ha de venir en todo el mundo, para probar á los que moran en la tierra.","spans":[{"start":0,"end":173,"speech":"REV-1-17"}]},"11":{"text":"He aquí, yo vengo presto; retén lo que tienes, para que ninguno tome tu corona.","spans":[{"start":0,"end":79,"speech":"REV-1-17"}]},"12":{"text":"Al que venciere, yo lo haré columna en el templo de mi Dios, y nunca más saldrá fuera; y escribiré sobre él el nombre de mi Dios, y el nombre de la ciudad de mi Dios, la nueva Jerusalem, la cual desciende del cielo de con mi Dios, y mi nombre nuevo.","spans":[{"start":0,"end":249,"speech":"REV-1-17"}]},"13":{"text":"El que tiene oído, oiga lo que el Espíritu dice á las iglesias.","spans":[{"start":0,"end":63,"speech":"REV-1-17"}]},"14":{"text":"Y escribe al ángel de la iglesia en LAODICEA: He aquí dice el Amén, el testigo fiel y verdadero, el principio de la creación de Dios:","spans":[{"start":0,"end":133,"speech":"REV-1-17"}]},"15":{"text":"Yo conozco tus obras, que ni eres frío, ni caliente. ¡Ojalá fueses frío, ó caliente!","spans":[{"start":0,"end":84,"speech":"REV-1-17"}]},"16":{"text":"Mas porque eres tibio, y no frío ni caliente, te vomitaré de mi boca.","spans":[{"start":0,"end":69,"speech":"REV-1-17"}]},"17":{"text":"Porque tú dices: Yo soy rico, y estoy enriquecido, y no tengo necesidad de ninguna cosa; y no conoces que tú eres un cuitado y miserable y pobre y ciego y desnudo;","spans":[{"start":0,"end":163,"speech":"REV-1-17"}]},"18":{"text":"Yo te amonesto que de mí compres oro afinado en fuego, para que seas hecho rico, y seas vestido de vestiduras blancas, para que no se descubra la vergüenza de tu desnudez; y unge tus ojos con colirio, para que veas.","spans":[{"start":0,"end":215,"speech":"REV-1-17"}]},"19":{"text":"Yo reprendo y castigo á todos los que amo: sé pues celoso, y arrepiéntete.","spans":[{"start":0,"end":74,"speech":"REV-1-17"}]},"20":{"text":"He aquí, yo estoy á la puerta y llamo: si alguno oyere mi voz y abriere la puerta, entraré á él, y cenaré con él, y él conmigo.","spans":[{"start":0,"end":127,"speech":"REV-1-17"}]},"21":{"text":"Al que venciere, yo le daré que se siente conmigo en mi trono; así como yo he vencido, y me he sentado con mi Padre en su trono.","spans":[{"start":0,"end":128,"speech":"REV-1-17"}]},"22":{"text":"El que tiene oído, oiga lo que el Espíritu dice á las iglesias.","spans":[{"start":0,"end":63,"speech":"REV-1-17"}]}}}
