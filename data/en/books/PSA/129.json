{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":129,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 129:1"},"Many a time have they afflicted me from my youth, may Israel now say: ",{"type":"verse","marker":"v","eid":"PSA 129:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 129:2"},"Many a time have they afflicted me from my youth: yet they have not prevailed against me. ",{"type":"verse","marker":"v","eid":"PSA 129:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 129:3"},"The plowers plowed upon my back: they made long their furrows. ",{"type":"verse","marker":"v","eid":"PSA 129:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 129:4"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," righteous: he hath cut asunder the cords of the wicked. ",{"type":"verse","marker":"v","eid":"PSA 129:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 129:5"},"Let them all be confounded and turned back that hate Zion. ",{"type":"verse","marker":"v","eid":"PSA 129:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 129:6"},"Let them be as the grass ",{"type":"char","marker":"add","content":["upon"]}," the housetops, which withereth afore it groweth up: ",{"type":"verse","marker":"v","eid":"PSA 129:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 129:7"},"Wherewith the mower filleth not his hand; nor he that bindeth sheaves his bosom. ",{"type":"verse","marker":"v","eid":"PSA 129:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 129:8"},"Neither do they which go by say, The blessing of the LORD ",{"type":"char","marker":"add","content":["be "]},"upon you: we bless you in the name of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 129:8"}]}]}
