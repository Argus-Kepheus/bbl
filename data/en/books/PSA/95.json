{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":95,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 95:1"},"O come, let us sing unto the LORD: let us make a joyful noise to the rock of our salvation. ",{"type":"verse","marker":"v","eid":"PSA 95:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 95:2"},"Let us come before his presence with thanksgiving, and make a joyful noise unto him with psalms. ",{"type":"verse","marker":"v","eid":"PSA 95:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 95:3"},"For the LORD ",{"type":"char","marker":"add","content":["is"]}," a great God, and a great King above all gods. ",{"type":"verse","marker":"v","eid":"PSA 95:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 95:4"},"In his hand ",{"type":"char","marker":"add","content":["are"]}," the deep places of the earth: the strength of the hills ",{"type":"char","marker":"add","content":["is"]}," his also. ",{"type":"verse","marker":"v","eid":"PSA 95:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 95:5"},"The sea ",{"type":"char","marker":"add","content":["is"]}," his, and he made it: and his hands formed the dry ",{"type":"char","marker":"add","content":["land."]},{"type":"verse","marker":"v","eid":"PSA 95:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 95:6"},"O come, let us worship and bow down: let us kneel before the LORD our maker. ",{"type":"verse","marker":"v","eid":"PSA 95:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 95:7"},"For he ",{"type":"char","marker":"add","content":["is"]}," our God; and we ",{"type":"char","marker":"add","content":["are"]}," the people of his pasture, and the sheep of his hand. To day if ye will hear his voice, ",{"type":"verse","marker":"v","eid":"PSA 95:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 95:8"},"Harden not your heart, as in the provocation, ",{"type":"char","marker":"add","content":["and as in"]}," the day of temptation in the wilderness: ",{"type":"verse","marker":"v","eid":"PSA 95:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 95:9"},"When your fathers tempted me, proved me, and saw my work. ",{"type":"verse","marker":"v","eid":"PSA 95:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 95:10"},"Forty years long was I grieved with ",{"type":"char","marker":"add","content":["this"]}," generation, and said, It ",{"type":"char","marker":"add","content":["is"]}," a people that do err in their heart, and they have not known my ways: ",{"type":"verse","marker":"v","eid":"PSA 95:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 95:11"},"Unto whom I sware in my wrath that they should not enter into my rest. ",{"type":"verse","marker":"v","eid":"PSA 95:11"}]}]}
