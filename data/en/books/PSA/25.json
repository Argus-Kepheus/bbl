{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":25,"content":[{"type":"para","marker":"d","content":["A ",{"type":"char","marker":"add","content":["Psalm"]}," of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 25:1"},"Unto thee, O LORD, do I lift up my soul. ",{"type":"verse","marker":"v","eid":"PSA 25:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 25:2"},"O my God, I trust in thee: let me not be ashamed, let not mine enemies triumph over me. ",{"type":"verse","marker":"v","eid":"PSA 25:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 25:3"},"Yea, let none that wait on thee be ashamed: let them be ashamed which transgress without cause. ",{"type":"verse","marker":"v","eid":"PSA 25:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 25:4"},"Shew me thy ways, O LORD; teach me thy paths. ",{"type":"verse","marker":"v","eid":"PSA 25:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 25:5"},"Lead me in thy truth, and teach me: for thou ",{"type":"char","marker":"add","content":["art"]}," the God of my salvation; on thee do I wait all the day. ",{"type":"verse","marker":"v","eid":"PSA 25:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 25:6"},"Remember, O LORD, thy tender mercies and thy lovingkindnesses; for they ",{"type":"char","marker":"add","content":["have been"]}," ever of old. ",{"type":"verse","marker":"v","eid":"PSA 25:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 25:7"},"Remember not the sins of my youth, nor my transgressions: according to thy mercy remember thou me for thy goodness’ sake, O LORD. ",{"type":"verse","marker":"v","eid":"PSA 25:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 25:8"},"Good and upright ",{"type":"char","marker":"add","content":["is"]}," the LORD: therefore will he teach sinners in the way. ",{"type":"verse","marker":"v","eid":"PSA 25:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 25:9"},"The meek will he guide in judgment: and the meek will he teach his way. ",{"type":"verse","marker":"v","eid":"PSA 25:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 25:10"},"All the paths of the LORD ",{"type":"char","marker":"add","content":["are"]}," mercy and truth unto such as keep his covenant and his testimonies. ",{"type":"verse","marker":"v","eid":"PSA 25:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 25:11"},"For thy name’s sake, O LORD, pardon mine iniquity; for it ",{"type":"char","marker":"add","content":["is "]},"great. ",{"type":"verse","marker":"v","eid":"PSA 25:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 25:12"},"What man ",{"type":"char","marker":"add","content":["is"]}," he that feareth the LORD? him shall he teach in the way ",{"type":"char","marker":"add","content":["that"]}," he shall choose. ",{"type":"verse","marker":"v","eid":"PSA 25:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 25:13"},"His soul shall dwell at ease; and his seed shall inherit the earth. ",{"type":"verse","marker":"v","eid":"PSA 25:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 25:14"},"The secret of the LORD ",{"type":"char","marker":"add","content":["is"]}," with them that fear him; and he will shew them his covenant. ",{"type":"verse","marker":"v","eid":"PSA 25:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 25:15"},"Mine eyes ",{"type":"char","marker":"add","content":["are"]}," ever toward the LORD; for he shall pluck my feet out of the net. ",{"type":"verse","marker":"v","eid":"PSA 25:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 25:16"},"Turn thee unto me, and have mercy upon me; for I ",{"type":"char","marker":"add","content":["am"]}," desolate and afflicted. ",{"type":"verse","marker":"v","eid":"PSA 25:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 25:17"},"The troubles of my heart are enlarged: ",{"type":"char","marker":"add","content":["O"]}," bring thou me out of my distresses. ",{"type":"verse","marker":"v","eid":"PSA 25:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 25:18"},"Look upon mine affliction and my pain; and forgive all my sins. ",{"type":"verse","marker":"v","eid":"PSA 25:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 25:19"},"Consider mine enemies; for they are many; and they hate me with cruel hatred. ",{"type":"verse","marker":"v","eid":"PSA 25:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 25:20"},"O keep my soul, and deliver me: let me not be ashamed; for I put my trust in thee. ",{"type":"verse","marker":"v","eid":"PSA 25:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 25:21"},"Let integrity and uprightness preserve me; for I wait on thee. ",{"type":"verse","marker":"v","eid":"PSA 25:21"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"22","sid":"PSA 25:22"},"Redeem Israel, O God, out of all his troubles. ",{"type":"verse","marker":"v","eid":"PSA 25:22"}]}]}
