{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":46,"content":[{"type":"para","marker":"d","content":["To the chief Musician for the sons of Korah, A Song upon Alamoth. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 46:1"},"God ",{"type":"char","marker":"add","content":["is"]}," our refuge and strength, a very present help in trouble. ",{"type":"verse","marker":"v","eid":"PSA 46:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 46:2"},"Therefore will not we fear, though the earth be removed, and though the mountains be carried into the midst of the sea; ",{"type":"verse","marker":"v","eid":"PSA 46:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 46:3"},{"type":"char","marker":"add","content":["Though"]}," the waters thereof roar ",{"type":"char","marker":"add","content":["and"]}," be troubled, ",{"type":"char","marker":"add","content":["though"]}," the mountains shake with the swelling thereof. Selah. ",{"type":"verse","marker":"v","eid":"PSA 46:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 46:4"},{"type":"char","marker":"add","content":["There is"]}," a river, the streams whereof shall make glad the city of God, the holy ",{"type":"char","marker":"add","content":["place"]}," of the tabernacles of the most High. ",{"type":"verse","marker":"v","eid":"PSA 46:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 46:5"},"God ",{"type":"char","marker":"add","content":["is"]}," in the midst of her; she shall not be moved: God shall help her, ",{"type":"char","marker":"add","content":["and that"]}," right early. ",{"type":"verse","marker":"v","eid":"PSA 46:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 46:6"},"The heathen raged, the kingdoms were moved: he uttered his voice, the earth melted. ",{"type":"verse","marker":"v","eid":"PSA 46:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 46:7"},"The LORD of hosts ",{"type":"char","marker":"add","content":["is"]}," with us; the God of Jacob ",{"type":"char","marker":"add","content":["is "]},"our refuge. Selah. ",{"type":"verse","marker":"v","eid":"PSA 46:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 46:8"},"Come, behold the works of the LORD, what desolations he hath made in the earth. ",{"type":"verse","marker":"v","eid":"PSA 46:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 46:9"},"He maketh wars to cease unto the end of the earth; he breaketh the bow, and cutteth the spear in sunder; he burneth the chariot in the fire. ",{"type":"verse","marker":"v","eid":"PSA 46:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 46:10"},"Be still, and know that I ",{"type":"char","marker":"add","content":["am"]}," God: I will be exalted among the heathen, I will be exalted in the earth. ",{"type":"verse","marker":"v","eid":"PSA 46:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 46:11"},"The LORD of hosts ",{"type":"char","marker":"add","content":["is"]}," with us; the God of Jacob ",{"type":"char","marker":"add","content":["is "]},"our refuge. Selah. ",{"type":"verse","marker":"v","eid":"PSA 46:11"}]}]}
