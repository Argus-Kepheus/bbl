{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":111,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 111:1"},"Praise ye the LORD. I will praise the LORD with ",{"type":"char","marker":"add","content":["my"]}," whole heart, in the assembly of the upright, and ",{"type":"char","marker":"add","content":["in"]}," the congregation. ",{"type":"verse","marker":"v","eid":"PSA 111:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 111:2"},"The works of the LORD ",{"type":"char","marker":"add","content":["are"]}," great, sought out of all them that have pleasure therein. ",{"type":"verse","marker":"v","eid":"PSA 111:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 111:3"},"His work ",{"type":"char","marker":"add","content":["is"]}," honourable and glorious: and his righteousness endureth for ever. ",{"type":"verse","marker":"v","eid":"PSA 111:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 111:4"},"He hath made his wonderful works to be remembered: the LORD ",{"type":"char","marker":"add","content":["is "]},"gracious and full of compassion. ",{"type":"verse","marker":"v","eid":"PSA 111:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 111:5"},"He hath given meat unto them that fear him: he will ever be mindful of his covenant. ",{"type":"verse","marker":"v","eid":"PSA 111:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 111:6"},"He hath shewed his people the power of his works, that he may give them the heritage of the heathen. ",{"type":"verse","marker":"v","eid":"PSA 111:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 111:7"},"The works of his hands ",{"type":"char","marker":"add","content":["are"]}," verity and judgment; all his commandments ",{"type":"char","marker":"add","content":["are"]}," sure. ",{"type":"verse","marker":"v","eid":"PSA 111:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 111:8"},"They stand fast for ever and ever, ",{"type":"char","marker":"add","content":["and are"]}," done in truth and uprightness. ",{"type":"verse","marker":"v","eid":"PSA 111:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 111:9"},"He sent redemption unto his people: he hath commanded his covenant for ever: holy and reverend ",{"type":"char","marker":"add","content":["is"]}," his name. ",{"type":"verse","marker":"v","eid":"PSA 111:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 111:10"},"The fear of the LORD ",{"type":"char","marker":"add","content":["is"]}," the beginning of wisdom: a good understanding have all they that do ",{"type":"char","marker":"add","content":["his commandments:"]}," his praise endureth for ever. ",{"type":"verse","marker":"v","eid":"PSA 111:10"}]}]}
