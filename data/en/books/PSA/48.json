{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":48,"content":[{"type":"para","marker":"d","content":["A Song ",{"type":"char","marker":"add","content":["and"]}," Psalm for the sons of Korah. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 48:1"},"Great ",{"type":"char","marker":"add","content":["is"]}," the LORD, and greatly to be praised in the city of our God, ",{"type":"char","marker":"add","content":["in"]}," the mountain of his holiness. ",{"type":"verse","marker":"v","eid":"PSA 48:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 48:2"},"Beautiful for situation, the joy of the whole earth, ",{"type":"char","marker":"add","content":["is"]}," mount Zion, ",{"type":"char","marker":"add","content":["on"]}," the sides of the north, the city of the great King. ",{"type":"verse","marker":"v","eid":"PSA 48:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 48:3"},"God is known in her palaces for a refuge. ",{"type":"verse","marker":"v","eid":"PSA 48:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 48:4"},"For, lo, the kings were assembled, they passed by together. ",{"type":"verse","marker":"v","eid":"PSA 48:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 48:5"},"They saw ",{"type":"char","marker":"add","content":["it, and"]}," so they marvelled; they were troubled, ",{"type":"char","marker":"add","content":["and"]}," hasted away. ",{"type":"verse","marker":"v","eid":"PSA 48:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 48:6"},"Fear took hold upon them there, ",{"type":"char","marker":"add","content":["and"]}," pain, as of a woman in travail. ",{"type":"verse","marker":"v","eid":"PSA 48:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 48:7"},"Thou breakest the ships of Tarshish with an east wind. ",{"type":"verse","marker":"v","eid":"PSA 48:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 48:8"},"As we have heard, so have we seen in the city of the LORD of hosts, in the city of our God: God will establish it for ever. Selah. ",{"type":"verse","marker":"v","eid":"PSA 48:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 48:9"},"We have thought of thy lovingkindness, O God, in the midst of thy temple. ",{"type":"verse","marker":"v","eid":"PSA 48:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 48:10"},"According to thy name, O God, so ",{"type":"char","marker":"add","content":["is"]}," thy praise unto the ends of the earth: thy right hand is full of righteousness. ",{"type":"verse","marker":"v","eid":"PSA 48:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 48:11"},"Let mount Zion rejoice, let the daughters of Judah be glad, because of thy judgments. ",{"type":"verse","marker":"v","eid":"PSA 48:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 48:12"},"Walk about Zion, and go round about her: tell the towers thereof. ",{"type":"verse","marker":"v","eid":"PSA 48:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 48:13"},"Mark ye well her bulwarks, consider her palaces; that ye may tell ",{"type":"char","marker":"add","content":["it"]}," to the generation following. ",{"type":"verse","marker":"v","eid":"PSA 48:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 48:14"},"For this God ",{"type":"char","marker":"add","content":["is"]}," our God for ever and ever: he will be our guide ",{"type":"char","marker":"add","content":["even"]}," unto death. ",{"type":"verse","marker":"v","eid":"PSA 48:14"}]}]}
