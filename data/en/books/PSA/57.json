{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":57,"content":[{"type":"para","marker":"d","content":["To the chief Musician, Altaschith, Michtam of David, when he fled from Saul in the cave. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 57:1"},"Be merciful unto me, O God, be merciful unto me: for my soul trusteth in thee: yea, in the shadow of thy wings will I make my refuge, until ",{"type":"char","marker":"add","content":["these "]},"calamities be overpast. ",{"type":"verse","marker":"v","eid":"PSA 57:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 57:2"},"I will cry unto God most high; unto God that performeth ",{"type":"char","marker":"add","content":["all things "]},"for me. ",{"type":"verse","marker":"v","eid":"PSA 57:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 57:3"},"He shall send from heaven, and save ",{"type":"char","marker":"add","content":["from"]}," the reproach of him that would swallow me up. Selah. God shall send forth his mercy and his truth. ",{"type":"verse","marker":"v","eid":"PSA 57:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 57:4"},"My soul ",{"type":"char","marker":"add","content":["is"]}," among lions: ",{"type":"char","marker":"add","content":["and"]}," I lie ",{"type":"char","marker":"add","content":["even among "]},"them that are set on fire, ",{"type":"char","marker":"add","content":["even"]}," the sons of men, whose teeth ",{"type":"char","marker":"add","content":["are"]}," spears and arrows, and their tongue a sharp sword. ",{"type":"verse","marker":"v","eid":"PSA 57:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 57:5"},"Be thou exalted, O God, above the heavens; ",{"type":"char","marker":"add","content":["let"]}," thy glory ",{"type":"char","marker":"add","content":["be"]}," above all the earth. ",{"type":"verse","marker":"v","eid":"PSA 57:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 57:6"},"They have prepared a net for my steps; my soul is bowed down: they have digged a pit before me, into the midst whereof they are fallen ",{"type":"char","marker":"add","content":["themselves. "]},"Selah. ",{"type":"verse","marker":"v","eid":"PSA 57:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 57:7"},"My heart is fixed, O God, my heart is fixed: I will sing and give praise. ",{"type":"verse","marker":"v","eid":"PSA 57:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 57:8"},"Awake up, my glory; awake, psaltery and harp: I ",{"type":"char","marker":"add","content":["myself"]}," will awake early. ",{"type":"verse","marker":"v","eid":"PSA 57:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 57:9"},"I will praise thee, O Lord, among the people: I will sing unto thee among the nations. ",{"type":"verse","marker":"v","eid":"PSA 57:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 57:10"},"For thy mercy is great unto the heavens, and thy truth unto the clouds. ",{"type":"verse","marker":"v","eid":"PSA 57:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 57:11"},"Be thou exalted, O God, above the heavens: ",{"type":"char","marker":"add","content":["let"]}," thy glory ",{"type":"char","marker":"add","content":["be"]}," above all the earth. ",{"type":"verse","marker":"v","eid":"PSA 57:11"}]}]}
