{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":145,"content":[{"type":"para","marker":"d","content":["David’s ",{"type":"char","marker":"add","content":["Psalm"]}," of praise. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 145:1"},"I will extol thee, my God, O king; and I will bless thy name for ever and ever. ",{"type":"verse","marker":"v","eid":"PSA 145:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 145:2"},"Every day will I bless thee; and I will praise thy name for ever and ever. ",{"type":"verse","marker":"v","eid":"PSA 145:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 145:3"},"Great ",{"type":"char","marker":"add","content":["is"]}," the LORD, and greatly to be praised; and his greatness ",{"type":"char","marker":"add","content":["is"]}," unsearchable. ",{"type":"verse","marker":"v","eid":"PSA 145:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 145:4"},"One generation shall praise thy works to another, and shall declare thy mighty acts. ",{"type":"verse","marker":"v","eid":"PSA 145:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 145:5"},"I will speak of the glorious honour of thy majesty, and of thy wondrous works. ",{"type":"verse","marker":"v","eid":"PSA 145:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 145:6"},"And ",{"type":"char","marker":"add","content":["men"]}," shall speak of the might of thy terrible acts: and I will declare thy greatness. ",{"type":"verse","marker":"v","eid":"PSA 145:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 145:7"},"They shall abundantly utter the memory of thy great goodness, and shall sing of thy righteousness. ",{"type":"verse","marker":"v","eid":"PSA 145:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 145:8"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," gracious, and full of compassion; slow to anger, and of great mercy. ",{"type":"verse","marker":"v","eid":"PSA 145:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 145:9"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," good to all: and his tender mercies ",{"type":"char","marker":"add","content":["are "]},"over all his works. ",{"type":"verse","marker":"v","eid":"PSA 145:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 145:10"},"All thy works shall praise thee, O LORD; and thy saints shall bless thee. ",{"type":"verse","marker":"v","eid":"PSA 145:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 145:11"},"They shall speak of the glory of thy kingdom, and talk of thy power; ",{"type":"verse","marker":"v","eid":"PSA 145:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 145:12"},"To make known to the sons of men his mighty acts, and the glorious majesty of his kingdom. ",{"type":"verse","marker":"v","eid":"PSA 145:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 145:13"},"Thy kingdom ",{"type":"char","marker":"add","content":["is"]}," an everlasting kingdom, and thy dominion ",{"type":"char","marker":"add","content":["endureth"]}," throughout all generations. ",{"type":"verse","marker":"v","eid":"PSA 145:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 145:14"},"The LORD upholdeth all that fall, and raiseth up all ",{"type":"char","marker":"add","content":["those that be "]},"bowed down. ",{"type":"verse","marker":"v","eid":"PSA 145:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 145:15"},"The eyes of all wait upon thee; and thou givest them their meat in due season. ",{"type":"verse","marker":"v","eid":"PSA 145:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 145:16"},"Thou openest thine hand, and satisfiest the desire of every living thing. ",{"type":"verse","marker":"v","eid":"PSA 145:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 145:17"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," righteous in all his ways, and holy in all his works. ",{"type":"verse","marker":"v","eid":"PSA 145:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 145:18"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," nigh unto all them that call upon him, to all that call upon him in truth. ",{"type":"verse","marker":"v","eid":"PSA 145:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 145:19"},"He will fulfil the desire of them that fear him: he also will hear their cry, and will save them. ",{"type":"verse","marker":"v","eid":"PSA 145:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 145:20"},"The LORD preserveth all them that love him: but all the wicked will he destroy. ",{"type":"verse","marker":"v","eid":"PSA 145:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 145:21"},"My mouth shall speak the praise of the LORD: and let all flesh bless his holy name for ever and ever. ",{"type":"verse","marker":"v","eid":"PSA 145:21"}]}]}
