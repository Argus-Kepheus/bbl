{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":138,"content":[{"type":"para","marker":"d","content":["A ",{"type":"char","marker":"add","content":["Psalm"]}," of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 138:1"},"I will praise thee with my whole heart: before the gods will I sing praise unto thee. ",{"type":"verse","marker":"v","eid":"PSA 138:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 138:2"},"I will worship toward thy holy temple, and praise thy name for thy lovingkindness and for thy truth: for thou hast magnified thy word above all thy name. ",{"type":"verse","marker":"v","eid":"PSA 138:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 138:3"},"In the day when I cried thou answeredst me, ",{"type":"char","marker":"add","content":["and"]}," strengthenedst me ",{"type":"char","marker":"add","content":["with"]}," strength in my soul. ",{"type":"verse","marker":"v","eid":"PSA 138:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 138:4"},"All the kings of the earth shall praise thee, O LORD, when they hear the words of thy mouth. ",{"type":"verse","marker":"v","eid":"PSA 138:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 138:5"},"Yea, they shall sing in the ways of the LORD: for great ",{"type":"char","marker":"add","content":["is "]},"the glory of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 138:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 138:6"},"Though the LORD ",{"type":"char","marker":"add","content":["be"]}," high, yet hath he respect unto the lowly: but the proud he knoweth afar off. ",{"type":"verse","marker":"v","eid":"PSA 138:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 138:7"},"Though I walk in the midst of trouble, thou wilt revive me: thou shalt stretch forth thine hand against the wrath of mine enemies, and thy right hand shall save me. ",{"type":"verse","marker":"v","eid":"PSA 138:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 138:8"},"The LORD will perfect ",{"type":"char","marker":"add","content":["that which"]}," concerneth me: thy mercy, O LORD, ",{"type":"char","marker":"add","content":["endureth"]}," for ever: forsake not the works of thine own hands. ",{"type":"verse","marker":"v","eid":"PSA 138:8"}]}]}
