{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":87,"content":[{"type":"para","marker":"d","content":["A Psalm ",{"type":"char","marker":"add","content":["or"]}," Song for the sons of Korah. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 87:1"},"His foundation ",{"type":"char","marker":"add","content":["is"]}," in the holy mountains. ",{"type":"verse","marker":"v","eid":"PSA 87:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 87:2"},"The LORD loveth the gates of Zion more than all the dwellings of Jacob. ",{"type":"verse","marker":"v","eid":"PSA 87:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 87:3"},"Glorious things are spoken of thee, O city of God. Selah. ",{"type":"verse","marker":"v","eid":"PSA 87:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 87:4"},"I will make mention of Rahab and Babylon to them that know me: behold Philistia, and Tyre, with Ethiopia; this ",{"type":"char","marker":"add","content":["man"]}," was born there. ",{"type":"verse","marker":"v","eid":"PSA 87:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 87:5"},"And of Zion it shall be said, This and ",{"type":"char","marker":"add","content":["that man"]}," was born in her: and the highest himself shall establish her. ",{"type":"verse","marker":"v","eid":"PSA 87:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 87:6"},"The LORD shall count, when he writeth up the people, that this man was born there. Selah. ",{"type":"verse","marker":"v","eid":"PSA 87:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 87:7"},"As well the singers as the players on instruments ",{"type":"char","marker":"add","content":["shall be there: "]},"all my springs ",{"type":"char","marker":"add","content":["are"]}," in thee. ",{"type":"verse","marker":"v","eid":"PSA 87:7"}]}]}
