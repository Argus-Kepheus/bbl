{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":125,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 125:1"},"They that trust in the LORD ",{"type":"char","marker":"add","content":["shall be"]}," as mount Zion, ",{"type":"char","marker":"add","content":["which "]},"cannot be removed, ",{"type":"char","marker":"add","content":["but"]}," abideth for ever. ",{"type":"verse","marker":"v","eid":"PSA 125:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 125:2"},"As the mountains ",{"type":"char","marker":"add","content":["are"]}," round about Jerusalem, so the LORD ",{"type":"char","marker":"add","content":["is"]}," round about his people from henceforth even for ever. ",{"type":"verse","marker":"v","eid":"PSA 125:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 125:3"},"For the rod of the wicked shall not rest upon the lot of the righteous; lest the righteous put forth their hands unto iniquity. ",{"type":"verse","marker":"v","eid":"PSA 125:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 125:4"},"Do good, O LORD, unto ",{"type":"char","marker":"add","content":["those that be"]}," good, and ",{"type":"char","marker":"add","content":["to them that are"]}," upright in their hearts. ",{"type":"verse","marker":"v","eid":"PSA 125:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 125:5"},"As for such as turn aside unto their crooked ways, the LORD shall lead them forth with the workers of iniquity: ",{"type":"char","marker":"add","content":["but"]}," peace ",{"type":"char","marker":"add","content":["shall be "]},"upon Israel. ",{"type":"verse","marker":"v","eid":"PSA 125:5"}]}]}
