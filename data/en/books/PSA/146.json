{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":146,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 146:1"},"Praise ye the LORD. Praise the LORD, O my soul. ",{"type":"verse","marker":"v","eid":"PSA 146:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 146:2"},"While I live will I praise the LORD: I will sing praises unto my God while I have any being. ",{"type":"verse","marker":"v","eid":"PSA 146:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 146:3"},"Put not your trust in princes, ",{"type":"char","marker":"add","content":["nor"]}," in the son of man, in whom ",{"type":"char","marker":"add","content":["there is"]}," no help. ",{"type":"verse","marker":"v","eid":"PSA 146:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 146:4"},"His breath goeth forth, he returneth to his earth; in that very day his thoughts perish. ",{"type":"verse","marker":"v","eid":"PSA 146:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 146:5"},"Happy ",{"type":"char","marker":"add","content":["is he"]}," that ",{"type":"char","marker":"add","content":["hath"]}," the God of Jacob for his help, whose hope ",{"type":"char","marker":"add","content":["is"]}," in the LORD his God: ",{"type":"verse","marker":"v","eid":"PSA 146:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 146:6"},"Which made heaven, and earth, the sea, and all that therein ",{"type":"char","marker":"add","content":["is: "]},"which keepeth truth for ever: ",{"type":"verse","marker":"v","eid":"PSA 146:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 146:7"},"Which executeth judgment for the oppressed: which giveth food to the hungry. The LORD looseth the prisoners: ",{"type":"verse","marker":"v","eid":"PSA 146:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 146:8"},"The LORD openeth ",{"type":"char","marker":"add","content":["the eyes of"]}," the blind: the LORD raiseth them that are bowed down: the LORD loveth the righteous: ",{"type":"verse","marker":"v","eid":"PSA 146:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 146:9"},"The LORD preserveth the strangers; he relieveth the fatherless and widow: but the way of the wicked he turneth upside down. ",{"type":"verse","marker":"v","eid":"PSA 146:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 146:10"},"The LORD shall reign for ever, ",{"type":"char","marker":"add","content":["even"]}," thy God, O Zion, unto all generations. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 146:10"}]}]}
