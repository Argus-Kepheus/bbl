{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":62,"content":[{"type":"para","marker":"d","content":["To the chief Musician, to Jeduthun, A Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 62:1"},"Truly my soul waiteth upon God: from him ",{"type":"char","marker":"add","content":["cometh"]}," my salvation. ",{"type":"verse","marker":"v","eid":"PSA 62:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 62:2"},"He only ",{"type":"char","marker":"add","content":["is"]}," my rock and my salvation; ",{"type":"char","marker":"add","content":["he is"]}," my defence; I shall not be greatly moved. ",{"type":"verse","marker":"v","eid":"PSA 62:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 62:3"},"How long will ye imagine mischief against a man? ye shall be slain all of you: as a bowing wall ",{"type":"char","marker":"add","content":["shall ye be, and as"]}," a tottering fence. ",{"type":"verse","marker":"v","eid":"PSA 62:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 62:4"},"They only consult to cast ",{"type":"char","marker":"add","content":["him"]}," down from his excellency: they delight in lies: they bless with their mouth, but they curse inwardly. Selah. ",{"type":"verse","marker":"v","eid":"PSA 62:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 62:5"},"My soul, wait thou only upon God; for my expectation ",{"type":"char","marker":"add","content":["is"]}," from him. ",{"type":"verse","marker":"v","eid":"PSA 62:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 62:6"},"He only ",{"type":"char","marker":"add","content":["is"]}," my rock and my salvation: ",{"type":"char","marker":"add","content":["he is"]}," my defence; I shall not be moved. ",{"type":"verse","marker":"v","eid":"PSA 62:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 62:7"},"In God ",{"type":"char","marker":"add","content":["is"]}," my salvation and my glory: the rock of my strength, ",{"type":"char","marker":"add","content":["and"]}," my refuge, ",{"type":"char","marker":"add","content":["is"]}," in God. ",{"type":"verse","marker":"v","eid":"PSA 62:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 62:8"},"Trust in him at all times; ",{"type":"char","marker":"add","content":["ye"]}," people, pour out your heart before him: God ",{"type":"char","marker":"add","content":["is"]}," a refuge for us. Selah. ",{"type":"verse","marker":"v","eid":"PSA 62:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 62:9"},"Surely men of low degree ",{"type":"char","marker":"add","content":["are"]}," vanity, ",{"type":"char","marker":"add","content":["and"]}," men of high degree ",{"type":"char","marker":"add","content":["are"]}," a lie: to be laid in the balance, they ",{"type":"char","marker":"add","content":["are "]},"altogether ",{"type":"char","marker":"add","content":["lighter"]}," than vanity. ",{"type":"verse","marker":"v","eid":"PSA 62:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 62:10"},"Trust not in oppression, and become not vain in robbery: if riches increase, set not your heart ",{"type":"char","marker":"add","content":["upon them."]},{"type":"verse","marker":"v","eid":"PSA 62:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 62:11"},"God hath spoken once; twice have I heard this; that power ",{"type":"char","marker":"add","content":["belongeth "]},"unto God. ",{"type":"verse","marker":"v","eid":"PSA 62:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 62:12"},"Also unto thee, O Lord, ",{"type":"char","marker":"add","content":["belongeth"]}," mercy: for thou renderest to every man according to his work. ",{"type":"verse","marker":"v","eid":"PSA 62:12"}]}]}
