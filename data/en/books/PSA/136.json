{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":136,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 136:1"},"O give thanks unto the LORD; for ",{"type":"char","marker":"add","content":["he is"]}," good: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 136:2"},"O give thanks unto the God of gods: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 136:3"},"O give thanks to the Lord of lords: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 136:4"},"To him who alone doeth great wonders: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 136:5"},"To him that by wisdom made the heavens: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 136:6"},"To him that stretched out the earth above the waters: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 136:7"},"To him that made great lights: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 136:8"},"The sun to rule by day: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 136:9"},"The moon and stars to rule by night: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 136:10"},"To him that smote Egypt in their firstborn: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 136:11"},"And brought out Israel from among them: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 136:12"},"With a strong hand, and with a stretched out arm: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 136:13"},"To him which divided the Red sea into parts: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 136:14"},"And made Israel to pass through the midst of it: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 136:15"},"But overthrew Pharaoh and his host in the Red sea: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 136:16"},"To him which led his people through the wilderness: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 136:17"},"To him which smote great kings: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 136:18"},"And slew famous kings: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 136:19"},"Sihon king of the Amorites: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 136:20"},"And Og the king of Bashan: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 136:21"},"And gave their land for an heritage: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:21"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"22","sid":"PSA 136:22"},{"type":"char","marker":"add","content":["Even"]}," an heritage unto Israel his servant: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:22"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"23","sid":"PSA 136:23"},"Who remembered us in our low estate: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever: ",{"type":"verse","marker":"v","eid":"PSA 136:23"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"24","sid":"PSA 136:24"},"And hath redeemed us from our enemies: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:24"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"25","sid":"PSA 136:25"},"Who giveth food to all flesh: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:25"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"26","sid":"PSA 136:26"},"O give thanks unto the God of heaven: for his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 136:26"}]}]}
