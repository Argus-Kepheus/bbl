{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":84,"content":[{"type":"para","marker":"d","content":["To the chief Musician upon Gittith, A Psalm for the sons of Korah. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 84:1"},"How amiable ",{"type":"char","marker":"add","content":["are"]}," thy tabernacles, O LORD of hosts! ",{"type":"verse","marker":"v","eid":"PSA 84:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 84:2"},"My soul longeth, yea, even fainteth for the courts of the LORD: my heart and my flesh crieth out for the living God. ",{"type":"verse","marker":"v","eid":"PSA 84:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 84:3"},"Yea, the sparrow hath found an house, and the swallow a nest for herself, where she may lay her young, ",{"type":"char","marker":"add","content":["even"]}," thine altars, O LORD of hosts, my King, and my God. ",{"type":"verse","marker":"v","eid":"PSA 84:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 84:4"},"Blessed ",{"type":"char","marker":"add","content":["are"]}," they that dwell in thy house: they will be still praising thee. Selah. ",{"type":"verse","marker":"v","eid":"PSA 84:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 84:5"},"Blessed ",{"type":"char","marker":"add","content":["is"]}," the man whose strength ",{"type":"char","marker":"add","content":["is"]}," in thee; in whose heart ",{"type":"char","marker":"add","content":["are"]}," the ways ",{"type":"char","marker":"add","content":["of them."]},{"type":"verse","marker":"v","eid":"PSA 84:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 84:6"},{"type":"char","marker":"add","content":["Who"]}," passing through the valley of Baca make it a well; the rain also filleth the pools. ",{"type":"verse","marker":"v","eid":"PSA 84:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 84:7"},"They go from strength to strength, ",{"type":"char","marker":"add","content":["every one of them"]}," in Zion appeareth before God. ",{"type":"verse","marker":"v","eid":"PSA 84:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 84:8"},"O LORD God of hosts, hear my prayer: give ear, O God of Jacob. Selah. ",{"type":"verse","marker":"v","eid":"PSA 84:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 84:9"},"Behold, O God our shield, and look upon the face of thine anointed. ",{"type":"verse","marker":"v","eid":"PSA 84:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 84:10"},"For a day in thy courts ",{"type":"char","marker":"add","content":["is"]}," better than a thousand. I had rather be a doorkeeper in the house of my God, than to dwell in the tents of wickedness. ",{"type":"verse","marker":"v","eid":"PSA 84:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 84:11"},"For the LORD God ",{"type":"char","marker":"add","content":["is"]}," a sun and shield: the LORD will give grace and glory: no good ",{"type":"char","marker":"add","content":["thing"]}," will he withhold from them that walk uprightly. ",{"type":"verse","marker":"v","eid":"PSA 84:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 84:12"},"O LORD of hosts, blessed ",{"type":"char","marker":"add","content":["is"]}," the man that trusteth in thee. ",{"type":"verse","marker":"v","eid":"PSA 84:12"}]}]}
