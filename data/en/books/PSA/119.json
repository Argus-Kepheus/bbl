{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":119,"content":[{"type":"para","marker":"d","content":["ALEPH. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 119:1"},"Blessed ",{"type":"char","marker":"add","content":["are"]}," the undefiled in the way, who walk in the law of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 119:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 119:2"},"Blessed ",{"type":"char","marker":"add","content":["are"]}," they that keep his testimonies, ",{"type":"char","marker":"add","content":["and that "]},"seek him with the whole heart. ",{"type":"verse","marker":"v","eid":"PSA 119:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 119:3"},"They also do no iniquity: they walk in his ways. ",{"type":"verse","marker":"v","eid":"PSA 119:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 119:4"},"Thou hast commanded ",{"type":"char","marker":"add","content":["us"]}," to keep thy precepts diligently. ",{"type":"verse","marker":"v","eid":"PSA 119:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 119:5"},"O that my ways were directed to keep thy statutes! ",{"type":"verse","marker":"v","eid":"PSA 119:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 119:6"},"Then shall I not be ashamed, when I have respect unto all thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 119:7"},"I will praise thee with uprightness of heart, when I shall have learned thy righteous judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 119:8"},"I will keep thy statutes: O forsake me not utterly. ",{"type":"verse","marker":"v","eid":"PSA 119:8"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["BETH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 119:9"},"Wherewithal shall a young man cleanse his way? by taking heed ",{"type":"char","marker":"add","content":["thereto "]},"according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 119:10"},"With my whole heart have I sought thee: O let me not wander from thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 119:11"},"Thy word have I hid in mine heart, that I might not sin against thee. ",{"type":"verse","marker":"v","eid":"PSA 119:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 119:12"},"Blessed ",{"type":"char","marker":"add","content":["art"]}," thou, O LORD: teach me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 119:13"},"With my lips have I declared all the judgments of thy mouth. ",{"type":"verse","marker":"v","eid":"PSA 119:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 119:14"},"I have rejoiced in the way of thy testimonies, as ",{"type":"char","marker":"add","content":["much as "]},"in all riches. ",{"type":"verse","marker":"v","eid":"PSA 119:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 119:15"},"I will meditate in thy precepts, and have respect unto thy ways. ",{"type":"verse","marker":"v","eid":"PSA 119:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 119:16"},"I will delight myself in thy statutes: I will not forget thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:16"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["GIMEL. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 119:17"},"Deal bountifully with thy servant, ",{"type":"char","marker":"add","content":["that"]}," I may live, and keep thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 119:18"},"Open thou mine eyes, that I may behold wondrous things out of thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 119:19"},"I ",{"type":"char","marker":"add","content":["am"]}," a stranger in the earth: hide not thy commandments from me. ",{"type":"verse","marker":"v","eid":"PSA 119:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 119:20"},"My soul breaketh for the longing ",{"type":"char","marker":"add","content":["that it hath"]}," unto thy judgments at all times. ",{"type":"verse","marker":"v","eid":"PSA 119:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 119:21"},"Thou hast rebuked the proud ",{"type":"char","marker":"add","content":["that are"]}," cursed, which do err from thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:21"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"22","sid":"PSA 119:22"},"Remove from me reproach and contempt; for I have kept thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:22"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"23","sid":"PSA 119:23"},"Princes also did sit ",{"type":"char","marker":"add","content":["and"]}," speak against me: ",{"type":"char","marker":"add","content":["but "]},"thy servant did meditate in thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:23"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"24","sid":"PSA 119:24"},"Thy testimonies also ",{"type":"char","marker":"add","content":["are"]}," my delight ",{"type":"char","marker":"add","content":["and"]}," my counsellors. ",{"type":"verse","marker":"v","eid":"PSA 119:24"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["DALETH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"25","sid":"PSA 119:25"},"My soul cleaveth unto the dust: quicken thou me according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:25"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"26","sid":"PSA 119:26"},"I have declared my ways, and thou heardest me: teach me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:26"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"27","sid":"PSA 119:27"},"Make me to understand the way of thy precepts: so shall I talk of thy wondrous works. ",{"type":"verse","marker":"v","eid":"PSA 119:27"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"28","sid":"PSA 119:28"},"My soul melteth for heaviness: strengthen thou me according unto thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:28"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"29","sid":"PSA 119:29"},"Remove from me the way of lying: and grant me thy law graciously. ",{"type":"verse","marker":"v","eid":"PSA 119:29"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"30","sid":"PSA 119:30"},"I have chosen the way of truth: thy judgments have I laid ",{"type":"char","marker":"add","content":["before me."]},{"type":"verse","marker":"v","eid":"PSA 119:30"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"31","sid":"PSA 119:31"},"I have stuck unto thy testimonies: O LORD, put me not to shame. ",{"type":"verse","marker":"v","eid":"PSA 119:31"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"32","sid":"PSA 119:32"},"I will run the way of thy commandments, when thou shalt enlarge my heart. ",{"type":"verse","marker":"v","eid":"PSA 119:32"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["HE. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"33","sid":"PSA 119:33"},"Teach me, O LORD, the way of thy statutes; and I shall keep it ",{"type":"char","marker":"add","content":["unto"]}," the end. ",{"type":"verse","marker":"v","eid":"PSA 119:33"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"34","sid":"PSA 119:34"},"Give me understanding, and I shall keep thy law; yea, I shall observe it with ",{"type":"char","marker":"add","content":["my"]}," whole heart. ",{"type":"verse","marker":"v","eid":"PSA 119:34"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"35","sid":"PSA 119:35"},"Make me to go in the path of thy commandments; for therein do I delight. ",{"type":"verse","marker":"v","eid":"PSA 119:35"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"36","sid":"PSA 119:36"},"Incline my heart unto thy testimonies, and not to covetousness. ",{"type":"verse","marker":"v","eid":"PSA 119:36"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"37","sid":"PSA 119:37"},"Turn away mine eyes from beholding vanity; ",{"type":"char","marker":"add","content":["and"]}," quicken thou me in thy way. ",{"type":"verse","marker":"v","eid":"PSA 119:37"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"38","sid":"PSA 119:38"},"Stablish thy word unto thy servant, who ",{"type":"char","marker":"add","content":["is devoted"]}," to thy fear. ",{"type":"verse","marker":"v","eid":"PSA 119:38"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"39","sid":"PSA 119:39"},"Turn away my reproach which I fear: for thy judgments ",{"type":"char","marker":"add","content":["are "]},"good. ",{"type":"verse","marker":"v","eid":"PSA 119:39"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"40","sid":"PSA 119:40"},"Behold, I have longed after thy precepts: quicken me in thy righteousness. ",{"type":"verse","marker":"v","eid":"PSA 119:40"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["VAU. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"41","sid":"PSA 119:41"},"Let thy mercies come also unto me, O LORD, ",{"type":"char","marker":"add","content":["even"]}," thy salvation, according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:41"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"42","sid":"PSA 119:42"},"So shall I have wherewith to answer him that reproacheth me: for I trust in thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:42"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"43","sid":"PSA 119:43"},"And take not the word of truth utterly out of my mouth; for I have hoped in thy judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:43"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"44","sid":"PSA 119:44"},"So shall I keep thy law continually for ever and ever. ",{"type":"verse","marker":"v","eid":"PSA 119:44"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"45","sid":"PSA 119:45"},"And I will walk at liberty: for I seek thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:45"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"46","sid":"PSA 119:46"},"I will speak of thy testimonies also before kings, and will not be ashamed. ",{"type":"verse","marker":"v","eid":"PSA 119:46"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"47","sid":"PSA 119:47"},"And I will delight myself in thy commandments, which I have loved. ",{"type":"verse","marker":"v","eid":"PSA 119:47"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"48","sid":"PSA 119:48"},"My hands also will I lift up unto thy commandments, which I have loved; and I will meditate in thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:48"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["ZAIN "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"49","sid":"PSA 119:49"},"Remember the word unto thy servant, upon which thou hast caused me to hope. ",{"type":"verse","marker":"v","eid":"PSA 119:49"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"50","sid":"PSA 119:50"},"This ",{"type":"char","marker":"add","content":["is"]}," my comfort in my affliction: for thy word hath quickened me. ",{"type":"verse","marker":"v","eid":"PSA 119:50"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"51","sid":"PSA 119:51"},"The proud have had me greatly in derision: ",{"type":"char","marker":"add","content":["yet"]}," have I not declined from thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:51"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"52","sid":"PSA 119:52"},"I remembered thy judgments of old, O LORD; and have comforted myself. ",{"type":"verse","marker":"v","eid":"PSA 119:52"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"53","sid":"PSA 119:53"},"Horror hath taken hold upon me because of the wicked that forsake thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:53"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"54","sid":"PSA 119:54"},"Thy statutes have been my songs in the house of my pilgrimage. ",{"type":"verse","marker":"v","eid":"PSA 119:54"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"55","sid":"PSA 119:55"},"I have remembered thy name, O LORD, in the night, and have kept thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:55"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"56","sid":"PSA 119:56"},"This I had, because I kept thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:56"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["CHETH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"57","sid":"PSA 119:57"},{"type":"char","marker":"add","content":["Thou art"]}," my portion, O LORD: I have said that I would keep thy words. ",{"type":"verse","marker":"v","eid":"PSA 119:57"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"58","sid":"PSA 119:58"},"I intreated thy favour with ",{"type":"char","marker":"add","content":["my"]}," whole heart: be merciful unto me according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:58"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"59","sid":"PSA 119:59"},"I thought on my ways, and turned my feet unto thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:59"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"60","sid":"PSA 119:60"},"I made haste, and delayed not to keep thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:60"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"61","sid":"PSA 119:61"},"The bands of the wicked have robbed me: ",{"type":"char","marker":"add","content":["but"]}," I have not forgotten thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:61"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"62","sid":"PSA 119:62"},"At midnight I will rise to give thanks unto thee because of thy righteous judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:62"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"63","sid":"PSA 119:63"},"I ",{"type":"char","marker":"add","content":["am"]}," a companion of all ",{"type":"char","marker":"add","content":["them"]}," that fear thee, and of them that keep thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:63"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"64","sid":"PSA 119:64"},"The earth, O LORD, is full of thy mercy: teach me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:64"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["TETH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"65","sid":"PSA 119:65"},"Thou hast dealt well with thy servant, O LORD, according unto thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:65"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"66","sid":"PSA 119:66"},"Teach me good judgment and knowledge: for I have believed thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:66"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"67","sid":"PSA 119:67"},"Before I was afflicted I went astray: but now have I kept thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:67"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"68","sid":"PSA 119:68"},"Thou ",{"type":"char","marker":"add","content":["art"]}," good, and doest good; teach me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:68"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"69","sid":"PSA 119:69"},"The proud have forged a lie against me: ",{"type":"char","marker":"add","content":["but"]}," I will keep thy precepts with ",{"type":"char","marker":"add","content":["my"]}," whole heart. ",{"type":"verse","marker":"v","eid":"PSA 119:69"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"70","sid":"PSA 119:70"},"Their heart is as fat as grease; ",{"type":"char","marker":"add","content":["but"]}," I delight in thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:70"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"71","sid":"PSA 119:71"},{"type":"char","marker":"add","content":["It is"]}," good for me that I have been afflicted; that I might learn thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:71"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"72","sid":"PSA 119:72"},"The law of thy mouth ",{"type":"char","marker":"add","content":["is"]}," better unto me than thousands of gold and silver. ",{"type":"verse","marker":"v","eid":"PSA 119:72"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["JOD. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"73","sid":"PSA 119:73"},"Thy hands have made me and fashioned me: give me understanding, that I may learn thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:73"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"74","sid":"PSA 119:74"},"They that fear thee will be glad when they see me; because I have hoped in thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:74"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"75","sid":"PSA 119:75"},"I know, O LORD, that thy judgments ",{"type":"char","marker":"add","content":["are"]}," right, and that ",{"type":"char","marker":"add","content":["thou"]}," in faithfulness hast afflicted me. ",{"type":"verse","marker":"v","eid":"PSA 119:75"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"76","sid":"PSA 119:76"},"Let, I pray thee, thy merciful kindness be for my comfort, according to thy word unto thy servant. ",{"type":"verse","marker":"v","eid":"PSA 119:76"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"77","sid":"PSA 119:77"},"Let thy tender mercies come unto me, that I may live: for thy law ",{"type":"char","marker":"add","content":["is"]}," my delight. ",{"type":"verse","marker":"v","eid":"PSA 119:77"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"78","sid":"PSA 119:78"},"Let the proud be ashamed; for they dealt perversely with me without a cause: ",{"type":"char","marker":"add","content":["but"]}," I will meditate in thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:78"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"79","sid":"PSA 119:79"},"Let those that fear thee turn unto me, and those that have known thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:79"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"80","sid":"PSA 119:80"},"Let my heart be sound in thy statutes; that I be not ashamed. ",{"type":"verse","marker":"v","eid":"PSA 119:80"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["CAPH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"81","sid":"PSA 119:81"},"My soul fainteth for thy salvation: ",{"type":"char","marker":"add","content":["but"]}," I hope in thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:81"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"82","sid":"PSA 119:82"},"Mine eyes fail for thy word, saying, When wilt thou comfort me? ",{"type":"verse","marker":"v","eid":"PSA 119:82"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"83","sid":"PSA 119:83"},"For I am become like a bottle in the smoke; ",{"type":"char","marker":"add","content":["yet"]}," do I not forget thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:83"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"84","sid":"PSA 119:84"},"How many ",{"type":"char","marker":"add","content":["are"]}," the days of thy servant? when wilt thou execute judgment on them that persecute me? ",{"type":"verse","marker":"v","eid":"PSA 119:84"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"85","sid":"PSA 119:85"},"The proud have digged pits for me, which ",{"type":"char","marker":"add","content":["are"]}," not after thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:85"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"86","sid":"PSA 119:86"},"All thy commandments ",{"type":"char","marker":"add","content":["are"]}," faithful: they persecute me wrongfully; help thou me. ",{"type":"verse","marker":"v","eid":"PSA 119:86"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"87","sid":"PSA 119:87"},"They had almost consumed me upon earth; but I forsook not thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:87"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"88","sid":"PSA 119:88"},"Quicken me after thy lovingkindness; so shall I keep the testimony of thy mouth. ",{"type":"verse","marker":"v","eid":"PSA 119:88"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["LAMED. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"89","sid":"PSA 119:89"},"For ever, O LORD, thy word is settled in heaven. ",{"type":"verse","marker":"v","eid":"PSA 119:89"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"90","sid":"PSA 119:90"},"Thy faithfulness ",{"type":"char","marker":"add","content":["is"]}," unto all generations: thou hast established the earth, and it abideth. ",{"type":"verse","marker":"v","eid":"PSA 119:90"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"91","sid":"PSA 119:91"},"They continue this day according to thine ordinances: for all ",{"type":"char","marker":"add","content":["are"]}," thy servants. ",{"type":"verse","marker":"v","eid":"PSA 119:91"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"92","sid":"PSA 119:92"},"Unless thy law ",{"type":"char","marker":"add","content":["had been"]}," my delights, I should then have perished in mine affliction. ",{"type":"verse","marker":"v","eid":"PSA 119:92"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"93","sid":"PSA 119:93"},"I will never forget thy precepts: for with them thou hast quickened me. ",{"type":"verse","marker":"v","eid":"PSA 119:93"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"94","sid":"PSA 119:94"},"I ",{"type":"char","marker":"add","content":["am"]}," thine, save me; for I have sought thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:94"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"95","sid":"PSA 119:95"},"The wicked have waited for me to destroy me: ",{"type":"char","marker":"add","content":["but"]}," I will consider thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:95"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"96","sid":"PSA 119:96"},"I have seen an end of all perfection: ",{"type":"char","marker":"add","content":["but"]}," thy commandment ",{"type":"char","marker":"add","content":["is"]}," exceeding broad. ",{"type":"verse","marker":"v","eid":"PSA 119:96"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["MEM. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"97","sid":"PSA 119:97"},"O how love I thy law! it ",{"type":"char","marker":"add","content":["is"]}," my meditation all the day. ",{"type":"verse","marker":"v","eid":"PSA 119:97"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"98","sid":"PSA 119:98"},"Thou through thy commandments hast made me wiser than mine enemies: for they ",{"type":"char","marker":"add","content":["are"]}," ever with me. ",{"type":"verse","marker":"v","eid":"PSA 119:98"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"99","sid":"PSA 119:99"},"I have more understanding than all my teachers: for thy testimonies ",{"type":"char","marker":"add","content":["are"]}," my meditation. ",{"type":"verse","marker":"v","eid":"PSA 119:99"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"100","sid":"PSA 119:100"},"I understand more than the ancients, because I keep thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:100"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"101","sid":"PSA 119:101"},"I have refrained my feet from every evil way, that I might keep thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:101"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"102","sid":"PSA 119:102"},"I have not departed from thy judgments: for thou hast taught me. ",{"type":"verse","marker":"v","eid":"PSA 119:102"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"103","sid":"PSA 119:103"},"How sweet are thy words unto my taste! ",{"type":"char","marker":"add","content":["yea, sweeter"]}," than honey to my mouth! ",{"type":"verse","marker":"v","eid":"PSA 119:103"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"104","sid":"PSA 119:104"},"Through thy precepts I get understanding: therefore I hate every false way. ",{"type":"verse","marker":"v","eid":"PSA 119:104"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["NUN. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"105","sid":"PSA 119:105"},"Thy word ",{"type":"char","marker":"add","content":["is"]}," a lamp unto my feet, and a light unto my path. ",{"type":"verse","marker":"v","eid":"PSA 119:105"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"106","sid":"PSA 119:106"},"I have sworn, and I will perform ",{"type":"char","marker":"add","content":["it,"]}," that I will keep thy righteous judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:106"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"107","sid":"PSA 119:107"},"I am afflicted very much: quicken me, O LORD, according unto thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:107"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"108","sid":"PSA 119:108"},"Accept, I beseech thee, the freewill offerings of my mouth, O LORD, and teach me thy judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:108"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"109","sid":"PSA 119:109"},"My soul ",{"type":"char","marker":"add","content":["is"]}," continually in my hand: yet do I not forget thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:109"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"110","sid":"PSA 119:110"},"The wicked have laid a snare for me: yet I erred not from thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:110"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"111","sid":"PSA 119:111"},"Thy testimonies have I taken as an heritage for ever: for they ",{"type":"char","marker":"add","content":["are"]}," the rejoicing of my heart. ",{"type":"verse","marker":"v","eid":"PSA 119:111"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"112","sid":"PSA 119:112"},"I have inclined mine heart to perform thy statutes alway, ",{"type":"char","marker":"add","content":["even unto"]}," the end. ",{"type":"verse","marker":"v","eid":"PSA 119:112"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["SAMECH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"113","sid":"PSA 119:113"},"I hate ",{"type":"char","marker":"add","content":["vain"]}," thoughts: but thy law do I love. ",{"type":"verse","marker":"v","eid":"PSA 119:113"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"114","sid":"PSA 119:114"},"Thou ",{"type":"char","marker":"add","content":["art"]}," my hiding place and my shield: I hope in thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:114"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"115","sid":"PSA 119:115"},"Depart from me, ye evildoers: for I will keep the commandments of my God. ",{"type":"verse","marker":"v","eid":"PSA 119:115"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"116","sid":"PSA 119:116"},"Uphold me according unto thy word, that I may live: and let me not be ashamed of my hope. ",{"type":"verse","marker":"v","eid":"PSA 119:116"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"117","sid":"PSA 119:117"},"Hold thou me up, and I shall be safe: and I will have respect unto thy statutes continually. ",{"type":"verse","marker":"v","eid":"PSA 119:117"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"118","sid":"PSA 119:118"},"Thou hast trodden down all them that err from thy statutes: for their deceit ",{"type":"char","marker":"add","content":["is"]}," falsehood. ",{"type":"verse","marker":"v","eid":"PSA 119:118"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"119","sid":"PSA 119:119"},"Thou puttest away all the wicked of the earth ",{"type":"char","marker":"add","content":["like"]}," dross: therefore I love thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:119"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"120","sid":"PSA 119:120"},"My flesh trembleth for fear of thee; and I am afraid of thy judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:120"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["AIN. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"121","sid":"PSA 119:121"},"I have done judgment and justice: leave me not to mine oppressors. ",{"type":"verse","marker":"v","eid":"PSA 119:121"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"122","sid":"PSA 119:122"},"Be surety for thy servant for good: let not the proud oppress me. ",{"type":"verse","marker":"v","eid":"PSA 119:122"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"123","sid":"PSA 119:123"},"Mine eyes fail for thy salvation, and for the word of thy righteousness. ",{"type":"verse","marker":"v","eid":"PSA 119:123"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"124","sid":"PSA 119:124"},"Deal with thy servant according unto thy mercy, and teach me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:124"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"125","sid":"PSA 119:125"},"I ",{"type":"char","marker":"add","content":["am"]}," thy servant; give me understanding, that I may know thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:125"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"126","sid":"PSA 119:126"},{"type":"char","marker":"add","content":["It is"]}," time for ",{"type":"char","marker":"add","content":["thee,"]}," LORD, to work: ",{"type":"char","marker":"add","content":["for "]},"they have made void thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:126"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"127","sid":"PSA 119:127"},"Therefore I love thy commandments above gold; yea, above fine gold. ",{"type":"verse","marker":"v","eid":"PSA 119:127"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"128","sid":"PSA 119:128"},"Therefore I esteem all ",{"type":"char","marker":"add","content":["thy"]}," precepts ",{"type":"char","marker":"add","content":["concerning "]},"all ",{"type":"char","marker":"add","content":["things to be"]}," right; ",{"type":"char","marker":"add","content":["and"]}," I hate every false way. ",{"type":"verse","marker":"v","eid":"PSA 119:128"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["PE. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"129","sid":"PSA 119:129"},"Thy testimonies ",{"type":"char","marker":"add","content":["are"]}," wonderful: therefore doth my soul keep them. ",{"type":"verse","marker":"v","eid":"PSA 119:129"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"130","sid":"PSA 119:130"},"The entrance of thy words giveth light; it giveth understanding unto the simple. ",{"type":"verse","marker":"v","eid":"PSA 119:130"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"131","sid":"PSA 119:131"},"I opened my mouth, and panted: for I longed for thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:131"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"132","sid":"PSA 119:132"},"Look thou upon me, and be merciful unto me, as thou usest to do unto those that love thy name. ",{"type":"verse","marker":"v","eid":"PSA 119:132"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"133","sid":"PSA 119:133"},"Order my steps in thy word: and let not any iniquity have dominion over me. ",{"type":"verse","marker":"v","eid":"PSA 119:133"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"134","sid":"PSA 119:134"},"Deliver me from the oppression of man: so will I keep thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:134"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"135","sid":"PSA 119:135"},"Make thy face to shine upon thy servant; and teach me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:135"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"136","sid":"PSA 119:136"},"Rivers of waters run down mine eyes, because they keep not thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:136"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["TZADDE. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"137","sid":"PSA 119:137"},"Righteous ",{"type":"char","marker":"add","content":["art"]}," thou, O LORD, and upright ",{"type":"char","marker":"add","content":["are"]}," thy judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:137"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"138","sid":"PSA 119:138"},"Thy testimonies ",{"type":"char","marker":"add","content":["that"]}," thou hast commanded ",{"type":"char","marker":"add","content":["are"]}," righteous and very faithful. ",{"type":"verse","marker":"v","eid":"PSA 119:138"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"139","sid":"PSA 119:139"},"My zeal hath consumed me, because mine enemies have forgotten thy words. ",{"type":"verse","marker":"v","eid":"PSA 119:139"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"140","sid":"PSA 119:140"},"Thy word ",{"type":"char","marker":"add","content":["is"]}," very pure: therefore thy servant loveth it. ",{"type":"verse","marker":"v","eid":"PSA 119:140"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"141","sid":"PSA 119:141"},"I ",{"type":"char","marker":"add","content":["am"]}," small and despised: ",{"type":"char","marker":"add","content":["yet"]}," do not I forget thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:141"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"142","sid":"PSA 119:142"},"Thy righteousness ",{"type":"char","marker":"add","content":["is"]}," an everlasting righteousness, and thy law ",{"type":"char","marker":"add","content":["is"]}," the truth. ",{"type":"verse","marker":"v","eid":"PSA 119:142"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"143","sid":"PSA 119:143"},"Trouble and anguish have taken hold on me: ",{"type":"char","marker":"add","content":["yet"]}," thy commandments ",{"type":"char","marker":"add","content":["are"]}," my delights. ",{"type":"verse","marker":"v","eid":"PSA 119:143"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"144","sid":"PSA 119:144"},"The righteousness of thy testimonies ",{"type":"char","marker":"add","content":["is"]}," everlasting: give me understanding, and I shall live. ",{"type":"verse","marker":"v","eid":"PSA 119:144"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["KOPH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"145","sid":"PSA 119:145"},"I cried with ",{"type":"char","marker":"add","content":["my"]}," whole heart; hear me, O LORD: I will keep thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:145"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"146","sid":"PSA 119:146"},"I cried unto thee; save me, and I shall keep thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:146"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"147","sid":"PSA 119:147"},"I prevented the dawning of the morning, and cried: I hoped in thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:147"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"148","sid":"PSA 119:148"},"Mine eyes prevent the ",{"type":"char","marker":"add","content":["night"]}," watches, that I might meditate in thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:148"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"149","sid":"PSA 119:149"},"Hear my voice according unto thy lovingkindness: O LORD, quicken me according to thy judgment. ",{"type":"verse","marker":"v","eid":"PSA 119:149"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"150","sid":"PSA 119:150"},"They draw nigh that follow after mischief: they are far from thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:150"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"151","sid":"PSA 119:151"},"Thou ",{"type":"char","marker":"add","content":["art"]}," near, O LORD; and all thy commandments ",{"type":"char","marker":"add","content":["are "]},"truth. ",{"type":"verse","marker":"v","eid":"PSA 119:151"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"152","sid":"PSA 119:152"},"Concerning thy testimonies, I have known of old that thou hast founded them for ever. ",{"type":"verse","marker":"v","eid":"PSA 119:152"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["RESH. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"153","sid":"PSA 119:153"},"Consider mine affliction, and deliver me: for I do not forget thy law. ",{"type":"verse","marker":"v","eid":"PSA 119:153"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"154","sid":"PSA 119:154"},"Plead my cause, and deliver me: quicken me according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:154"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"155","sid":"PSA 119:155"},"Salvation ",{"type":"char","marker":"add","content":["is"]}," far from the wicked: for they seek not thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:155"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"156","sid":"PSA 119:156"},"Great ",{"type":"char","marker":"add","content":["are"]}," thy tender mercies, O LORD: quicken me according to thy judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:156"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"157","sid":"PSA 119:157"},"Many ",{"type":"char","marker":"add","content":["are"]}," my persecutors and mine enemies; ",{"type":"char","marker":"add","content":["yet "]},"do I not decline from thy testimonies. ",{"type":"verse","marker":"v","eid":"PSA 119:157"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"158","sid":"PSA 119:158"},"I beheld the transgressors, and was grieved; because they kept not thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:158"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"159","sid":"PSA 119:159"},"Consider how I love thy precepts: quicken me, O LORD, according to thy lovingkindness. ",{"type":"verse","marker":"v","eid":"PSA 119:159"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"160","sid":"PSA 119:160"},"Thy word ",{"type":"char","marker":"add","content":["is"]}," true ",{"type":"char","marker":"add","content":["from"]}," the beginning: and every one of thy righteous judgments ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 119:160"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["SCHIN. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"161","sid":"PSA 119:161"},"Princes have persecuted me without a cause: but my heart standeth in awe of thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:161"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"162","sid":"PSA 119:162"},"I rejoice at thy word, as one that findeth great spoil. ",{"type":"verse","marker":"v","eid":"PSA 119:162"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"163","sid":"PSA 119:163"},"I hate and abhor lying: ",{"type":"char","marker":"add","content":["but"]}," thy law do I love. ",{"type":"verse","marker":"v","eid":"PSA 119:163"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"164","sid":"PSA 119:164"},"Seven times a day do I praise thee because of thy righteous judgments. ",{"type":"verse","marker":"v","eid":"PSA 119:164"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"165","sid":"PSA 119:165"},"Great peace have they which love thy law: and nothing shall offend them. ",{"type":"verse","marker":"v","eid":"PSA 119:165"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"166","sid":"PSA 119:166"},"LORD, I have hoped for thy salvation, and done thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:166"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"167","sid":"PSA 119:167"},"My soul hath kept thy testimonies; and I love them exceedingly. ",{"type":"verse","marker":"v","eid":"PSA 119:167"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"168","sid":"PSA 119:168"},"I have kept thy precepts and thy testimonies: for all my ways ",{"type":"char","marker":"add","content":["are"]}," before thee. ",{"type":"verse","marker":"v","eid":"PSA 119:168"}]},{"type":"para","marker":"b"},{"type":"para","marker":"d","content":["TAU. "]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"169","sid":"PSA 119:169"},"Let my cry come near before thee, O LORD: give me understanding according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:169"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"170","sid":"PSA 119:170"},"Let my supplication come before thee: deliver me according to thy word. ",{"type":"verse","marker":"v","eid":"PSA 119:170"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"171","sid":"PSA 119:171"},"My lips shall utter praise, when thou hast taught me thy statutes. ",{"type":"verse","marker":"v","eid":"PSA 119:171"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"172","sid":"PSA 119:172"},"My tongue shall speak of thy word: for all thy commandments ",{"type":"char","marker":"add","content":["are "]},"righteousness. ",{"type":"verse","marker":"v","eid":"PSA 119:172"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"173","sid":"PSA 119:173"},"Let thine hand help me; for I have chosen thy precepts. ",{"type":"verse","marker":"v","eid":"PSA 119:173"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"174","sid":"PSA 119:174"},"I have longed for thy salvation, O LORD; and thy law ",{"type":"char","marker":"add","content":["is "]},"my delight. ",{"type":"verse","marker":"v","eid":"PSA 119:174"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"175","sid":"PSA 119:175"},"Let my soul live, and it shall praise thee; and let thy judgments help me. ",{"type":"verse","marker":"v","eid":"PSA 119:175"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"176","sid":"PSA 119:176"},"I have gone astray like a lost sheep; seek thy servant; for I do not forget thy commandments. ",{"type":"verse","marker":"v","eid":"PSA 119:176"}]}]}
