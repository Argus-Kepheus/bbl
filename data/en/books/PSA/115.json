{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":115,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 115:1"},"Not unto us, O LORD, not unto us, but unto thy name give glory, for thy mercy, ",{"type":"char","marker":"add","content":["and"]}," for thy truth’s sake. ",{"type":"verse","marker":"v","eid":"PSA 115:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 115:2"},"Wherefore should the heathen say, Where ",{"type":"char","marker":"add","content":["is"]}," now their God? ",{"type":"verse","marker":"v","eid":"PSA 115:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 115:3"},"But our God ",{"type":"char","marker":"add","content":["is"]}," in the heavens: he hath done whatsoever he hath pleased. ",{"type":"verse","marker":"v","eid":"PSA 115:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 115:4"},"Their idols ",{"type":"char","marker":"add","content":["are"]}," silver and gold, the work of men’s hands. ",{"type":"verse","marker":"v","eid":"PSA 115:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 115:5"},"They have mouths, but they speak not: eyes have they, but they see not: ",{"type":"verse","marker":"v","eid":"PSA 115:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 115:6"},"They have ears, but they hear not: noses have they, but they smell not: ",{"type":"verse","marker":"v","eid":"PSA 115:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 115:7"},"They have hands, but they handle not: feet have they, but they walk not: neither speak they through their throat. ",{"type":"verse","marker":"v","eid":"PSA 115:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 115:8"},"They that make them are like unto them; ",{"type":"char","marker":"add","content":["so is"]}," every one that trusteth in them. ",{"type":"verse","marker":"v","eid":"PSA 115:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 115:9"},"O Israel, trust thou in the LORD: he ",{"type":"char","marker":"add","content":["is"]}," their help and their shield. ",{"type":"verse","marker":"v","eid":"PSA 115:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 115:10"},"O house of Aaron, trust in the LORD: he ",{"type":"char","marker":"add","content":["is"]}," their help and their shield. ",{"type":"verse","marker":"v","eid":"PSA 115:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 115:11"},"Ye that fear the LORD, trust in the LORD: he ",{"type":"char","marker":"add","content":["is"]}," their help and their shield. ",{"type":"verse","marker":"v","eid":"PSA 115:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 115:12"},"The LORD hath been mindful of us: he will bless ",{"type":"char","marker":"add","content":["us;"]}," he will bless the house of Israel; he will bless the house of Aaron. ",{"type":"verse","marker":"v","eid":"PSA 115:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 115:13"},"He will bless them that fear the LORD, ",{"type":"char","marker":"add","content":["both"]}," small and great. ",{"type":"verse","marker":"v","eid":"PSA 115:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 115:14"},"The LORD shall increase you more and more, you and your children. ",{"type":"verse","marker":"v","eid":"PSA 115:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 115:15"},"Ye ",{"type":"char","marker":"add","content":["are"]}," blessed of the LORD which made heaven and earth. ",{"type":"verse","marker":"v","eid":"PSA 115:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 115:16"},"The heaven, ",{"type":"char","marker":"add","content":["even"]}," the heavens, ",{"type":"char","marker":"add","content":["are"]}," the LORD’S: but the earth hath he given to the children of men. ",{"type":"verse","marker":"v","eid":"PSA 115:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 115:17"},"The dead praise not the LORD, neither any that go down into silence. ",{"type":"verse","marker":"v","eid":"PSA 115:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 115:18"},"But we will bless the LORD from this time forth and for evermore. Praise the LORD. ",{"type":"verse","marker":"v","eid":"PSA 115:18"}]}]}
