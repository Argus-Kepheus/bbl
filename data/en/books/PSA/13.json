{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":13,"content":[{"type":"para","marker":"d","content":["To the chief Musician, A Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 13:1"},"How long wilt thou forget me, O LORD? for ever? how long wilt thou hide thy face from me? ",{"type":"verse","marker":"v","eid":"PSA 13:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 13:2"},"How long shall I take counsel in my soul, ",{"type":"char","marker":"add","content":["having"]}," sorrow in my heart daily? how long shall mine enemy be exalted over me? ",{"type":"verse","marker":"v","eid":"PSA 13:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 13:3"},"Consider ",{"type":"char","marker":"add","content":["and"]}," hear me, O LORD my God: lighten mine eyes, lest I sleep the ",{"type":"char","marker":"add","content":["sleep of"]}," death; ",{"type":"verse","marker":"v","eid":"PSA 13:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 13:4"},"Lest mine enemy say, I have prevailed against him; ",{"type":"char","marker":"add","content":["and"]}," those that trouble me rejoice when I am moved. ",{"type":"verse","marker":"v","eid":"PSA 13:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 13:5"},"But I have trusted in thy mercy; my heart shall rejoice in thy salvation. ",{"type":"verse","marker":"v","eid":"PSA 13:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 13:6"},"I will sing unto the LORD, because he hath dealt bountifully with me. ",{"type":"verse","marker":"v","eid":"PSA 13:6"}]}]}
