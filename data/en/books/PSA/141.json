{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":141,"content":[{"type":"para","marker":"d","content":["A Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 141:1"},"LORD, I cry unto thee: make haste unto me; give ear unto my voice, when I cry unto thee. ",{"type":"verse","marker":"v","eid":"PSA 141:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 141:2"},"Let my prayer be set forth before thee ",{"type":"char","marker":"add","content":["as"]}," incense; ",{"type":"char","marker":"add","content":["and "]},"the lifting up of my hands ",{"type":"char","marker":"add","content":["as"]}," the evening sacrifice. ",{"type":"verse","marker":"v","eid":"PSA 141:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 141:3"},"Set a watch, O LORD, before my mouth; keep the door of my lips. ",{"type":"verse","marker":"v","eid":"PSA 141:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 141:4"},"Incline not my heart to ",{"type":"char","marker":"add","content":["any"]}," evil thing, to practise wicked works with men that work iniquity: and let me not eat of their dainties. ",{"type":"verse","marker":"v","eid":"PSA 141:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 141:5"},"Let the righteous smite me; ",{"type":"char","marker":"add","content":["it shall be"]}," a kindness: and let him reprove me; ",{"type":"char","marker":"add","content":["it shall be"]}," an excellent oil, ",{"type":"char","marker":"add","content":["which"]}," shall not break my head: for yet my prayer also ",{"type":"char","marker":"add","content":["shall be"]}," in their calamities. ",{"type":"verse","marker":"v","eid":"PSA 141:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 141:6"},"When their judges are overthrown in stony places, they shall hear my words; for they are sweet. ",{"type":"verse","marker":"v","eid":"PSA 141:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 141:7"},"Our bones are scattered at the grave’s mouth, as when one cutteth and cleaveth ",{"type":"char","marker":"add","content":["wood"]}," upon the earth. ",{"type":"verse","marker":"v","eid":"PSA 141:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 141:8"},"But mine eyes ",{"type":"char","marker":"add","content":["are"]}," unto thee, O GOD the Lord: in thee is my trust; leave not my soul destitute. ",{"type":"verse","marker":"v","eid":"PSA 141:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 141:9"},"Keep me from the snares ",{"type":"char","marker":"add","content":["which"]}," they have laid for me, and the gins of the workers of iniquity. ",{"type":"verse","marker":"v","eid":"PSA 141:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 141:10"},"Let the wicked fall into their own nets, whilst that I withal escape. ",{"type":"verse","marker":"v","eid":"PSA 141:10"}]}]}
