{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":60,"content":[{"type":"para","marker":"d","content":["To the chief Musician upon Shushan-eduth, Michtam of David, to teach; when he strove with Aram-naharaim and with Aram-zobah, when Joab returned, and smote of Edom in the valley of salt twelve thousand. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 60:1"},"O God, thou hast cast us off, thou hast scattered us, thou hast been displeased; O turn thyself to us again. ",{"type":"verse","marker":"v","eid":"PSA 60:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 60:2"},"Thou hast made the earth to tremble; thou hast broken it: heal the breaches thereof; for it shaketh. ",{"type":"verse","marker":"v","eid":"PSA 60:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 60:3"},"Thou hast shewed thy people hard things: thou hast made us to drink the wine of astonishment. ",{"type":"verse","marker":"v","eid":"PSA 60:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 60:4"},"Thou hast given a banner to them that fear thee, that it may be displayed because of the truth. Selah. ",{"type":"verse","marker":"v","eid":"PSA 60:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 60:5"},"That thy beloved may be delivered; save ",{"type":"char","marker":"add","content":["with"]}," thy right hand, and hear me. ",{"type":"verse","marker":"v","eid":"PSA 60:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 60:6"},"God hath spoken in his holiness; I will rejoice, I will divide Shechem, and mete out the valley of Succoth. ",{"type":"verse","marker":"v","eid":"PSA 60:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 60:7"},"Gilead ",{"type":"char","marker":"add","content":["is"]}," mine, and Manasseh ",{"type":"char","marker":"add","content":["is"]}," mine; Ephraim also ",{"type":"char","marker":"add","content":["is"]}," the strength of mine head; Judah ",{"type":"char","marker":"add","content":["is"]}," my lawgiver; ",{"type":"verse","marker":"v","eid":"PSA 60:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 60:8"},"Moab ",{"type":"char","marker":"add","content":["is"]}," my washpot; over Edom will I cast out my shoe: Philistia, triumph thou because of me. ",{"type":"verse","marker":"v","eid":"PSA 60:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 60:9"},"Who will bring me ",{"type":"char","marker":"add","content":["into"]}," the strong city? who will lead me into Edom? ",{"type":"verse","marker":"v","eid":"PSA 60:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 60:10"},{"type":"char","marker":"add","content":["Wilt"]}," not thou, O God, ",{"type":"char","marker":"add","content":["which"]}," hadst cast us off? and ",{"type":"char","marker":"add","content":["thou,"]}," O God, ",{"type":"char","marker":"add","content":["which"]}," didst not go out with our armies? ",{"type":"verse","marker":"v","eid":"PSA 60:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 60:11"},"Give us help from trouble: for vain ",{"type":"char","marker":"add","content":["is"]}," the help of man. ",{"type":"verse","marker":"v","eid":"PSA 60:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 60:12"},"Through God we shall do valiantly: for he ",{"type":"char","marker":"add","content":["it is that"]}," shall tread down our enemies. ",{"type":"verse","marker":"v","eid":"PSA 60:12"}]}]}
