{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":75,"content":[{"type":"para","marker":"d","content":["To the chief Musician, Altaschith, A Psalm ",{"type":"char","marker":"add","content":["or"]}," Song of Asaph. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 75:1"},"Unto thee, O God, do we give thanks, ",{"type":"char","marker":"add","content":["unto thee"]}," do we give thanks: for ",{"type":"char","marker":"add","content":["that"]}," thy name is near thy wondrous works declare. ",{"type":"verse","marker":"v","eid":"PSA 75:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 75:2"},"When I shall receive the congregation I will judge uprightly. ",{"type":"verse","marker":"v","eid":"PSA 75:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 75:3"},"The earth and all the inhabitants thereof are dissolved: I bear up the pillars of it. Selah. ",{"type":"verse","marker":"v","eid":"PSA 75:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 75:4"},"I said unto the fools, Deal not foolishly: and to the wicked, Lift not up the horn: ",{"type":"verse","marker":"v","eid":"PSA 75:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 75:5"},"Lift not up your horn on high: speak ",{"type":"char","marker":"add","content":["not with"]}," a stiff neck. ",{"type":"verse","marker":"v","eid":"PSA 75:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 75:6"},"For promotion ",{"type":"char","marker":"add","content":["cometh"]}," neither from the east, nor from the west, nor from the south. ",{"type":"verse","marker":"v","eid":"PSA 75:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 75:7"},"But God ",{"type":"char","marker":"add","content":["is"]}," the judge: he putteth down one, and setteth up another. ",{"type":"verse","marker":"v","eid":"PSA 75:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 75:8"},"For in the hand of the LORD ",{"type":"char","marker":"add","content":["there is"]}," a cup, and the wine is red; it is full of mixture; and he poureth out of the same: but the dregs thereof, all the wicked of the earth shall wring ",{"type":"char","marker":"add","content":["them"]}," out, ",{"type":"char","marker":"add","content":["and"]}," drink ",{"type":"char","marker":"add","content":["them."]},{"type":"verse","marker":"v","eid":"PSA 75:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 75:9"},"But I will declare for ever; I will sing praises to the God of Jacob. ",{"type":"verse","marker":"v","eid":"PSA 75:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 75:10"},"All the horns of the wicked also will I cut off; ",{"type":"char","marker":"add","content":["but"]}," the horns of the righteous shall be exalted. ",{"type":"verse","marker":"v","eid":"PSA 75:10"}]}]}
