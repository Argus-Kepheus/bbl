{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":113,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 113:1"},"Praise ye the LORD. Praise, O ye servants of the LORD, praise the name of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 113:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 113:2"},"Blessed be the name of the LORD from this time forth and for evermore. ",{"type":"verse","marker":"v","eid":"PSA 113:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 113:3"},"From the rising of the sun unto the going down of the same the LORD’S name ",{"type":"char","marker":"add","content":["is"]}," to be praised. ",{"type":"verse","marker":"v","eid":"PSA 113:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 113:4"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," high above all nations, ",{"type":"char","marker":"add","content":["and"]}," his glory above the heavens. ",{"type":"verse","marker":"v","eid":"PSA 113:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 113:5"},"Who ",{"type":"char","marker":"add","content":["is"]}," like unto the LORD our God, who dwelleth on high, ",{"type":"verse","marker":"v","eid":"PSA 113:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 113:6"},"Who humbleth ",{"type":"char","marker":"add","content":["himself"]}," to behold ",{"type":"char","marker":"add","content":["the things that are "]},"in heaven, and in the earth! ",{"type":"verse","marker":"v","eid":"PSA 113:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 113:7"},"He raiseth up the poor out of the dust, ",{"type":"char","marker":"add","content":["and"]}," lifteth the needy out of the dunghill; ",{"type":"verse","marker":"v","eid":"PSA 113:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 113:8"},"That he may set ",{"type":"char","marker":"add","content":["him"]}," with princes, ",{"type":"char","marker":"add","content":["even"]}," with the princes of his people. ",{"type":"verse","marker":"v","eid":"PSA 113:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 113:9"},"He maketh the barren woman to keep house, ",{"type":"char","marker":"add","content":["and to be"]}," a joyful mother of children. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 113:9"}]}]}
