{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":15,"content":[{"type":"para","marker":"d","content":["A Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 15:1"},"LORD, who shall abide in thy tabernacle? who shall dwell in thy holy hill? ",{"type":"verse","marker":"v","eid":"PSA 15:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 15:2"},"He that walketh uprightly, and worketh righteousness, and speaketh the truth in his heart. ",{"type":"verse","marker":"v","eid":"PSA 15:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 15:3"},{"type":"char","marker":"add","content":["He that"]}," backbiteth not with his tongue, nor doeth evil to his neighbour, nor taketh up a reproach against his neighbour. ",{"type":"verse","marker":"v","eid":"PSA 15:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 15:4"},"In whose eyes a vile person is contemned; but he honoureth them that fear the LORD. ",{"type":"char","marker":"add","content":["He that"]}," sweareth to ",{"type":"char","marker":"add","content":["his own"]}," hurt, and changeth not. ",{"type":"verse","marker":"v","eid":"PSA 15:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 15:5"},{"type":"char","marker":"add","content":["He that"]}," putteth not out his money to usury, nor taketh reward against the innocent. He that doeth these ",{"type":"char","marker":"add","content":["things"]}," shall never be moved. ",{"type":"verse","marker":"v","eid":"PSA 15:5"}]}]}
