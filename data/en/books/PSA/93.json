{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":93,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 93:1"},"The LORD reigneth, he is clothed with majesty; the LORD is clothed with strength, ",{"type":"char","marker":"add","content":["wherewith"]}," he hath girded himself: the world also is stablished, that it cannot be moved. ",{"type":"verse","marker":"v","eid":"PSA 93:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 93:2"},"Thy throne ",{"type":"char","marker":"add","content":["is"]}," established of old: thou ",{"type":"char","marker":"add","content":["art"]}," from everlasting. ",{"type":"verse","marker":"v","eid":"PSA 93:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 93:3"},"The floods have lifted up, O LORD, the floods have lifted up their voice; the floods lift up their waves. ",{"type":"verse","marker":"v","eid":"PSA 93:3"}]},{"type":"para","marker":"b"},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 93:4"},"The LORD on high ",{"type":"char","marker":"add","content":["is"]}," mightier than the noise of many waters, ",{"type":"char","marker":"add","content":["yea, than"]}," the mighty waves of the sea. ",{"type":"verse","marker":"v","eid":"PSA 93:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 93:5"},"Thy testimonies are very sure: holiness becometh thine house, O LORD, for ever. ",{"type":"verse","marker":"v","eid":"PSA 93:5"}]}]}
