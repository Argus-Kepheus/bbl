{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":34,"content":[{"type":"para","marker":"d","content":["A ",{"type":"char","marker":"add","content":["Psalm"]}," of David, when he changed his behaviour before Abimelech; who drove him away, and he departed. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 34:1"},"I will bless the LORD at all times: his praise ",{"type":"char","marker":"add","content":["shall"]}," continually ",{"type":"char","marker":"add","content":["be"]}," in my mouth. ",{"type":"verse","marker":"v","eid":"PSA 34:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 34:2"},"My soul shall make her boast in the LORD: the humble shall hear ",{"type":"char","marker":"add","content":["thereof,"]}," and be glad. ",{"type":"verse","marker":"v","eid":"PSA 34:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 34:3"},"O magnify the LORD with me, and let us exalt his name together. ",{"type":"verse","marker":"v","eid":"PSA 34:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 34:4"},"I sought the LORD, and he heard me, and delivered me from all my fears. ",{"type":"verse","marker":"v","eid":"PSA 34:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 34:5"},"They looked unto him, and were lightened: and their faces were not ashamed. ",{"type":"verse","marker":"v","eid":"PSA 34:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 34:6"},"This poor man cried, and the LORD heard ",{"type":"char","marker":"add","content":["him,"]}," and saved him out of all his troubles. ",{"type":"verse","marker":"v","eid":"PSA 34:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 34:7"},"The angel of the LORD encampeth round about them that fear him, and delivereth them. ",{"type":"verse","marker":"v","eid":"PSA 34:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 34:8"},"O taste and see that the LORD ",{"type":"char","marker":"add","content":["is"]}," good: blessed ",{"type":"char","marker":"add","content":["is "]},"the man ",{"type":"char","marker":"add","content":["that"]}," trusteth in him. ",{"type":"verse","marker":"v","eid":"PSA 34:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 34:9"},"O fear the LORD, ye his saints: for ",{"type":"char","marker":"add","content":["there is"]}," no want to them that fear him. ",{"type":"verse","marker":"v","eid":"PSA 34:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 34:10"},"The young lions do lack, and suffer hunger: but they that seek the LORD shall not want any good ",{"type":"char","marker":"add","content":["thing."]},{"type":"verse","marker":"v","eid":"PSA 34:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 34:11"},"Come, ye children, hearken unto me: I will teach you the fear of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 34:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 34:12"},"What man ",{"type":"char","marker":"add","content":["is he that"]}," desireth life, ",{"type":"char","marker":"add","content":["and"]}," loveth ",{"type":"char","marker":"add","content":["many"]}," days, that he may see good? ",{"type":"verse","marker":"v","eid":"PSA 34:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 34:13"},"Keep thy tongue from evil, and thy lips from speaking guile. ",{"type":"verse","marker":"v","eid":"PSA 34:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 34:14"},"Depart from evil, and do good; seek peace, and pursue it. ",{"type":"verse","marker":"v","eid":"PSA 34:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 34:15"},"The eyes of the LORD ",{"type":"char","marker":"add","content":["are"]}," upon the righteous, and his ears ",{"type":"char","marker":"add","content":["are open"]}," unto their cry. ",{"type":"verse","marker":"v","eid":"PSA 34:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 34:16"},"The face of the LORD ",{"type":"char","marker":"add","content":["is"]}," against them that do evil, to cut off the remembrance of them from the earth. ",{"type":"verse","marker":"v","eid":"PSA 34:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 34:17"},{"type":"char","marker":"add","content":["The righteous"]}," cry, and the LORD heareth, and delivereth them out of all their troubles. ",{"type":"verse","marker":"v","eid":"PSA 34:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 34:18"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," nigh unto them that are of a broken heart; and saveth such as be of a contrite spirit. ",{"type":"verse","marker":"v","eid":"PSA 34:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 34:19"},"Many ",{"type":"char","marker":"add","content":["are"]}," the afflictions of the righteous: but the LORD delivereth him out of them all. ",{"type":"verse","marker":"v","eid":"PSA 34:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 34:20"},"He keepeth all his bones: not one of them is broken. ",{"type":"verse","marker":"v","eid":"PSA 34:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 34:21"},"Evil shall slay the wicked: and they that hate the righteous shall be desolate. ",{"type":"verse","marker":"v","eid":"PSA 34:21"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"22","sid":"PSA 34:22"},"The LORD redeemeth the soul of his servants: and none of them that trust in him shall be desolate. ",{"type":"verse","marker":"v","eid":"PSA 34:22"}]}]}
