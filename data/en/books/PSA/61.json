{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":61,"content":[{"type":"para","marker":"d","content":["To the chief Musician upon Neginah, A ",{"type":"char","marker":"add","content":["Psalm"]}," of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 61:1"},"Hear my cry, O God; attend unto my prayer. ",{"type":"verse","marker":"v","eid":"PSA 61:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 61:2"},"From the end of the earth will I cry unto thee, when my heart is overwhelmed: lead me to the rock ",{"type":"char","marker":"add","content":["that"]}," is higher than I. ",{"type":"verse","marker":"v","eid":"PSA 61:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 61:3"},"For thou hast been a shelter for me, ",{"type":"char","marker":"add","content":["and"]}," a strong tower from the enemy. ",{"type":"verse","marker":"v","eid":"PSA 61:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 61:4"},"I will abide in thy tabernacle for ever: I will trust in the covert of thy wings. Selah. ",{"type":"verse","marker":"v","eid":"PSA 61:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 61:5"},"For thou, O God, hast heard my vows: thou hast given ",{"type":"char","marker":"add","content":["me"]}," the heritage of those that fear thy name. ",{"type":"verse","marker":"v","eid":"PSA 61:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 61:6"},"Thou wilt prolong the king’s life: ",{"type":"char","marker":"add","content":["and"]}," his years as many generations. ",{"type":"verse","marker":"v","eid":"PSA 61:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 61:7"},"He shall abide before God for ever: O prepare mercy and truth, ",{"type":"char","marker":"add","content":["which"]}," may preserve him. ",{"type":"verse","marker":"v","eid":"PSA 61:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 61:8"},"So will I sing praise unto thy name for ever, that I may daily perform my vows. ",{"type":"verse","marker":"v","eid":"PSA 61:8"}]}]}
