{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":86,"content":[{"type":"para","marker":"d","content":["A Prayer of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 86:1"},"Bow down thine ear, O LORD, hear me: for I ",{"type":"char","marker":"add","content":["am"]}," poor and needy. ",{"type":"verse","marker":"v","eid":"PSA 86:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 86:2"},"Preserve my soul; for I ",{"type":"char","marker":"add","content":["am"]}," holy: O thou my God, save thy servant that trusteth in thee. ",{"type":"verse","marker":"v","eid":"PSA 86:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 86:3"},"Be merciful unto me, O Lord: for I cry unto thee daily. ",{"type":"verse","marker":"v","eid":"PSA 86:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 86:4"},"Rejoice the soul of thy servant: for unto thee, O Lord, do I lift up my soul. ",{"type":"verse","marker":"v","eid":"PSA 86:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 86:5"},"For thou, Lord, ",{"type":"char","marker":"add","content":["art"]}," good, and ready to forgive; and plenteous in mercy unto all them that call upon thee. ",{"type":"verse","marker":"v","eid":"PSA 86:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 86:6"},"Give ear, O LORD, unto my prayer; and attend to the voice of my supplications. ",{"type":"verse","marker":"v","eid":"PSA 86:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 86:7"},"In the day of my trouble I will call upon thee: for thou wilt answer me. ",{"type":"verse","marker":"v","eid":"PSA 86:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 86:8"},"Among the gods ",{"type":"char","marker":"add","content":["there is"]}," none like unto thee, O Lord; neither ",{"type":"char","marker":"add","content":["are there any works"]}," like unto thy works. ",{"type":"verse","marker":"v","eid":"PSA 86:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 86:9"},"All nations whom thou hast made shall come and worship before thee, O Lord; and shall glorify thy name. ",{"type":"verse","marker":"v","eid":"PSA 86:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 86:10"},"For thou ",{"type":"char","marker":"add","content":["art"]}," great, and doest wondrous things: thou ",{"type":"char","marker":"add","content":["art"]}," God alone. ",{"type":"verse","marker":"v","eid":"PSA 86:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 86:11"},"Teach me thy way, O LORD; I will walk in thy truth: unite my heart to fear thy name. ",{"type":"verse","marker":"v","eid":"PSA 86:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 86:12"},"I will praise thee, O Lord my God, with all my heart: and I will glorify thy name for evermore. ",{"type":"verse","marker":"v","eid":"PSA 86:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 86:13"},"For great ",{"type":"char","marker":"add","content":["is"]}," thy mercy toward me: and thou hast delivered my soul from the lowest hell. ",{"type":"verse","marker":"v","eid":"PSA 86:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 86:14"},"O God, the proud are risen against me, and the assemblies of violent ",{"type":"char","marker":"add","content":["men"]}," have sought after my soul; and have not set thee before them. ",{"type":"verse","marker":"v","eid":"PSA 86:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 86:15"},"But thou, O Lord, ",{"type":"char","marker":"add","content":["art"]}," a God full of compassion, and gracious, longsuffering, and plenteous in mercy and truth. ",{"type":"verse","marker":"v","eid":"PSA 86:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 86:16"},"O turn unto me, and have mercy upon me; give thy strength unto thy servant, and save the son of thine handmaid. ",{"type":"verse","marker":"v","eid":"PSA 86:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 86:17"},"Show me a token for good; that they which hate me may see ",{"type":"char","marker":"add","content":["it, "]},"and be ashamed: because thou, LORD, hast helped me, and comforted me. ",{"type":"verse","marker":"v","eid":"PSA 86:17"}]}]}
