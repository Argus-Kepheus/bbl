{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":120,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 120:1"},"In my distress I cried unto the LORD, and he heard me. ",{"type":"verse","marker":"v","eid":"PSA 120:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 120:2"},"Deliver my soul, O LORD, from lying lips, ",{"type":"char","marker":"add","content":["and"]}," from a deceitful tongue. ",{"type":"verse","marker":"v","eid":"PSA 120:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 120:3"},"What shall be given unto thee? or what shall be done unto thee, thou false tongue? ",{"type":"verse","marker":"v","eid":"PSA 120:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 120:4"},"Sharp arrows of the mighty, with coals of juniper. ",{"type":"verse","marker":"v","eid":"PSA 120:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 120:5"},"Woe is me, that I sojourn in Mesech, ",{"type":"char","marker":"add","content":["that"]}," I dwell in the tents of Kedar! ",{"type":"verse","marker":"v","eid":"PSA 120:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 120:6"},"My soul hath long dwelt with him that hateth peace. ",{"type":"verse","marker":"v","eid":"PSA 120:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 120:7"},"I ",{"type":"char","marker":"add","content":["am for"]}," peace: but when I speak, they ",{"type":"char","marker":"add","content":["are"]}," for war. ",{"type":"verse","marker":"v","eid":"PSA 120:7"}]}]}
