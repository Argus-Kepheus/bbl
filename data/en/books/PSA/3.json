{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":3,"content":[{"type":"para","marker":"d","content":["A Psalm of David, when he fled from Absalom his son. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 3:1"},"LORD, how are they increased that trouble me! many ",{"type":"char","marker":"add","content":["are"]}," they that rise up against me. ",{"type":"verse","marker":"v","eid":"PSA 3:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 3:2"},"Many ",{"type":"char","marker":"add","content":["there be"]}," which say of my soul, ",{"type":"char","marker":"add","content":["There is"]}," no help for him in God. Selah. ",{"type":"verse","marker":"v","eid":"PSA 3:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 3:3"},"But thou, O LORD, ",{"type":"char","marker":"add","content":["art"]}," a shield for me; my glory, and the lifter up of mine head. ",{"type":"verse","marker":"v","eid":"PSA 3:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 3:4"},"I cried unto the LORD with my voice, and he heard me out of his holy hill. Selah. ",{"type":"verse","marker":"v","eid":"PSA 3:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 3:5"},"I laid me down and slept; I awaked; for the LORD sustained me. ",{"type":"verse","marker":"v","eid":"PSA 3:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 3:6"},"I will not be afraid of ten thousands of people, that have set ",{"type":"char","marker":"add","content":["themselves"]}," against me round about. ",{"type":"verse","marker":"v","eid":"PSA 3:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 3:7"},"Arise, O LORD; save me, O my God: for thou hast smitten all mine enemies ",{"type":"char","marker":"add","content":["upon"]}," the cheek bone; thou hast broken the teeth of the ungodly. ",{"type":"verse","marker":"v","eid":"PSA 3:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 3:8"},"Salvation ",{"type":"char","marker":"add","content":["belongeth"]}," unto the LORD: thy blessing ",{"type":"char","marker":"add","content":["is "]},"upon thy people. Selah. ",{"type":"verse","marker":"v","eid":"PSA 3:8"}]}]}
