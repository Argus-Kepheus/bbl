{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":130,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 130:1"},"Out of the depths have I cried unto thee, O LORD. ",{"type":"verse","marker":"v","eid":"PSA 130:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 130:2"},"Lord, hear my voice: let thine ears be attentive to the voice of my supplications. ",{"type":"verse","marker":"v","eid":"PSA 130:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 130:3"},"If thou, LORD, shouldest mark iniquities, O Lord, who shall stand? ",{"type":"verse","marker":"v","eid":"PSA 130:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 130:4"},"But ",{"type":"char","marker":"add","content":["there is"]}," forgiveness with thee, that thou mayest be feared. ",{"type":"verse","marker":"v","eid":"PSA 130:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 130:5"},"I wait for the LORD, my soul doth wait, and in his word do I hope. ",{"type":"verse","marker":"v","eid":"PSA 130:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 130:6"},"My soul ",{"type":"char","marker":"add","content":["waiteth"]}," for the Lord more than they that watch for the morning: ",{"type":"char","marker":"add","content":["I say, more than"]}," they that watch for the morning. ",{"type":"verse","marker":"v","eid":"PSA 130:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 130:7"},"Let Israel hope in the LORD: for with the LORD ",{"type":"char","marker":"add","content":["there is"]}," mercy, and with him ",{"type":"char","marker":"add","content":["is"]}," plenteous redemption. ",{"type":"verse","marker":"v","eid":"PSA 130:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 130:8"},"And he shall redeem Israel from all his iniquities. ",{"type":"verse","marker":"v","eid":"PSA 130:8"}]}]}
