{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":127,"content":[{"type":"para","marker":"d","content":["A Song of degrees for Solomon. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 127:1"},"Except the LORD build the house, they labour in vain that build it: except the LORD keep the city, the watchman waketh ",{"type":"char","marker":"add","content":["but"]}," in vain. ",{"type":"verse","marker":"v","eid":"PSA 127:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 127:2"},{"type":"char","marker":"add","content":["It is"]}," vain for you to rise up early, to sit up late, to eat the bread of sorrows: ",{"type":"char","marker":"add","content":["for"]}," so he giveth his beloved sleep. ",{"type":"verse","marker":"v","eid":"PSA 127:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 127:3"},"Lo, children ",{"type":"char","marker":"add","content":["are"]}," an heritage of the LORD: ",{"type":"char","marker":"add","content":["and"]}," the fruit of the womb ",{"type":"char","marker":"add","content":["is his"]}," reward. ",{"type":"verse","marker":"v","eid":"PSA 127:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 127:4"},"As arrows ",{"type":"char","marker":"add","content":["are"]}," in the hand of a mighty man; so ",{"type":"char","marker":"add","content":["are "]},"children of the youth. ",{"type":"verse","marker":"v","eid":"PSA 127:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 127:5"},"Happy ",{"type":"char","marker":"add","content":["is"]}," the man that hath his quiver full of them: they shall not be ashamed, but they shall speak with the enemies in the gate. ",{"type":"verse","marker":"v","eid":"PSA 127:5"}]}]}
