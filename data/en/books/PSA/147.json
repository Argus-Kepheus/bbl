{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":147,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 147:1"},"Praise ye the LORD: for ",{"type":"char","marker":"add","content":["it is"]}," good to sing praises unto our God; for ",{"type":"char","marker":"add","content":["it is"]}," pleasant; ",{"type":"char","marker":"add","content":["and"]}," praise is comely. ",{"type":"verse","marker":"v","eid":"PSA 147:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 147:2"},"The LORD doth build up Jerusalem: he gathereth together the outcasts of Israel. ",{"type":"verse","marker":"v","eid":"PSA 147:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 147:3"},"He healeth the broken in heart, and bindeth up their wounds. ",{"type":"verse","marker":"v","eid":"PSA 147:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 147:4"},"He telleth the number of the stars; he calleth them all by ",{"type":"char","marker":"add","content":["their "]},"names. ",{"type":"verse","marker":"v","eid":"PSA 147:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 147:5"},"Great ",{"type":"char","marker":"add","content":["is"]}," our Lord, and of great power: his understanding ",{"type":"char","marker":"add","content":["is"]}," infinite. ",{"type":"verse","marker":"v","eid":"PSA 147:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 147:6"},"The LORD lifteth up the meek: he casteth the wicked down to the ground. ",{"type":"verse","marker":"v","eid":"PSA 147:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 147:7"},"Sing unto the LORD with thanksgiving; sing praise upon the harp unto our God: ",{"type":"verse","marker":"v","eid":"PSA 147:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 147:8"},"Who covereth the heaven with clouds, who prepareth rain for the earth, who maketh grass to grow upon the mountains. ",{"type":"verse","marker":"v","eid":"PSA 147:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 147:9"},"He giveth to the beast his food, ",{"type":"char","marker":"add","content":["and"]}," to the young ravens which cry. ",{"type":"verse","marker":"v","eid":"PSA 147:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 147:10"},"He delighteth not in the strength of the horse: he taketh not pleasure in the legs of a man. ",{"type":"verse","marker":"v","eid":"PSA 147:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 147:11"},"The LORD taketh pleasure in them that fear him, in those that hope in his mercy. ",{"type":"verse","marker":"v","eid":"PSA 147:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 147:12"},"Praise the LORD, O Jerusalem; praise thy God, O Zion. ",{"type":"verse","marker":"v","eid":"PSA 147:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 147:13"},"For he hath strengthened the bars of thy gates; he hath blessed thy children within thee. ",{"type":"verse","marker":"v","eid":"PSA 147:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 147:14"},"He maketh peace ",{"type":"char","marker":"add","content":["in"]}," thy borders, ",{"type":"char","marker":"add","content":["and"]}," filleth thee with the finest of the wheat. ",{"type":"verse","marker":"v","eid":"PSA 147:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 147:15"},"He sendeth forth his commandment ",{"type":"char","marker":"add","content":["upon"]}," earth: his word runneth very swiftly. ",{"type":"verse","marker":"v","eid":"PSA 147:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 147:16"},"He giveth snow like wool: he scattereth the hoar frost like ashes. ",{"type":"verse","marker":"v","eid":"PSA 147:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 147:17"},"He casteth forth his ice like morsels: who can stand before his cold? ",{"type":"verse","marker":"v","eid":"PSA 147:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 147:18"},"He sendeth out his word, and melteth them: he causeth his wind to blow, ",{"type":"char","marker":"add","content":["and"]}," the waters flow. ",{"type":"verse","marker":"v","eid":"PSA 147:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 147:19"},"He sheweth his word unto Jacob, his statutes and his judgments unto Israel. ",{"type":"verse","marker":"v","eid":"PSA 147:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 147:20"},"He hath not dealt so with any nation: and ",{"type":"char","marker":"add","content":["as for his"]}," judgments, they have not known them. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 147:20"}]}]}
