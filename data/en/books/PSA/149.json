{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":149,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 149:1"},"Praise ye the LORD. Sing unto the LORD a new song, ",{"type":"char","marker":"add","content":["and"]}," his praise in the congregation of saints. ",{"type":"verse","marker":"v","eid":"PSA 149:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 149:2"},"Let Israel rejoice in him that made him: let the children of Zion be joyful in their King. ",{"type":"verse","marker":"v","eid":"PSA 149:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 149:3"},"Let them praise his name in the dance: let them sing praises unto him with the timbrel and harp. ",{"type":"verse","marker":"v","eid":"PSA 149:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 149:4"},"For the LORD taketh pleasure in his people: he will beautify the meek with salvation. ",{"type":"verse","marker":"v","eid":"PSA 149:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 149:5"},"Let the saints be joyful in glory: let them sing aloud upon their beds. ",{"type":"verse","marker":"v","eid":"PSA 149:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 149:6"},{"type":"char","marker":"add","content":["Let"]}," the high ",{"type":"char","marker":"add","content":["praises"]}," of God ",{"type":"char","marker":"add","content":["be"]}," in their mouth, and a twoedged sword in their hand; ",{"type":"verse","marker":"v","eid":"PSA 149:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 149:7"},"To execute vengeance upon the heathen, ",{"type":"char","marker":"add","content":["and"]}," punishments upon the people; ",{"type":"verse","marker":"v","eid":"PSA 149:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 149:8"},"To bind their kings with chains, and their nobles with fetters of iron; ",{"type":"verse","marker":"v","eid":"PSA 149:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 149:9"},"To execute upon them the judgment written: this honour have all his saints. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 149:9"}]}]}
