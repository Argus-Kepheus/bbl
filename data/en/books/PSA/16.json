{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":16,"content":[{"type":"para","marker":"d","content":["Michtam of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 16:1"},"Preserve me, O God: for in thee do I put my trust. ",{"type":"verse","marker":"v","eid":"PSA 16:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 16:2"},{"type":"char","marker":"add","content":["O my soul,"]}," thou hast said unto the LORD, Thou ",{"type":"char","marker":"add","content":["art "]},"my Lord: my goodness ",{"type":"char","marker":"add","content":["extendeth"]}," not to thee; ",{"type":"verse","marker":"v","eid":"PSA 16:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 16:3"},{"type":"char","marker":"add","content":["But"]}," to the saints that ",{"type":"char","marker":"add","content":["are"]}," in the earth, and ",{"type":"char","marker":"add","content":["to"]}," the excellent, in whom ",{"type":"char","marker":"add","content":["is"]}," all my delight. ",{"type":"verse","marker":"v","eid":"PSA 16:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 16:4"},"Their sorrows shall be multiplied ",{"type":"char","marker":"add","content":["that"]}," hasten ",{"type":"char","marker":"add","content":["after "]},"another ",{"type":"char","marker":"add","content":["god:"]}," their drink offerings of blood will I not offer, nor take up their names into my lips. ",{"type":"verse","marker":"v","eid":"PSA 16:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 16:5"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," the portion of mine inheritance and of my cup: thou maintainest my lot. ",{"type":"verse","marker":"v","eid":"PSA 16:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 16:6"},"The lines are fallen unto me in pleasant ",{"type":"char","marker":"add","content":["places;"]}," yea, I have a goodly heritage. ",{"type":"verse","marker":"v","eid":"PSA 16:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 16:7"},"I will bless the LORD, who hath given me counsel: my reins also instruct me in the night seasons. ",{"type":"verse","marker":"v","eid":"PSA 16:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 16:8"},"I have set the LORD always before me: because ",{"type":"char","marker":"add","content":["he is"]}," at my right hand, I shall not be moved. ",{"type":"verse","marker":"v","eid":"PSA 16:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 16:9"},"Therefore my heart is glad, and my glory rejoiceth: my flesh also shall rest in hope. ",{"type":"verse","marker":"v","eid":"PSA 16:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 16:10"},"For thou wilt not leave my soul in hell; neither wilt thou suffer thine Holy One to see corruption. ",{"type":"verse","marker":"v","eid":"PSA 16:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 16:11"},"Thou wilt shew me the path of life: in thy presence ",{"type":"char","marker":"add","content":["is"]}," fulness of joy; at thy right hand ",{"type":"char","marker":"add","content":["there are"]}," pleasures for evermore. ",{"type":"verse","marker":"v","eid":"PSA 16:11"}]}]}
