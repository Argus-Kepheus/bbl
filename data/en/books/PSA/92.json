{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":92,"content":[{"type":"para","marker":"d","content":["A Psalm ",{"type":"char","marker":"add","content":["or"]}," Song for the sabbath day. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 92:1"},{"type":"char","marker":"add","content":["It is a"]}," good ",{"type":"char","marker":"add","content":["thing"]}," to give thanks unto the LORD, and to sing praises unto thy name, O most High: ",{"type":"verse","marker":"v","eid":"PSA 92:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 92:2"},"To shew forth thy lovingkindness in the morning, and thy faithfulness every night, ",{"type":"verse","marker":"v","eid":"PSA 92:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 92:3"},"Upon an instrument of ten strings, and upon the psaltery; upon the harp with a solemn sound. ",{"type":"verse","marker":"v","eid":"PSA 92:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 92:4"},"For thou, LORD, hast made me glad through thy work: I will triumph in the works of thy hands. ",{"type":"verse","marker":"v","eid":"PSA 92:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 92:5"},"O LORD, how great are thy works! ",{"type":"char","marker":"add","content":["and"]}," thy thoughts are very deep. ",{"type":"verse","marker":"v","eid":"PSA 92:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 92:6"},"A brutish man knoweth not; neither doth a fool understand this. ",{"type":"verse","marker":"v","eid":"PSA 92:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 92:7"},"When the wicked spring as the grass, and when all the workers of iniquity do flourish; ",{"type":"char","marker":"add","content":["it is"]}," that they shall be destroyed for ever: ",{"type":"verse","marker":"v","eid":"PSA 92:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 92:8"},"But thou, LORD, ",{"type":"char","marker":"add","content":["art most"]}," high for evermore. ",{"type":"verse","marker":"v","eid":"PSA 92:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 92:9"},"For, lo, thine enemies, O LORD, for, lo, thine enemies shall perish; all the workers of iniquity shall be scattered. ",{"type":"verse","marker":"v","eid":"PSA 92:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 92:10"},"But my horn shalt thou exalt like ",{"type":"char","marker":"add","content":["the horn of"]}," an unicorn: I shall be anointed with fresh oil. ",{"type":"verse","marker":"v","eid":"PSA 92:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 92:11"},"Mine eye also shall see ",{"type":"char","marker":"add","content":["my desire"]}," on mine enemies, ",{"type":"char","marker":"add","content":["and "]},"mine ears shall hear ",{"type":"char","marker":"add","content":["my desire"]}," of the wicked that rise up against me. ",{"type":"verse","marker":"v","eid":"PSA 92:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 92:12"},"The righteous shall flourish like the palm tree: he shall grow like a cedar in Lebanon. ",{"type":"verse","marker":"v","eid":"PSA 92:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 92:13"},"Those that be planted in the house of the LORD shall flourish in the courts of our God. ",{"type":"verse","marker":"v","eid":"PSA 92:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 92:14"},"They shall still bring forth fruit in old age; they shall be fat and flourishing; ",{"type":"verse","marker":"v","eid":"PSA 92:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 92:15"},"To shew that the LORD ",{"type":"char","marker":"add","content":["is"]}," upright: ",{"type":"char","marker":"add","content":["he is"]}," my rock, and ",{"type":"char","marker":"add","content":["there is"]}," no unrighteousness in him. ",{"type":"verse","marker":"v","eid":"PSA 92:15"}]}]}
