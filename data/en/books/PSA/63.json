{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":63,"content":[{"type":"para","marker":"d","content":["A Psalm of David, when he was in the wilderness of Judah. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 63:1"},"O God, thou ",{"type":"char","marker":"add","content":["art"]}," my God; early will I seek thee: my soul thirsteth for thee, my flesh longeth for thee in a dry and thirsty land, where no water is; ",{"type":"verse","marker":"v","eid":"PSA 63:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 63:2"},"To see thy power and thy glory, so ",{"type":"char","marker":"add","content":["as"]}," I have seen thee in the sanctuary. ",{"type":"verse","marker":"v","eid":"PSA 63:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 63:3"},"Because thy lovingkindness ",{"type":"char","marker":"add","content":["is"]}," better than life, my lips shall praise thee. ",{"type":"verse","marker":"v","eid":"PSA 63:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 63:4"},"Thus will I bless thee while I live: I will lift up my hands in thy name. ",{"type":"verse","marker":"v","eid":"PSA 63:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 63:5"},"My soul shall be satisfied as ",{"type":"char","marker":"add","content":["with"]}," marrow and fatness; and my mouth shall praise ",{"type":"char","marker":"add","content":["thee"]}," with joyful lips: ",{"type":"verse","marker":"v","eid":"PSA 63:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 63:6"},"When I remember thee upon my bed, ",{"type":"char","marker":"add","content":["and"]}," meditate on thee in the ",{"type":"char","marker":"add","content":["night"]}," watches. ",{"type":"verse","marker":"v","eid":"PSA 63:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 63:7"},"Because thou hast been my help, therefore in the shadow of thy wings will I rejoice. ",{"type":"verse","marker":"v","eid":"PSA 63:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 63:8"},"My soul followeth hard after thee: thy right hand upholdeth me. ",{"type":"verse","marker":"v","eid":"PSA 63:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 63:9"},"But those ",{"type":"char","marker":"add","content":["that"]}," seek my soul, to destroy ",{"type":"char","marker":"add","content":["it,"]}," shall go into the lower parts of the earth. ",{"type":"verse","marker":"v","eid":"PSA 63:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 63:10"},"They shall fall by the sword: they shall be a portion for foxes. ",{"type":"verse","marker":"v","eid":"PSA 63:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 63:11"},"But the king shall rejoice in God; every one that sweareth by him shall glory: but the mouth of them that speak lies shall be stopped. ",{"type":"verse","marker":"v","eid":"PSA 63:11"}]}]}
