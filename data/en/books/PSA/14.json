{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":14,"content":[{"type":"para","marker":"d","content":["To the chief Musician, A ",{"type":"char","marker":"add","content":["Psalm"]}," of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 14:1"},"The fool hath said in his heart, ",{"type":"char","marker":"add","content":["There is"]}," no God. They are corrupt, they have done abominable works, ",{"type":"char","marker":"add","content":["there is"]}," none that doeth good. ",{"type":"verse","marker":"v","eid":"PSA 14:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 14:2"},"The LORD looked down from heaven upon the children of men, to see if there were any that did understand, ",{"type":"char","marker":"add","content":["and"]}," seek God. ",{"type":"verse","marker":"v","eid":"PSA 14:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 14:3"},"They are all gone aside, they are ",{"type":"char","marker":"add","content":["all"]}," together become filthy: ",{"type":"char","marker":"add","content":["there is"]}," none that doeth good, no, not one. ",{"type":"verse","marker":"v","eid":"PSA 14:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 14:4"},"Have all the workers of iniquity no knowledge? who eat up my people ",{"type":"char","marker":"add","content":["as"]}," they eat bread, and call not upon the LORD. ",{"type":"verse","marker":"v","eid":"PSA 14:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 14:5"},"There were they in great fear: for God ",{"type":"char","marker":"add","content":["is"]}," in the generation of the righteous. ",{"type":"verse","marker":"v","eid":"PSA 14:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 14:6"},"Ye have shamed the counsel of the poor, because the LORD ",{"type":"char","marker":"add","content":["is "]},"his refuge. ",{"type":"verse","marker":"v","eid":"PSA 14:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 14:7"},"Oh that the salvation of Israel ",{"type":"char","marker":"add","content":["were come"]}," out of Zion! when the LORD bringeth back the captivity of his people, Jacob shall rejoice, ",{"type":"char","marker":"add","content":["and"]}," Israel shall be glad. ",{"type":"verse","marker":"v","eid":"PSA 14:7"}]}]}
