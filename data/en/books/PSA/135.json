{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":135,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 135:1"},"Praise ye the LORD. Praise ye the name of the LORD; praise ",{"type":"char","marker":"add","content":["him, "]},"O ye servants of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 135:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 135:2"},"Ye that stand in the house of the LORD, in the courts of the house of our God, ",{"type":"verse","marker":"v","eid":"PSA 135:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 135:3"},"Praise the LORD; for the LORD ",{"type":"char","marker":"add","content":["is"]}," good: sing praises unto his name; for ",{"type":"char","marker":"add","content":["it is"]}," pleasant. ",{"type":"verse","marker":"v","eid":"PSA 135:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 135:4"},"For the LORD hath chosen Jacob unto himself, ",{"type":"char","marker":"add","content":["and"]}," Israel for his peculiar treasure. ",{"type":"verse","marker":"v","eid":"PSA 135:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 135:5"},"For I know that the LORD ",{"type":"char","marker":"add","content":["is"]}," great, and ",{"type":"char","marker":"add","content":["that"]}," our Lord ",{"type":"char","marker":"add","content":["is"]}," above all gods. ",{"type":"verse","marker":"v","eid":"PSA 135:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 135:6"},"Whatsoever the LORD pleased, ",{"type":"char","marker":"add","content":["that"]}," did he in heaven, and in earth, in the seas, and all deep places. ",{"type":"verse","marker":"v","eid":"PSA 135:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 135:7"},"He causeth the vapours to ascend from the ends of the earth; he maketh lightnings for the rain; he bringeth the wind out of his treasuries. ",{"type":"verse","marker":"v","eid":"PSA 135:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 135:8"},"Who smote the firstborn of Egypt, both of man and beast. ",{"type":"verse","marker":"v","eid":"PSA 135:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 135:9"},{"type":"char","marker":"add","content":["Who"]}," sent tokens and wonders into the midst of thee, O Egypt, upon Pharaoh, and upon all his servants. ",{"type":"verse","marker":"v","eid":"PSA 135:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 135:10"},"Who smote great nations, and slew mighty kings; ",{"type":"verse","marker":"v","eid":"PSA 135:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 135:11"},"Sihon king of the Amorites, and Og king of Bashan, and all the kingdoms of Canaan: ",{"type":"verse","marker":"v","eid":"PSA 135:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 135:12"},"And gave their land ",{"type":"char","marker":"add","content":["for"]}," an heritage, an heritage unto Israel his people. ",{"type":"verse","marker":"v","eid":"PSA 135:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 135:13"},"Thy name, O LORD, ",{"type":"char","marker":"add","content":["endureth"]}," for ever; ",{"type":"char","marker":"add","content":["and"]}," thy memorial, O LORD, throughout all generations. ",{"type":"verse","marker":"v","eid":"PSA 135:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 135:14"},"For the LORD will judge his people, and he will repent himself concerning his servants. ",{"type":"verse","marker":"v","eid":"PSA 135:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 135:15"},"The idols of the heathen ",{"type":"char","marker":"add","content":["are"]}," silver and gold, the work of men’s hands. ",{"type":"verse","marker":"v","eid":"PSA 135:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 135:16"},"They have mouths, but they speak not; eyes have they, but they see not; ",{"type":"verse","marker":"v","eid":"PSA 135:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 135:17"},"They have ears, but they hear not; neither is there ",{"type":"char","marker":"add","content":["any"]}," breath in their mouths. ",{"type":"verse","marker":"v","eid":"PSA 135:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 135:18"},"They that make them are like unto them: ",{"type":"char","marker":"add","content":["so is"]}," every one that trusteth in them. ",{"type":"verse","marker":"v","eid":"PSA 135:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 135:19"},"Bless the LORD, O house of Israel: bless the LORD, O house of Aaron: ",{"type":"verse","marker":"v","eid":"PSA 135:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 135:20"},"Bless the LORD, O house of Levi: ye that fear the LORD, bless the LORD. ",{"type":"verse","marker":"v","eid":"PSA 135:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 135:21"},"Blessed be the LORD out of Zion, which dwelleth at Jerusalem. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 135:21"}]}]}
