{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":132,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 132:1"},"LORD, remember David, ",{"type":"char","marker":"add","content":["and"]}," all his afflictions: ",{"type":"verse","marker":"v","eid":"PSA 132:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 132:2"},"How he sware unto the LORD, ",{"type":"char","marker":"add","content":["and"]}," vowed unto the mighty ",{"type":"char","marker":"add","content":["God"]}," of Jacob; ",{"type":"verse","marker":"v","eid":"PSA 132:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 132:3"},"Surely I will not come into the tabernacle of my house, nor go up into my bed; ",{"type":"verse","marker":"v","eid":"PSA 132:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 132:4"},"I will not give sleep to mine eyes, ",{"type":"char","marker":"add","content":["or"]}," slumber to mine eyelids, ",{"type":"verse","marker":"v","eid":"PSA 132:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 132:5"},"Until I find out a place for the LORD, an habitation for the mighty ",{"type":"char","marker":"add","content":["God"]}," of Jacob. ",{"type":"verse","marker":"v","eid":"PSA 132:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 132:6"},"Lo, we heard of it at Ephratah: we found it in the fields of the wood. ",{"type":"verse","marker":"v","eid":"PSA 132:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 132:7"},"We will go into his tabernacles: we will worship at his footstool. ",{"type":"verse","marker":"v","eid":"PSA 132:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 132:8"},"Arise, O LORD, into thy rest; thou, and the ark of thy strength. ",{"type":"verse","marker":"v","eid":"PSA 132:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 132:9"},"Let thy priests be clothed with righteousness; and let thy saints shout for joy. ",{"type":"verse","marker":"v","eid":"PSA 132:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 132:10"},"For thy servant David’s sake turn not away the face of thine anointed. ",{"type":"verse","marker":"v","eid":"PSA 132:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 132:11"},"The LORD hath sworn ",{"type":"char","marker":"add","content":["in"]}," truth unto David; he will not turn from it; Of the fruit of thy body will I set upon thy throne. ",{"type":"verse","marker":"v","eid":"PSA 132:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 132:12"},"If thy children will keep my covenant and my testimony that I shall teach them, their children shall also sit upon thy throne for evermore. ",{"type":"verse","marker":"v","eid":"PSA 132:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 132:13"},"For the LORD hath chosen Zion; he hath desired ",{"type":"char","marker":"add","content":["it"]}," for his habitation. ",{"type":"verse","marker":"v","eid":"PSA 132:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 132:14"},"This ",{"type":"char","marker":"add","content":["is"]}," my rest for ever: here will I dwell; for I have desired it. ",{"type":"verse","marker":"v","eid":"PSA 132:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 132:15"},"I will abundantly bless her provision: I will satisfy her poor with bread. ",{"type":"verse","marker":"v","eid":"PSA 132:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 132:16"},"I will also clothe her priests with salvation: and her saints shall shout aloud for joy. ",{"type":"verse","marker":"v","eid":"PSA 132:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 132:17"},"There will I make the horn of David to bud: I have ordained a lamp for mine anointed. ",{"type":"verse","marker":"v","eid":"PSA 132:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 132:18"},"His enemies will I clothe with shame: but upon himself shall his crown flourish. ",{"type":"verse","marker":"v","eid":"PSA 132:18"}]}]}
