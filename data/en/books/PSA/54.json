{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":54,"content":[{"type":"para","marker":"d","content":["To the chief Musician on Neginoth, Maschil, A ",{"type":"char","marker":"add","content":["Psalm"]}," of David, when the Ziphims came and said to Saul, Doth not David hide himself with us? "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 54:1"},"Save me, O God, by thy name, and judge me by thy strength. ",{"type":"verse","marker":"v","eid":"PSA 54:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 54:2"},"Hear my prayer, O God; give ear to the words of my mouth. ",{"type":"verse","marker":"v","eid":"PSA 54:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 54:3"},"For strangers are risen up against me, and oppressors seek after my soul: they have not set God before them. Selah. ",{"type":"verse","marker":"v","eid":"PSA 54:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 54:4"},"Behold, God ",{"type":"char","marker":"add","content":["is"]}," mine helper: the Lord ",{"type":"char","marker":"add","content":["is"]}," with them that uphold my soul. ",{"type":"verse","marker":"v","eid":"PSA 54:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 54:5"},"He shall reward evil unto mine enemies: cut them off in thy truth. ",{"type":"verse","marker":"v","eid":"PSA 54:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 54:6"},"I will freely sacrifice unto thee: I will praise thy name, O LORD; for ",{"type":"char","marker":"add","content":["it is"]}," good. ",{"type":"verse","marker":"v","eid":"PSA 54:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 54:7"},"For he hath delivered me out of all trouble: and mine eye hath seen ",{"type":"char","marker":"add","content":["his desire"]}," upon mine enemies. ",{"type":"verse","marker":"v","eid":"PSA 54:7"}]}]}
