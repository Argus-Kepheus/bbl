{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":100,"content":[{"type":"para","marker":"d","content":["A Psalm of praise. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 100:1"},"Make a joyful noise unto the LORD, all ye lands. ",{"type":"verse","marker":"v","eid":"PSA 100:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 100:2"},"Serve the LORD with gladness: come before his presence with singing. ",{"type":"verse","marker":"v","eid":"PSA 100:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 100:3"},"Know ye that the LORD he ",{"type":"char","marker":"add","content":["is"]}," God: ",{"type":"char","marker":"add","content":["it is"]}," he ",{"type":"char","marker":"add","content":["that "]},"hath made us, and not we ourselves; ",{"type":"char","marker":"add","content":["we are"]}," his people, and the sheep of his pasture. ",{"type":"verse","marker":"v","eid":"PSA 100:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 100:4"},"Enter into his gates with thanksgiving, ",{"type":"char","marker":"add","content":["and"]}," into his courts with praise: be thankful unto him, ",{"type":"char","marker":"add","content":["and"]}," bless his name. ",{"type":"verse","marker":"v","eid":"PSA 100:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 100:5"},"For the LORD ",{"type":"char","marker":"add","content":["is"]}," good; his mercy ",{"type":"char","marker":"add","content":["is"]}," everlasting; and his truth ",{"type":"char","marker":"add","content":["endureth"]}," to all generations. ",{"type":"verse","marker":"v","eid":"PSA 100:5"}]}]}
