{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":108,"content":[{"type":"para","marker":"d","content":["A Song ",{"type":"char","marker":"add","content":["or"]}," Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 108:1"},"O God, my heart is fixed; I will sing and give praise, even with my glory. ",{"type":"verse","marker":"v","eid":"PSA 108:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 108:2"},"Awake, psaltery and harp: I ",{"type":"char","marker":"add","content":["myself"]}," will awake early. ",{"type":"verse","marker":"v","eid":"PSA 108:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 108:3"},"I will praise thee, O LORD, among the people: and I will sing praises unto thee among the nations. ",{"type":"verse","marker":"v","eid":"PSA 108:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 108:4"},"For thy mercy ",{"type":"char","marker":"add","content":["is"]}," great above the heavens: and thy truth ",{"type":"char","marker":"add","content":["reacheth"]}," unto the clouds. ",{"type":"verse","marker":"v","eid":"PSA 108:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 108:5"},"Be thou exalted, O God, above the heavens: and thy glory above all the earth; ",{"type":"verse","marker":"v","eid":"PSA 108:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 108:6"},"That thy beloved may be delivered: save ",{"type":"char","marker":"add","content":["with"]}," thy right hand, and answer me. ",{"type":"verse","marker":"v","eid":"PSA 108:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 108:7"},"God hath spoken in his holiness; I will rejoice, I will divide Shechem, and mete out the valley of Succoth. ",{"type":"verse","marker":"v","eid":"PSA 108:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 108:8"},"Gilead ",{"type":"char","marker":"add","content":["is"]}," mine; Manasseh ",{"type":"char","marker":"add","content":["is"]}," mine; Ephraim also ",{"type":"char","marker":"add","content":["is"]}," the strength of mine head; Judah ",{"type":"char","marker":"add","content":["is"]}," my lawgiver; ",{"type":"verse","marker":"v","eid":"PSA 108:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 108:9"},"Moab ",{"type":"char","marker":"add","content":["is"]}," my washpot; over Edom will I cast out my shoe; over Philistia will I triumph. ",{"type":"verse","marker":"v","eid":"PSA 108:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 108:10"},"Who will bring me into the strong city? who will lead me into Edom? ",{"type":"verse","marker":"v","eid":"PSA 108:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 108:11"},{"type":"char","marker":"add","content":["Wilt"]}," not ",{"type":"char","marker":"add","content":["thou,"]}," O God, ",{"type":"char","marker":"add","content":["who"]}," hast cast us off? and wilt not thou, O God, go forth with our hosts? ",{"type":"verse","marker":"v","eid":"PSA 108:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 108:12"},"Give us help from trouble: for vain ",{"type":"char","marker":"add","content":["is"]}," the help of man. ",{"type":"verse","marker":"v","eid":"PSA 108:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 108:13"},"Through God we shall do valiantly: for he ",{"type":"char","marker":"add","content":["it is that"]}," shall tread down our enemies. ",{"type":"verse","marker":"v","eid":"PSA 108:13"}]}]}
