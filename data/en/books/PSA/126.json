{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":126,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 126:1"},"When the LORD turned again the captivity of Zion, we were like them that dream. ",{"type":"verse","marker":"v","eid":"PSA 126:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 126:2"},"Then was our mouth filled with laughter, and our tongue with singing: then said they among the heathen, The LORD hath done great things for them. ",{"type":"verse","marker":"v","eid":"PSA 126:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 126:3"},"The LORD hath done great things for us; ",{"type":"char","marker":"add","content":["whereof"]}," we are glad. ",{"type":"verse","marker":"v","eid":"PSA 126:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 126:4"},"Turn again our captivity, O LORD, as the streams in the south. ",{"type":"verse","marker":"v","eid":"PSA 126:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 126:5"},"They that sow in tears shall reap in joy. ",{"type":"verse","marker":"v","eid":"PSA 126:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 126:6"},"He that goeth forth and weepeth, bearing precious seed, shall doubtless come again with rejoicing, bringing his sheaves ",{"type":"char","marker":"add","content":["with him."]},{"type":"verse","marker":"v","eid":"PSA 126:6"}]}]}
