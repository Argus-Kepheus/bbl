{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":134,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 134:1"},"Behold, bless ye the LORD, all ",{"type":"char","marker":"add","content":["ye"]}," servants of the LORD, which by night stand in the house of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 134:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 134:2"},"Lift up your hands ",{"type":"char","marker":"add","content":["in"]}," the sanctuary, and bless the LORD. ",{"type":"verse","marker":"v","eid":"PSA 134:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 134:3"},"The LORD that made heaven and earth bless thee out of Zion. ",{"type":"verse","marker":"v","eid":"PSA 134:3"}]}]}
