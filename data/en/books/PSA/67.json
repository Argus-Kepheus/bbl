{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":67,"content":[{"type":"para","marker":"d","content":["To the chief Musician on Neginoth, A Psalm ",{"type":"char","marker":"add","content":["or"]}," Song. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 67:1"},"God be merciful unto us, and bless us; ",{"type":"char","marker":"add","content":["and"]}," cause his face to shine upon us; Selah. ",{"type":"verse","marker":"v","eid":"PSA 67:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 67:2"},"That thy way may be known upon earth, thy saving health among all nations. ",{"type":"verse","marker":"v","eid":"PSA 67:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 67:3"},"Let the people praise thee, O God; let all the people praise thee. ",{"type":"verse","marker":"v","eid":"PSA 67:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 67:4"},"O let the nations be glad and sing for joy: for thou shalt judge the people righteously, and govern the nations upon earth. Selah. ",{"type":"verse","marker":"v","eid":"PSA 67:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 67:5"},"Let the people praise thee, O God; let all the people praise thee. ",{"type":"verse","marker":"v","eid":"PSA 67:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 67:6"},{"type":"char","marker":"add","content":["Then"]}," shall the earth yield her increase; ",{"type":"char","marker":"add","content":["and"]}," God, ",{"type":"char","marker":"add","content":["even"]}," our own God, shall bless us. ",{"type":"verse","marker":"v","eid":"PSA 67:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 67:7"},"God shall bless us; and all the ends of the earth shall fear him. ",{"type":"verse","marker":"v","eid":"PSA 67:7"}]}]}
