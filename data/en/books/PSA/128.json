{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":128,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 128:1"},"Blessed ",{"type":"char","marker":"add","content":["is"]}," every one that feareth the LORD; that walketh in his ways. ",{"type":"verse","marker":"v","eid":"PSA 128:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 128:2"},"For thou shalt eat the labour of thine hands: happy ",{"type":"char","marker":"add","content":["shalt "]},"thou ",{"type":"char","marker":"add","content":["be,"]}," and ",{"type":"char","marker":"add","content":["it shall be"]}," well with thee. ",{"type":"verse","marker":"v","eid":"PSA 128:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 128:3"},"Thy wife ",{"type":"char","marker":"add","content":["shall be"]}," as a fruitful vine by the sides of thine house: thy children like olive plants round about thy table. ",{"type":"verse","marker":"v","eid":"PSA 128:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 128:4"},"Behold, that thus shall the man be blessed that feareth the LORD. ",{"type":"verse","marker":"v","eid":"PSA 128:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 128:5"},"The LORD shall bless thee out of Zion: and thou shalt see the good of Jerusalem all the days of thy life. ",{"type":"verse","marker":"v","eid":"PSA 128:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 128:6"},"Yea, thou shalt see thy children’s children, ",{"type":"char","marker":"add","content":["and"]}," peace upon Israel. ",{"type":"verse","marker":"v","eid":"PSA 128:6"}]}]}
