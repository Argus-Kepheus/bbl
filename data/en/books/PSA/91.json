{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":91,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 91:1"},"He that dwelleth in the secret place of the most High shall abide under the shadow of the Almighty. ",{"type":"verse","marker":"v","eid":"PSA 91:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 91:2"},"I will say of the LORD, ",{"type":"char","marker":"add","content":["He is"]}," my refuge and my fortress: my God; in him will I trust. ",{"type":"verse","marker":"v","eid":"PSA 91:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 91:3"},"Surely he shall deliver thee from the snare of the fowler, ",{"type":"char","marker":"add","content":["and "]},"from the noisome pestilence. ",{"type":"verse","marker":"v","eid":"PSA 91:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 91:4"},"He shall cover thee with his feathers, and under his wings shalt thou trust: his truth ",{"type":"char","marker":"add","content":["shall be thy"]}," shield and buckler. ",{"type":"verse","marker":"v","eid":"PSA 91:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 91:5"},"Thou shalt not be afraid for the terror by night; ",{"type":"char","marker":"add","content":["nor"]}," for the arrow ",{"type":"char","marker":"add","content":["that"]}," flieth by day; ",{"type":"verse","marker":"v","eid":"PSA 91:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 91:6"},{"type":"char","marker":"add","content":["Nor"]}," for the pestilence ",{"type":"char","marker":"add","content":["that"]}," walketh in darkness; ",{"type":"char","marker":"add","content":["nor"]}," for the destruction ",{"type":"char","marker":"add","content":["that"]}," wasteth at noonday. ",{"type":"verse","marker":"v","eid":"PSA 91:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 91:7"},"A thousand shall fall at thy side, and ten thousand at thy right hand; ",{"type":"char","marker":"add","content":["but"]}," it shall not come nigh thee. ",{"type":"verse","marker":"v","eid":"PSA 91:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 91:8"},"Only with thine eyes shalt thou behold and see the reward of the wicked. ",{"type":"verse","marker":"v","eid":"PSA 91:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 91:9"},"Because thou hast made the LORD, ",{"type":"char","marker":"add","content":["which is"]}," my refuge, ",{"type":"char","marker":"add","content":["even"]}," the most High, thy habitation; ",{"type":"verse","marker":"v","eid":"PSA 91:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 91:10"},"There shall no evil befall thee, neither shall any plague come nigh thy dwelling. ",{"type":"verse","marker":"v","eid":"PSA 91:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 91:11"},"For he shall give his angels charge over thee, to keep thee in all thy ways. ",{"type":"verse","marker":"v","eid":"PSA 91:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 91:12"},"They shall bear thee up in ",{"type":"char","marker":"add","content":["their"]}," hands, lest thou dash thy foot against a stone. ",{"type":"verse","marker":"v","eid":"PSA 91:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 91:13"},"Thou shalt tread upon the lion and adder: the young lion and the dragon shalt thou trample under feet. ",{"type":"verse","marker":"v","eid":"PSA 91:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 91:14"},"Because he hath set his love upon me, therefore will I deliver him: I will set him on high, because he hath known my name. ",{"type":"verse","marker":"v","eid":"PSA 91:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 91:15"},"He shall call upon me, and I will answer him: I ",{"type":"char","marker":"add","content":["will be"]}," with him in trouble; I will deliver him, and honour him. ",{"type":"verse","marker":"v","eid":"PSA 91:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 91:16"},"With long life will I satisfy him, and shew him my salvation. ",{"type":"verse","marker":"v","eid":"PSA 91:16"}]}]}
