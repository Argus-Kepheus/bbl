{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":52,"content":[{"type":"para","marker":"d","content":["To the chief Musician, Maschil, A ",{"type":"char","marker":"add","content":["Psalm"]}," of David, when Doeg the Edomite came and told Saul, and said unto him, David is come to the house of Ahimelech. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 52:1"},"Why boastest thou thyself in mischief, O mighty man? the goodness of God ",{"type":"char","marker":"add","content":["endureth "]},"continually. ",{"type":"verse","marker":"v","eid":"PSA 52:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 52:2"},"Thy tongue deviseth mischiefs; like a sharp rasor, working deceitfully. ",{"type":"verse","marker":"v","eid":"PSA 52:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 52:3"},"Thou lovest evil more than good; ",{"type":"char","marker":"add","content":["and"]}," lying rather than to speak righteousness. Selah. ",{"type":"verse","marker":"v","eid":"PSA 52:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 52:4"},"Thou lovest all devouring words, O ",{"type":"char","marker":"add","content":["thou"]}," deceitful tongue. ",{"type":"verse","marker":"v","eid":"PSA 52:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 52:5"},"God shall likewise destroy thee for ever, he shall take thee away, and pluck thee out of ",{"type":"char","marker":"add","content":["thy"]}," dwelling place, and root thee out of the land of the living. Selah. ",{"type":"verse","marker":"v","eid":"PSA 52:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 52:6"},"The righteous also shall see, and fear, and shall laugh at him: ",{"type":"verse","marker":"v","eid":"PSA 52:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 52:7"},"Lo, ",{"type":"char","marker":"add","content":["this is"]}," the man ",{"type":"char","marker":"add","content":["that"]}," made not God his strength; but trusted in the abundance of his riches, ",{"type":"char","marker":"add","content":["and"]}," strengthened himself in his wickedness. ",{"type":"verse","marker":"v","eid":"PSA 52:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 52:8"},"But I ",{"type":"char","marker":"add","content":["am"]}," like a green olive tree in the house of God: I trust in the mercy of God for ever and ever. ",{"type":"verse","marker":"v","eid":"PSA 52:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 52:9"},"I will praise thee for ever, because thou hast done ",{"type":"char","marker":"add","content":["it:"]}," and I will wait on thy name; for ",{"type":"char","marker":"add","content":["it is"]}," good before thy saints. ",{"type":"verse","marker":"v","eid":"PSA 52:9"}]}]}
