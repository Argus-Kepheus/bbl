{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":144,"content":[{"type":"para","marker":"d","content":["A ",{"type":"char","marker":"add","content":["Psalm"]}," of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 144:1"},"Blessed ",{"type":"char","marker":"add","content":["be"]}," the LORD my strength, which teacheth my hands to war, ",{"type":"char","marker":"add","content":["and"]}," my fingers to fight: ",{"type":"verse","marker":"v","eid":"PSA 144:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 144:2"},"My goodness, and my fortress; my high tower, and my deliverer; my shield, and ",{"type":"char","marker":"add","content":["he"]}," in whom I trust; who subdueth my people under me. ",{"type":"verse","marker":"v","eid":"PSA 144:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 144:3"},"LORD, what ",{"type":"char","marker":"add","content":["is"]}," man, that thou takest knowledge of him! ",{"type":"char","marker":"add","content":["or"]}," the son of man, that thou makest account of him! ",{"type":"verse","marker":"v","eid":"PSA 144:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 144:4"},"Man is like to vanity: his days ",{"type":"char","marker":"add","content":["are"]}," as a shadow that passeth away. ",{"type":"verse","marker":"v","eid":"PSA 144:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 144:5"},"Bow thy heavens, O LORD, and come down: touch the mountains, and they shall smoke. ",{"type":"verse","marker":"v","eid":"PSA 144:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 144:6"},"Cast forth lightning, and scatter them: shoot out thine arrows, and destroy them. ",{"type":"verse","marker":"v","eid":"PSA 144:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 144:7"},"Send thine hand from above; rid me, and deliver me out of great waters, from the hand of strange children; ",{"type":"verse","marker":"v","eid":"PSA 144:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 144:8"},"Whose mouth speaketh vanity, and their right hand ",{"type":"char","marker":"add","content":["is"]}," a right hand of falsehood. ",{"type":"verse","marker":"v","eid":"PSA 144:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 144:9"},"I will sing a new song unto thee, O God: upon a psaltery ",{"type":"char","marker":"add","content":["and "]},"an instrument of ten strings will I sing praises unto thee. ",{"type":"verse","marker":"v","eid":"PSA 144:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 144:10"},{"type":"char","marker":"add","content":["It is he"]}," that giveth salvation unto kings: who delivereth David his servant from the hurtful sword. ",{"type":"verse","marker":"v","eid":"PSA 144:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 144:11"},"Rid me, and deliver me from the hand of strange children, whose mouth speaketh vanity, and their right hand ",{"type":"char","marker":"add","content":["is"]}," a right hand of falsehood: ",{"type":"verse","marker":"v","eid":"PSA 144:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 144:12"},"That our sons ",{"type":"char","marker":"add","content":["may be"]}," as plants grown up in their youth; ",{"type":"char","marker":"add","content":["that"]}," our daughters ",{"type":"char","marker":"add","content":["may be"]}," as corner stones, polished ",{"type":"char","marker":"add","content":["after"]}," the similitude of a palace: ",{"type":"verse","marker":"v","eid":"PSA 144:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 144:13"},{"type":"char","marker":"add","content":["That"]}," our garners ",{"type":"char","marker":"add","content":["may be"]}," full, affording all manner of store: ",{"type":"char","marker":"add","content":["that"]}," our sheep may bring forth thousands and ten thousands in our streets: ",{"type":"verse","marker":"v","eid":"PSA 144:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 144:14"},{"type":"char","marker":"add","content":["That"]}," our oxen ",{"type":"char","marker":"add","content":["may be"]}," strong to labour; ",{"type":"char","marker":"add","content":["that there be"]}," no breaking in, nor going out; that ",{"type":"char","marker":"add","content":["there be"]}," no complaining in our streets. ",{"type":"verse","marker":"v","eid":"PSA 144:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 144:15"},"Happy ",{"type":"char","marker":"add","content":["is that"]}," people, that is in such a case: ",{"type":"char","marker":"add","content":["yea, "]},"happy ",{"type":"char","marker":"add","content":["is that"]}," people, whose God ",{"type":"char","marker":"add","content":["is"]}," the LORD. ",{"type":"verse","marker":"v","eid":"PSA 144:15"}]}]}
