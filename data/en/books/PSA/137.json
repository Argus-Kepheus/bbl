{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":137,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 137:1"},"By the rivers of Babylon, there we sat down, yea, we wept, when we remembered Zion. ",{"type":"verse","marker":"v","eid":"PSA 137:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 137:2"},"We hanged our harps upon the willows in the midst thereof. ",{"type":"verse","marker":"v","eid":"PSA 137:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 137:3"},"For there they that carried us away captive required of us a song; and they that wasted us ",{"type":"char","marker":"add","content":["required of us"]}," mirth, ",{"type":"char","marker":"add","content":["saying,"]}," Sing us ",{"type":"char","marker":"add","content":["one"]}," of the songs of Zion. ",{"type":"verse","marker":"v","eid":"PSA 137:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 137:4"},"How shall we sing the LORD’S song in a strange land? ",{"type":"verse","marker":"v","eid":"PSA 137:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 137:5"},"If I forget thee, O Jerusalem, let my right hand forget ",{"type":"char","marker":"add","content":["her cunning."]},{"type":"verse","marker":"v","eid":"PSA 137:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 137:6"},"If I do not remember thee, let my tongue cleave to the roof of my mouth; if I prefer not Jerusalem above my chief joy. ",{"type":"verse","marker":"v","eid":"PSA 137:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 137:7"},"Remember, O LORD, the children of Edom in the day of Jerusalem; who said, Rase ",{"type":"char","marker":"add","content":["it,"]}," rase ",{"type":"char","marker":"add","content":["it, even"]}," to the foundation thereof. ",{"type":"verse","marker":"v","eid":"PSA 137:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 137:8"},"O daughter of Babylon, who art to be destroyed; happy ",{"type":"char","marker":"add","content":["shall he be, "]},"that rewardeth thee as thou hast served us. ",{"type":"verse","marker":"v","eid":"PSA 137:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 137:9"},"Happy ",{"type":"char","marker":"add","content":["shall he be,"]}," that taketh and dasheth thy little ones against the stones. ",{"type":"verse","marker":"v","eid":"PSA 137:9"}]}]}
