{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":114,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 114:1"},"When Israel went out of Egypt, the house of Jacob from a people of strange language; ",{"type":"verse","marker":"v","eid":"PSA 114:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 114:2"},"Judah was his sanctuary, ",{"type":"char","marker":"add","content":["and"]}," Israel his dominion. ",{"type":"verse","marker":"v","eid":"PSA 114:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 114:3"},"The sea saw ",{"type":"char","marker":"add","content":["it,"]}," and fled: Jordan was driven back. ",{"type":"verse","marker":"v","eid":"PSA 114:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 114:4"},"The mountains skipped like rams, ",{"type":"char","marker":"add","content":["and"]}," the little hills like lambs. ",{"type":"verse","marker":"v","eid":"PSA 114:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 114:5"},"What ",{"type":"char","marker":"add","content":["ailed"]}," thee, O thou sea, that thou fleddest? thou Jordan, ",{"type":"char","marker":"add","content":["that"]}," thou wast driven back? ",{"type":"verse","marker":"v","eid":"PSA 114:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 114:6"},"Ye mountains, ",{"type":"char","marker":"add","content":["that"]}," ye skipped like rams; ",{"type":"char","marker":"add","content":["and"]}," ye little hills, like lambs? ",{"type":"verse","marker":"v","eid":"PSA 114:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 114:7"},"Tremble, thou earth, at the presence of the Lord, at the presence of the God of Jacob; ",{"type":"verse","marker":"v","eid":"PSA 114:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 114:8"},"Which turned the rock ",{"type":"char","marker":"add","content":["into"]}," a standing water, the flint into a fountain of waters. ",{"type":"verse","marker":"v","eid":"PSA 114:8"}]}]}
