{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":99,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 99:1"},"The LORD reigneth; let the people tremble: he sitteth ",{"type":"char","marker":"add","content":["between "]},"the cherubims; let the earth be moved. ",{"type":"verse","marker":"v","eid":"PSA 99:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 99:2"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," great in Zion; and he ",{"type":"char","marker":"add","content":["is"]}," high above all the people. ",{"type":"verse","marker":"v","eid":"PSA 99:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 99:3"},"Let them praise thy great and terrible name; ",{"type":"char","marker":"add","content":["for"]}," it ",{"type":"char","marker":"add","content":["is "]},"holy. ",{"type":"verse","marker":"v","eid":"PSA 99:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 99:4"},"The king’s strength also loveth judgment; thou dost establish equity, thou executest judgment and righteousness in Jacob. ",{"type":"verse","marker":"v","eid":"PSA 99:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 99:5"},"Exalt ye the LORD our God, and worship at his footstool; ",{"type":"char","marker":"add","content":["for "]},"he ",{"type":"char","marker":"add","content":["is"]}," holy. ",{"type":"verse","marker":"v","eid":"PSA 99:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 99:6"},"Moses and Aaron among his priests, and Samuel among them that call upon his name; they called upon the LORD, and he answered them. ",{"type":"verse","marker":"v","eid":"PSA 99:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 99:7"},"He spake unto them in the cloudy pillar: they kept his testimonies, and the ordinance ",{"type":"char","marker":"add","content":["that"]}," he gave them. ",{"type":"verse","marker":"v","eid":"PSA 99:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 99:8"},"Thou answeredst them, O LORD our God: thou wast a God that forgavest them, though thou tookest vengeance of their inventions. ",{"type":"verse","marker":"v","eid":"PSA 99:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 99:9"},"Exalt the LORD our God, and worship at his holy hill; for the LORD our God ",{"type":"char","marker":"add","content":["is"]}," holy. ",{"type":"verse","marker":"v","eid":"PSA 99:9"}]}]}
