{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":121,"content":[{"type":"para","marker":"d","content":["A Song of degrees. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 121:1"},"I will lift up mine eyes unto the hills, from whence cometh my help. ",{"type":"verse","marker":"v","eid":"PSA 121:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 121:2"},"My help ",{"type":"char","marker":"add","content":["cometh"]}," from the LORD, which made heaven and earth. ",{"type":"verse","marker":"v","eid":"PSA 121:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 121:3"},"He will not suffer thy foot to be moved: he that keepeth thee will not slumber. ",{"type":"verse","marker":"v","eid":"PSA 121:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 121:4"},"Behold, he that keepeth Israel shall neither slumber nor sleep. ",{"type":"verse","marker":"v","eid":"PSA 121:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 121:5"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," thy keeper: the LORD ",{"type":"char","marker":"add","content":["is"]}," thy shade upon thy right hand. ",{"type":"verse","marker":"v","eid":"PSA 121:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 121:6"},"The sun shall not smite thee by day, nor the moon by night. ",{"type":"verse","marker":"v","eid":"PSA 121:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 121:7"},"The LORD shall preserve thee from all evil: he shall preserve thy soul. ",{"type":"verse","marker":"v","eid":"PSA 121:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 121:8"},"The LORD shall preserve thy going out and thy coming in from this time forth, and even for evermore. ",{"type":"verse","marker":"v","eid":"PSA 121:8"}]}]}
