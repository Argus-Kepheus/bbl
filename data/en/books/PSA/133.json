{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":133,"content":[{"type":"para","marker":"d","content":["A Song of degrees of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 133:1"},"Behold, how good and how pleasant ",{"type":"char","marker":"add","content":["it is"]}," for brethren to dwell together in unity! ",{"type":"verse","marker":"v","eid":"PSA 133:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 133:2"},{"type":"char","marker":"add","content":["It is"]}," like the precious ointment upon the head, that ran down upon the beard, ",{"type":"char","marker":"add","content":["even"]}," Aaron’s beard: that went down to the skirts of his garments; ",{"type":"verse","marker":"v","eid":"PSA 133:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 133:3"},"As the dew of Hermon, ",{"type":"char","marker":"add","content":["and as the dew"]}," that descended upon the mountains of Zion: for there the LORD commanded the blessing, ",{"type":"char","marker":"add","content":["even "]},"life for evermore. ",{"type":"verse","marker":"v","eid":"PSA 133:3"}]}]}
