{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":116,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 116:1"},"I love the LORD, because he hath heard my voice ",{"type":"char","marker":"add","content":["and"]}," my supplications. ",{"type":"verse","marker":"v","eid":"PSA 116:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 116:2"},"Because he hath inclined his ear unto me, therefore will I call upon ",{"type":"char","marker":"add","content":["him"]}," as long as I live. ",{"type":"verse","marker":"v","eid":"PSA 116:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 116:3"},"The sorrows of death compassed me, and the pains of hell gat hold upon me: I found trouble and sorrow. ",{"type":"verse","marker":"v","eid":"PSA 116:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 116:4"},"Then called I upon the name of the LORD; O LORD, I beseech thee, deliver my soul. ",{"type":"verse","marker":"v","eid":"PSA 116:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 116:5"},"Gracious ",{"type":"char","marker":"add","content":["is"]}," the LORD, and righteous; yea, our God ",{"type":"char","marker":"add","content":["is "]},"merciful. ",{"type":"verse","marker":"v","eid":"PSA 116:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 116:6"},"The LORD preserveth the simple: I was brought low, and he helped me. ",{"type":"verse","marker":"v","eid":"PSA 116:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 116:7"},"Return unto thy rest, O my soul; for the LORD hath dealt bountifully with thee. ",{"type":"verse","marker":"v","eid":"PSA 116:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 116:8"},"For thou hast delivered my soul from death, mine eyes from tears, ",{"type":"char","marker":"add","content":["and"]}," my feet from falling. ",{"type":"verse","marker":"v","eid":"PSA 116:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 116:9"},"I will walk before the LORD in the land of the living. ",{"type":"verse","marker":"v","eid":"PSA 116:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 116:10"},"I believed, therefore have I spoken: I was greatly afflicted: ",{"type":"verse","marker":"v","eid":"PSA 116:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 116:11"},"I said in my haste, All men ",{"type":"char","marker":"add","content":["are"]}," liars. ",{"type":"verse","marker":"v","eid":"PSA 116:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 116:12"},"What shall I render unto the LORD ",{"type":"char","marker":"add","content":["for"]}," all his benefits toward me? ",{"type":"verse","marker":"v","eid":"PSA 116:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 116:13"},"I will take the cup of salvation, and call upon the name of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 116:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 116:14"},"I will pay my vows unto the LORD now in the presence of all his people. ",{"type":"verse","marker":"v","eid":"PSA 116:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 116:15"},"Precious in the sight of the LORD ",{"type":"char","marker":"add","content":["is"]}," the death of his saints. ",{"type":"verse","marker":"v","eid":"PSA 116:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 116:16"},"O LORD, truly I ",{"type":"char","marker":"add","content":["am"]}," thy servant; I ",{"type":"char","marker":"add","content":["am"]}," thy servant, ",{"type":"char","marker":"add","content":["and"]}," the son of thine handmaid: thou hast loosed my bonds. ",{"type":"verse","marker":"v","eid":"PSA 116:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 116:17"},"I will offer to thee the sacrifice of thanksgiving, and will call upon the name of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 116:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 116:18"},"I will pay my vows unto the LORD now in the presence of all his people, ",{"type":"verse","marker":"v","eid":"PSA 116:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 116:19"},"In the courts of the LORD’S house, in the midst of thee, O Jerusalem. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 116:19"}]}]}
