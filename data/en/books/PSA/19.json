{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":19,"content":[{"type":"para","marker":"d","content":["To the chief Musician, A Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 19:1"},"The heavens declare the glory of God; and the firmament sheweth his handywork. ",{"type":"verse","marker":"v","eid":"PSA 19:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 19:2"},"Day unto day uttereth speech, and night unto night sheweth knowledge. ",{"type":"verse","marker":"v","eid":"PSA 19:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 19:3"},{"type":"char","marker":"add","content":["There is"]}," no speech nor language, ",{"type":"char","marker":"add","content":["where"]}," their voice is not heard. ",{"type":"verse","marker":"v","eid":"PSA 19:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 19:4"},"Their line is gone out through all the earth, and their words to the end of the world. In them hath he set a tabernacle for the sun, ",{"type":"verse","marker":"v","eid":"PSA 19:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 19:5"},"Which ",{"type":"char","marker":"add","content":["is"]}," as a bridegroom coming out of his chamber, ",{"type":"char","marker":"add","content":["and "]},"rejoiceth as a strong man to run a race. ",{"type":"verse","marker":"v","eid":"PSA 19:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 19:6"},"His going forth ",{"type":"char","marker":"add","content":["is"]}," from the end of the heaven, and his circuit unto the ends of it: and there is nothing hid from the heat thereof. ",{"type":"verse","marker":"v","eid":"PSA 19:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 19:7"},"The law of the LORD ",{"type":"char","marker":"add","content":["is"]}," perfect, converting the soul: the testimony of the LORD ",{"type":"char","marker":"add","content":["is"]}," sure, making wise the simple. ",{"type":"verse","marker":"v","eid":"PSA 19:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 19:8"},"The statutes of the LORD ",{"type":"char","marker":"add","content":["are"]}," right, rejoicing the heart: the commandment of the LORD ",{"type":"char","marker":"add","content":["is"]}," pure, enlightening the eyes. ",{"type":"verse","marker":"v","eid":"PSA 19:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 19:9"},"The fear of the LORD ",{"type":"char","marker":"add","content":["is"]}," clean, enduring for ever: the judgments of the LORD ",{"type":"char","marker":"add","content":["are"]}," true ",{"type":"char","marker":"add","content":["and"]}," righteous altogether. ",{"type":"verse","marker":"v","eid":"PSA 19:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 19:10"},"More to be desired ",{"type":"char","marker":"add","content":["are they"]}," than gold, yea, than much fine gold: sweeter also than honey and the honeycomb. ",{"type":"verse","marker":"v","eid":"PSA 19:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 19:11"},"Moreover by them is thy servant warned: ",{"type":"char","marker":"add","content":["and"]}," in keeping of them ",{"type":"char","marker":"add","content":["there is"]}," great reward. ",{"type":"verse","marker":"v","eid":"PSA 19:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 19:12"},"Who can understand ",{"type":"char","marker":"add","content":["his"]}," errors? cleanse thou me from secret ",{"type":"char","marker":"add","content":["faults."]},{"type":"verse","marker":"v","eid":"PSA 19:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 19:13"},"Keep back thy servant also from presumptuous ",{"type":"char","marker":"add","content":["sins;"]}," let them not have dominion over me: then shall I be upright, and I shall be innocent from the great transgression. ",{"type":"verse","marker":"v","eid":"PSA 19:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 19:14"},"Let the words of my mouth, and the meditation of my heart, be acceptable in thy sight, O LORD, my strength, and my redeemer. ",{"type":"verse","marker":"v","eid":"PSA 19:14"}]}]}
