{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":82,"content":[{"type":"para","marker":"d","content":["A Psalm of Asaph. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 82:1"},"God standeth in the congregation of the mighty; he judgeth among the gods. ",{"type":"verse","marker":"v","eid":"PSA 82:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 82:2"},"How long will ye judge unjustly, and accept the persons of the wicked? Selah. ",{"type":"verse","marker":"v","eid":"PSA 82:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 82:3"},"Defend the poor and fatherless: do justice to the afflicted and needy. ",{"type":"verse","marker":"v","eid":"PSA 82:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 82:4"},"Deliver the poor and needy: rid ",{"type":"char","marker":"add","content":["them"]}," out of the hand of the wicked. ",{"type":"verse","marker":"v","eid":"PSA 82:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 82:5"},"They know not, neither will they understand; they walk on in darkness: all the foundations of the earth are out of course. ",{"type":"verse","marker":"v","eid":"PSA 82:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 82:6"},"I have said, Ye ",{"type":"char","marker":"add","content":["are"]}," gods; and all of you ",{"type":"char","marker":"add","content":["are"]}," children of the most High. ",{"type":"verse","marker":"v","eid":"PSA 82:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 82:7"},"But ye shall die like men, and fall like one of the princes. ",{"type":"verse","marker":"v","eid":"PSA 82:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 82:8"},"Arise, O God, judge the earth: for thou shalt inherit all nations. ",{"type":"verse","marker":"v","eid":"PSA 82:8"}]}]}
