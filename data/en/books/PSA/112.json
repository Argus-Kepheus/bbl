{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":112,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 112:1"},"Praise ye the LORD. Blessed ",{"type":"char","marker":"add","content":["is"]}," the man ",{"type":"char","marker":"add","content":["that"]}," feareth the LORD, ",{"type":"char","marker":"add","content":["that"]}," delighteth greatly in his commandments. ",{"type":"verse","marker":"v","eid":"PSA 112:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 112:2"},"His seed shall be mighty upon earth: the generation of the upright shall be blessed. ",{"type":"verse","marker":"v","eid":"PSA 112:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 112:3"},"Wealth and riches ",{"type":"char","marker":"add","content":["shall be"]}," in his house: and his righteousness endureth for ever. ",{"type":"verse","marker":"v","eid":"PSA 112:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 112:4"},"Unto the upright there ariseth light in the darkness: ",{"type":"char","marker":"add","content":["he is "]},"gracious, and full of compassion, and righteous. ",{"type":"verse","marker":"v","eid":"PSA 112:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 112:5"},"A good man sheweth favour, and lendeth: he will guide his affairs with discretion. ",{"type":"verse","marker":"v","eid":"PSA 112:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 112:6"},"Surely he shall not be moved for ever: the righteous shall be in everlasting remembrance. ",{"type":"verse","marker":"v","eid":"PSA 112:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 112:7"},"He shall not be afraid of evil tidings: his heart is fixed, trusting in the LORD. ",{"type":"verse","marker":"v","eid":"PSA 112:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 112:8"},"His heart ",{"type":"char","marker":"add","content":["is"]}," established, he shall not be afraid, until he see ",{"type":"char","marker":"add","content":["his desire"]}," upon his enemies. ",{"type":"verse","marker":"v","eid":"PSA 112:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 112:9"},"He hath dispersed, he hath given to the poor; his righteousness endureth for ever; his horn shall be exalted with honour. ",{"type":"verse","marker":"v","eid":"PSA 112:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 112:10"},"The wicked shall see ",{"type":"char","marker":"add","content":["it,"]}," and be grieved; he shall gnash with his teeth, and melt away: the desire of the wicked shall perish. ",{"type":"verse","marker":"v","eid":"PSA 112:10"}]}]}
