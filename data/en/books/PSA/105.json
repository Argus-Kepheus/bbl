{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":105,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 105:1"},"O give thanks unto the LORD; call upon his name: make known his deeds among the people. ",{"type":"verse","marker":"v","eid":"PSA 105:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 105:2"},"Sing unto him, sing psalms unto him: talk ye of all his wondrous works. ",{"type":"verse","marker":"v","eid":"PSA 105:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 105:3"},"Glory ye in his holy name: let the heart of them rejoice that seek the LORD. ",{"type":"verse","marker":"v","eid":"PSA 105:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 105:4"},"Seek the LORD, and his strength: seek his face evermore. ",{"type":"verse","marker":"v","eid":"PSA 105:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 105:5"},"Remember his marvellous works that he hath done; his wonders, and the judgments of his mouth; ",{"type":"verse","marker":"v","eid":"PSA 105:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 105:6"},"O ye seed of Abraham his servant, ye children of Jacob his chosen. ",{"type":"verse","marker":"v","eid":"PSA 105:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 105:7"},"He ",{"type":"char","marker":"add","content":["is"]}," the LORD our God: his judgments ",{"type":"char","marker":"add","content":["are"]}," in all the earth. ",{"type":"verse","marker":"v","eid":"PSA 105:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 105:8"},"He hath remembered his covenant for ever, the word ",{"type":"char","marker":"add","content":["which"]}," he commanded to a thousand generations. ",{"type":"verse","marker":"v","eid":"PSA 105:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 105:9"},"Which ",{"type":"char","marker":"add","content":["covenant"]}," he made with Abraham, and his oath unto Isaac; ",{"type":"verse","marker":"v","eid":"PSA 105:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 105:10"},"And confirmed the same unto Jacob for a law, ",{"type":"char","marker":"add","content":["and"]}," to Israel ",{"type":"char","marker":"add","content":["for"]}," an everlasting covenant: ",{"type":"verse","marker":"v","eid":"PSA 105:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 105:11"},"Saying, Unto thee will I give the land of Canaan, the lot of your inheritance: ",{"type":"verse","marker":"v","eid":"PSA 105:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 105:12"},"When they were ",{"type":"char","marker":"add","content":["but"]}," a few men in number; yea, very few, and strangers in it. ",{"type":"verse","marker":"v","eid":"PSA 105:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 105:13"},"When they went from one nation to another, from ",{"type":"char","marker":"add","content":["one"]}," kingdom to another people; ",{"type":"verse","marker":"v","eid":"PSA 105:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 105:14"},"He suffered no man to do them wrong: yea, he reproved kings for their sakes; ",{"type":"verse","marker":"v","eid":"PSA 105:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 105:15"},{"type":"char","marker":"add","content":["Saying,"]}," Touch not mine anointed, and do my prophets no harm. ",{"type":"verse","marker":"v","eid":"PSA 105:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 105:16"},"Moreover he called for a famine upon the land: he brake the whole staff of bread. ",{"type":"verse","marker":"v","eid":"PSA 105:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 105:17"},"He sent a man before them, ",{"type":"char","marker":"add","content":["even"]}," Joseph, ",{"type":"char","marker":"add","content":["who"]}," was sold for a servant: ",{"type":"verse","marker":"v","eid":"PSA 105:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 105:18"},"Whose feet they hurt with fetters: he was laid in iron: ",{"type":"verse","marker":"v","eid":"PSA 105:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 105:19"},"Until the time that his word came: the word of the LORD tried him. ",{"type":"verse","marker":"v","eid":"PSA 105:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 105:20"},"The king sent and loosed him; ",{"type":"char","marker":"add","content":["even"]}," the ruler of the people, and let him go free. ",{"type":"verse","marker":"v","eid":"PSA 105:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 105:21"},"He made him lord of his house, and ruler of all his substance: ",{"type":"verse","marker":"v","eid":"PSA 105:21"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"22","sid":"PSA 105:22"},"To bind his princes at his pleasure; and teach his senators wisdom. ",{"type":"verse","marker":"v","eid":"PSA 105:22"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"23","sid":"PSA 105:23"},"Israel also came into Egypt; and Jacob sojourned in the land of Ham. ",{"type":"verse","marker":"v","eid":"PSA 105:23"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"24","sid":"PSA 105:24"},"And he increased his people greatly; and made them stronger than their enemies. ",{"type":"verse","marker":"v","eid":"PSA 105:24"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"25","sid":"PSA 105:25"},"He turned their heart to hate his people, to deal subtilly with his servants. ",{"type":"verse","marker":"v","eid":"PSA 105:25"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"26","sid":"PSA 105:26"},"He sent Moses his servant; ",{"type":"char","marker":"add","content":["and"]}," Aaron whom he had chosen. ",{"type":"verse","marker":"v","eid":"PSA 105:26"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"27","sid":"PSA 105:27"},"They shewed his signs among them, and wonders in the land of Ham. ",{"type":"verse","marker":"v","eid":"PSA 105:27"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"28","sid":"PSA 105:28"},"He sent darkness, and made it dark; and they rebelled not against his word. ",{"type":"verse","marker":"v","eid":"PSA 105:28"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"29","sid":"PSA 105:29"},"He turned their waters into blood, and slew their fish. ",{"type":"verse","marker":"v","eid":"PSA 105:29"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"30","sid":"PSA 105:30"},"Their land brought forth frogs in abundance, in the chambers of their kings. ",{"type":"verse","marker":"v","eid":"PSA 105:30"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"31","sid":"PSA 105:31"},"He spake, and there came divers sorts of flies, ",{"type":"char","marker":"add","content":["and"]}," lice in all their coasts. ",{"type":"verse","marker":"v","eid":"PSA 105:31"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"32","sid":"PSA 105:32"},"He gave them hail for rain, ",{"type":"char","marker":"add","content":["and"]}," flaming fire in their land. ",{"type":"verse","marker":"v","eid":"PSA 105:32"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"33","sid":"PSA 105:33"},"He smote their vines also and their fig trees; and brake the trees of their coasts. ",{"type":"verse","marker":"v","eid":"PSA 105:33"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"34","sid":"PSA 105:34"},"He spake, and the locusts came, and caterpillers, and that without number, ",{"type":"verse","marker":"v","eid":"PSA 105:34"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"35","sid":"PSA 105:35"},"And did eat up all the herbs in their land, and devoured the fruit of their ground. ",{"type":"verse","marker":"v","eid":"PSA 105:35"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"36","sid":"PSA 105:36"},"He smote also all the firstborn in their land, the chief of all their strength. ",{"type":"verse","marker":"v","eid":"PSA 105:36"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"37","sid":"PSA 105:37"},"He brought them forth also with silver and gold: and ",{"type":"char","marker":"add","content":["there was "]},"not one feeble ",{"type":"char","marker":"add","content":["person"]}," among their tribes. ",{"type":"verse","marker":"v","eid":"PSA 105:37"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"38","sid":"PSA 105:38"},"Egypt was glad when they departed: for the fear of them fell upon them. ",{"type":"verse","marker":"v","eid":"PSA 105:38"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"39","sid":"PSA 105:39"},"He spread a cloud for a covering; and fire to give light in the night. ",{"type":"verse","marker":"v","eid":"PSA 105:39"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"40","sid":"PSA 105:40"},{"type":"char","marker":"add","content":["The people"]}," asked, and he brought quails, and satisfied them with the bread of heaven. ",{"type":"verse","marker":"v","eid":"PSA 105:40"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"41","sid":"PSA 105:41"},"He opened the rock, and the waters gushed out; they ran in the dry places ",{"type":"char","marker":"add","content":["like"]}," a river. ",{"type":"verse","marker":"v","eid":"PSA 105:41"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"42","sid":"PSA 105:42"},"For he remembered his holy promise, ",{"type":"char","marker":"add","content":["and"]}," Abraham his servant. ",{"type":"verse","marker":"v","eid":"PSA 105:42"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"43","sid":"PSA 105:43"},"And he brought forth his people with joy, ",{"type":"char","marker":"add","content":["and"]}," his chosen with gladness: ",{"type":"verse","marker":"v","eid":"PSA 105:43"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"44","sid":"PSA 105:44"},"And gave them the lands of the heathen: and they inherited the labour of the people; ",{"type":"verse","marker":"v","eid":"PSA 105:44"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"45","sid":"PSA 105:45"},"That they might observe his statutes, and keep his laws. Praise ye the LORD. ",{"type":"verse","marker":"v","eid":"PSA 105:45"}]}]}
