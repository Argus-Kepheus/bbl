{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":12,"content":[{"type":"para","marker":"d","content":["To the chief Musician upon Sheminith, A Psalm of David. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 12:1"},"Help, LORD; for the godly man ceaseth; for the faithful fail from among the children of men. ",{"type":"verse","marker":"v","eid":"PSA 12:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 12:2"},"They speak vanity every one with his neighbour: ",{"type":"char","marker":"add","content":["with"]}," flattering lips ",{"type":"char","marker":"add","content":["and"]}," with a double heart do they speak. ",{"type":"verse","marker":"v","eid":"PSA 12:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 12:3"},"The LORD shall cut off all flattering lips, ",{"type":"char","marker":"add","content":["and"]}," the tongue that speaketh proud things: ",{"type":"verse","marker":"v","eid":"PSA 12:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 12:4"},"Who have said, With our tongue will we prevail; our lips ",{"type":"char","marker":"add","content":["are "]},"our own: who ",{"type":"char","marker":"add","content":["is"]}," lord over us? ",{"type":"verse","marker":"v","eid":"PSA 12:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 12:5"},"For the oppression of the poor, for the sighing of the needy, now will I arise, saith the LORD; I will set ",{"type":"char","marker":"add","content":["him"]}," in safety ",{"type":"char","marker":"add","content":["from him that "]},"puffeth at him. ",{"type":"verse","marker":"v","eid":"PSA 12:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 12:6"},"The words of the LORD ",{"type":"char","marker":"add","content":["are"]}," pure words: ",{"type":"char","marker":"add","content":["as"]}," silver tried in a furnace of earth, purified seven times. ",{"type":"verse","marker":"v","eid":"PSA 12:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 12:7"},"Thou shalt keep them, O LORD, thou shalt preserve them from this generation for ever. ",{"type":"verse","marker":"v","eid":"PSA 12:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 12:8"},"The wicked walk on every side, when the vilest men are exalted. ",{"type":"verse","marker":"v","eid":"PSA 12:8"}]}]}
