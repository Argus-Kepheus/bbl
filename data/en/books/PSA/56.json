{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":56,"content":[{"type":"para","marker":"d","content":["To the chief Musician upon Jonathelemrechokim, Michtam of David, when the Philistines took him in Gath. "]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 56:1"},"Be merciful unto me, O God: for man would swallow me up; he fighting daily oppresseth me. ",{"type":"verse","marker":"v","eid":"PSA 56:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 56:2"},"Mine enemies would daily swallow ",{"type":"char","marker":"add","content":["me"]}," up: for ",{"type":"char","marker":"add","content":["they be "]},"many that fight against me, O thou most High. ",{"type":"verse","marker":"v","eid":"PSA 56:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 56:3"},"What time I am afraid, I will trust in thee. ",{"type":"verse","marker":"v","eid":"PSA 56:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 56:4"},"In God I will praise his word, in God I have put my trust; I will not fear what flesh can do unto me. ",{"type":"verse","marker":"v","eid":"PSA 56:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 56:5"},"Every day they wrest my words: all their thoughts ",{"type":"char","marker":"add","content":["are"]}," against me for evil. ",{"type":"verse","marker":"v","eid":"PSA 56:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 56:6"},"They gather themselves together, they hide themselves, they mark my steps, when they wait for my soul. ",{"type":"verse","marker":"v","eid":"PSA 56:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 56:7"},"Shall they escape by iniquity? in ",{"type":"char","marker":"add","content":["thine"]}," anger cast down the people, O God. ",{"type":"verse","marker":"v","eid":"PSA 56:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 56:8"},"Thou tellest my wanderings: put thou my tears into thy bottle: ",{"type":"char","marker":"add","content":["are they"]}," not in thy book? ",{"type":"verse","marker":"v","eid":"PSA 56:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 56:9"},"When I cry ",{"type":"char","marker":"add","content":["unto thee,"]}," then shall mine enemies turn back: this I know; for God ",{"type":"char","marker":"add","content":["is"]}," for me. ",{"type":"verse","marker":"v","eid":"PSA 56:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 56:10"},"In God will I praise ",{"type":"char","marker":"add","content":["his"]}," word: in the LORD will I praise ",{"type":"char","marker":"add","content":["his"]}," word. ",{"type":"verse","marker":"v","eid":"PSA 56:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 56:11"},"In God have I put my trust: I will not be afraid what man can do unto me. ",{"type":"verse","marker":"v","eid":"PSA 56:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 56:12"},"Thy vows ",{"type":"char","marker":"add","content":["are"]}," upon me, O God: I will render praises unto thee. ",{"type":"verse","marker":"v","eid":"PSA 56:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 56:13"},"For thou hast delivered my soul from death: ",{"type":"char","marker":"add","content":["wilt"]}," not ",{"type":"char","marker":"add","content":["thou deliver"]}," my feet from falling, that I may walk before God in the light of the living? ",{"type":"verse","marker":"v","eid":"PSA 56:13"}]}]}
