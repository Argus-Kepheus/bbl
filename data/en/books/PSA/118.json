{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Psalms","testament":"OT"},"chapter":118,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 118:1"},"O give thanks unto the LORD; for ",{"type":"char","marker":"add","content":["he is"]}," good: because his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 118:1"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 118:2"},"Let Israel now say, that his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 118:2"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 118:3"},"Let the house of Aaron now say, that his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 118:3"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 118:4"},"Let them now that fear the LORD say, that his mercy ",{"type":"char","marker":"add","content":["endureth "]},"for ever. ",{"type":"verse","marker":"v","eid":"PSA 118:4"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 118:5"},"I called upon the LORD in distress: the LORD answered me, ",{"type":"char","marker":"add","content":["and set me"]}," in a large place. ",{"type":"verse","marker":"v","eid":"PSA 118:5"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 118:6"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," on my side; I will not fear: what can man do unto me? ",{"type":"verse","marker":"v","eid":"PSA 118:6"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 118:7"},"The LORD taketh my part with them that help me: therefore shall I see ",{"type":"char","marker":"add","content":["my desire"]}," upon them that hate me. ",{"type":"verse","marker":"v","eid":"PSA 118:7"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 118:8"},{"type":"char","marker":"add","content":["It is"]}," better to trust in the LORD than to put confidence in man. ",{"type":"verse","marker":"v","eid":"PSA 118:8"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 118:9"},{"type":"char","marker":"add","content":["It is"]}," better to trust in the LORD than to put confidence in princes. ",{"type":"verse","marker":"v","eid":"PSA 118:9"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"10","sid":"PSA 118:10"},"All nations compassed me about: but in the name of the LORD will I destroy them. ",{"type":"verse","marker":"v","eid":"PSA 118:10"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"11","sid":"PSA 118:11"},"They compassed me about; yea, they compassed me about: but in the name of the LORD I will destroy them. ",{"type":"verse","marker":"v","eid":"PSA 118:11"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"12","sid":"PSA 118:12"},"They compassed me about like bees; they are quenched as the fire of thorns: for in the name of the LORD I will destroy them. ",{"type":"verse","marker":"v","eid":"PSA 118:12"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"13","sid":"PSA 118:13"},"Thou hast thrust sore at me that I might fall: but the LORD helped me. ",{"type":"verse","marker":"v","eid":"PSA 118:13"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"14","sid":"PSA 118:14"},"The LORD ",{"type":"char","marker":"add","content":["is"]}," my strength and song, and is become my salvation. ",{"type":"verse","marker":"v","eid":"PSA 118:14"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"15","sid":"PSA 118:15"},"The voice of rejoicing and salvation ",{"type":"char","marker":"add","content":["is"]}," in the tabernacles of the righteous: the right hand of the LORD doeth valiantly. ",{"type":"verse","marker":"v","eid":"PSA 118:15"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"16","sid":"PSA 118:16"},"The right hand of the LORD is exalted: the right hand of the LORD doeth valiantly. ",{"type":"verse","marker":"v","eid":"PSA 118:16"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"17","sid":"PSA 118:17"},"I shall not die, but live, and declare the works of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 118:17"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"18","sid":"PSA 118:18"},"The LORD hath chastened me sore: but he hath not given me over unto death. ",{"type":"verse","marker":"v","eid":"PSA 118:18"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"19","sid":"PSA 118:19"},"Open to me the gates of righteousness: I will go into them, ",{"type":"char","marker":"add","content":["and "]},"I will praise the LORD: ",{"type":"verse","marker":"v","eid":"PSA 118:19"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"20","sid":"PSA 118:20"},"This gate of the LORD, into which the righteous shall enter. ",{"type":"verse","marker":"v","eid":"PSA 118:20"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"21","sid":"PSA 118:21"},"I will praise thee: for thou hast heard me, and art become my salvation. ",{"type":"verse","marker":"v","eid":"PSA 118:21"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"22","sid":"PSA 118:22"},"The stone ",{"type":"char","marker":"add","content":["which"]}," the builders refused is become the head ",{"type":"char","marker":"add","content":["stone"]}," of the corner. ",{"type":"verse","marker":"v","eid":"PSA 118:22"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"23","sid":"PSA 118:23"},"This is the LORD’S doing; it ",{"type":"char","marker":"add","content":["is"]}," marvellous in our eyes. ",{"type":"verse","marker":"v","eid":"PSA 118:23"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"24","sid":"PSA 118:24"},"This ",{"type":"char","marker":"add","content":["is"]}," the day ",{"type":"char","marker":"add","content":["which"]}," the LORD hath made; we will rejoice and be glad in it. ",{"type":"verse","marker":"v","eid":"PSA 118:24"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"25","sid":"PSA 118:25"},"Save now, I beseech thee, O LORD: O LORD, I beseech thee, send now prosperity. ",{"type":"verse","marker":"v","eid":"PSA 118:25"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"26","sid":"PSA 118:26"},"Blessed ",{"type":"char","marker":"add","content":["be"]}," he that cometh in the name of the LORD: we have blessed you out of the house of the LORD. ",{"type":"verse","marker":"v","eid":"PSA 118:26"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"27","sid":"PSA 118:27"},"God ",{"type":"char","marker":"add","content":["is"]}," the LORD, which hath shewed us light: bind the sacrifice with cords, ",{"type":"char","marker":"add","content":["even"]}," unto the horns of the altar. ",{"type":"verse","marker":"v","eid":"PSA 118:27"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"28","sid":"PSA 118:28"},"Thou ",{"type":"char","marker":"add","content":["art"]}," my God, and I will praise thee: ",{"type":"char","marker":"add","content":["thou art "]},"my God, I will exalt thee. ",{"type":"verse","marker":"v","eid":"PSA 118:28"}]},{"type":"para","marker":"q1","content":[{"type":"verse","marker":"v","number":"29","sid":"PSA 118:29"},"O give thanks unto the LORD; for ",{"type":"char","marker":"add","content":["he is"]}," good: for his mercy ",{"type":"char","marker":"add","content":["endureth"]}," for ever. ",{"type":"verse","marker":"v","eid":"PSA 118:29"}]}]}
