{"schema_version":"1.0","language":"en","edition":"en-ak","revision":"0","book":{"position":18,"code":"JOB","name":"Job","testament":"OT"},"chapter":25,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"JOB 25:1"},"Then answered Bildad the Shuhite, and said, ",{"type":"verse","marker":"v","eid":"JOB 25:1"},{"type":"verse","marker":"v","number":"2","sid":"JOB 25:2"},"Dominion and fear ",{"type":"char","marker":"add","content":["are"]}," with him, he maketh peace in his high places. ",{"type":"verse","marker":"v","eid":"JOB 25:2"},{"type":"verse","marker":"v","number":"3","sid":"JOB 25:3"},"Is there any number of his armies? and upon whom doth not his light arise? ",{"type":"verse","marker":"v","eid":"JOB 25:3"},{"type":"verse","marker":"v","number":"4","sid":"JOB 25:4"},"How then can man be justified with God? or how can he be clean ",{"type":"char","marker":"add","content":["that is"]}," born of a woman? ",{"type":"verse","marker":"v","eid":"JOB 25:4"},{"type":"verse","marker":"v","number":"5","sid":"JOB 25:5"},"Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight. ",{"type":"verse","marker":"v","eid":"JOB 25:5"},{"type":"verse","marker":"v","number":"6","sid":"JOB 25:6"},"How much less man, ",{"type":"char","marker":"add","content":["that is"]}," a worm? and the son of man, ",{"type":"char","marker":"add","content":["which is"]}," a worm? ",{"type":"verse","marker":"v","eid":"JOB 25:6"}]}]}
