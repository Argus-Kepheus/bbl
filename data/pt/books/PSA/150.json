{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":150,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 150:1"},"Louvai a Jeová! Louvai a Deus no seu santuário; louvai-o no firmamento, obra do seu poder.",{"type":"verse","marker":"v","eid":"PSA 150:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 150:2"},"Louvai-o pelos seus poderosos atos, louvai-o conforme a abundância da sua grandeza.",{"type":"verse","marker":"v","eid":"PSA 150:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 150:3"},"Louvai-o ao som da trombeta, louvai-o com saltério e com harpa.",{"type":"verse","marker":"v","eid":"PSA 150:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 150:4"},"Louvai-o com adufe e com dança, louvai-o com instrumentos de cordas e com flautas.",{"type":"verse","marker":"v","eid":"PSA 150:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 150:5"},"Louvai-o com sonoros címbalos, louvai-o com címbalos retumbantes.",{"type":"verse","marker":"v","eid":"PSA 150:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 150:6"},"Todo ser que respira louve a Jeová. Louvai a Jeová!",{"type":"verse","marker":"v","eid":"PSA 150:6"}]}]}
