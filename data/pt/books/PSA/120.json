{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":120,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 120:1"},"A Jeová, na minha tribulação, clamei, e ele me respondeu.",{"type":"verse","marker":"v","eid":"PSA 120:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 120:2"},"Livra, Jeová, de lábios mentirosos a minha alma e da língua enganadora.",{"type":"verse","marker":"v","eid":"PSA 120:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 120:3"},"Que te será dado e que te será acrescentado, língua enganadora?",{"type":"verse","marker":"v","eid":"PSA 120:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 120:4"},"Agudas setas do valente, juntamente com carvões de giestas.",{"type":"verse","marker":"v","eid":"PSA 120:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 120:5"},"Ai de mim, que peregrino em Meseque e habito entre as tendas de Quedar!",{"type":"verse","marker":"v","eid":"PSA 120:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 120:6"},"Há muito que a minha alma habita com aquele que odeia a paz.",{"type":"verse","marker":"v","eid":"PSA 120:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 120:7"},"Eu sou pela paz, mas, quando falo, eles são pela guerra.",{"type":"verse","marker":"v","eid":"PSA 120:7"}]}]}
