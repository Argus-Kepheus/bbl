{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":130,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 130:1"},"Das profundezas, clamo a ti, Jeová.",{"type":"verse","marker":"v","eid":"PSA 130:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 130:2"},"Ouve, Senhor, a minha voz; estejam atentos os teus ouvidos à voz das minhas súplicas.",{"type":"verse","marker":"v","eid":"PSA 130:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 130:3"},"Se observares, Jeová, iniquidades, quem, Senhor, poderá subsistir?",{"type":"verse","marker":"v","eid":"PSA 130:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 130:4"},"Mas contigo está o perdão, a fim de que sejas reverenciado.",{"type":"verse","marker":"v","eid":"PSA 130:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 130:5"},"Aguardo a Jeová, a minha alma o aguarda, e na tua palavra espero.",{"type":"verse","marker":"v","eid":"PSA 130:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 130:6"},"Pelo Senhor mais espera a minha alma que os guardas esperam pela alvorada, mais que os guardas pela alvorada.",{"type":"verse","marker":"v","eid":"PSA 130:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 130:7"},"Espera, ó Israel, em Jeová, pois com Jeová está a benignidade, e com ele está copiosa redenção.",{"type":"verse","marker":"v","eid":"PSA 130:7"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 130:8"},"E ele remirá a Israel de todas as suas iniquidades.",{"type":"verse","marker":"v","eid":"PSA 130:8"}]}]}
