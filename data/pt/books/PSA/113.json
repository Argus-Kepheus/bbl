{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":113,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 113:1"},"Louvai a Jeová! Louvai, servos de Jeová! Louvai o nome de Jeová!",{"type":"verse","marker":"v","eid":"PSA 113:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 113:2"},"Bendito seja o nome de Jeová desde agora e para sempre!",{"type":"verse","marker":"v","eid":"PSA 113:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 113:3"},"Desde o nascimento do sol até o seu ocaso, há de ser louvado o nome de Jeová.",{"type":"verse","marker":"v","eid":"PSA 113:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 113:4"},"Excelso é Jeová acima de todas as nações, e a sua glória, acima dos céus.",{"type":"verse","marker":"v","eid":"PSA 113:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 113:5"},"Quem é semelhante a Jeová, nosso Deus, que tem o seu trono nas alturas,",{"type":"verse","marker":"v","eid":"PSA 113:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 113:6"},"que se inclina para ver o que vai no céu e sobre a terra?",{"type":"verse","marker":"v","eid":"PSA 113:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 113:7"},"Ele levanta do pó ao pobre e, do monturo, ergue ao necessitado,",{"type":"verse","marker":"v","eid":"PSA 113:7"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 113:8"},"para o fazer sentar com os príncipes, sim, com os príncipes do seu povo.",{"type":"verse","marker":"v","eid":"PSA 113:8"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 113:9"},"Faz que a mulher estéril viva em casa, como jubilosa mãe de filhos. Louvai a Jeová!",{"type":"verse","marker":"v","eid":"PSA 113:9"}]}]}
