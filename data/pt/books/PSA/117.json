{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":117,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 117:1"},"Louvai a Jeová, todas as nações; dai-lhe louvores, todos os povos.",{"type":"verse","marker":"v","eid":"PSA 117:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 117:2"},"Pois grande é a sua benignidade para conosco, e a verdade de Jeová subsiste para sempre. Louvai a Jeová!",{"type":"verse","marker":"v","eid":"PSA 117:2"}]}]}
