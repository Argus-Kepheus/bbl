{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":122,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 122:1"},"Regozijei-me quando me disseram: Vamos à Casa de Jeová.",{"type":"verse","marker":"v","eid":"PSA 122:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 122:2"},"Os nossos pés estão parados dentro das tuas portas, Jerusalém.",{"type":"verse","marker":"v","eid":"PSA 122:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 122:3"},"Jerusalém que és edificada como uma cidade compacta,",{"type":"verse","marker":"v","eid":"PSA 122:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 122:4"},"aonde sobem as tribos, as tribos de Jeová, como testemunho a Israel, para darem graças ao nome de Jeová.",{"type":"verse","marker":"v","eid":"PSA 122:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 122:5"},"Pois ali estão postos os tronos de julgar, os tronos da casa de Davi.",{"type":"verse","marker":"v","eid":"PSA 122:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 122:6"},"Orai pela paz de Jerusalém. Gozem de prosperidade os que te amam.",{"type":"verse","marker":"v","eid":"PSA 122:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 122:7"},"Haja paz dentro dos teus muros, e prosperidade, nos teus palácios.",{"type":"verse","marker":"v","eid":"PSA 122:7"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 122:8"},"Por amor dos meus irmãos e amigos, diga eu: Haja paz dentro de ti.",{"type":"verse","marker":"v","eid":"PSA 122:8"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"9","sid":"PSA 122:9"},"Por amor da Casa de Jeová, nosso Deus, buscarei o teu bem.",{"type":"verse","marker":"v","eid":"PSA 122:9"}]}]}
