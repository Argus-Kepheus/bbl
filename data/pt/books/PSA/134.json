{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":134,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 134:1"},"Eis, bendizei a Jeová, todos vós, servos de Jeová, que de noite assistis na Casa de Jeová.",{"type":"verse","marker":"v","eid":"PSA 134:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 134:2"},"Erguei as mãos para o santuário e bendizei a Jeová.",{"type":"verse","marker":"v","eid":"PSA 134:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 134:3"},"De Sião te abençoe Jeová, que fez o céu e a terra.",{"type":"verse","marker":"v","eid":"PSA 134:3"}]}]}
