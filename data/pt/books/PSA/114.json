{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":19,"code":"PSA","name":"Salmos","testament":"OT"},"chapter":114,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"PSA 114:1"},"Quando Israel saiu do Egito, e a casa de Jacó, dentre povo de língua estranha,",{"type":"verse","marker":"v","eid":"PSA 114:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"PSA 114:2"},"Judá tornou-se-lhe o santuário, e Israel, o seu domínio.",{"type":"verse","marker":"v","eid":"PSA 114:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"PSA 114:3"},"O mar viu isso e fugiu; o Jordão fugiu para trás.",{"type":"verse","marker":"v","eid":"PSA 114:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"PSA 114:4"},"Os montes saltaram como carneiros, e as colinas, como cordeiros do rebanho.",{"type":"verse","marker":"v","eid":"PSA 114:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"PSA 114:5"},"Que tens tu, ó mar, para fugires? E tu, ó Jordão, para recuares?",{"type":"verse","marker":"v","eid":"PSA 114:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"PSA 114:6"},"Vós, montes, que saltais como carneiros; vós, colinas, como cordeiros do rebanho?",{"type":"verse","marker":"v","eid":"PSA 114:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"PSA 114:7"},"Treme, terra, na presença do Senhor, na presença do Deus de Jacó,",{"type":"verse","marker":"v","eid":"PSA 114:7"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"8","sid":"PSA 114:8"},"o qual converteu a rocha em lago de água e o seixo em fonte de água.",{"type":"verse","marker":"v","eid":"PSA 114:8"}]}]}
