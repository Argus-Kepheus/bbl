{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":18,"code":"JOB","name":"Jó","testament":"OT"},"chapter":25,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"JOB 25:1"},"Então, respondeu Bildade, suíta:",{"type":"verse","marker":"v","eid":"JOB 25:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"JOB 25:2"},"A Deus pertence o domínio e o poder. Ele faz reinar a paz nas regiões celestes.",{"type":"verse","marker":"v","eid":"JOB 25:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"JOB 25:3"},"Acaso, têm número as suas tropas? E sobre quem não surge a sua luz?",{"type":"verse","marker":"v","eid":"JOB 25:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"JOB 25:4"},"Como, pois, pode o homem ser justo diante de Deus? Ou como pode ser puro aquele que nasce de mulher?",{"type":"verse","marker":"v","eid":"JOB 25:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"JOB 25:5"},"Eis que até a lua não tem brilho, e as estrelas não são puras aos olhos dele.",{"type":"verse","marker":"v","eid":"JOB 25:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"JOB 25:6"},"Quanto menos o que é verme! E o filho do homem, que é vermezinho!",{"type":"verse","marker":"v","eid":"JOB 25:6"}]}]}
