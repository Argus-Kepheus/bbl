{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":13,"code":"1CH","name":"1 Crônicas","testament":"OT"},"chapter":8,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"1CH 8:1"},"Benjamim gerou a Bela, seu primogênito, a Asbel, o segundo, a Aará, o terceiro,",{"type":"verse","marker":"v","eid":"1CH 8:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"1CH 8:2"},"a Noá, o quarto, e a Rafa, o quinto.",{"type":"verse","marker":"v","eid":"1CH 8:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"1CH 8:3"},"Bela teve filhos: Adar, Gera e Abiúde;",{"type":"verse","marker":"v","eid":"1CH 8:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"1CH 8:4"},"Abisua, Naamã e Aoá;",{"type":"verse","marker":"v","eid":"1CH 8:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"1CH 8:5"},"Gera, Sefufá e Hurão.",{"type":"verse","marker":"v","eid":"1CH 8:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"1CH 8:6"},"Estes são os filhos de Eúde; estes são os cabeças das famílias dos habitantes de Geba e que foram levados cativos para Manaate;",{"type":"verse","marker":"v","eid":"1CH 8:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"1CH 8:7"},"e Naamã, e Aías, e Gera, sendo este que os levou cativos e gerou a Uza e a Aiude.",{"type":"verse","marker":"v","eid":"1CH 8:7"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"8","sid":"1CH 8:8"},"Saaraim gerou filhos nos campos de Moabe, depois de ter repudiado suas mulheres Husim e Baara.",{"type":"verse","marker":"v","eid":"1CH 8:8"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"9","sid":"1CH 8:9"},"De sua mulher Hodes gerou a Jobabe, a Zíbia, a Mesa e a Malcã;",{"type":"verse","marker":"v","eid":"1CH 8:9"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"10","sid":"1CH 8:10"},"a Jeús, a Saquias e a Mirma. Estes foram seus filhos, cabeças das famílias.",{"type":"verse","marker":"v","eid":"1CH 8:10"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"11","sid":"1CH 8:11"},"De Husim gerou a Abitube e a Elpaal.",{"type":"verse","marker":"v","eid":"1CH 8:11"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"12","sid":"1CH 8:12"},"Os filhos de Elpaal: Héber, Misã e Semede que edificou a Ono e a Lode, juntamente com as suas vilas;",{"type":"verse","marker":"v","eid":"1CH 8:12"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"13","sid":"1CH 8:13"},"Berias e Sema cabeças das famílias dos habitantes de Aijalom, que afugentaram os habitantes de Gate;",{"type":"verse","marker":"v","eid":"1CH 8:13"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"14","sid":"1CH 8:14"},"Aiô, Sasaque e Jeremote;",{"type":"verse","marker":"v","eid":"1CH 8:14"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"15","sid":"1CH 8:15"},"Zebadias, Arade e Éder;",{"type":"verse","marker":"v","eid":"1CH 8:15"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"16","sid":"1CH 8:16"},"Micael, Ispa e Joá, filhos de Berias;",{"type":"verse","marker":"v","eid":"1CH 8:16"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"17","sid":"1CH 8:17"},"Zebadias, Mesulão, Hizqui e Héber;",{"type":"verse","marker":"v","eid":"1CH 8:17"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"18","sid":"1CH 8:18"},"Ismerai, Izlias e Jobabe, filhos de Elpaal;",{"type":"verse","marker":"v","eid":"1CH 8:18"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"19","sid":"1CH 8:19"},"Jaquim, Zicri e Zabdi;",{"type":"verse","marker":"v","eid":"1CH 8:19"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"20","sid":"1CH 8:20"},"Elienai, Ziletai e Eliel;",{"type":"verse","marker":"v","eid":"1CH 8:20"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"21","sid":"1CH 8:21"},"Adaías, Beraías e Sinrate, filhos de Simei;",{"type":"verse","marker":"v","eid":"1CH 8:21"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"22","sid":"1CH 8:22"},"Ispã, Héber e Eliel;",{"type":"verse","marker":"v","eid":"1CH 8:22"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"23","sid":"1CH 8:23"},"Abdom, Zicri e Hanã;",{"type":"verse","marker":"v","eid":"1CH 8:23"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"24","sid":"1CH 8:24"},"Hananias, Elão e Antotias;",{"type":"verse","marker":"v","eid":"1CH 8:24"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"25","sid":"1CH 8:25"},"Ifdeias e Penuel, filhos de Sasaque;",{"type":"verse","marker":"v","eid":"1CH 8:25"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"26","sid":"1CH 8:26"},"Sanserai, Searias e Atalias;",{"type":"verse","marker":"v","eid":"1CH 8:26"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"27","sid":"1CH 8:27"},"Jaaresias, Elias e Zicri, filhos de Jeroão.",{"type":"verse","marker":"v","eid":"1CH 8:27"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"28","sid":"1CH 8:28"},"Estes foram cabeças das famílias segundo as suas gerações, homens principais, e habitaram em Jerusalém.",{"type":"verse","marker":"v","eid":"1CH 8:28"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"29","sid":"1CH 8:29"},"Em Gibeão habitaram: o pai de Gibeão, cuja mulher se chamava Maaca;",{"type":"verse","marker":"v","eid":"1CH 8:29"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"30","sid":"1CH 8:30"},"seu primogênito Abdom, Zur, Quis, Baal e Nadabe,",{"type":"verse","marker":"v","eid":"1CH 8:30"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"31","sid":"1CH 8:31"},"Gedor, Aiô e Zequer.",{"type":"verse","marker":"v","eid":"1CH 8:31"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"32","sid":"1CH 8:32"},"Miclote gerou a Simeia. Estes também habitaram em Jerusalém com seus irmãos, bem defronte deles.",{"type":"verse","marker":"v","eid":"1CH 8:32"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"33","sid":"1CH 8:33"},"Ner gerou a Quis; e Quis gerou a Saul; e Saul gerou a Jônatas, a Malquisua, a Abinadabe e a Esbaal.",{"type":"verse","marker":"v","eid":"1CH 8:33"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"34","sid":"1CH 8:34"},"O filho de Jônatas foi Meribe-Baal; e Meribe-Baal gerou a Mica.",{"type":"verse","marker":"v","eid":"1CH 8:34"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"35","sid":"1CH 8:35"},"Os filhos de Mica: Pitom, Meleque, Tareia e Acaz.",{"type":"verse","marker":"v","eid":"1CH 8:35"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"36","sid":"1CH 8:36"},"Acaz gerou a Joada; Joada gerou a Alemete, a Azmavete e a Zinri; Zinri gerou a Moza;",{"type":"verse","marker":"v","eid":"1CH 8:36"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"37","sid":"1CH 8:37"},"e Moza gerou a Bineá, de quem foi filho Rafa, de quem foi filho Eleasa, de quem foi filho Azel;",{"type":"verse","marker":"v","eid":"1CH 8:37"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"38","sid":"1CH 8:38"},"e Azel teve seis filhos, cujos nomes foram: Azricão, Bocru, Ismael, Searias, Obadias e Hanã. Todos estes foram filhos de Azel.",{"type":"verse","marker":"v","eid":"1CH 8:38"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"39","sid":"1CH 8:39"},"Os filhos de Eseque, seu irmão: Ulão, seu primogênito, Jeús, o segundo, e Elifelete, o terceiro.",{"type":"verse","marker":"v","eid":"1CH 8:39"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"40","sid":"1CH 8:40"},"Os filhos de Ulão foram homens ilustres em valor, flecheiros e tiveram muitos filhos e netos, em número de cento e cinquenta. Todos estes foram dos filhos de Benjamim.",{"type":"verse","marker":"v","eid":"1CH 8:40"}]}]}
