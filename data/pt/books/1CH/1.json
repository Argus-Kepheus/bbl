{"schema_version":"1.0","language":"pt","edition":"pt-ak","revision":"0","book":{"position":13,"code":"1CH","name":"1 Crônicas","testament":"OT"},"chapter":1,"content":[{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"1","sid":"1CH 1:1"},"Adão, Sete, Enos,",{"type":"verse","marker":"v","eid":"1CH 1:1"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"2","sid":"1CH 1:2"},"Cainã, Maalaleel, Jarede,",{"type":"verse","marker":"v","eid":"1CH 1:2"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"3","sid":"1CH 1:3"},"Enoque, Matusalém, Lameque,",{"type":"verse","marker":"v","eid":"1CH 1:3"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"4","sid":"1CH 1:4"},"Noé, Sem, Cam e Jafé.",{"type":"verse","marker":"v","eid":"1CH 1:4"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"5","sid":"1CH 1:5"},"Os filhos de Jafé: Gômer, Magogue, Madai, Javã, Tubal, Meseque e Tirás.",{"type":"verse","marker":"v","eid":"1CH 1:5"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"6","sid":"1CH 1:6"},"Os filhos de Gômer: Asquenaz, Difate e Togarma.",{"type":"verse","marker":"v","eid":"1CH 1:6"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"7","sid":"1CH 1:7"},"Os filhos de Javã: Elisá, Társis, Quitim e Rodanim.",{"type":"verse","marker":"v","eid":"1CH 1:7"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"8","sid":"1CH 1:8"},"Os filhos de Cam: Cuxe, Mizraim, Pute e Canaã.",{"type":"verse","marker":"v","eid":"1CH 1:8"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"9","sid":"1CH 1:9"},"Os filhos de Cuxe: Sebá, Havilá, Sabtá, Raamá e Sabtecá. Os filhos de Raamá: Sebá e Dedã.",{"type":"verse","marker":"v","eid":"1CH 1:9"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"10","sid":"1CH 1:10"},"Cuxe gerou a Ninrode, que começou a ser poderoso na terra.",{"type":"verse","marker":"v","eid":"1CH 1:10"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"11","sid":"1CH 1:11"},"Mizraim gerou a Ludim, a Ananim, a Leabim, a Naftuim,",{"type":"verse","marker":"v","eid":"1CH 1:11"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"12","sid":"1CH 1:12"},"a Patrusim, a Casluim (donde procederam os filisteus) e a Caftorim.",{"type":"verse","marker":"v","eid":"1CH 1:12"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"13","sid":"1CH 1:13"},"Canaã gerou a Sidom, seu primogênito, a Hete,",{"type":"verse","marker":"v","eid":"1CH 1:13"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"14","sid":"1CH 1:14"},"aos jebuseus, aos amorreus, aos girgaseus,",{"type":"verse","marker":"v","eid":"1CH 1:14"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"15","sid":"1CH 1:15"},"aos heveus, aos arqueus, aos sineus,",{"type":"verse","marker":"v","eid":"1CH 1:15"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"16","sid":"1CH 1:16"},"aos arvadeus, aos zemareus e aos hamateus.",{"type":"verse","marker":"v","eid":"1CH 1:16"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"17","sid":"1CH 1:17"},"Os filhos de Sem: Elão, Assur, Arfaxade, Lude, Arão, Uz, Hul, Géter e Meseque.",{"type":"verse","marker":"v","eid":"1CH 1:17"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"18","sid":"1CH 1:18"},"Arfaxade gerou a Selá, e Selá gerou a Héber.",{"type":"verse","marker":"v","eid":"1CH 1:18"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"19","sid":"1CH 1:19"},"A Héber nasceram dois filhos, um dos quais foi chamado Pelegue, porque, nos seus dias, se dividiu a terra; e o nome de seu irmão foi Joctã.",{"type":"verse","marker":"v","eid":"1CH 1:19"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"20","sid":"1CH 1:20"},"Joctã gerou a Almodade, a Salefe, a Hazar-Mavé, a Jerá,",{"type":"verse","marker":"v","eid":"1CH 1:20"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"21","sid":"1CH 1:21"},"a Hadorão, a Uzal, a Dicla,",{"type":"verse","marker":"v","eid":"1CH 1:21"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"22","sid":"1CH 1:22"},"a Ebal, a Abimael, a Sabá,",{"type":"verse","marker":"v","eid":"1CH 1:22"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"23","sid":"1CH 1:23"},"a Ofir, a Havilá e a Jobabe. Todos estes eram filhos de Joctã.",{"type":"verse","marker":"v","eid":"1CH 1:23"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"24","sid":"1CH 1:24"},"Sem, Arfaxade, Selá,",{"type":"verse","marker":"v","eid":"1CH 1:24"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"25","sid":"1CH 1:25"},"Héber, Pelegue, Reú,",{"type":"verse","marker":"v","eid":"1CH 1:25"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"26","sid":"1CH 1:26"},"Serugue, Naor, Tera,",{"type":"verse","marker":"v","eid":"1CH 1:26"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"27","sid":"1CH 1:27"},"Abrão (Este é Abraão.).",{"type":"verse","marker":"v","eid":"1CH 1:27"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"28","sid":"1CH 1:28"},"Os filhos de Abraão: Isaque e Ismael.",{"type":"verse","marker":"v","eid":"1CH 1:28"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"29","sid":"1CH 1:29"},"Estas são as suas gerações: Nebaiote, primogênito de Ismael, depois Quedar, Adbeel, Mibsão,",{"type":"verse","marker":"v","eid":"1CH 1:29"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"30","sid":"1CH 1:30"},"Misma, Dumá, Massá, Hadade, Tema,",{"type":"verse","marker":"v","eid":"1CH 1:30"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"31","sid":"1CH 1:31"},"Jetur, Nafis e Quedemá. Estes são os filhos de Ismael.",{"type":"verse","marker":"v","eid":"1CH 1:31"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"32","sid":"1CH 1:32"},"Os filhos de Quetura, concubina de Abraão, que deu à luz Zinrã, Jocsã, Medã, Midiã, Jisbaque e Sua. Os filhos de Jocsã: Sabá e Dedã.",{"type":"verse","marker":"v","eid":"1CH 1:32"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"33","sid":"1CH 1:33"},"Os filhos de Midiã: Efá, Éfer, Enoque, Abida e Elda. Todos estes eram filhos de Quetura.",{"type":"verse","marker":"v","eid":"1CH 1:33"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"34","sid":"1CH 1:34"},"Abraão gerou a Isaque. Os filhos de Isaque: Esaú e Israel.",{"type":"verse","marker":"v","eid":"1CH 1:34"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"35","sid":"1CH 1:35"},"Os filhos de Esaú: Elifaz, Reuel, Jeús, Jalão e Coré.",{"type":"verse","marker":"v","eid":"1CH 1:35"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"36","sid":"1CH 1:36"},"Os filhos de Elifaz: Temã, Omar, Zefi, Gaetã, Quenaz, Timna e Amaleque.",{"type":"verse","marker":"v","eid":"1CH 1:36"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"37","sid":"1CH 1:37"},"Os filhos de Reuel: Naate, Zerá, Samá e Mizá.",{"type":"verse","marker":"v","eid":"1CH 1:37"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"38","sid":"1CH 1:38"},"Os filhos de Seir: Lotã, Sobal, Zibeão, Aná, Diso, Ezer e Disã.",{"type":"verse","marker":"v","eid":"1CH 1:38"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"39","sid":"1CH 1:39"},"Os filhos de Lotã: Hori e Homã; e Timna era irmã de Lotã.",{"type":"verse","marker":"v","eid":"1CH 1:39"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"40","sid":"1CH 1:40"},"Os filhos de Sobal: Aliã, Manaate, Ebal, Sefi e Onã. Os filhos de Zibeão: Aiá e Aná.",{"type":"verse","marker":"v","eid":"1CH 1:40"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"41","sid":"1CH 1:41"},"Os filhos de Aná: Disom. Os filhos de Disom: Hanrão, Esbã, Itrã e Querã.",{"type":"verse","marker":"v","eid":"1CH 1:41"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"42","sid":"1CH 1:42"},"Os filhos de Eser: Bilã, Zaavã e Jaacã. Os filhos de Disã: Uz e Arã.",{"type":"verse","marker":"v","eid":"1CH 1:42"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"43","sid":"1CH 1:43"},"Ora, estes são os reis que reinaram na terra de Edom, antes que reinasse rei sobre os filhos de Israel: Bela, filho de Beor; e a sua cidade chamava-se Dinabá.",{"type":"verse","marker":"v","eid":"1CH 1:43"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"44","sid":"1CH 1:44"},"Morreu Bela, e, em seu lugar, reinou Jobabe, filho de Zerá, de Bozra.",{"type":"verse","marker":"v","eid":"1CH 1:44"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"45","sid":"1CH 1:45"},"Morreu Jobabe, e, em seu lugar, reinou Husão, da terra dos temanitas.",{"type":"verse","marker":"v","eid":"1CH 1:45"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"46","sid":"1CH 1:46"},"Morreu Husão, e, em seu lugar, reinou Hadade, filho de Bedade, que derrotou a Midiã no campo de Moabe; e a sua cidade chamava-se Avite.",{"type":"verse","marker":"v","eid":"1CH 1:46"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"47","sid":"1CH 1:47"},"Morreu Hadade, e, em seu lugar, reinou Sanlá de Masreca.",{"type":"verse","marker":"v","eid":"1CH 1:47"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"48","sid":"1CH 1:48"},"Morreu Sanlá, e, em seu lugar, reinou Saul de Reobote junto ao rio.",{"type":"verse","marker":"v","eid":"1CH 1:48"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"49","sid":"1CH 1:49"},"Morreu Saul, e, em seu lugar, reinou Baal-Hanã, filho de Acbor.",{"type":"verse","marker":"v","eid":"1CH 1:49"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"50","sid":"1CH 1:50"},"Morreu Baal-Hanã, e, em seu lugar, reinou Hadade; e a sua cidade chamava-se Paí. O nome de sua mulher era Meetabel, filha de Matrede, filha de Me-Zaabe.",{"type":"verse","marker":"v","eid":"1CH 1:50"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"51","sid":"1CH 1:51"},"Hadade morreu. Os príncipes de Edom foram: o príncipe Timna, o príncipe Aliá, o príncipe Jetete,",{"type":"verse","marker":"v","eid":"1CH 1:51"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"52","sid":"1CH 1:52"},"o príncipe Oolibama, o príncipe Elá, o príncipe Pinom,",{"type":"verse","marker":"v","eid":"1CH 1:52"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"53","sid":"1CH 1:53"},"o príncipe Quenaz, o príncipe Temã, o príncipe Mibzar,",{"type":"verse","marker":"v","eid":"1CH 1:53"}]},{"type":"para","marker":"p","content":[{"type":"verse","marker":"v","number":"54","sid":"1CH 1:54"},"o príncipe Magdiel e o príncipe Irã. Estes são os príncipes de Edom.",{"type":"verse","marker":"v","eid":"1CH 1:54"}]}]}
